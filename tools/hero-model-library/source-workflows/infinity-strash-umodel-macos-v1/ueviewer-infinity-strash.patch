diff --git a/Unreal/UnrealMesh/UnMesh4.cpp b/Unreal/UnrealMesh/UnMesh4.cpp
index 89e2119..9b4730b 100644
--- a/Unreal/UnrealMesh/UnMesh4.cpp
+++ b/Unreal/UnrealMesh/UnMesh4.cpp
@@ -845,6 +845,15 @@ struct FSkelMeshSection4
 		Ar << ClothMappingData;
 		S.HasClothData = (ClothMappingData.Num() > 0);
 
+		// Infinity Strash stores the section cumulative base vertex as uint64.
+		// Without this field, BoneMap is read eight bytes early.
+		if (Ar.Game == GAME_InfinityStrash)
+		{
+			uint64 BaseVertexIndex64;
+			Ar << BaseVertexIndex64;
+			S.BaseVertexIndex = (uint32)BaseVertexIndex64;
+		}
+
 		Ar << S.BoneMap;
 		Ar << S.NumVertices;
 		Ar << S.MaxBoneInfluences;
