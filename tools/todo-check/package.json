{
  "name": "@ggd/todo-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "todo-check": "./src/cli.ts"
  },
  "scripts": {
    "todo:static": "tsx src/cli.ts --static --dir ../../docs/todo",
    "todo:runtime": "tsx src/cli.ts --runtime",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
