// --- Trig_AcxelShooter_Conditions (family, line 35801) ---
function Trig_AcxelShooter_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0LB' ) ) then
        return false
    endif
    return true
