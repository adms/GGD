item rt=null
endglobalsfunction it takes real at returns nothinglocal real ntlocal real st=TimerGetElapsed(YS)if st<=0 thenset YS=CreateTimer()
call TimerStart(YS,$F4240,false,null)endifif(at>0)then
loop
set nt=at-TimerGetElapsed(YS)+st
exitwhen nt<=0if(nt>bj_POLLED_WAIT_SKIP_THRESHOLD)then
call TriggerSleepAction(.1*nt)else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endifendloopendifendfunctionfunction Vt takes location Et,real Xt,real Ot returns locationreturn Location(GetLocationX(Et)+Xt*Cos(Ot*bj_DEGTORAD),GetLocationY(Et)+Xt*Sin(Ot*bj_DEGTORAD))
endfunctionfunction Rt takes nothing returns booleanlocal real dx=GetDestructableX(GetFilterDestructable())-ZSlocal real dy=GetDestructableY(GetFilterDestructable())-vtreturn(dx*dx+dy*dy<=bj_enumDestructableRadius)endfunctionfunction It takes real At,location Nt,code bt returns nothinglocal rect r
if(At>=0)thenset ZS=GetLocationX(Nt)set vt=GetLocationY(Nt)set bj_enumDestructableRadius=At*Atset r=Rect(ZS-At,vt-At,ZS+At,vt+At)call EnumDestructablesInRect(r,filterEnumDestructablesInCircleBJ,bt)
call RemoveRect(r)set r=nullendifendfunctionfunction Bt takes rect r,boolexpr ct returns groupset et=CreateGroup()
call GroupEnumUnitsInRect(et,r,ct)call DestroyBoolExpr(ct)
return etendfunctionfunction Ct takes rect r returns groupset et=CreateGroup()
call GroupEnumUnitsInRect(et,r,ot)return etendfunctionfunction dt takes rect r,player Dt returns group
set et=CreateGroup()
set bj_groupEnumOwningPlayer=Dtcall GroupEnumUnitsInRect(et,r,filterGetUnitsInRectOfPlayer)
return etendfunctionfunction ft takes real At,location Ft,boolexpr ct returns groupset et=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(et,Ft,At,ct)
return etendfunctionfunction gt takes real At,location Ft returns groupset et=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(et,Ft,At,ot)
return etendfunctionfunction Gt takes player Dt,boolexpr ct returns groupset et=CreateGroup()
call GroupEnumUnitsOfPlayer(et,Dt,ct)call DestroyBoolExpr(ct)
return etendfunctionfunction ht takes player Dt returns groupset et=CreateGroup()
call GroupEnumUnitsOfPlayer(et,Dt,ot)return etendfunctionfunction Ht takes player Dt,integer jt returns group
set et=CreateGroup()
set bj_groupEnumTypeId=jtcall GroupEnumUnitsOfPlayer(et,Dt,filterGetUnitsOfPlayerAndTypeId)return etendfunctionfunction Jt takes player Dt returns forceset xt=CreateForce()
call ForceAddPlayer(xt,Dt)return xtendfunctionfunction kt takes mapcontrol Kt returns forcelocal integer lt
local player Ltset xt=CreateForce()
set lt=0
loop
set Lt=Player(lt)if GetPlayerController(Lt)==Kt thencall ForceAddPlayer(xt,Lt)endifset lt=lt+1exitwhen lt==16endloopreturn xtendfunctionfunction mt takes player Dt returns forceset xt=CreateForce()
call ForceEnumAllies(xt,Dt,ot)return xtendfunctionfunction Mt takes player Dt returns forceset xt=CreateForce()
call ForceEnumEnemies(xt,Dt,ot)return xtendfunctionfunction pt takes boolexpr ct returns forceset xt=CreateForce()
call ForceEnumPlayers(xt,ct)
call DestroyBoolExpr(ct)
return xtendfunctionfunction Pt takes itemtype qt,integer Qt returns nothing
local group gset bj_stockPickedItemType=qtset bj_stockPickedItemLevel=Qtset g=CreateGroup()call GroupEnumUnitsOfType(g,"marketplace",ot)call ForGroup(g,function UpdateEachStockBuildingEnum)call DestroyGroup(g)
set g=nullendfunctionfunction St takes nothing returns nothinglocal integer pickedItemIdlocal itemtype ttlocal integer Tt=0local integer ut=0local integer Qt
set Qt=1
loop
if(bj_stockAllowedPermanent[Qt])then
set ut=ut+1if(GetRandomInt(1,ut)==1)thenset tt=ITEM_TYPE_PERMANENTset Tt=Qtendifendifif(bj_stockAllowedCharged[Qt])thenset ut=ut+1if(GetRandomInt(1,ut)==1)thenset tt=ITEM_TYPE_CHARGED
