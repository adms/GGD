    call TriggerAddCondition( gg_trg_WildCut, Condition( function Trig_WildCut_Conditions ) )
    call TriggerAddAction( gg_trg_WildCut, function Trig_WildCut_Actions )
endfunction

//===========================================================================
// Trigger: WildCut Effect
//
// 
//===========================================================================
function Trig_WildCut_Effect_Func005A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_WildCut_Effect_Func012Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_KnockBack_TargetTN)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_WildCut_Effect_Func012Func002A takes nothing returns nothing
    if ( Trig_WildCut_Effect_Func012Func002Func001C() ) then
        call UnitDamageTargetBJ( udg_KnockBack_TargetTN, GetEnumUnit(), udg_wildCutDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_WildCut_Effect_Func012C takes nothing returns boolean
    if ( not ( ModuloInteger(udg_KnockBack_IndexTN, 2) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WildCut_Effect_Func013C takes nothing returns boolean
    if ( not ( udg_KnockBack_IndexTN >= 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WildCut_Effect_Actions takes nothing returns nothing
    set udg_KnockBack_IndexTN = ( udg_KnockBack_IndexTN + 1 )
    set udg_P1TN = GetUnitLoc(udg_KnockBack_TargetTN)
    set udg_P2TN = PolarProjectionBJ(udg_P1TN, 250.00, udg_KnockBack_AngleTN)
    call SetUnitPositionLoc( udg_KnockBack_TargetTN, udg_P2TN )
    call EnumDestructablesInCircleBJ( 350.00, GetUnitLoc(udg_KnockBack_TargetTN), function Trig_WildCut_Effect_Func005A )
    set udg_P3TN = GetUnitLoc(udg_KnockBack_TargetTN)
    call CreateTextTagUnitBJ( "TRIGSTR_490", udg_KnockBack_TargetTN, -30.00, 18.00, 90.00, 0.00, 0.00, 10.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 350.00, GetRandomDirectionDeg() )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    if ( Trig_WildCut_Effect_Func012C() ) then
        set udg_KnockBack_AngleTN = ( udg_KnockBack_AngleTN + 216.00 )
        call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, udg_P1TN), function Trig_WildCut_Effect_Func012Func002A )
    else
    endif
    if ( Trig_WildCut_Effect_Func013C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call RemoveLocation(udg_P1TN)
        call RemoveLocation(udg_P2TN)
        call RemoveLocation(udg_P3TN)
        call SetUnitPathing( udg_KnockBack_TargetTN, true )
        call GroupClear( udg_WildCutGroup )
        call UnitRemoveAbilityBJ( 'A09O', udg_KnockBack_TargetTN )
        call UnitRemoveAbilityBJ( 'A09P', udg_KnockBack_TargetTN )
        call UnitRemoveAbilityBJ( 'Avul', udg_KnockBack_TargetTN )
        call PlaySoundOnUnitBJ( gg_snd_EggSackDeath1, 100, udg_KnockBack_TargetTN )
    else
    endif
endfunction

//===========================================================================
function InitTrig_WildCut_Effect takes nothing returns nothing
    set gg_trg_WildCut_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_WildCut_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_WildCut_Effect, 0.06 )
    call TriggerAddAction( gg_trg_WildCut_Effect, function Trig_WildCut_Effect_Actions )
endfunction

