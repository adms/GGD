    set gg_trg_Map_Initialization = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Map_Initialization, function Trig_Map_Initialization_Actions )
endfunction

//===========================================================================
// Trigger: GameOver Red
//===========================================================================
function Trig_GameOver_Red_Func024Func001001002 takes nothing returns boolean
    return ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true )
endfunction

function Trig_GameOver_Red_Func024Func001A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_GameOver_Red_Func024Func002001002 takes nothing returns boolean
    return ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true )
endfunction

function Trig_GameOver_Red_Func024Func002A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_GameOver_Red_Actions takes nothing returns nothing
    call UnitAddAbilityBJ( 'A0J2', GetKillingUnitBJ() )
    call CreateTextTagUnitBJ( ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + " 終結！！" ), GetDyingUnit(), 0, 32.00, 100, 100.00, 100.00, 15.00 )
    set udg_GameOver = true
    call EnableTrigger( gg_trg_FinalFight )
    call DisableTrigger( gg_trg_Free_Gold )
    call DisableTrigger( gg_trg_GoDie_Center_SpawnF )
    call DisableTrigger( gg_trg_GoDie_Center_SpawnM )
    call DisableTrigger( gg_trg_GoDie_North_SpawnF )
    call DisableTrigger( gg_trg_GoDie_North_SpawnM )
    call DisableTrigger( gg_trg_GoDie_South_SpawnF )
    call DisableTrigger( gg_trg_GoDie_South_SpawnM )
    call DisableTrigger( gg_trg_Love_Center_SpawnF )
    call DisableTrigger( gg_trg_Love_Center_SpawnM )
    call DisableTrigger( gg_trg_Love_North_SpawnF )
    call DisableTrigger( gg_trg_Love_North_SpawnM )
    call DisableTrigger( gg_trg_Love_South_SpawnF )
    call DisableTrigger( gg_trg_Love_South_SpawnM )
    call DisableTrigger( gg_trg_Tower_Broken )
    call DisableTrigger( gg_trg_GameOver_Green )
    call PlaySoundBJ( gg_snd_GameFound )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 13
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetupApplyForPlayer( true, gg_cam_Camera_007, ConvertedPlayer(GetForLoopIndexA()), 2.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DisplayTimedTextToForce( GetPlayersAll(), 10.00, "TRIGSTR_376" )
    call TriggerSleepAction( 7.00 )
    set udg_cleanMap = 1
    loop
        exitwhen udg_cleanMap > 100
        call ForGroupBJ( GetUnitsOfPlayerMatching(Player(0), Condition(function Trig_GameOver_Red_Func024Func001001002)), function Trig_GameOver_Red_Func024Func001A )
        call ForGroupBJ( GetUnitsOfPlayerMatching(Player(6), Condition(function Trig_GameOver_Red_Func024Func002001002)), function Trig_GameOver_Red_Func024Func002A )
        set udg_cleanMap = udg_cleanMap + 1
    endloop
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 13
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetupApplyForPlayer( true, gg_cam_Camera_014, ConvertedPlayer(GetForLoopIndexA()), 2.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call PlayMusicExBJ( gg_snd_PH1, 0.10, 5.00 )
    call TriggerSleepAction( 1.00 )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_3853" )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_3898" )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_3963" )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_3996" )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_4122" )
    call TriggerSleepAction( 2.00 )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 13
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ReviveHeroLoc( udg_PlayerHeroUnit[GetForLoopIndexA()], GetRectCenter(gg_rct_Center), true )
        call SetUnitLifePercentBJ( udg_PlayerHeroUnit[GetForLoopIndexA()], 100 )
        call SetUnitManaPercentBJ( udg_PlayerHeroUnit[GetForLoopIndexA()], 100 )
        call UnitResetCooldown( udg_PlayerHeroUnit[GetForLoopIndexA()] )
        call SetUnitPositionLoc( udg_PlayerHeroUnit[GetForLoopIndexA()], GetRectCenter(gg_rct_Center) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 60.00 )
    call MeleeInitVictoryDefeat(  )
    call CustomVictoryBJ( Player(6), true, true )
    call CustomVictoryBJ( Player(7), true, true )
    call CustomVictoryBJ( Player(8), true, true )
    call CustomVictoryBJ( Player(9), true, true )
    call CustomVictoryBJ( Player(10), true, true )
    call CustomVictoryBJ( Player(11), true, true )
    call DisplayTimedTextToForce( GetPlayersAll(), 30.00, "TRIGSTR_1082" )
    call CustomDefeatBJ( Player(0), "TRIGSTR_2269" )
    call CustomDefeatBJ( Player(1), "TRIGSTR_2270" )
    call CustomDefeatBJ( Player(2), "TRIGSTR_2271" )
    call CustomDefeatBJ( Player(3), "TRIGSTR_2272" )
    call CustomDefeatBJ( Player(4), "TRIGSTR_2273" )
    call CustomDefeatBJ( Player(5), "TRIGSTR_2274" )
endfunction

