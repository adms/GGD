    set gg_trg_TimeMachineRev = CreateTrigger(  )
    call DisableTrigger( gg_trg_TimeMachineRev )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_TimeMachineRev, EVENT_PLAYER_UNIT_SPELL_EFFECT )
