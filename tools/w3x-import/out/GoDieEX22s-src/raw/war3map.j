        return false
    endif
    return true
endfunction

function Trig_Kuso_Mode_Func003C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_PlayersScourge) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kuso_Mode_Actions takes nothing returns nothing
    if ( Trig_Kuso_Mode_Func002C() ) then
        call SetHeroLevelBJ( GetTriggerUnit(), ( GetHeroLevel(GetTriggerUnit()) + 25 ), true )
        call AdjustPlayerStateBJ( 50000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        call AdjustPlayerStateBJ( 5000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
    else
    endif
    if ( Trig_Kuso_Mode_Func003C() ) then
        call SetHeroLevelBJ( GetTriggerUnit(), ( GetHeroLevel(GetTriggerUnit()) + 25 ), true )
        call AdjustPlayerStateBJ( 50000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        call AdjustPlayerStateBJ( 5000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
    else
    endif
endfunction

