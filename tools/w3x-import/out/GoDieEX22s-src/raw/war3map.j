//===========================================================================
// Trigger: linkmove
//===========================================================================
function Trig_linkmove_Func001Func007002003002 takes nothing returns boolean
    return GetBooleanAnd( IsUnitAliveBJ(GetFilterUnit()) == true, IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_TUnit[0])) == true )
endfunction

function Trig_linkmove_Func001Func007002003 takes nothing returns boolean
    return GetBooleanAnd( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false, Trig_linkmove_Func001Func007002003002() )
endfunction


function Trig_linkmove_Actions takes nothing returns nothing
    local location TedPoint
    local group TGroup

    if ( udg_Tdistance <= 20 ) then
        set udg_Tdistance = ( udg_Tdistance + 1 )
        set TedPoint = PolarProjectionBJ(udg_Tpoint, ( 50.00 * I2R(udg_Tdistance) ), udg_TAngle)
        call CreateNUnitsAtLoc( 1, 'u01R', GetOwningPlayer(udg_TUnit[0]), TedPoint, udg_TAngle )
        set udg_Tlinkunit[udg_Tdistance] = GetLastCreatedUnit()
        set TGroup = GetUnitsInRangeOfLocMatching(100.00, TedPoint, Condition(function Trig_linkmove_Func001Func007002003))
        call RemoveLocation( TedPoint )
        if ( udg_Tdistance >= 3 ) then
            set udg_TUnit[1] = GroupPickRandomUnit(TGroup)
            call DestroyGroup(TGroup)
            set TGroup = null
            if ( IsUnitAlly(udg_TUnit[1], GetOwningPlayer(udg_TUnit[0])) != true ) then
                call UnitDamageTargetBJ( udg_TUnit[0], udg_TUnit[1], ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A0RO', udg_TUnit[0])) + 50 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            endif
        endif
        if ( udg_TUnit[1] != null ) then
            call EnableTrigger( gg_trg_linkback )
            call DisableTrigger( GetTriggeringTrigger() )
        endif
    else
        call EnableTrigger( gg_trg_linkback )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_linkmove takes nothing returns nothing
    set gg_trg_linkmove = CreateTrigger(  )
    call DisableTrigger( gg_trg_linkmove )
    call TriggerRegisterTimerEventPeriodic( gg_trg_linkmove, 0.03 )
    call TriggerAddAction( gg_trg_linkmove, function Trig_linkmove_Actions )
endfunction

//===========================================================================
// Trigger: linkback
//===========================================================================
function Trig_linkback_Actions takes nothing returns nothing
    local location TedPoint

    if ( IsUnitAlly(udg_TUnit[1], Player(PLAYER_NEUTRAL_AGGRESSIVE)) == false ) then
       set TedPoint = GetUnitLoc(udg_Tlinkunit[udg_Tdistance])
       call SetUnitPositionLoc( udg_TUnit[1], TedPoint )
       call RemoveLocation( TedPoint )
    endif
    call KillUnit( udg_Tlinkunit[udg_Tdistance] )
    call RemoveUnit( udg_Tlinkunit[udg_Tdistance] )
    set udg_Tdistance = ( udg_Tdistance - 1 )
    if ( udg_Tdistance == 0 ) then
        set udg_TUnit[0] = null
        set udg_TUnit[1] = null
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_linkback takes nothing returns nothing
    set gg_trg_linkback = CreateTrigger(  )
    call DisableTrigger( gg_trg_linkback )
    call TriggerRegisterTimerEventPeriodic( gg_trg_linkback, 0.04 )
    call TriggerAddAction( gg_trg_linkback, function Trig_linkback_Actions )
endfunction

//===========================================================================
// Trigger: RiderSprint
//===========================================================================
function Trig_RiderSprint_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0RQ' )) then
        return false
    endif
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == false )) then
        return false
    endif
    return true
endfunction

function Trig_RiderSprint_Actions takes nothing returns nothing
    local location RiderPoints

    call ShowUnitHide( udg_Rider )
    set RiderPoints = GetUnitLoc(GetTriggerUnit())
    set udg_RiderCastPoint = GetSpellTargetLoc()
    set udg_RiderCenCirPoint = PolarProjectionBJ(RiderPoints, 800.00, ( GetUnitFacing(GetTriggerUnit()) + 180.00 ))
    set udg_RiderFlyAngle = AngleBetweenPoints(RiderPoints, udg_RiderCenCirPoint)
    set udg_RiderChaAngle = ( udg_RiderFlyAngle + 37.00 )
    call CreateNUnitsAtLoc( 1, 'h024', GetOwningPlayer(GetTriggerUnit()), RiderPoints, udg_RiderChaAngle )
    set udg_RiderUnit = GetLastCreatedUnit()
    set udg_RiderDistance = 750.00
    set udg_RiderHight = 100.00
    call RemoveLocation( RiderPoints )
    call EnableTrigger( gg_trg_Ridermoveline )
endfunction

//===========================================================================
function InitTrig_RiderSprint takes nothing returns nothing
    set gg_trg_RiderSprint = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_RiderSprint, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_RiderSprint, Condition( function Trig_RiderSprint_Conditions ) )
    call TriggerAddAction( gg_trg_RiderSprint, function Trig_RiderSprint_Actions )
endfunction

//===========================================================================
// Trigger: Ridermoveline
//===========================================================================
function Trig_Ridermoveline_Actions takes nothing returns nothing
    local location RiderNowPoint
    local location RiderEveryPoint

    if ( udg_RiderDistance > 0.00 ) then
        set RiderNowPoint = GetUnitLoc(udg_RiderUnit)
        set RiderEveryPoint = PolarProjectionBJ(RiderNowPoint, 50.00, udg_RiderChaAngle)
        set udg_RiderHight = ( udg_RiderHight + 15.00 )
        call SetUnitPositionLocFacingBJ( udg_RiderUnit, RiderEveryPoint, udg_RiderChaAngle )
        call SetUnitFacingTimed( udg_RiderUnit, udg_RiderChaAngle, 0 )
        set udg_RiderDistance = ( udg_RiderDistance - 50.00 )
        call SetUnitFlyHeightBJ( udg_RiderUnit, udg_RiderHight, 0.00 )
        call RemoveLocation( RiderNowPoint )
        call RemoveLocation( RiderEveryPoint )
    else
        set udg_RiderChaAngle = ( udg_RiderFlyAngle + 90.00 )
        set udg_RiderDistance = 180.00
        call EnableTrigger( gg_trg_Ridermovecir )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Ridermoveline takes nothing returns nothing
    set gg_trg_Ridermoveline = CreateTrigger(  )
    call DisableTrigger( gg_trg_Ridermoveline )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Ridermoveline, 0.01 )
    call TriggerAddAction( gg_trg_Ridermoveline, function Trig_Ridermoveline_Actions )
endfunction

//===========================================================================
// Trigger: Ridermovecir
//===========================================================================
function Trig_Ridermovecir_Actions takes nothing returns nothing
    local location RiderEveryPoint

    if ( udg_RiderDistance > 0.00 ) then
        set RiderEveryPoint = PolarProjectionBJ(udg_RiderCenCirPoint, 600.00, udg_RiderChaAngle)
        call SetUnitFacingTimed( udg_RiderUnit, ( udg_RiderChaAngle - 90.00 ), 0 )
        call SetUnitPositionLocFacingBJ( udg_RiderUnit, RiderEveryPoint, ( udg_RiderChaAngle - 90.00 ) )
        set udg_RiderDistance = ( udg_RiderDistance - 18.00 )
        set udg_RiderChaAngle = ( udg_RiderChaAngle - 18.00 )
        set udg_RiderHight = ( udg_RiderHight + 10.00 )
        call SetUnitFlyHeightBJ( udg_RiderUnit, udg_RiderHight, 0.00 )
        call RemoveLocation( RiderEveryPoint )
    else
        set RiderEveryPoint = GetUnitLoc(udg_RiderUnit)
        set udg_RiderChaAngle = AngleBetweenPoints(RiderEveryPoint, udg_RiderCastPoint)
        set udg_RiderDistance = DistanceBetweenPoints(RiderEveryPoint, udg_RiderCastPoint)
        call RemoveLocation( RiderEveryPoint )
        call EnableTrigger( gg_trg_RidermovelineDam )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Ridermovecir takes nothing returns nothing
    set gg_trg_Ridermovecir = CreateTrigger(  )
    call DisableTrigger( gg_trg_Ridermovecir )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Ridermovecir, 0.02 )
    call TriggerAddAction( gg_trg_Ridermovecir, function Trig_Ridermovecir_Actions )
endfunction

//===========================================================================
// Trigger: RidermovelineDam
//===========================================================================
function Trig_RidermovelineDam_Func001Func007001003 takes nothing returns boolean
    return GetBooleanAnd( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) != true ), ( IsUnitAlly(GetFilterUnit(), GetOwningPlayer(udg_Rider)) != true ) )
endfunction

function Trig_RidermovelineDam_Func001Func007A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Rider, GetEnumUnit(), ( 0.00 + ( ( 300.00 * I2R(GetUnitAbilityLevelSwapped('A0RQ', udg_Rider)) ) + ( 3.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Rider, true)) ) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

function Trig_RidermovelineDam_Actions takes nothing returns nothing
    local location RiderNowPoint
    local location RiderEveryPoint
    local location RiderPoint

    if ( udg_RiderDistance > 0.00 ) then
        set RiderNowPoint = GetUnitLoc(udg_RiderUnit)
        set RiderEveryPoint = PolarProjectionBJ(RiderNowPoint, 50.00, udg_RiderChaAngle)
        call SetUnitFacingTimed( udg_RiderUnit, udg_RiderChaAngle, 0 )
        call SetUnitPositionLocFacingBJ( udg_RiderUnit, RiderEveryPoint, udg_RiderChaAngle )
        set udg_RiderDistance = ( udg_RiderDistance - 50.00 )
        set udg_RiderHight = ( udg_RiderHight - 20.00 )
        call SetUnitFlyHeightBJ( udg_RiderUnit, udg_RiderHight, 0.00 )
        call RemoveLocation( RiderNowPoint )
        call RemoveLocation( RiderEveryPoint )
    else
        set RiderPoint = GetUnitLoc(udg_RiderUnit)
        call SetUnitPositionLoc( udg_Rider, RiderPoint )
        call CreateNUnitsAtLoc( 1, 'h025', GetOwningPlayer(udg_Rider), RiderPoint, bj_UNIT_FACING )
//        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        set udg_RiderSpaUnit = GetLastCreatedUnit()
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set RiderNowPoint = PolarProjectionBJ(RiderPoint, GetRandomReal(0.00, 300.00), GetRandomDirectionDeg())
            call AddSpecialEffectLocBJ( RiderNowPoint, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call RemoveLocation( RiderNowPoint )
