function Trig_Trample_Start_Actions takes nothing returns nothing
    // 變數設定
    set udg_Buncle_trample_Damage = ( 250.00 + ( 100.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
    set udg_Buncle_trample_Index = 0.00
    set udg_Buncle_trample_Caster = GetTriggerUnit()
    set udg_Buncle_trample_Target = GetSpellTargetUnit()
    set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_trample_Target)
    set udg_Buncle_P2 = GetUnitLoc(GetTriggerUnit())
    set udg_Buncle_trample_Angle = AngleBetweenPoints(udg_Buncle_P1, udg_Buncle_P2)
    call RemoveLocation( udg_Buncle_P1 )
    call RemoveLocation( udg_Buncle_P2 )
    // 施法者設定
    call PauseUnitBJ( true, udg_Buncle_trample_Target )
    call SetUnitPathing( udg_Buncle_trample_Target, false )
    call UnitAddAbilityBJ( 'Arav', udg_Buncle_trample_Target )
    call UnitAddAbilityBJ( 'Avul', udg_Buncle_trample_Target )
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call EnableTrigger( gg_trg_Trample_Effect )
endfunction

//===========================================================================
function InitTrig_Trample_Start takes nothing returns nothing
    set gg_trg_Trample_Start = CreateTrigger(  )
    call DisableTrigger( gg_trg_Trample_Start )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Trample_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Trample_Start, Condition( function Trig_Trample_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Trample_Start, function Trig_Trample_Start_Actions )
endfunction

//===========================================================================
// Trigger: Trample Effect
//===========================================================================
function Trig_Trample_Effect_Func007C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Buncle_P3, udg_Buncle_P2) <= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Trample_Effect_Actions takes nothing returns nothing
    set udg_Buncle_trample_Index = ( udg_Buncle_trample_Index + 1 )
    set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_trample_Target)
    set udg_Buncle_P2 = GetUnitLoc(udg_Buncle_trample_Caster)
    set udg_Buncle_trample_Angle = AngleBetweenPoints(udg_Buncle_P1, udg_Buncle_P2)
    set udg_Buncle_P3 = PolarProjectionBJ(udg_Buncle_P1, 50.00, udg_Buncle_trample_Angle)
    call SetUnitPositionLoc( udg_Buncle_trample_Target, udg_Buncle_P3 )
    if ( Trig_Trample_Effect_Func007C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Buncle_trample_Index = 0.00
        set udg_Buncle_P4 = PolarProjectionBJ(udg_Buncle_P2, 400.00, GetUnitFacing(udg_Buncle_trample_Caster))
        set udg_Buncle_trample_Angle = AngleBetweenPoints(udg_Buncle_P2, udg_Buncle_P4)
        set udg_Buncle_trample_dDist = ( DistanceBetweenPoints(udg_Buncle_P2, udg_Buncle_P4) / 21.00 )
        call EnableTrigger( gg_trg_Trample_Effect2 )
        call SetUnitAnimation( udg_Buncle_trample_Caster, "attack" )
    else
    endif
    call RemoveLocation( udg_Buncle_P1 )
    call RemoveLocation( udg_Buncle_P2)
    call RemoveLocation( udg_Buncle_P3 )
    call RemoveLocation( udg_Buncle_P4 )
endfunction

//===========================================================================
function InitTrig_Trample_Effect takes nothing returns nothing
    set gg_trg_Trample_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_Trample_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Trample_Effect, 0.05 )
    call TriggerAddAction( gg_trg_Trample_Effect, function Trig_Trample_Effect_Actions )
endfunction

//===========================================================================
// Trigger: Trample Effect2
//===========================================================================
function Trig_Trample_Effect2_Func009Func011001003001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Trample_Effect2_Func009Func011001003002001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Buncle_trample_Caster)) == true )
endfunction

function Trig_Trample_Effect2_Func009Func011001003002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) != true )
endfunction

function Trig_Trample_Effect2_Func009Func011001003002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Trample_Effect2_Func009Func011001003002001(), Trig_Trample_Effect2_Func009Func011001003002002() )
endfunction

function Trig_Trample_Effect2_Func009Func011001003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Trample_Effect2_Func009Func011001003001(), Trig_Trample_Effect2_Func009Func011001003002() )
endfunction

function Trig_Trample_Effect2_Func009Func011A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Buncle_trample_Caster, GetEnumUnit(), udg_Buncle_trample_Damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

function Trig_Trample_Effect2_Func009C takes nothing returns boolean
    if ( not ( udg_Buncle_trample_Index >= 21.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Trample_Effect2_Actions takes nothing returns nothing
    set udg_Buncle_trample_Index = ( udg_Buncle_trample_Index + 1 )
    set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_trample_Target)
    set udg_Buncle_P2 = PolarProjectionBJ(udg_Buncle_P1, udg_Buncle_trample_dDist, udg_Buncle_trample_Angle)
    call SetUnitPositionLoc( udg_Buncle_trample_Target, udg_Buncle_P2 )
    call RemoveLocation( udg_Buncle_P1 )
    call RemoveLocation( udg_Buncle_P2 )
    // 二次函數(拋物線)，Index=1,21時高度=0；Index=11時高度=300
    call SetUnitFlyHeightBJ( udg_Buncle_trample_Target, ( ( -3.00 * Pow(( udg_Buncle_trample_Index - 11.00 ), 2.00) ) + 300.00 ), 0.00 )
    if ( Trig_Trample_Effect2_Func009C() ) then
        // 停止觸發
        call DisableTrigger( GetTriggeringTrigger() )
        // 傷害與特效
        set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_trample_Target)
        set bj_wantDestroyGroup = true
        call UnitRemoveAbilityBJ( 'Avul', udg_Buncle_trample_Target )
        call UnitRemoveAbilityBJ( 'Arav', udg_Buncle_trample_Target )
        call SetUnitPathing( udg_Buncle_trample_Target, true )
        call PauseUnitBJ( false, udg_Buncle_trample_Target )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(270.00, udg_Buncle_P1, Condition(function Trig_Trample_Effect2_Func009Func011001003)), function Trig_Trample_Effect2_Func009Func011A )
        call AddSpecialEffectLocBJ( udg_Buncle_P1, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation( udg_Buncle_P1 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Trample_Effect2 takes nothing returns nothing
    set gg_trg_Trample_Effect2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Trample_Effect2 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Trample_Effect2, 0.02 )
    call TriggerAddAction( gg_trg_Trample_Effect2, function Trig_Trample_Effect2_Actions )
endfunction

//===========================================================================
// Trigger: Gigantomakhia 0
//===========================================================================
function Trig_Gigantomakhia_0_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0U8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gigantomakhia_0_Actions takes nothing returns nothing
    set udg_Buncle_P4 = GetSpellTargetLoc()
    set udg_Buncle_Gi_Damage = ( 200.00 + ( 400.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
    set udg_Buncle_Gi_Caster = GetTriggerUnit()
    call PauseUnitBJ( true, GetTriggerUnit() )
    set udg_Buncle_P1 = GetUnitLoc(GetTriggerUnit())
    set udg_Buncle_P2 = PolarProjectionBJ(udg_Buncle_P1, 200.00, ( GetUnitFacing(GetTriggerUnit()) + 45.00 ))
    set udg_Buncle_P3 = PolarProjectionBJ(udg_Buncle_P1, 200.00, ( GetUnitFacing(GetTriggerUnit()) + 135.00 ))
    set udg_Buncle_Gi_Angle = AngleBetweenPoints(udg_Buncle_P1, udg_Buncle_P4)
    set udg_Buncle_Gi_MaxDist = ( DistanceBetweenPoints(udg_Buncle_P1, udg_Buncle_P4) / 50.00 )
    call CreateNUnitsAtLoc( 1, 'h02M', GetOwningPlayer(GetTriggerUnit()), udg_Buncle_P2, bj_UNIT_FACING )
    set udg_Buncle_Gi_Unit = GetLastCreatedUnit()
    call IssuePointOrderLocBJ( udg_Buncle_Gi_Unit, "move", udg_Buncle_P3 )
    call RemoveLocation( udg_Buncle_P3 )
    set udg_Buncle_Int = 1
    loop
        exitwhen udg_Buncle_Int > 7
        set udg_Buncle_P3 = PolarProjectionBJ(udg_Buncle_P2, 400.00, GetRandomDirectionDeg())
        call CreateNUnitsAtLocFacingLocBJ( 1, 'h02M', GetOwningPlayer(GetTriggerUnit()), udg_Buncle_P3, udg_Buncle_P2 )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Buncle_Gi_Group )
        call RemoveLocation( udg_Buncle_P3 )
        set udg_Buncle_Int = udg_Buncle_Int + 1
    endloop
    set udg_Buncle_Int = 0
    set udg_Buncle_Gi_Color = 35.00
    call RemoveLocation( udg_Buncle_P1 )
    call RemoveLocation( udg_Buncle_P2 )
    call SetUnitAnimationWithRarity( GetTriggerUnit(), "attack", RARITY_FREQUENT )
    call SetUnitTimeScalePercent( udg_Buncle_Gi_Caster, 40.00 )
    call TriggerSleepAction( 0.10 )
    call EnableTrigger( gg_trg_Gigantomakhia_1 )
endfunction

//===========================================================================
function InitTrig_Gigantomakhia_0 takes nothing returns nothing
    set gg_trg_Gigantomakhia_0 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Gigantomakhia_0 )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Gigantomakhia_0, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Gigantomakhia_0, Condition( function Trig_Gigantomakhia_0_Conditions ) )
    call TriggerAddAction( gg_trg_Gigantomakhia_0, function Trig_Gigantomakhia_0_Actions )
endfunction

//===========================================================================
// Trigger: Gigantomakhia 1
//===========================================================================
function Trig_Gigantomakhia_1_Func003A takes nothing returns nothing
    set udg_Buncle_Gi_Unit2 = GetEnumUnit()
    return
endfunction

function Trig_Gigantomakhia_1_Func011C takes nothing returns boolean
    if ( not ( udg_Buncle_Int >= 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gigantomakhia_1_Actions takes nothing returns nothing
    set udg_Buncle_Int = ( udg_Buncle_Int + 1 )
    call ForGroupBJ( udg_Buncle_Gi_Group, function Trig_Gigantomakhia_1_Func003A )
    call SetUnitFlyHeightBJ( udg_Buncle_Gi_Unit2, GetRandomReal(0.00, 500.00), 0.00 )
    call IssueTargetOrderBJ( udg_Buncle_Gi_Unit2, "thunderbolt", udg_Buncle_Gi_Unit )
    call GroupRemoveUnitSimple( udg_Buncle_Gi_Unit2, udg_Buncle_Gi_Group )
    set udg_Buncle_Gi_Color = ( udg_Buncle_Gi_Color - 5.00 )
    set udg_Buncle_Gi_Size = ( 190.00 - ( udg_Buncle_Gi_Color * 2.00 ) )
    call SetUnitVertexColorBJ( udg_Buncle_Gi_Caster, ( 100.00 - ( udg_Buncle_Gi_Color * 2.00 ) ), udg_Buncle_Gi_Color, udg_Buncle_Gi_Color, 0 )
    call SetUnitScalePercent( udg_Buncle_Gi_Caster, udg_Buncle_Gi_Size, udg_Buncle_Gi_Size, udg_Buncle_Gi_Size )
    if ( Trig_Gigantomakhia_1_Func011C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call AddSpecialEffectTargetUnitBJ( "weapon", udg_Buncle_Gi_Caster, "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TriggerSleepAction( 0.15 )
        call SetUnitTimeScalePercent( udg_Buncle_Gi_Caster, 70.00 )
        set udg_Buncle_Int = 0
        call SetUnitPathing( udg_Buncle_Gi_Caster, false )
        call EnableTrigger( gg_trg_Gigantomakhia_2 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Gigantomakhia_1 takes nothing returns nothing
    set gg_trg_Gigantomakhia_1 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Gigantomakhia_1 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Gigantomakhia_1, 0.04 )
    call TriggerAddAction( gg_trg_Gigantomakhia_1, function Trig_Gigantomakhia_1_Actions )
endfunction

//===========================================================================
// Trigger: Gigantomakhia 2
//===========================================================================
function Trig_Gigantomakhia_2_Func006Func001C takes nothing returns boolean
    if ( ( udg_Buncle_Int >= R2I(udg_Buncle_Gi_MaxDist) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Gigantomakhia_2_Func006Func007Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_Buncle_Gi_Caster)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gigantomakhia_2_Func006Func007A takes nothing returns nothing
    if ( Trig_Gigantomakhia_2_Func006Func007Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_Buncle_Gi_Caster, GetEnumUnit(), udg_Buncle_Gi_Damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_Gigantomakhia_2_Func006Func008Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gigantomakhia_2_Func006Func008A takes nothing returns nothing
    if ( Trig_Gigantomakhia_2_Func006Func008Func001C() ) then
        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Gigantomakhia_2_Func006Func016A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Gigantomakhia_2_Func006C takes nothing returns boolean
    if ( not Trig_Gigantomakhia_2_Func006Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Gigantomakhia_2_Actions takes nothing returns nothing
    set udg_Buncle_Int = ( udg_Buncle_Int + 1 )
    set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_Gi_Caster)
    set udg_Buncle_P2 = PolarProjectionBJ(udg_Buncle_P1, 50.00, udg_Buncle_Gi_Angle)
    call SetUnitPositionLocFacingBJ( udg_Buncle_Gi_Caster, udg_Buncle_P2, udg_Buncle_Gi_Angle )
    if ( Trig_Gigantomakhia_2_Func006C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call TerrainDeformationRippleBJ( 4, true, udg_Buncle_P4, 1024, 1024, 128.00, 1, 512 )
        call AddSpecialEffectLocBJ( udg_Buncle_P4, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(430.00, udg_Buncle_P4), function Trig_Gigantomakhia_2_Func006Func007A )
        call EnumDestructablesInCircleBJ( 500.00, udg_Buncle_P4, function Trig_Gigantomakhia_2_Func006Func008A )
        call RemoveLocation( udg_Buncle_P4 )
        call SetUnitTimeScalePercent( udg_Buncle_Gi_Caster, 100.00 )
        call SetUnitVertexColorBJ( udg_Buncle_Gi_Caster, 30.00, 30.00, 30.00, 0 )
        call SetUnitScalePercent( udg_Buncle_Gi_Caster, 120.00, 120.00, 120.00 )
        call SetUnitPathing( udg_Buncle_Gi_Caster, true )
        call PauseUnitBJ( false, udg_Buncle_Gi_Caster )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_Buncle_Gi_Caster), 'h02M'), function Trig_Gigantomakhia_2_Func006Func016A )
    else
    endif
    call RemoveLocation( udg_Buncle_P1 )
    call RemoveLocation( udg_Buncle_P2 )
endfunction

//===========================================================================
function InitTrig_Gigantomakhia_2 takes nothing returns nothing
    set gg_trg_Gigantomakhia_2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Gigantomakhia_2 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Gigantomakhia_2, 0.02 )
    call TriggerAddAction( gg_trg_Gigantomakhia_2, function Trig_Gigantomakhia_2_Actions )
endfunction

