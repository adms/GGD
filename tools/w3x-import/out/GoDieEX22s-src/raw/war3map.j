//===========================================================================
function Trig_EX_burst_Func004C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetTriggerUnit()) >= 30 ) ) then
        return false
    endif
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_EX_burst_Conditions takes nothing returns boolean
    if ( not Trig_EX_burst_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_EX_burst_Actions takes nothing returns nothing
    set udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
    call SetPlayerTechResearchedSwap( 'R00R', 1, GetOwningPlayer(GetTriggerUnit()) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "MidchilderNanohaAura.mdx" )
endfunction

