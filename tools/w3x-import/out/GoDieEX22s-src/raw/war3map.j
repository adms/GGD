//===========================================================================
// Trigger: Item1100
//===========================================================================
function Trig_Item1100_Func003C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I01Z') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I06C') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item1100_Conditions takes nothing returns boolean
    if ( not Trig_Item1100_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Item1100_Func002C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I06C') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item1100_Actions takes nothing returns nothing
    call RemoveItem( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I06C') )
    if ( Trig_Item1100_Func002C() ) then
        call RemoveItem( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I01Z') )
        call RemoveItem( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I06C') )
        call AddSpecialEffectTargetUnitBJ( "overhead", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitAddItemByIdSwapped( 'I013', GetTriggerUnit() )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call UnitAddItemByIdSwapped( 'I06C', GetTriggerUnit() )
        call EnableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Item1100 takes nothing returns nothing
    set gg_trg_Item1100 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Item1100, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddCondition( gg_trg_Item1100, Condition( function Trig_Item1100_Conditions ) )
    call TriggerAddAction( gg_trg_Item1100, function Trig_Item1100_Actions )
