function Trig_pet_init_Actions takes nothing returns nothing
    set udg_PetArray[0] = 'u025'
    set udg_PetArray[1] = 'u02D'
    set udg_PetArray[2] = 'u02I'
    set udg_PetArray[3] = 'u028'
    set udg_PetArray[4] = 'u02M'
    set udg_PetArray[5] = 'u027'
    set udg_PetArray[6] = 'u01W'
    set udg_PetArray[7] = 'u02H'
    set udg_PetArray[8] = 'u02C'
    set udg_PetArrayNumber = 8
endfunction

//===========================================================================
function InitTrig_pet_init takes nothing returns nothing
    set gg_trg_pet_init = CreateTrigger(  )
    call TriggerAddAction( gg_trg_pet_init, function Trig_pet_init_Actions )
endfunction

//===========================================================================
// Trigger: pet move
//===========================================================================
function Trig_pet_move_Func001Func001Func001Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_PlayerHeroUnit[udg_PetCount]), GetUnitLoc(udg_Pet[udg_PetCount])) > 1500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Func001Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_PlayerHeroUnit[udg_PetCount]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Func001Func001C takes nothing returns boolean
    if ( not ( udg_PetISAdopt[udg_PetCount] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Func002Func001Func001Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_PlayerHeroUnit[udg_PetCount]), GetUnitLoc(udg_Pet[udg_PetCount])) > 1500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Func002Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_PlayerHeroUnit[udg_PetCount]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Func002Func001C takes nothing returns boolean
    if ( not ( udg_PetISAdopt[udg_PetCount] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_move_Actions takes nothing returns nothing
    set udg_PetCount = 2
    loop
        exitwhen udg_PetCount > 6
        if ( Trig_pet_move_Func001Func001C() ) then
            if ( Trig_pet_move_Func001Func001Func001C() ) then
                if ( Trig_pet_move_Func001Func001Func001Func002C() ) then
                    call SetUnitPositionLoc( udg_Pet[udg_PetCount], GetUnitLoc(udg_PlayerHeroUnit[udg_PetCount]) )
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Pet[udg_PetCount], "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                else
                endif
                call IssueImmediateOrderBJ( udg_Pet[udg_PetCount], "replenishlife" )
                call IssueTargetOrderBJ( udg_Pet[udg_PetCount], "move", udg_PlayerHeroUnit[udg_PetCount] )
            else
                call SetUnitPositionLoc( udg_Pet[udg_PetCount], GetRectCenter(gg_rct_LoveFinal) )
            endif
        else
        endif
        set udg_PetCount = udg_PetCount + 1
    endloop
    set udg_PetCount = 8
    loop
        exitwhen udg_PetCount > 12
        if ( Trig_pet_move_Func002Func001C() ) then
            if ( Trig_pet_move_Func002Func001Func001C() ) then
                if ( Trig_pet_move_Func002Func001Func001Func002C() ) then
                    call SetUnitPositionLoc( udg_Pet[udg_PetCount], GetUnitLoc(udg_PlayerHeroUnit[udg_PetCount]) )
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Pet[udg_PetCount], "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                else
                endif
                call IssueImmediateOrderBJ( udg_Pet[udg_PetCount], "replenishlife" )
                call IssueTargetOrderBJ( udg_Pet[udg_PetCount], "move", udg_PlayerHeroUnit[udg_PetCount] )
            else
                call SetUnitPositionLoc( udg_Pet[udg_PetCount], GetRectCenter(gg_rct_GoDieFinal) )
            endif
        else
        endif
        set udg_PetCount = udg_PetCount + 1
    endloop
endfunction

//===========================================================================
function InitTrig_pet_move takes nothing returns nothing
    set gg_trg_pet_move = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_pet_move, 3.00 )
    call TriggerAddAction( gg_trg_pet_move, function Trig_pet_move_Actions )
endfunction

//===========================================================================
// Trigger: pet adopt
//===========================================================================
function Trig_pet_adopt_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I054' ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_adopt_Func004Func002C takes nothing returns boolean
    if ( not ( udg_MissionScore[udg_PetBuyingPlayerIdx] >= 60 ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_adopt_Func004C takes nothing returns boolean
    if ( not ( udg_PetISAdopt[udg_PetBuyingPlayerIdx] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_adopt_Actions takes nothing returns nothing
    call ForceClear( udg_Mission_Score_Caster )
    call ForceAddPlayerSimple( GetOwningPlayer(GetBuyingUnit()), udg_Mission_Score_Caster )
    set udg_PetBuyingPlayerIdx = GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))
    if ( Trig_pet_adopt_Func004C() ) then
        if ( Trig_pet_adopt_Func004Func002C() ) then
            set udg_PetISAdopt[udg_PetBuyingPlayerIdx] = true
            set udg_MissionScore[udg_PetBuyingPlayerIdx] = ( udg_MissionScore[udg_PetBuyingPlayerIdx] - 60 )
            call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))], I2S(udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))]) )
            set udg_PetRandom = GetRandomInt(0, udg_PetArrayNumber)
            call CreateNUnitsAtLoc( 1, udg_PetArray[udg_PetRandom], ConvertedPlayer(udg_PetBuyingPlayerIdx), GetUnitLoc(udg_PlayerHeroUnit[udg_PetBuyingPlayerIdx]), bj_UNIT_FACING )
            set udg_Pet[udg_PetBuyingPlayerIdx] = GetLastCreatedUnit()
            call DisplayTextToForce( udg_Mission_Score_Caster, ( ( "玩家" + udg_Borad_PlayerNames[udg_PetBuyingPlayerIdx] ) + ( "認養寵物\" " + ( GetUnitName(GetLastCreatedUnit()) + " \"" ) ) ) )
        else
            call DisplayTextToForce( udg_Mission_Score_Caster, "TRIGSTR_10443" )
        endif
    else
        call DisplayTextToForce( udg_Mission_Score_Caster, "TRIGSTR_8385" )
    endif
    call DoNothing(  )
endfunction

//===========================================================================
function InitTrig_pet_adopt takes nothing returns nothing
    set gg_trg_pet_adopt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_pet_adopt, EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_pet_adopt, Condition( function Trig_pet_adopt_Conditions ) )
    call TriggerAddAction( gg_trg_pet_adopt, function Trig_pet_adopt_Actions )
endfunction

//===========================================================================
// Trigger: pet again
//
// 洗能力
// 順序重新打亂
//===========================================================================
function Trig_pet_again_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I056' ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_again_Func004Func001C takes nothing returns boolean
    if ( not ( udg_MissionScore[udg_PetBuyingPlayerIdx] >= 40 ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_again_Func004C takes nothing returns boolean
    if ( not ( udg_PetISAdopt[udg_PetBuyingPlayerIdx] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_pet_again_Actions takes nothing returns nothing
    call ForceClear( udg_Mission_Score_Caster )
    call ForceAddPlayerSimple( GetOwningPlayer(GetBuyingUnit()), udg_Mission_Score_Caster )
    set udg_PetBuyingPlayerIdx = GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))
    if ( Trig_pet_again_Func004C() ) then
        call DisplayTextToForce( udg_Mission_Score_Caster, "TRIGSTR_9491" )
    else
        if ( Trig_pet_again_Func004Func001C() ) then
            set udg_PetISAdopt[udg_PetBuyingPlayerIdx] = true
            set udg_MissionScore[udg_PetBuyingPlayerIdx] = ( udg_MissionScore[udg_PetBuyingPlayerIdx] - 40 )
            call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))], I2S(udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))]) )
            set udg_PetRandom = GetRandomInt(0, udg_PetArrayNumber)
            call CreateNUnitsAtLoc( 1, udg_PetArray[udg_PetRandom], ConvertedPlayer(udg_PetBuyingPlayerIdx), GetUnitLoc(udg_PlayerHeroUnit[udg_PetBuyingPlayerIdx]), bj_UNIT_FACING )
            call DisplayTextToForce( udg_Mission_Score_Caster, ( ( "玩家" + udg_Borad_PlayerNames[udg_PetBuyingPlayerIdx] ) + ( "將寵物\" " + ( GetUnitName(udg_Pet[udg_PetBuyingPlayerIdx]) + ( " \"交換成\" " + ( GetUnitName(GetLastCreatedUnit()) + " \"" ) ) ) ) ) )
            call KillUnit( udg_Pet[udg_PetBuyingPlayerIdx] )
            call RemoveUnit( udg_Pet[udg_PetBuyingPlayerIdx] )
            set udg_Pet[udg_PetBuyingPlayerIdx] = GetLastCreatedUnit()
        else
            call DisplayTextToForce( udg_Mission_Score_Caster, "TRIGSTR_10452" )
        endif
    endif
endfunction

//===========================================================================
function InitTrig_pet_again takes nothing returns nothing
    set gg_trg_pet_again = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_pet_again, EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_pet_again, Condition( function Trig_pet_again_Conditions ) )
    call TriggerAddAction( gg_trg_pet_again, function Trig_pet_again_Actions )
endfunction

