    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_AKTUnit)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AKT_2_Func017A takes nothing returns nothing
    if ( Trig_AKT_2_Func017Func001C() ) then
        call UnitDamageTargetBJ( udg_AKTUnit, GetEnumUnit(), I2R(( ( 4 * GetHeroStatBJ(bj_HEROSTAT_INT, udg_AKTUnit, true) ) + 400 )), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_AKT_2_Func019A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_AKT_2_Actions takes nothing returns nothing
    set udg_AKTStar_Point[1] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 30.00)
    set udg_AKTStar_Point[2] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 150.00)
    set udg_AKTStar_Point[3] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 270.00)
    set udg_AKTStar_Point[4] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 90.00)
    set udg_AKTStar_Point[5] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 210.00)
    set udg_AKTStar_Point[6] = PolarProjectionBJ(udg_AKTCastPoint, 450.00, 330.00)
    set udg_AKTStarIndex = 1
    loop
        exitwhen udg_AKTStarIndex > 6
        call CreateNUnitsAtLoc( 1, 'o01K', GetOwningPlayer(udg_AKTUnit), udg_AKTStar_Point[udg_AKTStarIndex], bj_UNIT_FACING )
        call SetUnitLifePercentBJ( GetLastCreatedUnit(), 1.00 )
        set udg_AKTStarUnit[udg_AKTStarIndex] = GetLastCreatedUnit()
        call SetUnitFlyHeightBJ( udg_AKTStarUnit[udg_AKTStarIndex], 150.00, 0.00 )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_AKTUnitGroup )
        set udg_AKTStarIndex = udg_AKTStarIndex + 1
    endloop
    call IssueTargetOrderBJ( udg_AKTStarUnit[1], "healingwave", udg_AKTStarUnit[2] )
    call IssueTargetOrderBJ( udg_AKTStarUnit[2], "healingwave", udg_AKTStarUnit[3] )
    call IssueTargetOrderBJ( udg_AKTStarUnit[3], "healingwave", udg_AKTStarUnit[1] )
    call IssueTargetOrderBJ( udg_AKTStarUnit[4], "healingwave", udg_AKTStarUnit[5] )
    call IssueTargetOrderBJ( udg_AKTStarUnit[5], "healingwave", udg_AKTStarUnit[6] )
    call IssueTargetOrderBJ( udg_AKTStarUnit[6], "healingwave", udg_AKTStarUnit[4] )
    call TriggerSleepAction( 0.50 )
    call CreateNUnitsAtLoc( 1, 'o01M', GetOwningPlayer(udg_AKTUnit), udg_AKTCastPoint, bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_AKTUnitGroup )
    call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_AKTCastPoint, 650.00, 650.00)), function Trig_AKT_2_Func017A )
    call TriggerSleepAction( 0.50 )
