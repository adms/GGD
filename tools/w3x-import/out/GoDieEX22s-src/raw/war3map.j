function Trig_ShanWindDragonMove_Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_WindDragonGroup) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShanWindDragonMove_Func004A takes nothing returns nothing
    if ( Trig_ShanWindDragonMove_Func004Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_WindDragonGroup )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_ShanWindDragonMove_Func005Func009Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_WindDragonUnit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShanWindDragonMove_Func005Func009A takes nothing returns nothing
    if ( Trig_ShanWindDragonMove_Func005Func009Func001C() ) then
        call UnitDamageTargetBJ( udg_WindDragonUnit, GetEnumUnit(), udg_WindDragonDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateTextTagUnitBJ( ( I2S(R2I(udg_WindDragonDamage)) + "!" ), GetEnumUnit(), -30.00, 10.00, 90.00, 0.00, 0.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_ShanWindDragonMove_Func005Func013A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_ShanWindDragonMove_Func005Func014C takes nothing returns boolean
    if ( ( DistanceBetweenPoints(udg_WindDragonPostion, udg_WindDragonTargetPoint) < 200.00 ) ) then
        return true
    endif
    if ( ( udg_WindDragonCount > 6 ) ) then
        return true
    endif
    return false
endfunction

function Trig_ShanWindDragonMove_Func005C takes nothing returns boolean
    if ( not Trig_ShanWindDragonMove_Func005Func014C() ) then
        return false
    endif
    return true
endfunction

function Trig_ShanWindDragonMove_Actions takes nothing returns nothing
    set udg_WindDragonCount = ( udg_WindDragonCount + 1 )
    set udg_WindDragonPostion = PolarProjectionBJ(udg_WindDragonPostion, 200.00, udg_WindDragonAngle)
    call SetUnitPositionLocFacingBJ( udg_WindDragonUnit, udg_WindDragonPostion, udg_WindDragonAngle )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(350.00, udg_WindDragonPostion), function Trig_ShanWindDragonMove_Func004A )
    if ( Trig_ShanWindDragonMove_Func005C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call CreateTextTagUnitBJ( "TRIGSTR_057", udg_WindDragonUnit, 0, 12.00, 100.00, 100.00, 100.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        call TriggerSleepAction( 0.10 )
        call ForGroupBJ( udg_WindDragonGroup, function Trig_ShanWindDragonMove_Func005Func009A )
        call UnitRemoveAbilityBJ( 'A0KW', udg_WindDragonUnit )
        call GroupClear( udg_WindDragonGroup )
        call TriggerSleepAction( 2 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_WindDragonUnit), 'u00W'), function Trig_ShanWindDragonMove_Func005Func013A )
    else
        call DoNothing(  )
    endif
endfunction

