    local player p = Player(PLAYER_NEUTRAL_PASSIVE)
    local unit u
    local integer unitID
    local trigger t
    local real life

    set gg_unit_Ogld_0032 = CreateUnit( p, 'Ogld', -7104.0, -2888.7, 180.000 )
    call SetHeroLevel( gg_unit_Ogld_0032, 30, false )
    call SetUnitState( gg_unit_Ogld_0032, UNIT_STATE_MANA, 1196 )
    set gg_unit_Utic_0117 = CreateUnit( p, 'Utic', -8792.0, 5094.6, 1.890 )
    call SetHeroLevel( gg_unit_Utic_0117, 16, false )
    call SetUnitState( gg_unit_Utic_0117, UNIT_STATE_MANA, 756 )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A00I' )
    call IssueImmediateOrder( gg_unit_Utic_0117, "" )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A00A' )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A00A' )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A00A' )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A00A' )
    call IssueImmediateOrder( gg_unit_Utic_0117, "" )
    call IssueImmediateOrder( gg_unit_Utic_0117, "manashieldon" )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A047' )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A047' )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A047' )
    call IssueImmediateOrder( gg_unit_Utic_0117, "" )
    call SelectHeroSkill( gg_unit_Utic_0117, 'A099' )
    call IssueImmediateOrder( gg_unit_Utic_0117, "" )
    call IssueImmediateOrder( gg_unit_Utic_0117, "" )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'I00Z', 0 )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'ssil', 1 )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'I03N', 2 )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'I00Q', 3 )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'I00L', 4 )
    call UnitAddItemToSlotById( gg_unit_Utic_0117, 'pams', 5 )
    set gg_unit_nzep_0121 = CreateUnit( p, 'nzep', -3298.2, -3816.9, 335.700 )
    set u = CreateUnit( p, 'hpea', -5645.4, -1690.0, 75.900 )
    set u = CreateUnit( p, 'zzrg', -1693.9, -6231.9, 246.159 )
    set gg_unit_noga_0182 = CreateUnit( p, 'noga', -4387.7, -3016.6, 311.030 )
    set gg_unit_opeo_0222 = CreateUnit( p, 'opeo', 2441.6, -3639.0, 26.579 )
    set gg_unit_opeo_0223 = CreateUnit( p, 'opeo', 2404.6, -3705.0, 343.844 )
    set gg_unit_opeo_0224 = CreateUnit( p, 'opeo', 2353.0, -3604.1, 322.495 )
endfunction

