        call CreateTextTagUnitBJ( ( I2S(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Inshou, true)) + "!" ), GetEnumUnit(), -30.00, 10.00, 90.00, 10.00, 10.00, 10.00 )
