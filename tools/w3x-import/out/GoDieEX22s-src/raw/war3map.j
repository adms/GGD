//===========================================================================
// Trigger: Light sword
//===========================================================================
function Trig_Light_sword_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0UB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_sword_Actions takes nothing returns nothing
    local unit Caster = GetTriggerUnit()
    local location P1 = GetUnitLoc(GetTriggerUnit())
    local location P2 = GetSpellTargetLoc()
    local location P3
    local real Move_Angle = AngleBetweenPoints(P1, P2)


    //初始化設定
    set P3 = PolarProjectionBJ(P1, 200.00, Move_Angle)
    call CreateNUnitsAtLoc( 1, 'o02U', GetOwningPlayer(Caster), P3, bj_UNIT_FACING )
    set udg_Light_MoveUnit = GetLastCreatedUnit()

    call SetHandleUnit(udg_Light_MoveUnit,"Caster",Caster)
    call SetHandleInt(udg_Light_MoveUnit,"Index",0)
    call SetHandleReal(udg_Light_MoveUnit,"Angle",Move_Angle)

    call RemoveLocation( P1 )
    call RemoveLocation( P2 )
    call RemoveLocation( P3 )
    call EnableTrigger( gg_trg_Light_sword_move )
endfunction

//===========================================================================
function InitTrig_Light_sword takes nothing returns nothing
    set gg_trg_Light_sword = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Light_sword, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Light_sword, Condition( function Trig_Light_sword_Conditions ) )
    call TriggerAddAction( gg_trg_Light_sword, function Trig_Light_sword_Actions )
endfunction

//===========================================================================
// Trigger: Light sword move
//
// P1＝目標目前位置
// P2＝預定移動位置
// P3＝移動後的位置
// 如果遇到障礙物，目標移動後的位置(P3)會和預定移動位置(P2)錯開一段距離
// 無障礙物：　P1→→→→→→→→P2＝P3　(P2與P3重疊)
// 有障礙物：　P1→→→→→→→↘障(P2) 　(P2與P3錯開)
// 　　　　　　　　　　　　　　   →P3
//===========================================================================
function Trig_KnockBack_Effect_Func011Func009001003 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_KnockBack_Effect_Func011Func009A takes nothing returns nothing
    local integer Index = GetHandleInt(udg_Light_MoveUnit,"Index")
    set Index = ( Index + 1 )
    call SetHandleInt(udg_Light_MoveUnit,"Index",Index)
endfunction

function Trig_KnockBack_Effect_Func011Func011Func001C takes nothing returns boolean
    local unit Master = GetHandleUnit(udg_Light_MoveUnit,"Caster")

    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(Master)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KnockBack_Effect_Func011Func011A takes nothing returns nothing
    local real LightDam = GetHandleReal(udg_Light_MoveUnit,"LightDam")
    local unit Master = GetHandleUnit(udg_Light_MoveUnit,"Caster")
    local integer Index = GetHandleInt(udg_Light_MoveUnit,"Index")

    if ( Trig_KnockBack_Effect_Func011Func011Func001C() ) then
        if ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) then
            call UnitDamageTargetBJ( Master, GetEnumUnit(), ( LightDam / I2R(Index) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        else
        endif
        call UnitDamageTargetBJ( Master, GetEnumUnit(), LightDam, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_KnockBack_Effect_Func011Func012A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_KnockBack_Effect_Func011Func015001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o01E' )
endfunction

function Trig_KnockBack_Effect_Func011Func015A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_KnockBack_Effect_Func011Func016001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o02U' )
endfunction

///////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////以上為條件判斷別理他//////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////

function Trig_Move_Effect_Actions takes nothing returns nothing
    local unit Master = GetHandleUnit(udg_Light_MoveUnit,"Caster")
    local real Angle = GetHandleReal(udg_Light_MoveUnit,"Angle")
    local real LightDam
    local integer Index = GetHandleInt(udg_Light_MoveUnit,"Index")
    local integer i
    local integer j
    local location P1
    local location P2
    local location P3

    // 變數取得
    set Index = Index+1
    call SetHandleInt(udg_Light_MoveUnit , "Index", Index)
    set P1 = GetUnitLoc(udg_Light_MoveUnit)
    call AddSpecialEffectLocBJ( P1, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set P2 = PolarProjectionBJ(P1, 80.00, Angle)
    call SetUnitPositionLoc( udg_Light_MoveUnit, P2 )
    set P3 = GetUnitLoc(udg_Light_MoveUnit)
    // 放大蒼龍破
    call SetUnitScalePercent( udg_Light_MoveUnit, ( 50.00 + ( I2R(Index) * 5.00 ) ), ( 50.00 + ( I2R(Index) * 5.00 ) ), 50.00 )

    // 目標移動後的位置(P3)和預定移動位置(P2)距離過遠，表示撞到障礙物。產生爆炸傷害
    if ( GetBooleanOr( (DistanceBetweenPoints(P2, P3) > 8.00), (Index >= 20) ) ) then
        call RemoveLocation( P1 )
        call RemoveLocation( P2 )
        call DisableTrigger( GetTriggeringTrigger() )
        set P1 = GetUnitLoc(udg_Light_MoveUnit)

        set i = 1
        loop
            exitwhen i > 5
            set j = 1
            loop
                exitwhen j > 8
                set P2 = PolarProjectionBJ( P1, ( 100.00 * I2R(i) ), ( 45.00 * I2R(j) ))
                call AddSpecialEffectLocBJ( P2, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                call RemoveLocation( P2 )
                set j = j + 1
            endloop
            set i = i + 1
        endloop
        //特效創造
        call CreateNUnitsAtLoc( 1, 'o01E', GetOwningPlayer(Master), P1, bj_UNIT_FACING )
        call SetUnitScalePercent( udg_Light_MoveUnit, 250.00, 250.00, 50.00 )
        call SetHandleInt(udg_Light_MoveUnit,"Index",0)
        //以下為判斷英雄個數
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(500.00, P1, Condition(function Trig_KnockBack_Effect_Func011Func009001003)), function Trig_KnockBack_Effect_Func011Func009A )
        //設定傷害
        set LightDam = ( ( I2R(GetUnitAbilityLevelSwapped('A0UB', Master)) * 200.00 ) + 400.00 )
        call SetHandleReal(udg_Light_MoveUnit,"LightDam",LightDam)
        //給予範圍內英雄傷害
        call ForGroupBJ( GetUnitsInRangeOfLocAll(500.00, P1), function Trig_KnockBack_Effect_Func011Func011A )
        call EnumDestructablesInCircleBJ( 500.00, P1, function Trig_KnockBack_Effect_Func011Func012A )
        call RemoveLocation( P1 )
        //移除特效部隊
        call TriggerSleepAction( 1.00 )
        call ForGroupBJ( GetUnitsOfPlayerMatching(GetOwningPlayer(Master), Condition(function Trig_KnockBack_Effect_Func011Func015001002)), function Trig_KnockBack_Effect_Func011Func015A )
        call ForGroupBJ( GetUnitsOfPlayerMatching(GetOwningPlayer(Master), Condition(function Trig_KnockBack_Effect_Func011Func016001002)), function Trig_KnockBack_Effect_Func011Func015A )
    else
    endif
    call RemoveLocation( P1 )
    call RemoveLocation( P2 )
    call RemoveLocation( P3 )
endfunction

//===========================================================================
function InitTrig_Light_sword_move takes nothing returns nothing
    set gg_trg_Light_sword_move = CreateTrigger(  )
    call DisableTrigger( gg_trg_Light_sword_move )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Light_sword_move, 0.04 )
    call TriggerAddAction( gg_trg_Light_sword_move, function Trig_Move_Effect_Actions )
endfunction

