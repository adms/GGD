//===========================================================================
// Trigger: Setup Invunerable
//===========================================================================
function Trig_Setup_Invunerable_Actions takes nothing returns nothing
    call SetUnitInvulnerable( gg_unit_etoe_0016, true )
    call SetUnitInvulnerable( gg_unit_unpl_0000, true )
    // First rows are vunerable.
    call SetUnitInvulnerable( gg_unit_etrp_0122, false )
    call SetUnitInvulnerable( gg_unit_etrp_0125, false )
    call SetUnitInvulnerable( gg_unit_etrp_0130, false )
    call SetUnitInvulnerable( gg_unit_usep_0072, false )
    call SetUnitInvulnerable( gg_unit_utod_0073, false )
    call SetUnitInvulnerable( gg_unit_usep_0103, false )
    call SetUnitInvulnerable( gg_unit_utod_0102, false )
    call SetUnitInvulnerable( gg_unit_usep_0075, false )
    call SetUnitInvulnerable( gg_unit_utod_0074, false )
    call SetUnitInvulnerable( gg_unit_eaoe_0020, false )
    call SetUnitInvulnerable( gg_unit_eaom_0022, false )
    call SetUnitInvulnerable( gg_unit_eaoe_0021, false )
    call SetUnitInvulnerable( gg_unit_eaom_0018, false )
    call SetUnitInvulnerable( gg_unit_eaoe_0024, false )
    call SetUnitInvulnerable( gg_unit_eaom_0023, false )
    call SetUnitInvulnerable( gg_unit_uzg1_0146, false )
    call SetUnitInvulnerable( gg_unit_uzg1_0145, false )
    call SetUnitInvulnerable( gg_unit_uzg1_0140, false )
    call SetUnitInvulnerable( gg_unit_nitb_0192, false )
endfunction

//===========================================================================
function InitTrig_Setup_Invunerable takes nothing returns nothing
    set gg_trg_Setup_Invunerable = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Setup_Invunerable, function Trig_Setup_Invunerable_Actions )
endfunction

//===========================================================================
// Trigger: Love Base
//===========================================================================
function Trig_Love_Base_Func002C takes nothing returns boolean
    if ( not ( udg_final_tower >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Love_Base_Actions takes nothing returns nothing
    set udg_final_tower = ( udg_final_tower + 1 )
    if ( Trig_Love_Base_Func002C() ) then
        call SetUnitInvulnerable( gg_unit_etoe_0016, false )
        call SetUnitInvulnerable( gg_unit_unpl_0000, false )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Love_Base takes nothing returns nothing
    set gg_trg_Love_Base = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Love_Base, gg_unit_u004_0026, EVENT_UNIT_DEATH )
