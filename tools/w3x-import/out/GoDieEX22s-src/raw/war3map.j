function Trig_CloseDestEffect_Func001C takes nothing returns boolean
    if ( not ( udg_CloseDesEffectCount < 60 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CloseDestEffect_Actions takes nothing returns nothing
    if ( Trig_CloseDestEffect_Func001C() ) then
        set udg_CloseDesEffectCount = ( udg_CloseDesEffectCount + 1 )
        call SetUnitScalePercent( udg_ShanaDesUnit, ( ( I2R(udg_CloseDesEffectCount) * 5.00 ) + 10.00 ), 100, 100 )
        call SetUnitVertexColorBJ( udg_ShanaDesUnit, 100, 100, 100, ( I2R(udg_CloseDesEffectCount) * 1.50 ) )
    else
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

