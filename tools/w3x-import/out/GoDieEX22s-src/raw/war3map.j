//===========================================================================
// Trigger: AKT 3
//===========================================================================
function Trig_AKT_3_Func011Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_AKTUnit)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AKT_3_Func011A takes nothing returns nothing
    if ( Trig_AKT_3_Func011Func001C() ) then
        call UnitDamageTargetBJ( udg_AKTUnit, GetEnumUnit(), I2R(( ( 4 * GetHeroStatBJ(bj_HEROSTAT_INT, udg_AKTUnit, true) ) + 0 )), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNKNOWN )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_AKT_3_Actions takes nothing returns nothing
    call TriggerSleepAction( 0.10 )
    call SetUnitPositionLoc( udg_AKTSpecialUnit[7], PolarProjectionBJ(udg_AKTCastPoint, 300.00, ( udg_AKTJumpAngle - 45.00 )) )
    call TriggerSleepAction( 0.10 )
    call SetUnitAnimation( udg_AKTSpecialUnit[7], "spell" )
    call TriggerSleepAction( 0.50 )
    set udg_AKTSpecialUnit[4] = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'o01N', GetOwningPlayer(udg_AKTUnit), udg_AKTCastPoint, bj_UNIT_FACING )
    set udg_AKTSpecialUnit[3] = GetLastCreatedUnit()
    call IssuePointOrderLocBJ( udg_AKTSpecialUnit[3], "silence", udg_AKTCastPoint )
    call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_AKTCastPoint, 650.00, 650.00)), function Trig_AKT_3_Func011A )
    call TriggerSleepAction( 3.00 )
    call KillUnit( udg_AKTSpecialUnit[3] )
    call KillUnit( udg_AKTSpecialUnit[4] )
    call RemoveUnit( udg_AKTSpecialUnit[3] )
    call RemoveUnit( udg_AKTSpecialUnit[4] )
endfunction

