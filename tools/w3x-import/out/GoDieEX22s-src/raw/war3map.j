// Trigger: ThunderCreate
//===========================================================================
function Trig_ThunderCreate_Func008C takes nothing returns boolean
    if ( not ( udg_ThunderLanceAccount <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ThunderCreate_Actions takes nothing returns nothing
    set udg_NegiLunderUnitPoint = PolarProjectionBJ(udg_NegiMasterPoint, GetRandomReal(0.00, 200.00), GetRandomDirectionDeg())
    call CreateNUnitsAtLoc( 1, 'o02J', GetOwningPlayer(udg_NegiUnit), udg_NegiLunderUnitPoint, udg_NegiAngle )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_NegiLanceGroup )
    call SetUnitVertexColorBJ( GetLastCreatedUnit(), 20.00, 20.00, 100, 50.00 )
    call SetUnitFlyHeightBJ( GetLastCreatedUnit(), udg_NegiHight, 0.00 )
    call RemoveLocation( udg_NegiLunderUnitPoint )
    set udg_ThunderLanceAccount = ( udg_ThunderLanceAccount - 1 )
    if ( Trig_ThunderCreate_Func008C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_ThunderMove )
        set udg_ThunderLanceAccount = 0
    else
    endif
endfunction

