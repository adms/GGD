function Trig_AImove_Actions takes nothing returns nothing
    if ( Trig_AImove_Func001C() ) then
        if ( Trig_AImove_Func001Func002C() ) then
            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_love_back, Player(0)))
            if ( Trig_AImove_Func001Func002Func002C() ) then
                call UnitUseItemTarget( GetTriggerUnit(), GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I048'), udg_MoveUnit )
            else
                call IssuePointOrderLocBJ( GetTriggerUnit(), "move", GetRectCenter(gg_rct_LoveHeroPoint) )
            endif
        else
            call IssuePointOrderLocBJ( GetTriggerUnit(), "attack", GetRectCenter(gg_rct_GoDieFinal) )
            call TriggerSleepAction( 3.00 )
            call IssuePointOrderLocBJ( GetTriggerUnit(), "attack", GetRectCenter(gg_rct_GoDieFinal) )
        endif
    else
        if ( Trig_AImove_Func001Func001C() ) then
            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_godie_back, Player(6)))
            if ( Trig_AImove_Func001Func001Func002C() ) then
                call UnitUseItemTarget( GetTriggerUnit(), GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I048'), udg_MoveUnit )
            else
                call IssuePointOrderLocBJ( GetTriggerUnit(), "move", GetRectCenter(gg_rct_DieHeroPoint) )
            endif
        else
            call IssuePointOrderLocBJ( GetTriggerUnit(), "attack", GetRectCenter(gg_rct_LoveFinal) )
            call TriggerSleepAction( 3.00 )
            call IssuePointOrderLocBJ( GetTriggerUnit(), "attack", GetRectCenter(gg_rct_LoveFinal) )
        endif
    endif
endfunction

