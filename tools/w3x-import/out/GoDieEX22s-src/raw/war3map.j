        call AddSpecialEffectLocBJ( udg_P3Wolf, "BloodBreathStream.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_WolfUnit, GetEnumUnit(), udg_WolfDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
