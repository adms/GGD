    set gg_trg_SSJ = CreateTrigger(  )
    call DisableTrigger( gg_trg_SSJ )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_SSJ, EVENT_PLAYER_UNIT_SPELL_EFFECT )
