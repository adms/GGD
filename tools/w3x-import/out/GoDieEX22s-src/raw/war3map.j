function Trig_ChatDialog_Actions takes nothing returns nothing
    if ( Trig_ChatDialog_Func001C() ) then
        if ( Trig_ChatDialog_Func001Func001C() ) then
            if ( Trig_ChatDialog_Func001Func001Func003C() ) then
                if ( Trig_ChatDialog_Func001Func001Func003Func001C() ) then
                    call DisplayTextToForce( GetPlayersAll(), ( ( "玩家" + udg_Borad_PlayerNames[GetConvertedPlayerId(ForcePickRandomPlayer(udg_PlayersScourgePlaying))] ) + "祝大家有情人終成家屬！" ) )
                else
                    call DisplayTextToForce( GetPlayersAll(), ( ( "那邊在偷窺蘿莉的" + udg_Borad_PlayerNames[GetConvertedPlayerId(ForcePickRandomPlayer(udg_PlayersSentinelPlaying))] ) + "放下你手中的望遠鏡吧！" ) )
                endif
            else
                call DisplayTextToForce( GetPlayersAll(), ( ( "羅莉控 " + udg_Borad_PlayerNames[GetConvertedPlayerId(ForcePickRandomPlayer(udg_PlayersSentinelPlaying))] ) + " 接受愛與正義的懲罰吧！" ) )
            endif
        else
            call DisplayTextToForce( GetPlayersAll(), ( ( "只有友情才是永恆的，" + udg_Borad_PlayerNames[GetConvertedPlayerId(ForcePickRandomPlayer(udg_PlayersSentinelPlaying))] ) + " 加入去死去死團吧！" ) )
        endif
    else
        call DisplayTextToForce( GetPlayersAll(), ( ( "我 " + udg_Borad_PlayerNames[GetConvertedPlayerId(ForcePickRandomPlayer(udg_PlayersSentinelPlaying))] ) + " 以愛~正義~與和平之名~將會跟你們頑抗到底!!|R" ) )
    endif
endfunction

