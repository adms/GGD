                                                                            call DisplayTextToForce( GetPlayersAll(), ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + ( "一護: 喔喔喔喔喔喔喔喔喔喔喔喔喔!!!!! (跨頁)" + "|r" ) ) )
                                                                        else
