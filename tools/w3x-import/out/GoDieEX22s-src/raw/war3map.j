//===========================================================================
// Trigger: Surrender system
//===========================================================================
function Trig_Surrender_system_Func004Func001C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(ConvertedPlayer(GetForLoopIndexA())) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Surrender_system_Func005Func001C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(ConvertedPlayer(GetForLoopIndexA())) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Surrender_system_Actions takes nothing returns nothing
    call DisplayTimedTextToForce( GetPlayersAll(), 15.00, "TRIGSTR_11013" )
    call EnableTrigger( gg_trg_Love_Surrender )
    call EnableTrigger( gg_trg_Die_Surrender )
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Surrender_system_Func004Func001C() ) then
            call UnitAddAbilityBJ( 'A0ZZ', udg_safe_array[GetForLoopIndexA()] )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Surrender_system_Func005Func001C() ) then
            call UnitAddAbilityBJ( 'A0ZZ', udg_safe_array[GetForLoopIndexA()] )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Surrender_system takes nothing returns nothing
    set gg_trg_Surrender_system = CreateTrigger(  )
