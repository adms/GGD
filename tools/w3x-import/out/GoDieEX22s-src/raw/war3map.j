//===========================================================================
function Trig_BlackDragon_Func001Func011A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_BlackDragon_Func001Func012A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_BlackDragon_Func001Func018C takes nothing returns boolean
    if ( not ( ModuloInteger(udg_BlackDargon, 4) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlackDragon_Func001C takes nothing returns boolean
    if ( not ( udg_BlackDargon == 80 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlackDragon_Actions takes nothing returns nothing
    if ( Trig_BlackDragon_Func001C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call PlaySoundOnUnitBJ( gg_snd_DragonYes2, 100.00, udg_AFuUnit )
        call SetUnitVertexColorBJ( udg_BlackDragonUnit, 0.00, 0.00, 0.00, 60.00 )
        call TriggerSleepAction( 0.01 )
        call SetUnitVertexColorBJ( udg_BlackDragonUnit, 0.00, 0.00, 0.00, 70.00 )
        call TriggerSleepAction( 0.01 )
        call SetUnitVertexColorBJ( udg_BlackDragonUnit, 0.00, 0.00, 0.00, 80.00 )
        call TriggerSleepAction( 0.01 )
        call SetUnitVertexColorBJ( udg_BlackDragonUnit, 0.00, 0.00, 0.00, 90.00 )
        call TriggerSleepAction( 0.01 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(Player(bj_PLAYER_NEUTRAL_VICTIM), 'o010'), function Trig_BlackDragon_Func001Func011A )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(Player(bj_PLAYER_NEUTRAL_VICTIM), 'o00Z'), function Trig_BlackDragon_Func001Func012A )
    else
        set udg_BlackDargon = ( udg_BlackDargon + 1 )
        set udg_tempReuslt = ( I2R(udg_BlackDargon) * 10.00 )
        call SetUnitScalePercent( udg_BlackDragonUnit, udg_tempReuslt, ( udg_tempReuslt * 2.00 ), ( udg_tempReuslt * 2.00 ) )
        call SetUnitVertexColorBJ( udg_BlackDragonUnit, 0.00, 0.00, 0.00, ( 110.00 - ( I2R(udg_BlackDargon) + 0.00 ) ) )
        call SetUnitPositionLocFacingBJ( udg_BlackDragonUnit, PolarProjectionBJ(GetUnitLoc(udg_BlackDragonUnit), 12.00, GetUnitFacing(udg_Hehi)), GetUnitFacing(udg_Hehi) )
        if ( Trig_BlackDragon_Func001Func018C() ) then
            call AddSpecialEffectLocBJ( GetRandomLocInRect(RectFromCenterSizeBJ(udg_BlackDGP, 750.00, 750.00)), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
    endif
endfunction

