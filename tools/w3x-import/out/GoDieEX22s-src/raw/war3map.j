//===========================================================================
// Trigger: back
//===========================================================================
function Trig_back_Conditions takes nothing returns boolean
    if ( not ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) >= 100 ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func001Func001Func002Func002Func002C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048') == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MoveUnit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func001Func001Func002Func002C takes nothing returns boolean
    if ( not Trig_back_Func001Func001Func001Func001Func002Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_COUNT]) <= 50.00 ) ) then
        return false
    endif
    if ( not ( GetAIDifficulty(ConvertedPlayer(udg_AI_COUNT)) != AI_DIFFICULTY_NEWBIE ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_COUNT])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func002Func001Func002Func002Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048') == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MoveUnit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func002Func001Func002Func002C takes nothing returns boolean
    if ( not Trig_back_Func001Func001Func002Func001Func002Func002Func001C() ) then
        return false
    endif
    return true
endfunction

