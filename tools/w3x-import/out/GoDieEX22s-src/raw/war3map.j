    call UnitDropItemTargetBJ( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 1), udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] )
    call UnitDropItemTargetBJ( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 2), udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] )
    call UnitDropItemTargetBJ( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 3), udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] )
