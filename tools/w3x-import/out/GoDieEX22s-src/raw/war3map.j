    return true
endfunction

function Trig_Free_Gold_Actions takes nothing returns nothing
    set udg_TempInteger = 8
    if ( Trig_Free_Gold_Func002001() ) then
        set udg_TempInteger = 8
    else
        call DoNothing(  )
    endif
    if ( Trig_Free_Gold_Func003001() ) then
        set udg_TempInteger = 20
    else
        call DoNothing(  )
    endif
    // 左塔影響發錢
    if ( Trig_Free_Gold_Func005C() ) then
        set udg_PayMoney = 2
        loop
            exitwhen udg_PayMoney > 6
            call AdjustPlayerStateBJ( ( udg_TempInteger + ( udg_iTowerBoken[2] * 1 ) ), ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
            if ( Trig_Free_Gold_Func005Func003Func002C() ) then
                if ( Trig_Free_Gold_Func005Func003Func002Func002C() ) then
                    call AdjustPlayerStateBJ( 8, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                else
                    if ( Trig_Free_Gold_Func005Func003Func002Func002Func002C() ) then
                        call AdjustPlayerStateBJ( 12, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                    else
                        if ( Trig_Free_Gold_Func005Func003Func002Func002Func002Func003C() ) then
                            call AdjustPlayerStateBJ( 30, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                        else
                        endif
                    endif
                endif
            else
            endif
            set udg_PayMoney = udg_PayMoney + 1
        endloop
    else
        set udg_PayMoney = 2
        loop
            exitwhen udg_PayMoney > 6
            call AdjustPlayerStateBJ( ( udg_TempInteger + 1 ), ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
            if ( Trig_Free_Gold_Func005Func001Func002C() ) then
                if ( Trig_Free_Gold_Func005Func001Func002Func002C() ) then
                    call AdjustPlayerStateBJ( 8, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                else
                    if ( Trig_Free_Gold_Func005Func001Func002Func002Func002C() ) then
                        call AdjustPlayerStateBJ( 12, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                    else
                        if ( Trig_Free_Gold_Func005Func001Func002Func002Func002Func003C() ) then
                            call AdjustPlayerStateBJ( 30, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                        else
                        endif
                    endif
                endif
            else
            endif
            set udg_PayMoney = udg_PayMoney + 1
        endloop
    endif
    if ( Trig_Free_Gold_Func006C() ) then
        set udg_PayMoney = 8
        loop
            exitwhen udg_PayMoney > 12
            call AdjustPlayerStateBJ( ( udg_TempInteger + ( udg_iTowerBoken[1] * 1 ) ), ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
            if ( Trig_Free_Gold_Func006Func002Func002C() ) then
                if ( Trig_Free_Gold_Func006Func002Func002Func002C() ) then
                    call AdjustPlayerStateBJ( 8, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                else
                    if ( Trig_Free_Gold_Func006Func002Func002Func002Func002C() ) then
                        call AdjustPlayerStateBJ( 12, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                    else
                        if ( Trig_Free_Gold_Func006Func002Func002Func002Func002Func003C() ) then
                            call AdjustPlayerStateBJ( 30, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                        else
                        endif
                    endif
                endif
            else
            endif
            set udg_PayMoney = udg_PayMoney + 1
        endloop
    else
        set udg_PayMoney = 8
        loop
            exitwhen udg_PayMoney > 12
            call AdjustPlayerStateBJ( ( udg_TempInteger + 1 ), ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
            if ( Trig_Free_Gold_Func006Func001Func002C() ) then
                if ( Trig_Free_Gold_Func006Func001Func002Func002C() ) then
                    call AdjustPlayerStateBJ( 8, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                else
                    if ( Trig_Free_Gold_Func006Func001Func002Func002Func002C() ) then
                        call AdjustPlayerStateBJ( 12, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                    else
                        if ( Trig_Free_Gold_Func006Func001Func002Func002Func002Func003C() ) then
                            call AdjustPlayerStateBJ( 30, ConvertedPlayer(udg_PayMoney), PLAYER_STATE_RESOURCE_GOLD )
                        else
                        endif
                    endif
                endif
            else
            endif
            set udg_PayMoney = udg_PayMoney + 1
        endloop
    endif
endfunction

