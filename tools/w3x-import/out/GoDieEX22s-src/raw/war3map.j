function Trig_LightMove_Func002C takes nothing returns boolean
    if ( not ( udg_LightTeethIndex <= 16 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LightMove_Actions takes nothing returns nothing
    set udg_LightTeethIndex = ( udg_LightTeethIndex + 1 )
    if ( Trig_LightMove_Func002C() ) then
        set udg_P1 = PolarProjectionBJ(udg_P2, ( 50.00 * I2R(udg_LightTeethIndex) ), udg_EyesLightAngle)
        call ForGroupBJ( GetUnitsInRangeOfLocAll(230.00, udg_P1), function Trig_LightMove_Func002Func010A )
        call EnumDestructablesInCircleBJ( 250.00, udg_P1, function Trig_LightMove_Func002Func011A )
        call RemoveLocation( udg_P1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call RemoveLocation( udg_P2 )
        call GroupClear( udg_LightGroup )
        call KillUnit( udg_LightTeeth )
        call RemoveUnit( udg_LightTeeth )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_EyesMaster), 'hfoo'), function Trig_LightMove_Func002Func006A )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_EyesMaster), 'hfoo'), function Trig_LightMove_Func002Func007A )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_EyesMaster), 'hfoo'), function Trig_LightMove_Func002Func008A )
    endif
endfunction

