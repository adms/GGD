//===========================================================================
// Trigger: Vengeance Robe
//
// 復仇之袍被動詛咒
//===========================================================================
function Trig_Vengeance_Robe_Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetAttackedUnitBJ(), 'I02J') == true ) ) then
        return false
    endif
    if ( not ( GetRandomInt(1, 8) <= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vengeance_Robe_Conditions takes nothing returns boolean
    if ( not Trig_Vengeance_Robe_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Vengeance_Robe_Actions takes nothing returns nothing
    set udg_Immediately_P1 = GetUnitLoc(GetAttackedUnitBJ())
    set udg_Immediately_P2 = GetUnitLoc(GetAttacker())
    call CreateNUnitsAtLocFacingLocBJ( 1, 'hfoo', GetOwningPlayer(GetAttackedUnitBJ()), udg_Immediately_P1, udg_Immediately_P2 )
    call ShowUnitHide( GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0BM', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "curse", GetAttacker() )
    call KillUnit( GetLastCreatedUnit() )
    call RemoveUnit( GetLastCreatedUnit() )
    call RemoveLocation(udg_Immediately_P1)
    call RemoveLocation(udg_Immediately_P2)
endfunction

//===========================================================================
function InitTrig_Vengeance_Robe takes nothing returns nothing
    set gg_trg_Vengeance_Robe = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vengeance_Robe, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Vengeance_Robe, Condition( function Trig_Vengeance_Robe_Conditions ) )
    call TriggerAddAction( gg_trg_Vengeance_Robe, function Trig_Vengeance_Robe_Actions )
endfunction

//===========================================================================
// Trigger: Light Wand
//
// 光魔杖被動閃電
//===========================================================================
function Trig_Light_Wand_Conditions takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetAttacker(), 'I027') == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetAttacker(), GetOwningPlayer(GetTriggerUnit())) != true ) ) then
        return false
    endif
    if ( not ( GetRandomInt(1, 4) <= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Wand_Actions takes nothing returns nothing
    local unit Light_Unit
    local unit Light_HideUnit
    local unit Light_AtkedUnit
    local location Light_UnitPoint

    set Light_Unit = GetAttacker()
    set Light_UnitPoint = GetUnitLoc(Light_Unit)
    set Light_AtkedUnit = GetAttackedUnitBJ()
    call CreateNUnitsAtLoc( 1, 'hfoo', GetOwningPlayer(Light_Unit), Light_UnitPoint, bj_UNIT_FACING )
    set Light_HideUnit = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', Light_HideUnit )
    call RemoveLocation( Light_UnitPoint )
