//===========================================================================
// Trigger: Longinus
//===========================================================================
function Trig_Longinus_Func005C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetAttacker(), GetOwningPlayer(GetTriggerUnit())) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetAttacker(), 'I018') == true ) ) then
        return false
    endif
    if ( not ( GetRandomReal(0, 1) <= ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, GetAttacker(), true)) / ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, GetAttacker(), true)) + 300.00 ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Longinus_Conditions takes nothing returns boolean
    if ( not Trig_Longinus_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Longinus_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( GetAttacker(), GetTriggerUnit(), I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetAttacker(), true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
endfunction

