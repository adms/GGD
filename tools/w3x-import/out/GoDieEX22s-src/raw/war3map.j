    set udg_HeroType[10] = 'Udre'
    set udg_HeroType[11] = 'Ewar'
    set udg_HeroType[12] = 'Efur'
    set udg_HeroType[13] = 'Etyr'
    set udg_HeroType[14] = 'Emfr'
    set udg_HeroType[15] = 'Nplh'
    set udg_HeroType[16] = 'Ewrd'
    set udg_HeroType[17] = 'Nsjs'
    set udg_HeroType[18] = 'E00K'
