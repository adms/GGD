    call TriggerRegisterAnyUnitEventBJ( gg_trg_EVA_ON, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_EVA_ON, Condition( function Trig_EVA_ON_Conditions ) )
