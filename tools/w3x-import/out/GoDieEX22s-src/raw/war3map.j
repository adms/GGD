//*  Map Configuration
//*
//***************************************************************************

function config takes nothing returns nothing
    call SetMapName( "TRIGSTR_003" )
    call SetMapDescription( "TRIGSTR_005" )
    call SetPlayers( 12 )
    call SetTeams( 12 )
    call SetGamePlacement( MAP_PLACEMENT_TEAMS_TOGETHER )

    call DefineStartLocation( 0, -7488.0, -8512.0 )
    call DefineStartLocation( 1, -7616.0, -9536.0 )
    call DefineStartLocation( 2, -7616.0, -9536.0 )
    call DefineStartLocation( 3, -7616.0, -9536.0 )
    call DefineStartLocation( 4, -7616.0, -9536.0 )
    call DefineStartLocation( 5, -7616.0, -9536.0 )
    call DefineStartLocation( 6, 4224.0, 3520.0 )
    call DefineStartLocation( 7, 4288.0, 5184.0 )
    call DefineStartLocation( 8, 4288.0, 5184.0 )
    call DefineStartLocation( 9, 4288.0, 5184.0 )
    call DefineStartLocation( 10, 4288.0, 5184.0 )
    call DefineStartLocation( 11, 4288.0, 5184.0 )

    // Player setup
    call InitCustomPlayerSlots(  )
    call InitCustomTeams(  )
    call InitAllyPriorities(  )
endfunction

