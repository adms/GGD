function Trig_AI_Init_Func008Func013C takes nothing returns boolean
    if ( not ( udg_AI_EasyMode == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Init_Func008C takes nothing returns boolean
    if ( not ( udg_AI_Running == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Init_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyTrigger(GetTriggeringTrigger())
    set udg_AI_TurnON = true
    // 打亂陣列100次
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_AI_Init_Func005Func001C() ) then
            // 創造陣列中12個英雄
            set udg_TempPlayer = ConvertedPlayer(GetForLoopIndexA())
            call TriggerExecute( gg_trg_Select_Random_Hero )
            if ( Trig_AI_Init_Func005Func001Func004C() ) then
                set udg_AI_EasyMode = true
                call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 90.00 )
                call UnitAddItemByIdSwapped( 'I05U', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I033', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I06K', udg_PlayerHeroUnit[GetForLoopIndexA()] )
            else
                if ( Trig_AI_Init_Func005Func001Func004Func006C() ) then
                    call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 100.00 )
                    call UnitAddItemByIdSwapped( 'I02G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I00Q', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I01G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                else
                    call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 150.00 )
                    call UnitAddItemByIdSwapped( 'I02G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I014', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I061', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                endif
            endif
            call UnitAddAbilityBJ( 'A0J9', udg_PlayerHeroUnit[GetForLoopIndexA()] )
            set udg_AI_Running_Red = true
            set udg_AI_Running = true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // 打亂陣列100次
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_AI_Init_Func007Func001C() ) then
            // 創造陣列中12個英雄
            set udg_TempPlayer = ConvertedPlayer(GetForLoopIndexA())
            call TriggerExecute( gg_trg_Select_Random_Hero )
            if ( Trig_AI_Init_Func007Func001Func004C() ) then
                set udg_AI_EasyMode = true
                call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 90.00 )
                call UnitAddItemByIdSwapped( 'I05U', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I033', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I06K', udg_PlayerHeroUnit[GetForLoopIndexA()] )
            else
                if ( Trig_AI_Init_Func007Func001Func004Func006C() ) then
                    call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 100.00 )
                    call UnitAddItemByIdSwapped( 'I02G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I00Q', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I01G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                else
                    call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 150.00 )
                    call UnitAddItemByIdSwapped( 'I02G', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I014', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                    call UnitAddItemByIdSwapped( 'I061', udg_PlayerHeroUnit[GetForLoopIndexA()] )
                endif
            endif
            call UnitAddAbilityBJ( 'A0J9', udg_PlayerHeroUnit[GetForLoopIndexA()] )
            set udg_AI_Running_Green = true
            set udg_AI_Running = true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_AI_Init_Func008C() ) then
        call EnableTrigger( gg_trg_AILearning )
        call EnableTrigger( gg_trg_AIRAttacked )
        call EnableTrigger( gg_trg_AINotice )
        call EnableTrigger( gg_trg_AImove )
        call EnableTrigger( gg_trg_AImove_LoveFinal )
        call EnableTrigger( gg_trg_AIgoHomeBuy )
        call EnableTrigger( gg_trg_AIGAttacked )
        call EnableTrigger( gg_trg_AImove )
        call EnableTrigger( gg_trg_AImove_GoDieFinal )
        call EnableTrigger( gg_trg_AIGSkills )
        call EnableTrigger( gg_trg_AILast )
        if ( Trig_AI_Init_Func008Func013C() ) then
            call EnableTrigger( gg_trg_AICallHelpTrg )
        else
            call DoNothing(  )
        endif
    else
        call DoNothing(  )
    endif
endfunction

//===========================================================================
function InitTrig_AI_Init takes nothing returns nothing
    set gg_trg_AI_Init = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_AI_Init, 40.00 )
    call TriggerAddAction( gg_trg_AI_Init, function Trig_AI_Init_Actions )
endfunction

//===========================================================================
// Trigger: AILearning
//
// 電腦回到溫泉區時所作的動作
//===========================================================================
function Trig_AILearning_Func016C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_AILearning_Conditions takes nothing returns boolean
    if ( not Trig_AILearning_Func016C() ) then
        return false
    endif
    return true
endfunction

