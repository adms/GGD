function Trig_go_Func003Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_go_Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_AINotice) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_go_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_NazgrelYes2 )
    if ( Trig_go_Func003C() ) then
        if ( Trig_go_Func003Func001C() ) then
            set udg_AI_COUNT = 2
            loop
                exitwhen udg_AI_COUNT > 6
                if ( Trig_go_Func003Func001Func001Func001C() ) then
                    if ( Trig_go_Func003Func001Func001Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        if ( Trig_go_Func003Func001Func001Func001Func002Func006C() ) then
                            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_LoveHeroPoint, Player(0)))
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_LoveHeroPoint) )
                        endif
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_godie_centerf, Player(0)))
                        if ( Trig_go_Func003Func001Func001Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            set udg_attackWay = 2
                            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(udg_RegoinAI[udg_attackWay], Player(0)))
                            if ( Trig_go_Func003Func001Func001Func001Func002Func002Func003C() ) then
                                call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                            else
                                call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "attack", GetRectCenter(udg_RegoinAI[udg_attackWay]) )
                            endif
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        else
            set udg_AI_COUNT = 8
            loop
                exitwhen udg_AI_COUNT > 12
                if ( Trig_go_Func003Func001Func002Func001C() ) then
                    if ( Trig_go_Func003Func001Func002Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        if ( Trig_go_Func003Func001Func002Func001Func002Func006C() ) then
                            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_DieHeroPoint, Player(6)))
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                        endif
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_love_centerf, Player(6)))
                        if ( Trig_go_Func003Func001Func002Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            set udg_attackWay = 2
                            set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(udg_RegoinAI[udg_attackWay], Player(6)))
                            if ( Trig_go_Func003Func001Func002Func001Func002Func002Func003C() ) then
                                call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                            else
                                call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "attack", GetRectCenter(udg_RegoinAI[udg_attackWay]) )
                            endif
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        endif
    else
    endif
    call DisplayTextToForce( GetPlayersAllies(GetTriggerPlayer()), ( ( "" + udg_Borad_PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())] ) + ": 是時候了!! 大家向前衝吧!! 用你們的死來證明自己的強悍!!" ) )
    call AdjustPlayerStateBJ( -100, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
endfunction

