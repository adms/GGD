    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetSpellTargetUnit()), GetUnitLoc(GetTriggerUnit())) < 400.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIGSkills_Actions takes nothing returns nothing
    set udg_AIActionNumber = 5
    // 特殊區
    if ( Trig_AIGSkills_Func003C() ) then
        call IssueImmediateOrderBJ( GetSpellTargetUnit(), "tranquility" )
    else
    endif
    if ( Trig_AIGSkills_Func004C() ) then
        call IssueImmediateOrderBJ( GetSpellTargetUnit(), "berserk" )
    else
    endif
    // 檢查區
    if ( Trig_AIGSkills_Func007C() ) then
        if ( Trig_AIGSkills_Func007Func002C() ) then
            if ( Trig_AIGSkills_Func007Func002Func002C() ) then
                set udg_AIActionNumber = 1
            else
                set udg_AIActionNumber = 2
            endif
        else
            set udg_AIActionNumber = 3
        endif
    else
        set udg_AIActionNumber = 5
    endif
    // 反應區
    if ( Trig_AIGSkills_Func009C() ) then
        if ( Trig_AIGSkills_Func009Func002C() ) then
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "thunderbolt", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "chainlightning", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "entangle", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "entangleinstant", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "manaburn", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "entanglingroots", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "shadowstrike", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "impale", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "frostnova", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "firebolt", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "drain", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "forkedlightning", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "acidbomb", GetTriggerUnit() )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "fingerofdeath", GetTriggerUnit() )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "shockwave", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "carrionswarm", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "impale", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "dreadlordinferno", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "deathanddecay", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "monsoon", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "stampede", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "breathoffire", GetUnitLoc(GetTriggerUnit()) )
            call IssuePointOrderLocBJ( GetSpellTargetUnit(), "clusterrockets", GetUnitLoc(GetTriggerUnit()) )
            call IssueImmediateOrderBJ( GetSpellTargetUnit(), "thunderclap" )
            call IssueImmediateOrderBJ( GetSpellTargetUnit(), "starfall" )
            call IssueImmediateOrderBJ( GetSpellTargetUnit(), "fanofknives" )
            call IssueImmediateOrderBJ( GetSpellTargetUnit(), "creepthunderclap" )
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "attack", GetTriggerUnit() )
        else
            call IssueTargetOrderBJ( GetSpellTargetUnit(), "attack", GetTriggerUnit() )
        endif
    else
    endif
endfunction

