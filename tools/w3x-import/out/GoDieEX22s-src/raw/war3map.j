    return true
endfunction

function Trig_AcxelShooter_Func006C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O02V' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= 150.00 ) ) then
        return false
    endif
    return true
endfunction

