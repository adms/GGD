//===========================================================================
// Trigger: ButtyGhost Afraid
//===========================================================================
function ButtyGhost_Afraid takes unit tu, unit au returns nothing
    set bj_lastCreatedUnit = CreateUnit( GetOwningPlayer(au), 'ogru', GetUnitX(tu), GetUnitY(tu), 0.00 )
    call UnitApplyTimedLife( bj_lastCreatedUnit, 'BTLF', 1.00 )
    call UnitAddAbility( bj_lastCreatedUnit, 'A0IF' )
    call IssueTargetOrder( bj_lastCreatedUnit, "curse", au )
    call PlaySoundOnUnitBJ( gg_snd_AmmoDumpWhat1, 100.00, tu )
endfunction


function Trig_ButtyGhost_Afraid_Actions takes nothing returns nothing
    if ( GetUnitTypeId(GetTriggerUnit()) != 'E00T' ) then
        return
    endif

    call ButtyGhost_Afraid( GetTriggerUnit(), GetAttacker() )
endfunction

