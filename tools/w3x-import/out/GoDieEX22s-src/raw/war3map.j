        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Nine_Lives_Hits_Func002Func062Func004C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Buncle_P3, udg_Buncle_P4) >= 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nine_Lives_Hits_Func002C takes nothing returns boolean
    if ( not ( udg_Buncle_Nine_Index < 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nine_Lives_Hits_Actions takes nothing returns nothing
    set udg_Buncle_Nine_Index = ( udg_Buncle_Nine_Index + 1 )
    if ( Trig_Nine_Lives_Hits_Func002C() ) then
        set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_Nine_Caster)
        set udg_Buncle_P2 = GetUnitLoc(udg_Buncle_Nine_Target)
        set udg_Buncle_Nine_Angle = AngleBetweenPoints(udg_Buncle_P1, udg_Buncle_P2)
        set udg_Buncle_P3 = PolarProjectionBJ(udg_Buncle_P1, 130.00, udg_Buncle_Nine_Angle)
        call SetUnitPositionLoc( udg_Buncle_Nine_Target, udg_Buncle_P3 )
        call SetUnitAnimation( udg_Buncle_Nine_Target, "death" )
        set udg_Buncle_Nine_Angle = AngleBetweenPoints(udg_Buncle_P2, udg_Buncle_P1)
        set udg_Buncle_P4 = PolarProjectionBJ(udg_Buncle_P3, 100.00, udg_Buncle_Nine_Angle)
        call SetUnitPositionLocFacingLocBJ( udg_Buncle_Nine_Caster, udg_Buncle_P4, udg_Buncle_P3 )
        call SetUnitTimeScalePercent( udg_Buncle_Nine_Caster, 250.00 )
        call SetUnitAnimationWithRarity( udg_Buncle_Nine_Caster, "attack", RARITY_FREQUENT )
        call CreateNUnitsAtLoc( 1, 'o02T', GetOwningPlayer(udg_Buncle_Nine_Caster), udg_Buncle_P4, ( GetUnitFacing(udg_Buncle_Nine_Caster) + GetRandomReal(-90.00, 90.00) ) )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 80.00, 10.00, 10.00, 50.00 )
        call SetUnitAnimation( GetLastCreatedUnit(), "attack" )
        call AddSpecialEffectTargetUnitBJ( "weapon", GetLastCreatedUnit(), "Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Buncle_Nine_Count = ( udg_Buncle_Nine_Count + udg_Buncle_Nine_Index )
        call CreateTextTagUnitBJ( ( I2S(udg_Buncle_Nine_Count) + "Hit!!" ), udg_Buncle_Nine_Target, -30.00, I2R(( ( udg_Buncle_Nine_Index * 3 ) + 8 )), 100, ( 100.00 - I2R(udg_Buncle_Nine_Count) ), ( 100.00 - I2R(udg_Buncle_Nine_Count) ), 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 180.00, GetRandomDirectionDeg() )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.50 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.00 )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Buncle_Nine_Target, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitInvulnerable( udg_Buncle_Nine_Target, false )
        call UnitDamageTargetBJ( udg_Buncle_Nine_Caster, udg_Buncle_Nine_Target, I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Buncle_Nine_Caster, true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call SetUnitInvulnerable( udg_Buncle_Nine_Target, true )
        call EnumDestructablesInCircleBJ( 200.00, udg_Buncle_P3, function Trig_Nine_Lives_Hits_Func002Func029A )
        call RemoveLocation( udg_Buncle_P1 )
        call RemoveLocation( udg_Buncle_P2 )
        call RemoveLocation( udg_Buncle_P3 )
        call RemoveLocation( udg_Buncle_P4 )
        set udg_Buncle_Nine_CD = ( udg_Buncle_Nine_CD * 0.75 )
        call StartTimerBJ( udg_Buncle_Nine_Timer, false, udg_Buncle_Nine_CD )
    else
        call TriggerSleepAction( 0.30 )
        call SetUnitTimeScalePercent( udg_Buncle_Nine_Caster, 50.00 )
        call SetUnitAnimationWithRarity( udg_Buncle_Nine_Caster, "attack", RARITY_FREQUENT )
        set udg_Buncle_P1 = GetUnitLoc(udg_Buncle_Nine_Caster)
        set udg_Buncle_P2 = GetUnitLoc(udg_Buncle_Nine_Target)
        set udg_Buncle_Nine_Angle = AngleBetweenPoints(udg_Buncle_P1, udg_Buncle_P2)
        call CreateNUnitsAtLoc( 1, 'o02T', GetOwningPlayer(udg_Buncle_Nine_Caster), udg_Buncle_P1, GetUnitFacing(udg_Buncle_Nine_Caster) )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 80.00, 10.00, 10.00, 50.00 )
        call SetUnitAnimation( GetLastCreatedUnit(), "attack" )
        call AddSpecialEffectTargetUnitBJ( "weapon", GetLastCreatedUnit(), "Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "weapon", udg_Buncle_Nine_Caster, "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TriggerSleepAction( 0.40 )
        call AddSpecialEffectLocBJ( udg_Buncle_P2, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitInvulnerable( udg_Buncle_Nine_Target, false )
        call UnitDamageTargetBJ( udg_Buncle_Nine_Caster, udg_Buncle_Nine_Target, 900.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call SetUnitInvulnerable( udg_Buncle_Nine_Target, true )
        call CreateTextTagUnitBJ( "TRIGSTR_991", udg_Buncle_Nine_Target, -30.00, 36.00, 100, 0.00, 0.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 100.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        call RemoveLocation( udg_Buncle_P2 )
        set udg_Buncle_Int = 1
        loop
            exitwhen udg_Buncle_Int > 10
            set udg_Buncle_P3 = PolarProjectionBJ(udg_Buncle_P1, ( 20.00 * I2R(udg_Buncle_Int) ), udg_Buncle_Nine_Angle)
            call SetUnitPositionLoc( udg_Buncle_Nine_Target, udg_Buncle_P3 )
            set udg_Buncle_P4 = GetUnitLoc(udg_Buncle_Nine_Target)
            if ( Trig_Nine_Lives_Hits_Func002Func062Func004C() ) then
                set udg_Buncle_P2 = PolarProjectionBJ(udg_Buncle_P1, ( 20.00 * I2R(( udg_Buncle_Int - 1 )) ), udg_Buncle_Nine_Angle)
                call SetUnitPositionLoc( udg_Buncle_Nine_Target, udg_Buncle_P2 )
                call EnumDestructablesInCircleBJ( 300.00, udg_Buncle_P2, function Trig_Nine_Lives_Hits_Func002Func062Func004Func003A )
                call RemoveLocation( udg_Buncle_P2 )
                set udg_Buncle_Int = 10
            else
            endif
            call RemoveLocation( udg_Buncle_P3 )
            call RemoveLocation( udg_Buncle_P4 )
            set udg_Buncle_Int = udg_Buncle_Int + 1
        endloop
        call RemoveLocation( udg_Buncle_P1 )
        call SetUnitAnimation( udg_Buncle_Nine_Target, "death" )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Buncle_Nine_Target, "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TriggerSleepAction( 0.60 )
        call UnitRemoveAbilityBJ( 'Avul', udg_Buncle_Nine_Target )
        call PauseUnitBJ( false, udg_Buncle_Nine_Target )
        call SetUnitTimeScalePercent( udg_Buncle_Nine_Caster, 100.00 )
        call UnitRemoveAbilityBJ( 'Avul', udg_Buncle_Nine_Caster )
        call PauseUnitBJ( false, udg_Buncle_Nine_Caster )
        call DisableTrigger( gg_trg_Nine_Lives_clear )
    endif
endfunction

