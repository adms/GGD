function Trig_Hell_Timer9_Func008C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HeavyTiger, 'B03J') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Timer9_Func011Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'o01T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Timer9_Func011A takes nothing returns nothing
    if ( Trig_Hell_Timer9_Func011Func001C() ) then
        call KillUnit( GetEnumUnit() )
        call RemoveUnit( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Hell_Timer9_Func019A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Hell_Timer9_Actions takes nothing returns nothing
    // 最後一下傷害給予
    call CreateNUnitsAtLoc( 1, 'u00X', GetOwningPlayer(udg_HeavyTiger), udg_HellRockPoint, bj_UNIT_FACING )
    call TerrainDeformationRippleBJ( 2.00, false, udg_HellRockPoint, 600.00, 900.00, 280.00, 1.00, 300.00 )
    call EnableWeatherEffect( GetLastCreatedWeatherEffect(), true )
    call AddSpecialEffectLocBJ( udg_DrganSlaveMovePoint, "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, udg_HellRockPoint), function Trig_Hell_Timer9_Func007A )
    if ( Trig_Hell_Timer9_Func008C() ) then
        call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, udg_HellRockPoint), function Trig_Hell_Timer9_Func008Func002A )
    else
    endif
    // 恢復原狀&清除部隊
    set udg_HellRockForIndex = 1
    loop
        exitwhen udg_HellRockForIndex > 16
        call KillUnit( udg_HellRockCreateUnit[udg_HellRockForIndex] )
        call RemoveUnit( udg_HellRockCreateUnit[udg_HellRockForIndex] )
        set udg_HellRockForIndex = udg_HellRockForIndex + 1
    endloop
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Hell_Timer9_Func011A )
    call SetUnitVertexColorBJ( udg_HeavyTiger, 100, 100.00, 100.00, 0 )
    call PauseUnitBJ( false, udg_HeavyTiger )
    call UnitRemoveAbilityBJ( 'A0FZ', udg_HeavyTiger )
    call UnitRemoveAbilityBJ( 'Avul', udg_HeavyTiger )
    call SetUnitPathing( udg_HeavyTiger, true )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 2 )
    call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_HeavyTiger), 'u00X'), function Trig_Hell_Timer9_Func019A )
endfunction

