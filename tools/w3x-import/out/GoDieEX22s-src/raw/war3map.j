    if ( not ( ModuloInteger(udg_ComToEatTime, 10) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ComeToEatEffect_Func003C takes nothing returns boolean
    if ( not ( udg_ComToEatTime < 51 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ComeToEatEffect_Actions takes nothing returns nothing
    set udg_ComToEatTime = ( udg_ComToEatTime + 1 )
    if ( Trig_ComeToEatEffect_Func003C() ) then
        call SetUnitPositionLoc( udg_ComeToEatUnit, GetUnitLoc(udg_HentiMaskUnit) )
        if ( Trig_ComeToEatEffect_Func003Func002C() ) then
            call SetUnitInvulnerable( udg_ComeToEatUnit, false )
            call UnitDamageTargetBJ( udg_HentiMaskUnit, udg_ComeToEatUnit, 400.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            call SetUnitInvulnerable( udg_ComeToEatUnit, true )
            call AddSpecialEffectTargetUnitBJ( "chest", udg_ComeToEatUnit, "Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call AddSpecialEffectTargetUnitBJ( "chest", udg_ComeToEatUnit, "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call AddSpecialEffectTargetUnitBJ( "head", udg_HentiMaskUnit, "LOVE2.MDX" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
            call DoNothing(  )
        endif
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitFlyHeightBJ( udg_ComeToEatUnit, 0.00, 0.00 )
        call UnitRemoveAbilityBJ( 'A0FZ', udg_ComeToEatUnit )
        call SetUnitPathing( udg_ComeToEatUnit, true )
        call SetUnitPathing( udg_HentiMaskUnit, true )
        call SetUnitInvulnerable( udg_ComeToEatUnit, false )
        call SetUnitInvulnerable( udg_HentiMaskUnit, false )
        call PauseUnitBJ( false, udg_ComeToEatUnit )
        call PauseUnitBJ( false, udg_HentiMaskUnit )
    endif
endfunction

