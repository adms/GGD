    set gg_trg_CircleCut_Moving = CreateTrigger(  )
    call DisableTrigger( gg_trg_CircleCut_Moving )
    call TriggerRegisterTimerEventPeriodic( gg_trg_CircleCut_Moving, 0.10 )
    call TriggerAddAction( gg_trg_CircleCut_Moving, function Trig_CircleCut_Moving_Actions )
