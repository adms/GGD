function Trig_PandaParty_Func007C takes nothing returns boolean
    if ( ( GetTriggerPlayer() == udg_coward ) ) then
        return true
    endif
    if ( ( GetTriggerPlayer() == udg_d8246505 ) ) then
        return true
    endif
    if ( ( GetPlayerName(GetTriggerPlayer()) == "adms" ) ) then
        return true
    endif
    return false
endfunction

function Trig_PandaParty_Conditions takes nothing returns boolean
    if ( not Trig_PandaParty_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_PandaParty_Func002Func001Func001C takes nothing returns boolean
    if ( ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) != MAP_CONTROL_NONE ) ) then
        return true
    endif
    if ( ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) != MAP_CONTROL_COMPUTER ) ) then
        return true
    endif
    return false
endfunction

function Trig_PandaParty_Func002Func001C takes nothing returns boolean
    if ( not Trig_PandaParty_Func002Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_PandaParty_Func004Func001Func002C takes nothing returns boolean
    if ( ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) != MAP_CONTROL_COMPUTER ) ) then
        return true
    endif
    if ( ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) != MAP_CONTROL_NONE ) ) then
        return true
    endif
    return false
endfunction

function Trig_PandaParty_Func004Func001C takes nothing returns boolean
    if ( not Trig_PandaParty_Func004Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_PandaParty_Actions takes nothing returns nothing
    call PlaySoundAtPointBJ( gg_snd_PandarenBrewmasterWarcry1, 100, GetRectCenter(gg_rct_CenterLove), 0 )
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_PandaParty_Func002Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'H02K', ConvertedPlayer(GetForLoopIndexA()), GetPlayerStartLocationLoc(ConvertedPlayer(GetForLoopIndexA())), bj_UNIT_FACING )
            set udg_PlayerHeroUnit[GetForLoopIndexA()] = GetLastCreatedUnit()
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call PlaySoundAtPointBJ( gg_snd_PandarenBrewmasterWarcry1, 100, GetRectCenter(gg_rct_CenterGodie), 0 )
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_PandaParty_Func004Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'H02K', ConvertedPlayer(GetForLoopIndexA()), GetPlayerStartLocationLoc(ConvertedPlayer(GetForLoopIndexA())), bj_UNIT_FACING )
            set udg_PlayerHeroUnit[GetForLoopIndexA()] = GetLastCreatedUnit()
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_9090" )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_9089" )
endfunction

