    set gg_trg_GoldDrgan_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_GoldDrgan_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_GoldDrgan_Effect, 0.04 )
