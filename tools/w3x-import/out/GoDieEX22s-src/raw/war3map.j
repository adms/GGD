//===========================================================================
// Trigger: Nine Lives out
//===========================================================================
function Trig_Nine_Lives_out_Func002C takes nothing returns boolean
    if ( not ( udg_Buncle_Nine_Count >= 99 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nine_Lives_out_Actions takes nothing returns nothing
    set udg_Buncle_Nine_Count = ( udg_Buncle_Nine_Count + 3 )
    if ( Trig_Nine_Lives_out_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call PauseTimerBJ( true, udg_Buncle_Nine_Timer2 )
        call CreateTextTagUnitBJ( "TRIGSTR_8058", udg_Buncle_Nine_Target, -30.00, 35.00, 100, 0.00, 0.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 150.00, GetRandomDirectionDeg() )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.50 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.00 )
    else
        call CreateTextTagUnitBJ( ( I2S(udg_Buncle_Nine_Count) + "Hit!!" ), udg_Buncle_Nine_Target, -30.00, I2R(( ( udg_Buncle_Nine_Index * 3 ) + 8 )), 100, ( 100.00 - I2R(udg_Buncle_Nine_Count) ), ( 100.00 - I2R(udg_Buncle_Nine_Count) ), 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 180.00, GetRandomDirectionDeg() )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 0.50 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.20 )
        set udg_Buncle_Nine_CD2 = ( udg_Buncle_Nine_CD2 * 0.75 )
        call StartTimerBJ( udg_Buncle_Nine_Timer2, false, udg_Buncle_Nine_CD2 )
    endif
endfunction

