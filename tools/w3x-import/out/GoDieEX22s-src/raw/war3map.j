//===========================================================================
// Trigger: Goku
//===========================================================================
function Trig_Goku_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) == GetOwningPlayer(udg_SSJ) ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_SSJ) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goku_Func003C takes nothing returns boolean
    if ( not ( udg_SSJ_KillCounter >= 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goku_Actions takes nothing returns nothing
    call UnitAddItemByIdSwapped( 'manh', udg_SSJ )
    set udg_SSJ_KillCounter = ( udg_SSJ_KillCounter + 1 )
    if ( Trig_Goku_Func003C() ) then
        set udg_SSJ_KillCounter = 0
        call ModifyHeroStat( bj_HEROSTAT_STR, udg_SSJ, bj_MODIFYMETHOD_ADD, 1 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Goku takes nothing returns nothing
    set gg_trg_Goku = CreateTrigger(  )
    call DisableTrigger( gg_trg_Goku )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Goku, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Goku, Condition( function Trig_Goku_Conditions ) )
    call TriggerAddAction( gg_trg_Goku, function Trig_Goku_Actions )
endfunction

