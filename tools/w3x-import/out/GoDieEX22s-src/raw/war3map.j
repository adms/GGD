//===========================================================================
// Trigger: Soul expense
//
// 死團 2.0 "靈魂消耗" 系統
// 英雄死亡將造成主堡損傷
//===========================================================================
function Trig_Soul_expense_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_expense_Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetDyingUnit(), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_expense_Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetDyingUnit(), Player(6)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_expense_Actions takes nothing returns nothing
    if ( Trig_Soul_expense_Func001C() ) then
        call SetUnitLifeBJ( gg_unit_etoe_0016, ( GetUnitStateSwap(UNIT_STATE_LIFE, gg_unit_etoe_0016) - ( ( ( GetUnitStateSwap(UNIT_STATE_LIFE, gg_unit_etoe_0016) * I2R(GetHeroLevel(GetDyingUnit())) ) * 0.01 ) * 0.10 ) ) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Soul_expense_Func002C() ) then
        call SetUnitLifeBJ( gg_unit_unpl_0000, ( GetUnitStateSwap(UNIT_STATE_LIFE, gg_unit_unpl_0000) - ( ( ( GetUnitStateSwap(UNIT_STATE_LIFE, gg_unit_unpl_0000) * I2R(GetHeroLevel(GetDyingUnit())) ) * 0.01 ) * 0.10 ) ) )
    else
        call DoNothing(  )
    endif
endfunction

