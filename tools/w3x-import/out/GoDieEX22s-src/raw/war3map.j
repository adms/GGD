function Trig_KillGodMove_Func002Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_NegiUnit)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_KillGodMove_Func002Func004A takes nothing returns nothing
    if ( Trig_KillGodMove_Func002Func004Func001C() ) then
        call UnitDamageTargetBJ( udg_NegiUnit, GetEnumUnit(), udg_NegiAbsorpDam, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_KillGodMove_Func002C takes nothing returns boolean
    if ( not ( udg_NegiGodKillHeight >= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KillGodMove_Actions takes nothing returns nothing
    call SetUnitFlyHeightBJ( udg_NegiKillGod, udg_NegiGodKillHeight, 0.00 )
    if ( Trig_KillGodMove_Func002C() ) then
        set udg_NegiGodKillHeight = ( udg_NegiGodKillHeight - 50.00 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_NegiMasterPoint = GetUnitLoc(udg_NegiKillGod)
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_NegiInt = 1
            loop
                exitwhen udg_NegiInt > 6
                set udg_NegiPoint = PolarProjectionBJ(udg_NegiMasterPoint, ( 50.00 * I2R(GetForLoopIndexA()) ), ( 60.00 * I2R(udg_NegiInt) ))
                call AddSpecialEffectLocBJ( udg_NegiPoint, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                call AddSpecialEffectLocBJ( udg_NegiPoint, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                call RemoveLocation( udg_NegiPoint )
                set udg_NegiInt = udg_NegiInt + 1
            endloop
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call ForGroupBJ( GetUnitsInRangeOfLocAll(300.00, udg_NegiMasterPoint), function Trig_KillGodMove_Func002Func004A )
        set udg_NegiAbsorpDam = 0.00
        call TriggerSleepAction( 1.00 )
        call KillUnit( udg_NegiKillGod )
        call RemoveUnit( udg_NegiKillGod )
    endif
    call RemoveLocation( udg_NegiMasterPoint )
endfunction

