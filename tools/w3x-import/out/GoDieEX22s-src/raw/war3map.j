function Trig_BoxMoveLimit_Actions takes nothing returns nothing
    if ( Trig_BoxMoveLimit_Func001C() ) then
        set udg_Immediately_P1 = GetRectCenter(gg_rct_LoveItemLimt)
        call SetUnitPositionLoc( GetTriggerUnit(), udg_Immediately_P1 )
        call RemoveLocation(udg_Immediately_P1)
    else
        if ( Trig_BoxMoveLimit_Func001Func001C() ) then
            set udg_Immediately_P1 = GetRectCenter(gg_rct_DieItemLimt)
            call SetUnitPositionLoc( GetTriggerUnit(), udg_Immediately_P1 )
            call RemoveLocation(udg_Immediately_P1)
        else
        endif
    endif
endfunction

