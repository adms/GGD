    return true
endfunction

function Trig_Kill_Unit_Tri_Actions takes nothing returns nothing
    if ( Trig_Kill_Unit_Tri_Func001C() ) then
        set udg_TK_SUM[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_TK_SUM[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 1 )
        call CreateTextTagUnitBJ( "TRIGSTR_109", GetDyingUnit(), -30.00, 10.00, 90.00, 90.00, 90.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    else
    endif
    if ( Trig_Kill_Unit_Tri_Func002C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "獲得新稱號!" ) )
        set udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = "|c00EFF000(龜裝的)|r"
        call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) ) )
    else
    endif
    if ( Trig_Kill_Unit_Tri_Func003C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "獲得新稱號!" ) )
        set udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = "|c00EFF000(背後捅刀的)|r"
        call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) ) )
        call AddHeroXPSwapped( 500, GetKillingUnitBJ(), true )
    else
    endif
    set udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 1 )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 5, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], I2S(udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
    if ( Trig_Kill_Unit_Tri_Func006C() ) then
        call ModifyHeroStat( bj_HEROSTAT_AGI, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 1 )
    else
    endif
    if ( Trig_Kill_Unit_Tri_Func007C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( ( "  " + I2S(udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) + " 人 擊破！" ) ) )
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( ( " 得到" + ( I2S(( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] * 5 )) + ( "黃金和" + ( I2S(( 210 + ( ( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] * 4 ) / 5 ) )) + "木頭的獎賞！" ) ) ) ) + " " ) ) )
        call AdjustPlayerStateBJ( ( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] * 5 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
        call AdjustPlayerStateBJ( ( 210 + ( ( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] * 4 ) / 5 ) ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_LUMBER )
        call AddHeroXPSwapped( 500, GetKillingUnitBJ(), true )
    else
    endif
    if ( Trig_Kill_Unit_Tri_Func008C() ) then
        call AddHeroXPSwapped( 500, GetKillingUnitBJ(), true )
        call SelectHeroSkill( GetKillingUnitBJ(), GetLearnedSkillBJ() )
    else
    endif
endfunction

