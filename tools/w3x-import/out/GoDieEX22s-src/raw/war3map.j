//===========================================================================
function Trig_The_End_ofWorldCasting_Func002Func004A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_The_End_ofWorldCasting_Func002Func005A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_The_End_ofWorldCasting_Func002C takes nothing returns boolean
    if ( not ( udg_WorldEndCount <= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_The_End_ofWorldCasting_Actions takes nothing returns nothing
    if ( Trig_The_End_ofWorldCasting_Func002C() ) then
        set udg_WorldEndCount = ( udg_WorldEndCount + 1 )
        call CreateNUnitsAtLoc( 1, 'u013', GetOwningPlayer(udg_EndWorldUnit), GetRandomLocInRect(RectFromCenterSizeBJ(udg_EndWorldPoint, 450.00, 450.00)), GetRandomDirectionDeg() )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0P6', GetLastCreatedUnit(), udg_EndWorldLevel )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "creepthunderclap" )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerSleepAction( 2 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_EndWorldUnit), 'u013'), function Trig_The_End_ofWorldCasting_Func002Func004A )
