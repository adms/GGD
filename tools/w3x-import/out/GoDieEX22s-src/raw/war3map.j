//===========================================================================
function InitTrig_AILearning takes nothing returns nothing
    set gg_trg_AILearning = CreateTrigger(  )
    call DisableTrigger( gg_trg_AILearning )
    call TriggerRegisterEnterRectSimple( gg_trg_AILearning, gg_rct_LoveHeroPoint )
    call TriggerRegisterEnterRectSimple( gg_trg_AILearning, gg_rct_DieHeroPoint )
    call TriggerAddCondition( gg_trg_AILearning, Condition( function Trig_AILearning_Conditions ) )
    call TriggerAddAction( gg_trg_AILearning, function Trig_AILearning_Actions )
endfunction

//===========================================================================
// Trigger: AIRAttacked
//
// 電腦移動AI
//===========================================================================
function Trig_AIRAttacked_Func003C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(0)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Conditions takes nothing returns boolean
    if ( not Trig_AIRAttacked_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= 70.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_COUNT])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_PlayerHeroUnit[udg_AI_COUNT]), GetUnitLoc(GetTriggerUnit())) < 900.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func001Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_COUNT]) <= 50.00 ) ) then
        return false
    endif
    if ( not ( GetAIDifficulty(ConvertedPlayer(udg_AI_COUNT)) != AI_DIFFICULTY_NEWBIE ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func001Func001C takes nothing returns boolean
    if ( not Trig_AIRAttacked_Func001Func001Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetAttacker()) <= 35.00 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIRAttacked_Actions takes nothing returns nothing
    if ( Trig_AIRAttacked_Func001C() ) then
        if ( Trig_AIRAttacked_Func001Func002C() ) then
            if ( Trig_AIRAttacked_Func001Func002Func001C() ) then
                call IssueTargetOrderBJ( GetTriggerUnit(), "attack", GetAttacker() )
            else
                call SelectHeroSkill( GetTriggerUnit(), GetLearnedSkillBJ() )
                call IssuePointOrderLocBJ( GetTriggerUnit(), "move", GetRectCenter(gg_rct_LoveHeroPoint) )
            endif
        else
        endif
    else
        set udg_AI_COUNT = 2
        loop
            exitwhen udg_AI_COUNT > 6
            if ( Trig_AIRAttacked_Func001Func001Func001C() ) then
                if ( Trig_AIRAttacked_Func001Func001Func001Func001C() ) then
                    call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I03D'), GetTriggerUnit() )
                else
                endif
                if ( Trig_AIRAttacked_Func001Func001Func001Func003C() ) then
                    call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_LoveHeroPoint) )
                else
                    call IssueTargetOrderBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "attack", GetAttacker() )
                endif
            else
            endif
            set udg_AI_COUNT = udg_AI_COUNT + 1
        endloop
    endif
endfunction

//===========================================================================
function InitTrig_AIRAttacked takes nothing returns nothing
    set gg_trg_AIRAttacked = CreateTrigger(  )
    call DisableTrigger( gg_trg_AIRAttacked )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_AIRAttacked, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_AIRAttacked, Condition( function Trig_AIRAttacked_Conditions ) )
    call TriggerAddAction( gg_trg_AIRAttacked, function Trig_AIRAttacked_Actions )
endfunction

