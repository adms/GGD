//===========================================================================
// Trigger: Hell Timer7
//===========================================================================
function Trig_Hell_Timer7_Func007C takes nothing returns boolean
    if ( not ( udg_HellRockForIndex >= 14 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Timer7_Actions takes nothing returns nothing
    set udg_HellSpecialPoint = PolarProjectionBJ(GetUnitLoc(udg_HeavyTiger), GetRandomReal(350.00, 550.00), GetRandomDirectionDeg())
    call CreateNUnitsAtLoc( 1, 'h01M', GetOwningPlayer(udg_HeavyTiger), udg_HellSpecialPoint, bj_UNIT_FACING )
    set udg_HellRockCreateUnit[udg_HellRockForIndex] = GetLastCreatedUnit()
    call SetUnitFlyHeightBJ( udg_HellRockCreateUnit[udg_HellRockForIndex], GetRandomReal(0.00, 500.00), 0.00 )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', udg_HellRockCreateUnit[udg_HellRockForIndex] )
    call IssueTargetOrderBJ( udg_HellRockCreateUnit[udg_HellRockForIndex], "thunderbolt", udg_HellRockCreateUnit[15] )
    if ( Trig_Hell_Timer7_Func007C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Hell_Timer8 )
        call StartTimerBJ( udg_HellTimer, false, 0.10 )
    else
        call StartTimerBJ( udg_HellTimer, false, 0.10 )
        set udg_HellRockForIndex = ( udg_HellRockForIndex + 1 )
    endif
    call PlaySoundOnUnitBJ( gg_snd_SargerasLaugh, 100.00, udg_HeavyTiger )
endfunction

//===========================================================================
function InitTrig_Hell_Timer7 takes nothing returns nothing
    set gg_trg_Hell_Timer7 = CreateTrigger(  )
