                call IssueTargetOrderBJ( udg_AIAttackUnit, "manaburn", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "entanglingroots", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "shadowstrike", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "impale", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "frostnova", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "firebolt", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "drain", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "forkedlightning", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "acidbomb", udg_AIAttackedUnit )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "fingerofdeath", udg_AIAttackedUnit )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "shockwave", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "carrionswarm", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "impale", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "dreadlordinferno", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "deathanddecay", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "monsoon", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "stampede", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "breathoffire", GetUnitLoc(udg_AIAttackedUnit) )
                call IssuePointOrderLocBJ( udg_AIAttackUnit, "clusterrockets", GetUnitLoc(udg_AIAttackedUnit) )
                call IssueImmediateOrderBJ( udg_AIAttackUnit, "thunderclap" )
                call IssueImmediateOrderBJ( udg_AIAttackUnit, "starfall" )
                call IssueImmediateOrderBJ( udg_AIAttackUnit, "fanofknives" )
                call IssueImmediateOrderBJ( udg_AIAttackUnit, "creepthunderclap" )
                call IssueTargetOrderBJ( udg_AIAttackUnit, "attack", udg_AIAttackedUnit )
            else
                call IssueTargetOrderBJ( udg_AIAttackUnit, "attack", udg_AIAttackedUnit )
            endif
        else
        endif
    else
    endif
endfunction

function Trig_AILast_Func001Func002Func004Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_PlayerHeroUnit[udg_AI_Counter3], GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_Counter2])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_PlayerHeroUnit[udg_AI_Counter3]) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_PlayerHeroUnit[udg_AI_Counter3]), GetUnitLoc(udg_PlayerHeroUnit[udg_AI_Counter2])) < 3600.00 ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_Counter3]) <= 35.00 ) ) then
        return false
    endif
    if ( not ( udg_PlayerHeroUnit[udg_AI_Counter3] != null ) ) then
        return false
    endif
    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AILast_Func001Func002Func004Func001C takes nothing returns boolean
    if ( not Trig_AILast_Func001Func002Func004Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_AILast_Func001Func002C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_Counter2])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_AILast_Actions takes nothing returns nothing
    set udg_AI_Counter2 = 2
    loop
        exitwhen udg_AI_Counter2 > 12
        set udg_AIAttackUnit = udg_PlayerHeroUnit[udg_AI_Counter2]
        if ( Trig_AILast_Func001Func002C() ) then
            // 檢查周圍
            call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, GetUnitLoc(udg_PlayerHeroUnit[udg_AI_Counter2])), function Trig_AILast_Func001Func002Func002A )
            // 檢查全地圖
            set udg_AI_Counter3 = 2
            loop
                exitwhen udg_AI_Counter3 > 12
                if ( Trig_AILast_Func001Func002Func004Func001C() ) then
                    call PingMinimapLocForForceEx( GetPlayersAllies(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_Counter2])), GetUnitLoc(udg_PlayerHeroUnit[udg_AI_Counter3]), 3.00, bj_MINIMAPPINGSTYLE_FLASHY, 100, 100, 100 )
                else
                endif
                set udg_AI_Counter3 = udg_AI_Counter3 + 1
            endloop
        else
        endif
        set udg_AI_Counter2 = udg_AI_Counter2 + 1
    endloop
endfunction

