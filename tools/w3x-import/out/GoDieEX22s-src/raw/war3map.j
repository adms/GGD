//===========================================================================
// Trigger: BR Law
//===========================================================================
function Trig_BR_Law_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BR_Law_Func009Func001Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BR_Law_Func009Func001Func004C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BR_Law_Func009Func001C takes nothing returns boolean
    if ( not Trig_BR_Law_Func009Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_BR_Law_Func009A takes nothing returns nothing
    if ( Trig_BR_Law_Func009Func001C() ) then
        call UnitDamageTargetBJ( GetLastCreatedUnit(), GetEnumUnit(), 3000.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        if ( Trig_BR_Law_Func009Func001Func004C() ) then
            call DisplayTextToForce( GetPlayersAll(), ( ( "滅殺" + GetUnitName(GetEnumUnit()) ) + "！" ) )
        else
        endif
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateTextTagUnitBJ( "TRIGSTR_8387", GetEnumUnit(), -30.00, 10.00, 90.00, 0.00, 0.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_BR_Law_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_1654" )
    call TriggerSleepAction( 90.00 )
    if ( Trig_BR_Law_Func004C() ) then
        set udg_RandomPointBR = GetUnitLoc(udg_PlayerHeroUnit[GetRandomInt(2, 6)])
    else
        set udg_RandomPointBR = GetUnitLoc(udg_PlayerHeroUnit[GetRandomInt(8, 12)])
    endif
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_5635" )
    call PingMinimapLocForForceEx( GetPlayersAll(), udg_RandomPointBR, 9.00, bj_MINIMAPPINGSTYLE_ATTACK, 100, 0.00, 0.00 )
    call TriggerSleepAction( 9.00 )
    call CreateNUnitsAtLoc( 1, 'o01M', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_RandomPointBR, bj_UNIT_FACING )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(1500.00, udg_RandomPointBR), function Trig_BR_Law_Func009A )
    call TriggerExecute( gg_trg_BR_Law )
endfunction

//===========================================================================
function InitTrig_BR_Law takes nothing returns nothing
    set gg_trg_BR_Law = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_BR_Law, Player(1), "-br", true )
    call TriggerAddAction( gg_trg_BR_Law, function Trig_BR_Law_Actions )
endfunction

//===========================================================================
// Trigger: Killme
//===========================================================================
function Trig_Killme_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())]) == 'E00R' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Killme_Actions takes nothing returns nothing
    local integer num
    if ( Trig_Killme_Func002C() ) then
        set udg_EVA_DieJudge = true
    else
    endif
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, ( "上天接受了" + ( GetPlayerName(GetTriggerPlayer()) + "卑微的請求，將於10秒後給予了他永恆的安寧，並帶走他50%的財產。" ) ) )
    set num = GetConvertedPlayerId(GetTriggerPlayer())
    call TriggerSleepAction( 10.00 )
    call SetPlayerStateBJ( ConvertedPlayer(num), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(ConvertedPlayer(num), PLAYER_STATE_RESOURCE_GOLD) / 2 ) )
    call SetPlayerStateBJ( ConvertedPlayer(num), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(ConvertedPlayer(num), PLAYER_STATE_RESOURCE_LUMBER) / 2 ) )
    call KillUnit( udg_PlayerHeroUnit[num] )
endfunction

//===========================================================================
function InitTrig_Killme takes nothing returns nothing
    set gg_trg_Killme = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(1), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(2), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(3), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(4), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(5), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(7), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(8), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(9), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(10), "-killme", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Killme, Player(11), "-killme", false )
    call TriggerAddAction( gg_trg_Killme, function Trig_Killme_Actions )
endfunction

//===========================================================================
// Trigger: Matchup
//===========================================================================
function Trig_Matchup_Func001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Matchup_Func002Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetTriggerPlayer()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Matchup_Func002A takes nothing returns nothing
    if ( Trig_Matchup_Func002Func001C() ) then
