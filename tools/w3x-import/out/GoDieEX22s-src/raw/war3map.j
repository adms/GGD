function Trig_Hell_Timer4_Func012C takes nothing returns boolean
    if ( not ( udg_HellRockForIndex >= 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Timer4_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'o01T', GetOwningPlayer(udg_HeavyTiger), udg_HellRockPoint, bj_UNIT_FACING )
    set udg_HellRockCreateUnit[udg_HellRockForIndex] = GetLastCreatedUnit()
    call ShowUnitHide( udg_HellRockCreateUnit[udg_HellRockForIndex] )
    call UnitAddAbilityBJ( 'A0LX', udg_HellRockCreateUnit[udg_HellRockForIndex] )
    call SetUnitAbilityLevelSwapped( 'A0LX', udg_HellRockCreateUnit[udg_HellRockForIndex], udg_HellRockLevel )
    call IssueImmediateOrderBJ( udg_HellRockCreateUnit[udg_HellRockForIndex], "thunderclap" )
    call AddSpecialEffectLocBJ( PolarProjectionBJ(udg_HellRockPoint, 100.00, udg_HellRockAngle), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call KillUnit( udg_HellRockCreateUnit[udg_HellRockForIndex] )
    call RemoveUnit( udg_HellRockCreateUnit[udg_HellRockForIndex] )
    call SetUnitAnimation( udg_HeavyTiger, "attack slam" )
    if ( Trig_Hell_Timer4_Func012C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Hell_Timer5 )
        call StartTimerBJ( udg_HellTimer, false, 0.30 )
    else
        call StartTimerBJ( udg_HellTimer, false, 0.30 )
        set udg_HellRockForIndex = ( udg_HellRockForIndex + 1 )
    endif
endfunction

