//===========================================================================
function Trig_NiLow_Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'Utic' ) ) then
        return false
    endif
    return true
endfunction

function Trig_NiLow_Conditions takes nothing returns boolean
    if ( not Trig_NiLow_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_NiLow_Func004C takes nothing returns boolean
    if ( not ( udg_killUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] >= 100 ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(GetTriggerUnit()) >= 16 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NiLow_Actions takes nothing returns nothing
    call DisplayTextToForce( GetPlayersAll(), ( "你就是" + ( GetUnitName(GetTriggerUnit()) + "吧!" ) ) )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_941" )
    if ( Trig_NiLow_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_943" )
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_Utic_0117 )
        call SetUnitOwner( gg_unit_Utic_0117, Player(PLAYER_NEUTRAL_AGGRESSIVE), true )
        call IssueTargetOrderBJ( gg_unit_Utic_0117, "attack", GetTriggerUnit() )
        set udg_DES_init_counter = 20
        loop
            exitwhen udg_DES_init_counter > 24
            call TriggerRegisterUnitEvent( udg_Des_BuffTri[udg_DES_init_counter], gg_unit_Utic_0117, EVENT_UNIT_DAMAGED )
            set udg_DES_init_counter = udg_DES_init_counter + 1
        endloop
        set udg_DES_init_counter = 20
        loop
            exitwhen udg_DES_init_counter > 23
            call TriggerRegisterUnitEvent( udg_Des_UtypTri[udg_DES_init_counter], gg_unit_Utic_0117, EVENT_UNIT_DAMAGED )
            set udg_DES_init_counter = udg_DES_init_counter + 1
        endloop
    else
    endif
endfunction

