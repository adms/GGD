    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_GaShoUnit))] == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_GoldDragonEatedUnit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoldDrgan_Effect_Func009C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_P2, udg_P3) > 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoldDrgan_Effect_Func013Func002Func003001 takes nothing returns boolean
    return ( udg_GoldDragonExtraAtk > 21 )
endfunction

