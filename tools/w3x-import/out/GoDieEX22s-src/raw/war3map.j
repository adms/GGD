//===========================================================================
// Trigger: Iamacoward
//===========================================================================
function Trig_Iamacoward_Func001C takes nothing returns boolean
    if ( ( GetTriggerPlayer() == udg_coward ) ) then
        return true
    endif
    if ( ( GetTriggerPlayer() == udg_d8246505 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Iamacoward_Conditions takes nothing returns boolean
    if ( not Trig_Iamacoward_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Iamacoward_Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_PlayerHeroUnit[S2I(udg_cheatNumberStr)]) == true ) ) then
        return false
    endif
    if ( not ( udg_PlayerHeroUnit[S2I(udg_cheatNumberStr)] != null ) ) then
        return false
    endif
    if ( not ( ConvertedPlayer(S2I(udg_cheatNumberStr)) != udg_d8246505 ) ) then
        return false
    endif
    if ( not ( ConvertedPlayer(S2I(udg_cheatNumberStr)) != udg_coward ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iamacoward_Actions takes nothing returns nothing
    set udg_cheatNumberStr = SubStringBJ(GetEventPlayerChatString(), 7, StringLength(GetEventPlayerChatString()))
    if ( Trig_Iamacoward_Func003C() ) then
        call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), ( GetPlayerName(GetTriggerPlayer()) + ( "給予" + ( GetPlayerName(ConvertedPlayer(S2I(udg_cheatNumberStr))) + "降下了正義之罰" ) ) ) )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_PlayerHeroUnit[S2I(udg_cheatNumberStr)], "SuperShinyThingy.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

