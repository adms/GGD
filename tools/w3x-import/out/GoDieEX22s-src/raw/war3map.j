    set gg_trg_GaiaAngre = CreateTrigger(  )
    call DisableTrigger( gg_trg_GaiaAngre )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_GaiaAngre, EVENT_PLAYER_UNIT_SPELL_EFFECT )
