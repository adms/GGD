    set gg_trg_Initiate_Fan_Toss_2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Initiate_Fan_Toss_2 )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Initiate_Fan_Toss_2, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Initiate_Fan_Toss_2, Condition( function Trig_Initiate_Fan_Toss_2_Conditions ) )
    call TriggerAddAction( gg_trg_Initiate_Fan_Toss_2, function Trig_Initiate_Fan_Toss_2_Actions )
endfunction

//===========================================================================
// Trigger: Fan Movement 2
//===========================================================================
function Trig_Fan_Movement_2_Func001Func001Func004C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_CurrentFanRightPointLink, udg_TrackWE_PointLink) <= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_Movement_2_Func001Func001C takes nothing returns boolean
    if ( not ( udg_FanRotationCounterLink >= 378.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_Movement_2_Func001C takes nothing returns boolean
    if ( not ( udg_FanTravel_DISTLink <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_Movement_2_Func002002003001001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_Fan_Movement_2_Func002002003001002 takes nothing returns boolean
    return ( IsUnitInGroup(GetFilterUnit(), udg_SafeTargetsFanRightLink) == false )
endfunction

function Trig_Fan_Movement_2_Func002002003001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Fan_Movement_2_Func002002003001001(), Trig_Fan_Movement_2_Func002002003001002() )
endfunction

function Trig_Fan_Movement_2_Func002002003002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Fan_Movement_2_Func002002003002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_Fan_Movement_2_Func002002003002002002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Link)) == true )
endfunction

function Trig_Fan_Movement_2_Func002002003002002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Fan_Movement_2_Func002002003002002001(), Trig_Fan_Movement_2_Func002002003002002002() )
endfunction

function Trig_Fan_Movement_2_Func002002003002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Fan_Movement_2_Func002002003002001(), Trig_Fan_Movement_2_Func002002003002002() )
endfunction

function Trig_Fan_Movement_2_Func002002003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Fan_Movement_2_Func002002003001(), Trig_Fan_Movement_2_Func002002003002() )
endfunction

function Trig_Fan_Movement_2_Func003A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Link, GetEnumUnit(), udg_FanTossDamageLink, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call GroupRemoveUnitSimple( GetEnumUnit(), udg_PotentialTargetsFanRightLink )
    call GroupAddUnitSimple( GetEnumUnit(), udg_SafeTargetsFanRightLink )
    call PlaySoundOnUnitBJ( gg_snd_WitchDoctorCastAttack1, 100.00, GetEnumUnit() )
endfunction

function Trig_Fan_Movement_2_Actions takes nothing returns nothing
    if ( Trig_Fan_Movement_2_Func001C() ) then
        if ( Trig_Fan_Movement_2_Func001Func001C() ) then
            set udg_TrackWE_PointLink = GetUnitLoc(udg_Link)
            set udg_CurrentFanRightPointLink = PolarProjectionBJ(GetUnitLoc(udg_FanRightLink), 50.00, AngleBetweenPoints(GetUnitLoc(udg_FanRightLink), udg_TrackWE_PointLink))
            call SetUnitPositionLocFacingBJ( udg_FanRightLink, udg_CurrentFanRightPointLink, bj_UNIT_FACING )
            if ( Trig_Fan_Movement_2_Func001Func001Func004C() ) then
                call KillUnit( udg_FanRightLink )
                call RemoveUnit( udg_FanRightLink )
                call GroupClear( udg_PotentialTargetsFanRightLink )
                call GroupClear( udg_SafeTargetsFanRightLink )
                call RemoveLocation(udg_TrackWE_PointLink)
                call RemoveLocation(udg_CurrentFanRightPointLink)
                call RemoveLocation(udg_Fan_Right_Point_1Link)
                call DisableTrigger( GetTriggeringTrigger() )
            else
                call DoNothing(  )
            endif
        else
            set udg_CurrentFanRightPointLink = PolarProjectionBJ(udg_Fan_Right_Point_1Link, 420.00, ( AngleBetweenPoints(udg_Fan_Right_Point_1Link, GetUnitLoc(udg_FanRightLink)) - 18.00 ))
            call SetUnitPositionLocFacingBJ( udg_FanRightLink, udg_CurrentFanRightPointLink, bj_UNIT_FACING )
            set udg_FanRotationCounterLink = ( udg_FanRotationCounterLink + 18.00 )
        endif
    else
        set udg_CurrentFanRightPointLink = PolarProjectionBJ(GetUnitLoc(udg_FanRightLink), 50.00, udg_FanRightAngleLink)
        set udg_FanTravel_DISTLink = ( udg_FanTravel_DISTLink - 50.00 )
        call SetUnitPositionLocFacingBJ( udg_FanRightLink, udg_CurrentFanRightPointLink, bj_UNIT_FACING )
    endif
    set udg_PotentialTargetsFanRightLink = GetUnitsInRangeOfLocMatching(225.00, udg_CurrentFanRightPointLink, Condition(function Trig_Fan_Movement_2_Func002002003))
    call ForGroupBJ( udg_PotentialTargetsFanRightLink, function Trig_Fan_Movement_2_Func003A )
    call RemoveLocation(udg_CurrentFanRightPointLink)
    call RemoveLocation(udg_TrackWE_PointLink)
endfunction

//===========================================================================
function InitTrig_Fan_Movement_2 takes nothing returns nothing
    set gg_trg_Fan_Movement_2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Fan_Movement_2 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Fan_Movement_2, 0.03 )
    call TriggerAddAction( gg_trg_Fan_Movement_2, function Trig_Fan_Movement_2_Actions )
endfunction

