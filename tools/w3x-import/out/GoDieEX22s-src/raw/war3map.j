//===========================================================================
function Trig_stupidStart_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'Udea' ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetSpellTargetUnit()), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_stupidStart_Conditions takes nothing returns boolean
    if ( not Trig_stupidStart_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_stupidStart_Func012Func001Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_MoriyaUnit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_stupidStart_Func012Func001C takes nothing returns boolean
    if ( not Trig_stupidStart_Func012Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_stupidStart_Func012A takes nothing returns nothing
    if ( Trig_stupidStart_Func012Func001C() ) then
        call UnitDamageTargetBJ( udg_MoriyaUnit, GetEnumUnit(), udg_StupidMoriya, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL )
        call CreateNUnitsAtLoc( 1, 'o00G', GetOwningPlayer(udg_MoriyaUnit), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0CS', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0CS', GetLastCreatedUnit(), 3 )
        call SetUnitFacingToFaceUnitTimed( GetLastCreatedUnit(), GetEnumUnit(), 0 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetEnumUnit() )
    else
    endif
endfunction

function Trig_stupidStart_Func014A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_stupidStart_Actions takes nothing returns nothing
    set udg_MoriyaUnit = GetSpellTargetUnit()
    set udg_P1 = GetUnitLoc(GetTriggerUnit())
    call CreateTextTagUnitBJ( "TRIGSTR_4608", GetTriggerUnit(), 0, 18.00, 100.00, 100.00, 100.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    set bj_wantDestroyGroup = true
    call TerrainDeformationRippleBJ( 3.00, false, GetUnitLoc(GetTriggerUnit()), 600.00, 600.00, 64.00, 6.00, 600.00 )
    call EnableWeatherEffect( GetLastCreatedWeatherEffect(), true )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(3600.00, GetUnitLoc(udg_MoriyaUnit)), function Trig_stupidStart_Func012A )
    call TriggerSleepAction( 6.00 )
    call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_MoriyaUnit), 'o00G'), function Trig_stupidStart_Func014A )
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

