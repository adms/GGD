    call AddSpecialEffectLocBJ( GetUnitLoc(udg_StumbledUnit), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
