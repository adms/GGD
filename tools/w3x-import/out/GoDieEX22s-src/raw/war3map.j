function Trig_AKT_1_Func003C takes nothing returns boolean
    if ( not ( udg_AKTJumpIndex >= 41 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AKT_1_Actions takes nothing returns nothing
    call SetUnitFlyHeightBJ( udg_AKTSpecialUnit[5], ( ( -1.50 * Pow(( I2R(udg_AKTJumpIndex) - 21.00 ), 2.00) ) + 600.00 ), 0.00 )
    call SetUnitPositionLocFacingLocBJ( udg_AKTSpecialUnit[5], PolarProjectionBJ(GetUnitLoc(udg_AKTSpecialUnit[5]), -10.00, ( udg_AKTJumpAngle + 135.00 )), udg_AKTCastPoint )
    if ( Trig_AKT_1_Func003C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitAnimation( udg_AKTSpecialUnit[5], "attack" )
        call CreateNUnitsAtLoc( 1, 'o015', GetOwningPlayer(udg_AKTUnit), udg_AKTCastPoint, bj_UNIT_FACING )
        set udg_AKTShanaUnit = GetLastCreatedUnit()
        set udg_CloseDesEffectCount = 0
        call EnableTrigger( gg_trg_AKT_1_Effect )
        call PlaySoundOnUnitBJ( gg_snd_FlareTarget1, 100.00, udg_AKTUnit )
        call TriggerSleepAction( 3.00 )
        call KillUnit( udg_AKTShanaUnit )
        call RemoveUnit( udg_AKTShanaUnit )
    else
        set udg_AKTJumpIndex = ( udg_AKTJumpIndex + 1 )
    endif
endfunction

