function CreateAllDestructables takes nothing returns nothing
    local destructable d
    local trigger t
    local real life
    set gg_dest_ATg4_0297 = CreateDestructable( 'ATg4', -2272.0, 928.0, 180.000, 1.000, 0 )
    set d = CreateDestructable( 'LTex', 2656.0, -3808.0, 256.000, 1.353, 0 )
    set t = CreateTrigger(  )
    call TriggerRegisterDeathEvent( t, d )
    call TriggerAddAction( t, function SaveDyingWidget )
    call TriggerAddAction( t, function Doodad000184_DropItems )
endfunction

