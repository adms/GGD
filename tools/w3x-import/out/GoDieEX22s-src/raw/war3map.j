//===========================================================================
// Trigger: MicEff
//===========================================================================
function Trig_MicEff_Func002Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_NM_MicCaster, Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func001Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_NM_Master, 'B04K') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func001Func003C takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_NM_Master))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func001C takes nothing returns boolean
    if ( not ( udg_ZZ_LC_Get == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_NM_MicCaster, Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func002Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_NM_Master, 'B04K') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func002Func003C takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_NM_Master))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_NM_MicCaster, Player(PLAYER_NEUTRAL_AGGRESSIVE)) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_NM_MicCaster) != 'Edem' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicEff_Actions takes nothing returns nothing
    set udg_NM_MicCaster = GetTriggerUnit()
    if ( Trig_MicEff_Func002C() ) then
        if ( Trig_MicEff_Func002Func002C() ) then
            if ( Trig_MicEff_Func002Func002Func001C() ) then
                set udg_NM_P = GetRectCenter(gg_rct_LoveHeroPoint)
            else
                set udg_NM_P = GetRectCenter(gg_rct_DieHeroPoint)
            endif
            if ( Trig_MicEff_Func002Func002Func002C() ) then
                call UnitDamageTargetBJ( udg_NM_Master, udg_NM_MicCaster, 300.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            else
            endif
            if ( Trig_MicEff_Func002Func002Func003C() ) then
                call UnitDamageTargetBJ( udg_NM_Master, udg_NM_MicCaster, ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_NM_Master, true)) * 5.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            else
            endif
            call TextUse("賣扣~~~", udg_NM_MicCaster , 30 , 4 , 100,0,0)
            call PauseUnitBJ( true, udg_NM_MicCaster )
            call SetUnitPathing( udg_NM_MicCaster, false )
            call UnitAddAbilityBJ( 'A0FZ', udg_NM_MicCaster )
            set udg_NM_P2 = GetUnitLoc(udg_NM_MicCaster)
            set udg_NM_Dis = DistanceBetweenPoints(udg_NM_P, udg_NM_P2)
            set udg_NM_Dis = ( udg_NM_Dis / 50.00 )
            set udg_NM_Ang = AngleBetweenPoints(udg_NM_P2, udg_NM_P)
            set udg_NM_Index = 0.00
            call RemoveLocation( udg_NM_P)
            call EnableTrigger( gg_trg_MicTimer )
        else
        endif
    else
        if ( Trig_MicEff_Func002Func001C() ) then
            if ( Trig_MicEff_Func002Func001Func001C() ) then
                set udg_NM_P = GetRectCenter(gg_rct_LoveHeroPoint)
            else
                set udg_NM_P = GetRectCenter(gg_rct_DieHeroPoint)
            endif
            if ( Trig_MicEff_Func002Func001Func002C() ) then
                call UnitDamageTargetBJ( udg_NM_Master, udg_NM_MicCaster, 300.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            else
            endif
            if ( Trig_MicEff_Func002Func001Func003C() ) then
                call UnitDamageTargetBJ( udg_NM_Master, udg_NM_MicCaster, ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_NM_Master, true)) * 5.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            else
            endif
            call TextUse("賣扣~~~", udg_NM_MicCaster , 30 , 4 , 100,0,0)
            call PauseUnitBJ( true, udg_NM_MicCaster )
            call SetUnitPathing( udg_NM_MicCaster, false )
            call UnitAddAbilityBJ( 'A0FZ', udg_NM_MicCaster )
            set udg_NM_P2 = GetUnitLoc(udg_NM_MicCaster)
            set udg_NM_Dis = DistanceBetweenPoints(udg_NM_P, udg_NM_P2)
            set udg_NM_Dis = ( udg_NM_Dis / 50.00 )
            set udg_NM_Ang = AngleBetweenPoints(udg_NM_P2, udg_NM_P)
            set udg_NM_Index = 0.00
            call RemoveLocation( udg_NM_P)
            call EnableTrigger( gg_trg_MicTimer )
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_MicEff takes nothing returns nothing
    set gg_trg_MicEff = CreateTrigger(  )
    call TriggerAddAction( gg_trg_MicEff, function Trig_MicEff_Actions )
endfunction

//===========================================================================
// Trigger: MicTimer
//===========================================================================
function Trig_MicTimer_Func003Func014Func001C takes nothing returns boolean
    if ( not ( udg_NM_Index >= ( udg_NM_Dis - 12.00 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicTimer_Func003Func014C takes nothing returns boolean
    if ( not ( udg_NM_Index <= 12.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicTimer_Func003C takes nothing returns boolean
    if ( not ( udg_NM_Index < udg_NM_Dis ) ) then
        return false
    endif
    return true
endfunction

function Trig_MicTimer_Actions takes nothing returns nothing
    set udg_NM_Index = ( udg_NM_Index + 1 )
    if ( Trig_MicTimer_Func003C() ) then
        set udg_NM_P = PolarProjectionBJ(udg_NM_P2, 50.00, udg_NM_Ang)
        call SetUnitPositionLoc( udg_NM_MicCaster, udg_NM_P )
        call RemoveLocation( udg_NM_P)
        call RemoveLocation( udg_NM_P2)
        set udg_NM_P2 = GetUnitLoc(udg_NM_MicCaster)
        if ( Trig_MicTimer_Func003Func014C() ) then
            call SetUnitFlyHeightBJ( udg_NM_MicCaster, ( 50.00 * udg_NM_Index ), 0.00 )
        else
            if ( Trig_MicTimer_Func003Func014Func001C() ) then
                call SetUnitFlyHeightBJ( udg_NM_MicCaster, ( 50.00 * ( udg_NM_Dis - udg_NM_Index ) ), 0.00 )
            else
            endif
        endif
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitFlyHeightBJ( udg_NM_MicCaster, 0.00, 0.00 )
        call AddSpecialEffectLocBJ( udg_NM_P2, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitRemoveAbilityBJ( 'A0FZ', udg_NM_MicCaster )
        call SetUnitPathing( udg_NM_MicCaster, true )
        call PauseUnitBJ( false, udg_NM_MicCaster )
        call RemoveLocation( udg_NM_P2)
    endif
endfunction

//===========================================================================
function InitTrig_MicTimer takes nothing returns nothing
    set gg_trg_MicTimer = CreateTrigger(  )
    call DisableTrigger( gg_trg_MicTimer )
    call TriggerRegisterTimerEventPeriodic( gg_trg_MicTimer, 0.01 )
    call TriggerAddAction( gg_trg_MicTimer, function Trig_MicTimer_Actions )
endfunction

//===========================================================================
// Trigger: TooLong
//===========================================================================
function Trig_TooLong_Conditions takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_NM_Master))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TooLong_Actions takes nothing returns nothing
    call ModifyHeroStat( bj_HEROSTAT_STR, udg_NM_Master, bj_MODIFYMETHOD_ADD, 7 )
    call ModifyHeroStat( bj_HEROSTAT_AGI, udg_NM_Master, bj_MODIFYMETHOD_ADD, 7 )
    call ModifyHeroStat( bj_HEROSTAT_INT, udg_NM_Master, bj_MODIFYMETHOD_ADD, 7 )
    call TextUse("太拖戲啦~~", udg_NM_Master , 15 , 2 , 50,50,0)
endfunction

//===========================================================================
function InitTrig_TooLong takes nothing returns nothing
    set gg_trg_TooLong = CreateTrigger(  )
    call DisableTrigger( gg_trg_TooLong )
    call TriggerRegisterTimerEventPeriodic( gg_trg_TooLong, 60.00 )
    call TriggerAddCondition( gg_trg_TooLong, Condition( function Trig_TooLong_Conditions ) )
    call TriggerAddAction( gg_trg_TooLong, function Trig_TooLong_Actions )
endfunction

//===========================================================================
// Trigger: Open Skill of HE
//
// Horse Emperor
//===========================================================================
function Trig_Open_Skill_of_HE_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E00J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Open_Skill_of_HE_Actions takes nothing returns nothing
    call DestroyTrigger(GetTriggeringTrigger())
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_HEUnit = GetEnteringUnit()
    call EnableTrigger( gg_trg_RedDragon )
    call EnableTrigger( gg_trg_Thankyou )
    call EnableTrigger( gg_trg_Fifty_Sky )
    call EnableTrigger( gg_trg_Hundred_Sky )
    call EnableTrigger( gg_trg_FriendComeBack )
    set udg_TaiwanOfKing = GetTriggerUnit()
    call SetPlayerAbilityAvailableBJ( false, 'A0YC', GetOwningPlayer(GetTriggerUnit()) )
    call DisplayTextToForce( GetPlayersAll(), ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + ( "騜：我相信正直跟善良會回來" + "|r" ) ) )
endfunction

//===========================================================================
function InitTrig_Open_Skill_of_HE takes nothing returns nothing
    set gg_trg_Open_Skill_of_HE = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Open_Skill_of_HE, GetPlayableMapRect() )
    call TriggerAddCondition( gg_trg_Open_Skill_of_HE, Condition( function Trig_Open_Skill_of_HE_Conditions ) )
    call TriggerAddAction( gg_trg_Open_Skill_of_HE, function Trig_Open_Skill_of_HE_Actions )
endfunction

//===========================================================================
// Trigger: RedDragon
//===========================================================================
function Trig_RedDragon_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0YB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_RedDragon_Actions takes nothing returns nothing
    call SetUnitLifePercentBJ( GetTriggerUnit(), ( GetUnitLifePercent(GetTriggerUnit()) + 10.00 ) )
    call SetUnitManaPercentBJ( GetTriggerUnit(), ( GetUnitManaPercent(GetTriggerUnit()) + 10.00 ) )
    call SetUnitAbilityLevelSwapped( 'A0YC', GetTriggerUnit(), 2 )
    call TriggerSleepAction( 10.00 )
    call SetUnitAbilityLevelSwapped( 'A0YC', GetTriggerUnit(), 1 )
endfunction

//===========================================================================
function InitTrig_RedDragon takes nothing returns nothing
    set gg_trg_RedDragon = CreateTrigger(  )
    call DisableTrigger( gg_trg_RedDragon )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_RedDragon, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_RedDragon, Condition( function Trig_RedDragon_Conditions ) )
    call TriggerAddAction( gg_trg_RedDragon, function Trig_RedDragon_Actions )
endfunction

//===========================================================================
// Trigger: Thankyou
//
// 
//===========================================================================
function Trig_Thankyou_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Y7' ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetSpellTargetUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thankyou_Func012Func001A takes nothing returns nothing
    call CameraSetEQNoiseForPlayer( GetOwningPlayer(GetEnumUnit()), 8.00 )
endfunction

function Trig_Thankyou_Actions takes nothing returns nothing
    set udg_HE_3Q_slv = GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    set udg_HE_3Q_Counter = ( 4 + ( 4 * GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) ) )
    set udg_HE_3Q_Target = GetSpellTargetUnit()
    set udg_HE_3Q_P1 = GetUnitLoc(GetTriggerUnit())
    set udg_HE_3Q_P2 = GetUnitLoc(GetSpellTargetUnit())
    set udg_HE_3Q_Angle = AngleBetweenPoints(udg_HE_3Q_P1, udg_HE_3Q_P2)
    call RemoveLocation( udg_HE_3Q_P1 )
    call RemoveLocation( udg_HE_3Q_P2 )
    call EnableTrigger( gg_trg_Thankyou_Effect )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(GetSpellTargetLoc(), 1600.00, 1600.00)), function Trig_Thankyou_Func012Func001A )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call TriggerSleepAction( 0.50 )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 12
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CameraClearNoiseForPlayer( ConvertedPlayer(GetForLoopIndexB()) )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Thankyou takes nothing returns nothing
    set gg_trg_Thankyou = CreateTrigger(  )
    call DisableTrigger( gg_trg_Thankyou )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Thankyou, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Thankyou, Condition( function Trig_Thankyou_Conditions ) )
    call TriggerAddAction( gg_trg_Thankyou, function Trig_Thankyou_Actions )
endfunction

//===========================================================================
// Trigger: Thankyou Effect
//
// 
//===========================================================================
function Trig_Thankyou_Effect_Func007A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Thankyou_Effect_Func012Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HEUnit, 'B04Y') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thankyou_Effect_Func012C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_HE_3Q_P2, udg_HE_3Q_P3) > 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thankyou_Effect_Func016C takes nothing returns boolean
    if ( not ( udg_HE_3Q_Counter <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thankyou_Effect_Actions takes nothing returns nothing
    set udg_HE_3Q_Counter = ( udg_HE_3Q_Counter - 1 )
    call UnitDamageTargetBJ( udg_HEUnit, udg_HE_3Q_Target, 30.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_HE_3Q_Target, "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_HE_3Q_P1 = GetUnitLoc(udg_HE_3Q_Target)
    set udg_HE_3Q_P2 = PolarProjectionBJ(udg_HE_3Q_P1, 50.00, udg_HE_3Q_Angle)
    call EnumDestructablesInCircleBJ( 300.00, GetUnitLoc(udg_HE_3Q_Target), function Trig_Thankyou_Effect_Func007A )
    call SetUnitPositionLoc( udg_HE_3Q_Target, udg_HE_3Q_P2 )
    set udg_HE_3Q_P3 = GetUnitLoc(udg_HE_3Q_Target)
    call AddSpecialEffectLocBJ( udg_HE_3Q_P1, "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_Thankyou_Effect_Func012C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_HE_3Q_Target, udg_HE_3Q_P1 )
        if ( Trig_Thankyou_Effect_Func012Func003C() ) then
            call CreateNUnitsAtLoc( 1, 'hfoo', GetOwningPlayer(udg_HEUnit), udg_HE_3Q_P1, bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0YE', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A0YE', GetLastCreatedUnit(), udg_HE_3Q_slv )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
            call KillUnit( GetLastCreatedUnit() )
            call RemoveUnit( GetLastCreatedUnit() )
            call AddSpecialEffectLocBJ( udg_HE_3Q_P1, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
    else
    endif
    call RemoveLocation( udg_HE_3Q_P1 )
    call RemoveLocation( udg_HE_3Q_P2 )
    call RemoveLocation( udg_HE_3Q_P3 )
    if ( Trig_Thankyou_Effect_Func016C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Thankyou_Effect takes nothing returns nothing
    set gg_trg_Thankyou_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_Thankyou_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Thankyou_Effect, 0.03 )
    call TriggerAddAction( gg_trg_Thankyou_Effect, function Trig_Thankyou_Effect_Actions )
endfunction

//===========================================================================
// Trigger: Fifty Sky
//===========================================================================
function Trig_Fifty_Sky_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Y8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Actions takes nothing returns nothing
    set udg_HE_50_Target = GetSpellTargetUnit()
    set udg_HE_50_P1 = GetUnitLoc(GetTriggerUnit())
    set udg_HE_50_P2 = GetUnitLoc(udg_HE_50_Target)
    set udg_HE_50_slv = GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    set udg_HE_50_Counter = 0
    set udg_HE_50_Damage = 0.00
    set udg_HE_50_Dist = R2I(( DistanceBetweenPoints(udg_HE_50_P1, udg_HE_50_P2) / 50.00 ))
    set udg_HE_50_Get = false
    call AddSpecialEffectLocBJ( udg_KniSkillPoint, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitAddAbilityBJ( 'A0YI', udg_HEUnit )
    call SetUnitAnimation( udg_HEUnit, "walk" )
    call TriggerSleepAction( 0.00 )
    call SetUnitPathing( udg_HEUnit, false )
    call EnableTrigger( gg_trg_Fifty_Sky_Effect )
endfunction

//===========================================================================
function InitTrig_Fifty_Sky takes nothing returns nothing
    set gg_trg_Fifty_Sky = CreateTrigger(  )
    call DisableTrigger( gg_trg_Fifty_Sky )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fifty_Sky, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Fifty_Sky, Condition( function Trig_Fifty_Sky_Conditions ) )
    call TriggerAddAction( gg_trg_Fifty_Sky, function Trig_Fifty_Sky_Actions )
endfunction

//===========================================================================
// Trigger: Fifty Sky Effect
//===========================================================================
function Trig_Fifty_Sky_Effect_Func003Func008Func001C takes nothing returns boolean
    if ( not ( GetEnumUnit() == udg_HE_50_Target ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Effect_Func003Func008A takes nothing returns nothing
    if ( Trig_Fifty_Sky_Effect_Func003Func008Func001C() ) then
        call UnitDamageTargetBJ( udg_HEUnit, GetEnumUnit(), ( 400.00 + ( 200.00 * I2R(udg_HE_50_slv) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call CreateNUnitsAtLoc( 1, 'o00E', GetOwningPlayer(udg_HEUnit), udg_HE_50_P2, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call SetUnitScalePercent( GetLastCreatedUnit(), 300.00, 300.00, 300.00 )
        set udg_HE_50_Get = true
    else
        call DoNothing(  )
    endif
endfunction

function Trig_Fifty_Sky_Effect_Func003Func009Func003Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_HEUnit)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Effect_Func003Func009Func003A takes nothing returns nothing
    if ( Trig_Fifty_Sky_Effect_Func003Func009Func003Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_HEUnit, GetEnumUnit(), udg_HE_50_Damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_Fifty_Sky_Effect_Func003Func009C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HEUnit, 'B04Y') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Effect_Func003Func010Func011A takes nothing returns nothing
    call CameraSetEQNoiseForPlayer( GetOwningPlayer(GetEnumUnit()), 8.00 )
endfunction

function Trig_Fifty_Sky_Effect_Func003Func010Func013A takes nothing returns nothing
    call CameraClearNoiseForPlayer( GetEnumPlayer() )
endfunction

function Trig_Fifty_Sky_Effect_Func003Func010Func014A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Fifty_Sky_Effect_Func003Func010C takes nothing returns boolean
    if ( not ( udg_HE_50_Get == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Effect_Func003C takes nothing returns boolean
    if ( not ( udg_HE_50_Counter < udg_HE_50_Dist ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fifty_Sky_Effect_Actions takes nothing returns nothing
    set udg_HE_50_Counter = ( udg_HE_50_Counter + 1 )
    if ( Trig_Fifty_Sky_Effect_Func003C() ) then
        call SetUnitPositionLoc( udg_HEUnit, PolarProjectionBJ(udg_HE_50_P1, ( 50.00 * I2R(udg_HE_50_Counter) ), AngleBetweenPoints(udg_HE_50_P1, udg_HE_50_P2)) )
        set udg_HE_50_Damage = ( udg_HE_50_Damage + 25.00 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_HEUnit, udg_HE_50_P2 )
        call UnitRemoveAbilityBJ( 'A0YI', udg_HEUnit )
        call SetUnitAnimation( udg_HEUnit, "stand" )
        call SetUnitPathing( udg_HEUnit, true )
        call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_HE_50_P2, 250.00, 250.00)), function Trig_Fifty_Sky_Effect_Func003Func008A )
        if ( Trig_Fifty_Sky_Effect_Func003Func009C() ) then
            call AddSpecialEffectLocBJ( udg_HE_50_P2, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call ForGroupBJ( GetUnitsInRangeOfLocAll(350.00, udg_HE_50_P2), function Trig_Fifty_Sky_Effect_Func003Func009Func003A )
        else
        endif
        if ( Trig_Fifty_Sky_Effect_Func003Func010C() ) then
            call CreateTextTagUnitBJ( "TRIGSTR_9940", udg_HEUnit, 0, 14.00, 100, 0.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
            call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
            call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
            call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
            call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_HE_50_P2, 1600.00, 1600.00)), function Trig_Fifty_Sky_Effect_Func003Func010Func011A )
            call TriggerSleepAction( 0.50 )
            call ForForce( GetPlayersByMapControl(MAP_CONTROL_USER), function Trig_Fifty_Sky_Effect_Func003Func010Func013A )
            call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_HEUnit), 'o00E'), function Trig_Fifty_Sky_Effect_Func003Func010Func014A )
        else
            call CreateTextTagUnitBJ( "TRIGSTR_9926", udg_HEUnit, 0, 10.00, 100, 0.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
            call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
            call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
            call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Fifty_Sky_Effect takes nothing returns nothing
    set gg_trg_Fifty_Sky_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_Fifty_Sky_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Fifty_Sky_Effect, 0.03 )
    call TriggerAddAction( gg_trg_Fifty_Sky_Effect, function Trig_Fifty_Sky_Effect_Actions )
endfunction

//===========================================================================
// Trigger: Hundred Sky
//===========================================================================
function Trig_Hundred_Sky_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Y9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hundred_Sky_Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HEUnit, 'B04Y') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hundred_Sky_Func005C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HE_100_Target, 'B050') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hundred_Sky_Actions takes nothing returns nothing
    set udg_HE_100_Target = GetSpellTargetUnit()
    set udg_HE_100_Damage = ( 300.00 + ( 300.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
    if ( Trig_Hundred_Sky_Func003C() ) then
        set udg_HE_P = GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc( 1, 'hfoo', GetOwningPlayer(udg_HEUnit), udg_HE_P, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0UT', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0UT', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0Y9', GetTriggerUnit()) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        call KillUnit( GetLastCreatedUnit() )
        call RemoveUnit( GetLastCreatedUnit() )
        call AddSpecialEffectLocBJ( udg_HE_P, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation( udg_HE_P )
    else
    endif
    call TriggerSleepAction( 0.00 )
    if ( Trig_Hundred_Sky_Func005C() ) then
        call UnitDamageTargetBJ( udg_HEUnit, udg_HE_100_Target, udg_HE_100_Damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_HE_100_Target, "Units\\NightElf\\Wisp\\WispExplode.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_HE_100_Target, "Abilities\\Spells\\Human\\Avatar\\AvatarCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Hundred_Sky takes nothing returns nothing
    set gg_trg_Hundred_Sky = CreateTrigger(  )
    call DisableTrigger( gg_trg_Hundred_Sky )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hundred_Sky, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Hundred_Sky, Condition( function Trig_Hundred_Sky_Conditions ) )
    call TriggerAddAction( gg_trg_Hundred_Sky, function Trig_Hundred_Sky_Actions )
