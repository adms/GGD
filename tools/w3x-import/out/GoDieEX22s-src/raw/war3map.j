// Trigger: AKT 4 Effect
//===========================================================================
function Trig_AKT_4_Effect_Func003C takes nothing returns boolean
    if ( not ( udg_AKTJumpIndex >= 21 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AKT_4_Effect_Actions takes nothing returns nothing
    call SetUnitFlyHeightBJ( udg_AKTSpecialUnit[8], ( ( -1.00 * Pow(( I2R(udg_AKTJumpIndex) - 21.00 ), 2.00) ) + 400.00 ), 0.00 )
    call SetUnitPositionLocFacingLocBJ( udg_AKTSpecialUnit[8], PolarProjectionBJ(GetUnitLoc(udg_AKTSpecialUnit[8]), udg_AKTMoveDis, ( udg_AKTJumpAngle - 315.00 )), udg_AKTCastPoint )
    if ( Trig_AKT_4_Effect_Func003C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitAnimation( udg_AKTSpecialUnit[8], "spell" )
        call PlaySoundBJ( gg_snd_nocute )
    else
        set udg_AKTJumpIndex = ( udg_AKTJumpIndex + 1 )
    endif
endfunction

