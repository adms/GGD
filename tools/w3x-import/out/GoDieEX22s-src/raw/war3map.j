function Trig_Tower_Broken_Actions takes nothing returns nothing
    if ( Trig_Tower_Broken_Func002C() ) then
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_5494" )
    else
    endif
    if ( Trig_Tower_Broken_Func003C() ) then
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_5493" )
    else
    endif
    if ( Trig_Tower_Broken_Func004C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( GetUnitName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + " 擊破! |r" ) ) + "|c00FF0000愛與和平最後防線已經被破壞，大家拿出必死決心抗戰吧！|r" ) )
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call CreateItemLoc( 'ankh', GetRectCenter(gg_rct________056) )
        call SetPlayerTechResearchedSwap( 'R00P', 1, Player(0) )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1959" )
    else
    endif
    if ( Trig_Tower_Broken_Func005C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( GetUnitName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + " 擊破! |r" ) ) + "|c0000FF00去死去死團最後防線已經被破壞，大家拿出必死決心抗戰吧！|r" ) )
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call CreateItemLoc( 'ankh', GetRectCenter(gg_rct________056) )
        call SetPlayerTechResearchedSwap( 'R00P', 1, Player(6) )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_2235" )
    else
    endif
    if ( Trig_Tower_Broken_Func006C() ) then
        call PlaySoundBJ( gg_snd_ClanInvitation )
        set udg_iTowerBoken[1] = ( udg_iTowerBoken[1] + 1 )
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call DisplayTextToForce( GetPlayersAll(), ( ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( GetUnitName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + " 擊破! |r" ) ) + "|c00FF0000愛與和平守護塔被攻陷！各單位請增加守備！|r" ) )
        if ( Trig_Tower_Broken_Func006Func006C() ) then
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8660" )
        else
            if ( Trig_Tower_Broken_Func006Func006Func001C() ) then
                call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8659" )
            else
                if ( Trig_Tower_Broken_Func006Func006Func001Func001C() ) then
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8658" )
                else
                endif
            endif
        endif
        if ( Trig_Tower_Broken_Func006Func007C() ) then
            call TriggerSleepAction( 2 )
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8536" )
            set bj_forLoopAIndex = 7
            set bj_forLoopAIndexEnd = 12
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call AdjustPlayerStateBJ( 100, ConvertedPlayer(GetForLoopIndexA()), PLAYER_STATE_RESOURCE_LUMBER )
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
        endif
    else
    endif
    if ( Trig_Tower_Broken_Func007C() ) then
        call PlaySoundBJ( gg_snd_ClanInvitation )
        set udg_iTowerBoken[2] = ( udg_iTowerBoken[2] + 1 )
        call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetTriggerUnit()), 10.00 )
        call DisplayTextToForce( GetPlayersAll(), ( ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( GetUnitName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + " 擊破! |r" ) ) + "|c0000FF00去死去死團守護塔被攻陷！各單位請增加守備！|r" ) )
        if ( Trig_Tower_Broken_Func007Func006C() ) then
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8555" )
        else
            if ( Trig_Tower_Broken_Func007Func006Func001C() ) then
                call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8656" )
            else
                if ( Trig_Tower_Broken_Func007Func006Func001Func001C() ) then
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8657" )
                else
                endif
            endif
        endif
        if ( Trig_Tower_Broken_Func007Func007C() ) then
            call TriggerSleepAction( 2 )
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8538" )
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = 6
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call AdjustPlayerStateBJ( 100, ConvertedPlayer(GetForLoopIndexA()), PLAYER_STATE_RESOURCE_LUMBER )
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
        endif
    else
    endif
    if ( Trig_Tower_Broken_Func008C() ) then
        set udg_KeroroCheck[1] = true
    else
    endif
    if ( Trig_Tower_Broken_Func009C() ) then
        set udg_KeroroCheck[2] = true
    else
    endif
endfunction

