//
// 電腦移動AI
//===========================================================================
function Trig_NoticeAI_Func001Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_NOTICE])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_NOTICE]) <= 50.00 ) ) then
        return false
    endif
    if ( not ( GetAIDifficulty(ConvertedPlayer(udg_AI_NOTICE)) != AI_DIFFICULTY_NEWBIE ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001Func001Func001C takes nothing returns boolean
    if ( not Trig_NoticeAI_Func001Func001Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001Func002Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_NOTICE])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001Func002Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_NOTICE]) <= 50.00 ) ) then
        return false
    endif
    if ( not ( GetAIDifficulty(ConvertedPlayer(udg_AI_NOTICE)) != AI_DIFFICULTY_NEWBIE ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001Func002Func001C takes nothing returns boolean
    if ( not Trig_NoticeAI_Func001Func002Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), Player(0)) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoticeAI_Actions takes nothing returns nothing
    if ( Trig_NoticeAI_Func001C() ) then
        set udg_AI_NOTICE = 8
        loop
            exitwhen udg_AI_NOTICE > 12
            if ( Trig_NoticeAI_Func001Func002Func001C() ) then
                if ( Trig_NoticeAI_Func001Func002Func001Func002C() ) then
                    call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_NOTICE], GetLearnedSkillBJ() )
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_NOTICE], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                else
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_NOTICE], "attack", GetRectCenter(gg_rct_LoveFinal) )
                endif
            else
            endif
            set udg_AI_NOTICE = udg_AI_NOTICE + 1
        endloop
    else
        set udg_AI_NOTICE = 2
        loop
            exitwhen udg_AI_NOTICE > 6
            if ( Trig_NoticeAI_Func001Func001Func001C() ) then
                if ( Trig_NoticeAI_Func001Func001Func001Func002C() ) then
                    call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_NOTICE], GetLearnedSkillBJ() )
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_NOTICE], "move", GetRectCenter(gg_rct_LoveHeroPoint) )
                else
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_NOTICE], "attack", GetRectCenter(gg_rct_GoDieFinal) )
                endif
            else
            endif
            set udg_AI_NOTICE = udg_AI_NOTICE + 1
        endloop
    endif
endfunction

