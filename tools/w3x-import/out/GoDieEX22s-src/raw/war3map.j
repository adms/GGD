    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_GaShoUnit))] == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_GoldDragonEatedUnit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoldDrgan_Effect_Func013C takes nothing returns boolean
    if ( not ( udg_KnockBack_Index >= 20 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoldDrgan_Effect_Actions takes nothing returns nothing
    set udg_KnockBack_Index = ( udg_KnockBack_Index + 1 )
    set udg_P1 = GetUnitLoc(udg_KnockBack_Target)
    set udg_P2 = PolarProjectionBJ(udg_P1, 50.00, udg_KnockBack_Angle)
    call SetUnitPositionLoc( udg_KnockBack_Target, udg_P2 )
    call EnumDestructablesInCircleBJ( 300.00, GetUnitLoc(udg_KnockBack_Target), function Trig_GoldDrgan_Effect_Func005A )
    set udg_P3 = GetUnitLoc(udg_KnockBack_Target)
    call AddSpecialEffectLocBJ( udg_P1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_GoldDrgan_Effect_Func009C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_KnockBack_Target, udg_P1 )
        call AddSpecialEffectLocBJ( udg_P1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_P2, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_P1, 378.00, 378.00)), function Trig_GoldDrgan_Effect_Func009Func007A )
        if ( Trig_GoldDrgan_Effect_Func009Func008C() ) then
            set udg_GoldDragonExtraAtk = ( R2I(GetUnitStateSwap(UNIT_STATE_MANA, udg_GoldDragonEatedUnit)) / 50 )
            set udg_GoldDragonExtraAtk = ( udg_GoldDragonExtraAtk + 1 )
            if ( Trig_GoldDrgan_Effect_Func009Func008Func003001() ) then
                set udg_GoldDragonExtraAtk = 21
            else
                call DoNothing(  )
            endif
            call SetUnitManaBJ( udg_GoldDragonEatedUnit, 0 )
            if ( Trig_GoldDrgan_Effect_Func009Func008Func005C() ) then
                call CreateNUnitsAtLoc( 1, 'h01K', Player(0), GetUnitLoc(udg_GoldDragonEatedUnit), GetUnitFacing(udg_GaShoUnit) )
            else
                call CreateNUnitsAtLoc( 1, 'h01K', Player(6), GetUnitLoc(udg_GoldDragonEatedUnit), GetUnitFacing(udg_GaShoUnit) )
            endif
            set udg_GoldDragonUnit = GetLastCreatedUnit()
            call SetUnitAbilityLevelSwapped( 'A0ZW', udg_GoldDragonUnit, udg_GoldDragonExtraAtk )
            call SetUnitFacingToFaceUnitTimed( GetLastCreatedUnit(), udg_GoldDragonEatedUnit, 0 )
            call UnitAddItemByIdSwapped( 'gsou', udg_GoldDragonUnit )
            call UnitUseItemTarget( udg_GoldDragonUnit, GetLastCreatedItem(), udg_GoldDragonEatedUnit )
            call TriggerSleepAction( 0.01 )
            call RemoveItem( GetLastCreatedItem() )
            call TriggerSleepAction( 20.00 )
            call KillUnit( udg_GoldDragonUnit )
        else
        endif
    else
    endif
    call RemoveLocation( udg_P1 )
    call RemoveLocation( udg_P2 )
    call RemoveLocation( udg_P3 )
    if ( Trig_GoldDrgan_Effect_Func013C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        if ( Trig_GoldDrgan_Effect_Func013Func002C() ) then
            set udg_GoldDragonExtraAtk = ( R2I(GetUnitStateSwap(UNIT_STATE_MANA, udg_GoldDragonEatedUnit)) / 50 )
            set udg_GoldDragonExtraAtk = ( udg_GoldDragonExtraAtk + 1 )
            if ( Trig_GoldDrgan_Effect_Func013Func002Func003001() ) then
                set udg_GoldDragonExtraAtk = 21
            else
                call DoNothing(  )
            endif
            call SetUnitManaBJ( udg_GoldDragonEatedUnit, 0 )
            if ( Trig_GoldDrgan_Effect_Func013Func002Func005C() ) then
                call CreateNUnitsAtLoc( 1, 'h01K', Player(0), GetUnitLoc(udg_GoldDragonEatedUnit), GetUnitFacing(udg_GaShoUnit) )
            else
                call CreateNUnitsAtLoc( 1, 'h01K', Player(6), GetUnitLoc(udg_GoldDragonEatedUnit), GetUnitFacing(udg_GaShoUnit) )
            endif
            set udg_GoldDragonUnit = GetLastCreatedUnit()
            call SetUnitAbilityLevelSwapped( 'A0ZW', udg_GoldDragonUnit, udg_GoldDragonExtraAtk )
            call SetUnitFacingToFaceUnitTimed( GetLastCreatedUnit(), udg_GoldDragonEatedUnit, 0 )
            call UnitAddItemByIdSwapped( 'gsou', udg_GoldDragonUnit )
            call UnitUseItemTarget( udg_GoldDragonUnit, GetLastCreatedItem(), udg_GoldDragonEatedUnit )
            call TriggerSleepAction( 0.01 )
            call RemoveItem( GetLastCreatedItem() )
            call TriggerSleepAction( 20.00 )
            call KillUnit( udg_GoldDragonUnit )
        else
        endif
    else
    endif
endfunction

