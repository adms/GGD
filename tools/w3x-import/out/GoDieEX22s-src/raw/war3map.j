//===========================================================================
// Trigger: HeavenSword
//===========================================================================
function Trig_HeavenSword_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == gg_unit_nitb_0192 ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetAttacker(), 'ankh') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeavenSword_Func005C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetAttacker()), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeavenSword_Actions takes nothing returns nothing
    call RemoveItem( GetItemOfTypeFromUnitBJ(GetAttacker(), 'ankh') )
    call DisableTrigger( GetTriggeringTrigger() )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_4055" )
    set udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))] = GetAttacker()
    if ( Trig_HeavenSword_Func005C() ) then
        set udg_LevelUpCount = 2
        loop
            exitwhen udg_LevelUpCount > 6
            call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
            call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
            set udg_LevelUpCount = udg_LevelUpCount + 1
        endloop
    else
        set udg_LevelUpCount = 8
        loop
            exitwhen udg_LevelUpCount > 12
            call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
            call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
            set udg_LevelUpCount = udg_LevelUpCount + 1
        endloop
    endif
    call KillUnit( GetTriggerUnit() )
    call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetAttacker())) + "完成天堂之劍任務|r" ) ) )
    call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetAttacker())) + "同盟獲得500賞金以及提升等級！|r" ) ) )
    call PlaySoundBJ( gg_snd_GoodJob )
    call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))] + "獲得新稱號!" ) )
    set udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))] = "|c20FF0000(飛上天的)|r"
    call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) ) )
endfunction

