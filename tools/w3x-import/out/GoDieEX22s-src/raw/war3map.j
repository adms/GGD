//===========================================================================
// Trigger: fastStepGo
//===========================================================================
function Trig_fastStepGo_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_AFuUnit ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetOrderTargetUnit())) < 1800.00 ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(udg_AFuUnit) != String2OrderIdBJ("entanglingroots") ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(udg_AFuUnit) != String2OrderIdBJ("hex") ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(udg_AFuUnit) != String2OrderIdBJ("unholyfrenzy") ) ) then
        return false
    endif
    return true
endfunction

function Trig_fastStepGo_Func001C takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_AFuUnit))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_fastStepGo_Actions takes nothing returns nothing
    if ( Trig_fastStepGo_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'o011', GetOwningPlayer(udg_AFuUnit), GetUnitLoc(udg_AFuUnit), GetRandomDirectionDeg() )
        call ShowUnitHide( GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A10T', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A10T', GetLastCreatedUnit(), 21 )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        call TerrainDeformationRippleBJ( 5.00, true, udg_RabTarget, 50.00, 340.00, 88.00, 1, 180.00 )
        call EnableWeatherEffect( GetLastCreatedWeatherEffect(), true )
        call PlaySoundAtPointBJ( gg_snd_GlueScreenMeteorHit1, 100, udg_RabTarget, 0 )
    else
    endif
    call SetUnitPositionLoc( GetTriggerUnit(), GetUnitLoc(GetOrderTargetUnit()) )
    call PlaySoundOnUnitBJ( gg_snd_GryphonRiderMissileLaunch3, 100.00, udg_AFuUnit )
endfunction

//===========================================================================
function InitTrig_fastStepGo takes nothing returns nothing
    set gg_trg_fastStepGo = CreateTrigger(  )
    call DisableTrigger( gg_trg_fastStepGo )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_fastStepGo, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER )
    call TriggerAddCondition( gg_trg_fastStepGo, Condition( function Trig_fastStepGo_Conditions ) )
    call TriggerAddAction( gg_trg_fastStepGo, function Trig_fastStepGo_Actions )
endfunction

