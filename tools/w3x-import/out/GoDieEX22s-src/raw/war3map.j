//===========================================================================
// Trigger: Saber_in_panda
//===========================================================================
function Trig_Saber_in_panda_Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( udg_PlayerTruthName[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == "Saber_in_panda" ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E00R' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Saber_in_panda_Conditions takes nothing returns boolean
    if ( not Trig_Saber_in_panda_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Saber_in_panda_Actions takes nothing returns nothing
    call DestroyTrigger(GetTriggeringTrigger())
    call DisableTrigger( GetTriggeringTrigger() )
    call ReplaceUnitBJ( GetTriggerUnit(), 'H02K', bj_UNIT_STATE_METHOD_RELATIVE )
    set udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = GetLastReplacedUnitBJ()
    call UnitAddAbilityBJ( 'A0UR', GetTriggerUnit() )
    set udg_DES_init_counter = 20
    loop
        exitwhen udg_DES_init_counter > 22
        call TriggerRegisterUnitEvent( udg_Des_BuffTri[udg_DES_init_counter], GetLastReplacedUnitBJ(), EVENT_UNIT_DAMAGED )
        set udg_DES_init_counter = udg_DES_init_counter + 1
    endloop
    set udg_DES_init_counter = 20
    loop
        exitwhen udg_DES_init_counter > 22
        call TriggerRegisterUnitEvent( udg_Des_UtypTri[udg_DES_init_counter], GetLastReplacedUnitBJ(), EVENT_UNIT_DAMAGED )
        set udg_DES_init_counter = udg_DES_init_counter + 1
    endloop
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_2619" )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_9377" )
endfunction

