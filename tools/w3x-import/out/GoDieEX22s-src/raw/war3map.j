//===========================================================================
// Trigger: PowerKnockBack Effect
//
// 
//===========================================================================
function Trig_PowerKnockBack_Effect_Func005A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_PowerKnockBack_Effect_Func009Func007Func001Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_RabUnitx)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_PowerKnockBack_Effect_Func009Func007Func001C takes nothing returns boolean
    if ( not Trig_PowerKnockBack_Effect_Func009Func007Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_PowerKnockBack_Effect_Func009Func007A takes nothing returns nothing
    if ( Trig_PowerKnockBack_Effect_Func009Func007Func001C() ) then
        call UnitDamageTargetBJ( udg_RabUnit, GetEnumUnit(), I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_RabUnitx, true) * 3 )), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_PowerKnockBack_Effect_Func009C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_PP2, udg_PP3) > 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PowerKnockBack_Effect_Func010C takes nothing returns boolean
    if ( not ( udg_PKnockBack_Index >= 20 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PowerKnockBack_Effect_Actions takes nothing returns nothing
    set udg_PKnockBack_Index = ( udg_PKnockBack_Index + 1 )
    set udg_PP1 = GetUnitLoc(udg_PKnockBack_Target)
    set udg_PP2 = PolarProjectionBJ(udg_PP1, 40.00, udg_PKnockBack_Angle)
    call SetUnitPositionLoc( udg_PKnockBack_Target, udg_PP2 )
    call EnumDestructablesInCircleBJ( 300.00, GetUnitLoc(udg_PKnockBack_Target), function Trig_PowerKnockBack_Effect_Func005A )
    set udg_PP3 = GetUnitLoc(udg_PKnockBack_Target)
    call AddSpecialEffectLocBJ( udg_PP1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_PowerKnockBack_Effect_Func009C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_PKnockBack_Target, udg_PP1 )
        call AddSpecialEffectLocBJ( udg_PP1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_PP2, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(udg_PP1, 300.00, 300.00)), function Trig_PowerKnockBack_Effect_Func009Func007A )
    else
    endif
    if ( Trig_PowerKnockBack_Effect_Func010C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

