//===========================================================================
// Trigger: CreepRevive
//
// 目前CP怪復活公式為15*Lv + 30
//===========================================================================
//TESH.scrollpos=35
//TESH.alwaysfold=0
//設定加入條件
function Trig_CreepRevive_Func001Func001C takes nothing returns boolean
//忽略掉非中立敵對之部隊,英雄,建築以及泰坦,龍龜,殭屍王
    if ( not ( IsUnitAlly(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'nfgl' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'ntrd' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'n002' ) ) then
        return false
    endif
    return true
endfunction

function CreepDeadAction takes nothing returns nothing
    local unit u1
    local integer uty
    local trigger trg
    local triggeraction trgact
    local real locX
    local real locY
    local integer LevelInt

    set u1 = GetTriggerUnit()
    set LevelInt = GetUnitLevel(GetTriggerUnit())
    set uty = ChooseRandomCreepBJ(LevelInt)
    set trg = GetTriggeringTrigger()
    set trgact = GetHandleTriggerAction( trg, "CreepReviveAct" )
    set locX = GetHandleReal( trg, "CreepReviseLocX" )
    set locY = GetHandleReal( trg, "CreepReviseLocY" )
    call FlushHandleLocals( trg )

//設定CP怪復活時間
    call PolledWait( I2R(GetUnitLevel(u1)) * 15.0 + 30 )

    set udg_CreepUnit = CreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), uty, locX, locY, bj_UNIT_FACING )

//設定寶箱產生機率
    if ( GetRandomInt(1, 30) == 15 ) then
        call CreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'h01W', locX, locY, bj_UNIT_FACING )
    endif
    call ExecuteFunc("AddCreeptoRevive")
    call TriggerRemoveAction( trg, trgact )
    call DestroyTrigger( trg )

    set u1 = null
    set trg = null
    set trgact = null
    
endfunction


//註冊CP怪死亡事件
function AddCreeptoRevive takes nothing returns nothing
    local unit u1 = udg_CreepUnit
    local trigger trg
    local triggeraction trgact

    set trg = CreateTrigger()
    set trgact = TriggerAddAction( trg, function CreepDeadAction )
    call TriggerRegisterUnitEvent( trg, u1, EVENT_UNIT_DEATH )

    call SetHandleTriggerAction( trg, "CreepReviveAct", trgact )
    call SetHandleReal( trg, "CreepReviseLocX", GetUnitX(u1) )
    call SetHandleReal( trg, "CreepReviseLocY", GetUnitY(u1) )

    set u1 = null
    set trg = null
    set trgact = null
    
endfunction

//初始化加入事件
function Trig_CreepRevive_Func001A takes nothing returns nothing
    if ( Trig_CreepRevive_Func001Func001C() ) then
        set udg_CreepUnit = GetEnumUnit()
        call ExecuteFunc("AddCreeptoRevive")
    endif
endfunction

function Trig_CreepRevive_Actions takes nothing returns nothing
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_CreepRevive_Func001A )
endfunction

//===========================================================================
function InitTrig_CreepRevive takes nothing returns nothing
    set gg_trg_CreepRevive = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_CreepRevive, 0.00 )
