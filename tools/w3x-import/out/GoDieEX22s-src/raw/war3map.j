function Trig_HeroDead_Actions takes nothing returns nothing
    if ( Trig_HeroDead_Func001C() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_6870" )
        call ModifyHeroStat( bj_HEROSTAT_STR, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 3 )
        call ModifyHeroStat( bj_HEROSTAT_AGI, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 3 )
        call ModifyHeroStat( bj_HEROSTAT_INT, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 3 )
    else
        call DoNothing(  )
    endif
    if ( Trig_HeroDead_Func002C() ) then
        call AdjustPlayerStateBJ( ( GetHeroLevel(GetTriggerUnit()) * 40 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    else
        call DoNothing(  )
    endif
    if ( Trig_HeroDead_Func003C() ) then
        call PlaySoundBJ( gg_snd_nog )
        set udg_KillKiller = ( 350 * udg_KillerNumber )
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( " 解決了殺人魔 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(udg_Killer))] + ( "獲得額外賞金 " + I2S(udg_KillKiller) ) ) ) ) )
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "你真是好人阿!!" ) )
        call AdjustPlayerStateBJ( udg_KillKiller, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    else
    endif
    if ( Trig_HeroDead_Func004C() ) then
        set udg_KillerNumber = ( udg_KillerNumber + 1 )
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( " 連殺了 " + ( I2S(udg_KillerNumber) + "人!" ) ) ) )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_023" )
        if ( Trig_HeroDead_Func004Func006C() ) then
            call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "獲得新稱號!" ) )
            set udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = "|c00EFF000(變態殺人王)|r"
            call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) ) )
        else
        endif
    else
        set udg_Killer = GetKillingUnitBJ()
        set udg_KillerNumber = 1
    endif
    if ( Trig_HeroDead_Func005C() ) then
        call PlaySoundBJ( gg_snd_4die )
        // 漂浮文字
        call CreateTextTagUnitBJ( "TRIGSTR_4270", GetTriggerUnit(), 0, 20.00, 100, 100.00, 100.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    else
    endif
    set udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = GetTriggerUnit()
    set udg_HeroDie[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_HeroDie[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
    if ( Trig_HeroDead_Func008C() ) then
        set udg_ReviveNumbet = ( I2R(GetHeroLevel(GetTriggerUnit())) * udg_Hero_Revive_Time_FactorRed )
        set udg_ReviveNumbet = ( udg_ReviveNumbet * 1.30 )
        call StartTimerBJ( udg_Timer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, udg_ReviveNumbet )
    else
        set udg_ReviveNumbet = ( I2R(GetHeroLevel(GetTriggerUnit())) * udg_Hero_Revive_Time_FactorGreen )
        set udg_ReviveNumbet = ( udg_ReviveNumbet * 1.30 )
        call StartTimerBJ( udg_Timer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, udg_ReviveNumbet )
    endif
    if ( Trig_HeroDead_Func009C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( "死神之眼釋放了" + GetUnitName(GetTriggerUnit()) ) )
        set udg_DeathUnit = null
    else
    endif
    if ( Trig_HeroDead_Func010C() ) then
        set udg_HeroKill[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_HeroKill[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 1 )
    else
    endif
    call DisplayTextToForce( GetPlayersAll(), ( ( "玩家 " + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + ( " 的英雄 " + ( GetUnitName(GetTriggerUnit()) + ( " 醬爆了,需要 " + ( R2S(udg_ReviveNumbet) + "秒復原" ) ) ) ) ) )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(600.00, GetUnitLoc(GetDyingUnit())), function Trig_HeroDead_Func012A )
    if ( Trig_HeroDead_Func013C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))] + "獲得新稱號!" ) )
        set udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))] = "|c00EFF000(/-_-)/ ~ ╧╧)|r"
        call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) ) )
    else
    endif
    if ( Trig_HeroDead_Func014C() ) then
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "獲得新稱號!" ) )
        set udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = "|c00EFF000(神人般)|r"
