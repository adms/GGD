function Trig_Begining_Item_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Begining_Item_Func001Func010Func007C takes nothing returns boolean
    if ( ( IsUnitAlly(GetTriggerUnit(), Player(0)) == true ) ) then
        return true
    endif
    if ( ( IsUnitAlly(GetTriggerUnit(), Player(6)) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Begining_Item_Func001Func010C takes nothing returns boolean
    if ( not ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) != udg_fucker ) ) then
        return false
    endif
    if ( not ( udg_BeginingItem[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == true ) ) then
        return false
    endif
    if ( not ( udg_IsSingleGame == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'U01F' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'O02P' ) ) then
        return false
    endif
    if ( not ( udg_PlayerTruthName[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] != "Saber_in_panda" ) ) then
        return false
    endif
    if ( not Trig_Begining_Item_Func001Func010Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Begining_Item_Func001C takes nothing returns boolean
    if ( not Trig_Begining_Item_Func001Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_Begining_Item_Func002Func003C takes nothing returns boolean
    if ( not ( udg_BeginingItem[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == false ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) != MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Begining_Item_Func002C takes nothing returns boolean
    if ( not Trig_Begining_Item_Func002Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Begining_Item_Actions takes nothing returns nothing
    if ( Trig_Begining_Item_Func001C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( "|c00ff0000操你媽的垃圾人 " + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + " 請不要智障選雙英雄!|r" ) ) )
        call SetPlayerStateBJ( GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_GAME_RESULT, -10000000 )
    else
    endif
    if ( Trig_Begining_Item_Func002C() ) then
        set udg_BeginingItem[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
        call DialogDisplayBJ( true, udg_InitialMode, GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
endfunction

