    set gg_trg_HolySword = CreateTrigger(  )
    call DisableTrigger( gg_trg_HolySword )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_HolySword, EVENT_PLAYER_UNIT_SPELL_EFFECT )
