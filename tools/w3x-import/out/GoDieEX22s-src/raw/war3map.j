        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_EarthBoomCheck_Func002Func002Func001Func001Func004C() ) then
            call UnitDamageTargetBJ( udg_PuUnit, GetEnumUnit(), ( udg_EarthDamage * 0.75 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        else
            call UnitDamageTargetBJ( udg_PuUnit, GetEnumUnit(), udg_EarthDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        endif
    else
        call DoNothing(  )
    endif
