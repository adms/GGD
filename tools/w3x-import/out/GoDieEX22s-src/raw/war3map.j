//===========================================================================
// Trigger: GiveMeHoney KB
//===========================================================================
function Trig_GiveMeHoney_KB_Func008Func001C takes nothing returns boolean
    if ( ( DistanceBetweenPoints(udg_Bear_P2, udg_Bear_P3) > 8.00 ) ) then
        return true
    endif
    if ( ( udg_Bear_Index2 >= 20 ) ) then
        return true
    endif
    return false
endfunction

function Trig_GiveMeHoney_KB_Func008C takes nothing returns boolean
    if ( not Trig_GiveMeHoney_KB_Func008Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_GiveMeHoney_KB_Actions takes nothing returns nothing
    set udg_Bear_Index2 = ( udg_Bear_Index2 + 1 )
    set udg_Bear_P1 = GetUnitLoc(udg_Bear_target)
    set udg_Bear_P2 = PolarProjectionBJ(udg_Bear_P1, 50.00, udg_Bear_Angle)
    call SetUnitPositionLoc( udg_Bear_target, udg_Bear_P2 )
    set udg_Bear_P3 = GetUnitLoc(udg_Bear_target)
    call AddSpecialEffectLocBJ( udg_Bear_P1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_GiveMeHoney_KB_Func008C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_Bear_target, udg_Bear_P1 )
        call AddSpecialEffectLocBJ( udg_Bear_P1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Bear_P2, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitTimeScalePercent( udg_Bear_target, 100.00 )
    else
    endif
    call RemoveLocation( udg_Bear_P1 )
    call RemoveLocation( udg_Bear_P2 )
    call RemoveLocation( udg_Bear_P3 )
endfunction

