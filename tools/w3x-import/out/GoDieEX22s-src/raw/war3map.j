//===========================================================================
// Trigger: LightFire
//===========================================================================
function Trig_LightFire_Func010Func005A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
    call GroupClear( udg_NegiGroup )
endfunction

function Trig_LightFire_Func010Func006A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_LightFire_Func010Func007A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_LightFire_Func010C takes nothing returns boolean
    if ( not ( udg_LightArrowAccountTemp <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LightFire_Actions takes nothing returns nothing
    set udg_NegiPoint = PolarProjectionBJ(udg_NegiMasterPoint, GetRandomReal(0.00, 200.00), GetRandomDirectionDeg())
    call CreateNUnitsAtLoc( 1, 'o02I', GetOwningPlayer(udg_NegiUnit), udg_NegiPoint, bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_NegiGroup )
    call ShowUnitHide( GetLastCreatedUnit() )
    call SetUnitFlyHeightBJ( GetLastCreatedUnit(), GetRandomReal(50.00, 150.00), 0.00 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_NegiCastUnit )
    call RemoveLocation( udg_NegiPoint )
    set udg_LightArrowAccountTemp = ( udg_LightArrowAccountTemp - 1 )
    if ( Trig_LightFire_Func010C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_LightArrowAccount = 0
        call RemoveLocation( udg_NegiMasterPoint )
        call TriggerSleepAction( 1.00 )
        call ForGroupBJ( udg_NegiGroup, function Trig_LightFire_Func010Func005A )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_NegiUnit), 'o02I'), function Trig_LightFire_Func010Func006A )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_NegiUnit), 'u014'), function Trig_LightFire_Func010Func007A )
    else
    endif
endfunction

