    set gg_trg_Run_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_Run_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Run_Effect, 0.04 )
    call TriggerAddAction( gg_trg_Run_Effect, function Trig_Run_Effect_Actions )
endfunction

