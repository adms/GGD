    call IssuePointOrderLocBJ( udg_AKTSpecialUnit[8], "move", PolarProjectionBJ(udg_AKTCastPoint, 200.00, ( udg_AKTJumpAngle - 135.00 )) )
    call UnitAddAbilityBJ( 'A0C0', udg_AKTSpecialUnit[8] )
    call SetUnitAbilityLevelSwapped( 'A0C0', udg_AKTSpecialUnit[8], 3 )
    call TriggerSleepAction( 0.50 )
    set udg_AKTMoveDis = ( DistanceBetweenPoints(udg_AKTCastPoint, GetUnitLoc(udg_AKTSpecialUnit[8])) / 21.00 )
    call EnableTrigger( gg_trg_AKT_4_Effect )
endfunction

