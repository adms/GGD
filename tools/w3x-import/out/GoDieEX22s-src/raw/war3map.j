//===========================================================================
// Trigger: flunkOutEff
//===========================================================================
function Trig_flunkOutEff_Conditions takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_Pro_FO_target) >= 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_flunkOutEff_Actions takes nothing returns nothing
    set udg_Pro_FO_int = ( GetHeroLevel(udg_Pro_FO_target) - 3 )
    call SetHeroLevelBJ( udg_Pro_FO_target, 1, false )
    call SetHeroLevelBJ( udg_Pro_FO_target, udg_Pro_FO_int, false )
    call PauseTimerBJ( true, udg_Pro_FO_timer )
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

