    set gg_trg_RandomKillHero = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_RandomKillHero, udg_TargetKillHreoTimer )
    call TriggerAddAction( gg_trg_RandomKillHero, function Trig_RandomKillHero_Actions )
endfunction

//===========================================================================
// Trigger: HatredSystem
//===========================================================================
function Trig_HatredSystem_Func006Func008C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(3) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(7) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(8) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(9) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(10) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(11) ) ) then
        return true
    endif
    return false
endfunction

function Trig_HatredSystem_Func006C takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) != Player(0) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) != Player(6) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != Player(0) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != Player(6) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not Trig_HatredSystem_Func006Func008C() ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != GetOwningPlayer(GetDyingUnit()) ) ) then
        return false
    endif
    if ( not ( GetKillingUnitBJ() != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_HatredSystem_Conditions takes nothing returns boolean
    if ( not Trig_HatredSystem_Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_HatredSystem_Func002C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_TargetKillHero ) ) then
        return false
    endif
    return true
endfunction

function Trig_HatredSystem_Actions takes nothing returns nothing
    // 積分系統- 星人
    if ( Trig_HatredSystem_Func002C() ) then
        set udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( GetHeroLevel(GetDyingUnit()) + ( udg_HatredValues[( ( GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) * 13 ) + GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit())) )] * 5 ) ) )
        call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(udg_TargetKillHero))] + ( "星人已被消滅!!　獵殺者" + ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( "獲得額外獎勵" + "" ) ) ) ) )
        call AdjustPlayerStateBJ( ( udg_MaxPoint * ( 35 + 0 ) ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
        call AdjustPlayerStateBJ( 150, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_LUMBER )
        call TriggerExecute( gg_trg_RandomKillHero )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], I2S(udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
    else
    endif
    // 仇恨值, 把二維陣列轉為一維使用
    set udg_HatredValues[( ( GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit())) * 13 ) + GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) )] = ( udg_HatredValues[( ( GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit())) * 13 ) + GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) )] + 1 )
    set udg_HatredValues[( ( GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) * 13 ) + GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit())) )] = 0
endfunction

//===========================================================================
function InitTrig_HatredSystem takes nothing returns nothing
    set gg_trg_HatredSystem = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_HatredSystem, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_HatredSystem, Condition( function Trig_HatredSystem_Conditions ) )
    call TriggerAddAction( gg_trg_HatredSystem, function Trig_HatredSystem_Actions )
endfunction

