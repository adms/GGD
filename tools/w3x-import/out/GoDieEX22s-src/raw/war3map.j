                            endif
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        endif
    else
    endif
    call DisplayTextToForce( GetPlayersAllies(GetTriggerPlayer()), ( ( "" + udg_Borad_PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())] ) + ": 大家請向左路進攻！" ) )
    call AdjustPlayerStateBJ( -100, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
endfunction

