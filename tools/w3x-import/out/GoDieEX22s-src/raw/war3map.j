function Trig_WolfStrikeEffect_Func012C takes nothing returns boolean
    if ( not ( udg_KnockBack_IndexWolf >= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WolfStrikeEffect_Actions takes nothing returns nothing
    call SetUnitFacingTimed( udg_KnockBack_TargetWolf, ( GetUnitFacing(udg_KnockBack_TargetWolf) + 195.00 ), 0 )
    set udg_KnockBack_IndexWolf = ( udg_KnockBack_IndexWolf + 1 )
    set udg_P1Wolf = GetUnitLoc(udg_KnockBack_TargetWolf)
    set udg_P2Wolf = PolarProjectionBJ(udg_P1Wolf, 50.00, udg_KnockBack_AngleWolf)
    call SetUnitPositionLoc( udg_KnockBack_TargetWolf, udg_P2Wolf )
    call SetUnitAnimation( udg_KnockBack_TargetWolf, "attack" )
    call EnumDestructablesInCircleBJ( 350.00, GetUnitLoc(udg_KnockBack_TargetWolf), function Trig_WolfStrikeEffect_Func007A )
    call PlaySoundOnUnitBJ( gg_snd_DruidOfTheTalonMissileLaunch2, 50.00, udg_WolfUnit )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_P1Wolf), function Trig_WolfStrikeEffect_Func009A )
    call AddSpecialEffectLocBJ( udg_P2Wolf, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_WolfStrikeEffect_Func012C() ) then
        call ForGroupBJ( udg_WolfGroup, function Trig_WolfStrikeEffect_Func012Func001A )
        call GroupClear( udg_WolfGroup )
        call SetUnitPositionLoc( udg_WolfUnit, udg_P2Wolf )
        call ShowUnitShow( udg_WolfUnit )
        call SelectUnitForPlayerSingle( udg_WolfUnit, GetOwningPlayer(udg_WolfUnit) )
        call KillUnit( udg_KnockBack_TargetWolf )
        call RemoveUnit( udg_KnockBack_TargetWolf )
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
    call RemoveLocation( udg_P1Wolf )
    call RemoveLocation( udg_P2Wolf )
    call RemoveLocation( udg_P3Wolf )
endfunction

//===========================================================================
function InitTrig_WolfStrikeEffect takes nothing returns nothing
    set gg_trg_WolfStrikeEffect = CreateTrigger(  )
    call DisableTrigger( gg_trg_WolfStrikeEffect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_WolfStrikeEffect, 0.05 )
    call TriggerAddAction( gg_trg_WolfStrikeEffect, function Trig_WolfStrikeEffect_Actions )
endfunction

