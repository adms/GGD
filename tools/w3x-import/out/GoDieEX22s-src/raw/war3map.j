    if ( not ( IsPlayerInForce(GetTriggerPlayer(), udg_PlayersSentinel) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Player_Leaves_Game_Func007C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(GetTriggerPlayer()) != PLAYER_SLOT_STATE_LEFT ) ) then
        return false
    endif
    return true
endfunction

function Trig_Player_Leaves_Game_Actions takes nothing returns nothing
    call MultiboardDisplayBJ( true, GetLastCreatedMultiboard() )
    set udg_TempRandomNumber = GetRandomInt(1, 4)
    if ( Trig_Player_Leaves_Game_Func003C() ) then
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_WARNING, ( GetPlayerName(GetTriggerPlayer()) + " 覺得自己太弱，先去單機練習了！" ) )
    else
        if ( Trig_Player_Leaves_Game_Func003Func002C() ) then
            call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_WARNING, ( ( "你看到 " + GetPlayerName(GetTriggerPlayer()) ) + " 的中離其實是幻覺！是幻覺！絕對是幻覺！" ) )
        else
            if ( Trig_Player_Leaves_Game_Func003Func002Func001C() ) then
                call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_WARNING, ( ( "小妹妹 " + GetPlayerName(GetTriggerPlayer()) ) + " 玩洋娃娃的時間到了，先走一步，大家繼續唷！" ) )
            else
                call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_WARNING, ( ( "腳殘的 " + GetPlayerName(GetTriggerPlayer()) ) + "不小心踢到網路線，所以不小心中離了！" ) )
            endif
        endif
    endif
    if ( Trig_Player_Leaves_Game_Func004C() ) then
        set udg_TempInteger = ( ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) / CountPlayersInForceBJ(udg_PlayersSentinelPlaying) ) + 1 )
        call ForceRemovePlayerSimple( GetTriggerPlayer(), udg_PlayersSentinelPlaying )
        call ForForce( udg_PlayersSentinelPlaying, function Trig_Player_Leaves_Game_Func004Func006A )
    else
        set udg_TempInteger = ( ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) / CountPlayersInForceBJ(udg_PlayersScourgePlaying) ) + 1 )
        call ForceRemovePlayerSimple( GetTriggerPlayer(), udg_PlayersScourgePlaying )
        call ForForce( udg_PlayersScourgePlaying, function Trig_Player_Leaves_Game_Func004Func004A )
    endif
    if ( Trig_Player_Leaves_Game_Func005C() ) then
        call ForForce( udg_PlayersScourge, function Trig_Player_Leaves_Game_Func005Func001A )
    else
    endif
    if ( Trig_Player_Leaves_Game_Func006C() ) then
        call ForForce( udg_PlayersSentinel, function Trig_Player_Leaves_Game_Func006Func001A )
    else
    endif
    if ( Trig_Player_Leaves_Game_Func007C() ) then
        if ( Trig_Player_Leaves_Game_Func007Func001C() ) then
            call SetForceAllianceStateBJ( GetForceOfPlayer(GetTriggerPlayer()), udg_PlayersSentinel, bj_ALLIANCE_ALLIED_ADVUNITS )
        else
            call SetForceAllianceStateBJ( GetForceOfPlayer(GetTriggerPlayer()), udg_PlayersScourge, bj_ALLIANCE_ALLIED_ADVUNITS )
        endif
    else
    endif
    call MultiboardDisplayBJ( true, GetLastCreatedMultiboard() )
endfunction

