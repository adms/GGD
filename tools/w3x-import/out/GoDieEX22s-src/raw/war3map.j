    set gg_trg_MagicReturn = CreateTrigger(  )
    call DisableTrigger( gg_trg_MagicReturn )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_MagicReturn, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_MagicReturn, Condition( function Trig_MagicReturn_Conditions ) )
    call TriggerAddAction( gg_trg_MagicReturn, function Trig_MagicReturn_Actions )
