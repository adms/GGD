    set gg_trg_stupidStart = CreateTrigger(  )
    call DisableTrigger( gg_trg_stupidStart )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_stupidStart, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_stupidStart, Condition( function Trig_stupidStart_Conditions ) )
    call TriggerAddAction( gg_trg_stupidStart, function Trig_stupidStart_Actions )
