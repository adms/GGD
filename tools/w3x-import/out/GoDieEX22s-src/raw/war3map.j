//===========================================================================
// Trigger: Wind CloseEffect
//===========================================================================
function Trig_Wind_CloseEffect_Func001C takes nothing returns boolean
    if ( not ( udg_WindEffectCount < 60 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wind_CloseEffect_Actions takes nothing returns nothing
    if ( Trig_Wind_CloseEffect_Func001C() ) then
        call SetUnitFacingTimed( udg_Magiccure[1], ( 6.00 * I2R(udg_WindEffectCount) ), 0 )
        call SetUnitFacingTimed( udg_Magiccure[2], ( 360.00 - ( 6.00 * I2R(udg_WindEffectCount) ) ), 0 )
        call SetUnitFlyHeightBJ( udg_Magiccure[1], ( 5.00 * I2R(udg_WindEffectCount) ), 0.00 )
        call SetUnitFlyHeightBJ( udg_Magiccure[2], ( 5.00 * I2R(udg_WindEffectCount) ), 0.00 )
        call SetUnitScalePercent( udg_Magiccure[1], ( ( I2R(udg_WindEffectCount) * 10.00 ) + 100.00 ), 100, 100 )
        call SetUnitVertexColorBJ( udg_Magiccure[1], 100.00, 100.00, 0.00, ( I2R(udg_WindEffectCount) * 1.50 ) )
        call SetUnitScalePercent( udg_Magiccure[2], ( ( I2R(udg_WindEffectCount) * 10.00 ) + 100.00 ), 100, 100 )
        call SetUnitVertexColorBJ( udg_Magiccure[2], 0.00, 100.00, 100.00, ( I2R(udg_WindEffectCount) * 1.50 ) )
        set udg_WindEffectCount = ( udg_WindEffectCount + 1 )
    else
        call DestroyEffectBJ( udg_MagicSpecial[1] )
        set udg_WindEffectCount = 0
        call KillUnit( udg_Magiccure[1] )
        call RemoveUnit( udg_Magiccure[1] )
        call KillUnit( udg_Magiccure[2] )
        call RemoveUnit( udg_Magiccure[2] )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

