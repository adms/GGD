    if ( not ( DistanceBetweenPoints(udg_P2, udg_P3) > 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PowerBack_Effect_Func015C takes nothing returns boolean
    if ( not ( udg_PowerBack_Index >= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PowerBack_Effect_Actions takes nothing returns nothing
    set udg_PowerBack_Index = ( udg_PowerBack_Index + 1 )
    set udg_P1 = GetUnitLoc(udg_PowerBack_Target)
    set udg_P2 = PolarProjectionBJ(udg_P1, 50.00, udg_PowerBack_Angle)
    call SetUnitPositionLoc( udg_PowerBack_Target, udg_P2 )
    call EnumDestructablesInCircleBJ( 300.00, GetUnitLoc(udg_PowerBack_Target), function Trig_PowerBack_Effect_Func005A )
    set udg_P3 = GetUnitLoc(udg_PowerBack_Target)
    call AddSpecialEffectLocBJ( udg_P1, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_PowerBack_Target, "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_PowerBack_Effect_Func011C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_PowerBack_Target, udg_P1 )
        call AddSpecialEffectLocBJ( udg_P2, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    call RemoveLocation( udg_P1 )
    call RemoveLocation( udg_P2 )
    call RemoveLocation( udg_P3 )
    if ( Trig_PowerBack_Effect_Func015C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

