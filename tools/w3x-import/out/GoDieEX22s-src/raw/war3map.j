function InitSounds takes nothing returns nothing
    set gg_snd_4die = CreateSound( "war3mapImported\\4die.mp3", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_4die, 1672 )
    call SetSoundChannel( gg_snd_4die, 0 )
    call SetSoundVolume( gg_snd_4die, 90 )
    call SetSoundPitch( gg_snd_4die, 1.0 )
    set gg_snd_87joke = CreateSound( "war3mapImported\\87joke.Mp3", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_87joke, 7056 )
    call SetSoundChannel( gg_snd_87joke, 0 )
    call SetSoundVolume( gg_snd_87joke, 90 )
    call SetSoundPitch( gg_snd_87joke, 1.0 )
    set gg_snd_AkamaPissed8 = CreateSound( "Units\\Other\\DranaiAkama\\AkamaPissed8.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_AkamaPissed8, "AkamaPissed" )
    call SetSoundDuration( gg_snd_AkamaPissed8, 3471 )
    set gg_snd_AltarOfEldersWhat1 = CreateSound( "Buildings\\NightElf\\AltarOfElders\\AltarOfEldersWhat1.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_AltarOfEldersWhat1, "AltarOfEldersWhat" )
    call SetSoundDuration( gg_snd_AltarOfEldersWhat1, 3496 )
    set gg_snd_AltarOfKingsWhat1 = CreateSound( "Buildings\\Human\\AltarOfKings\\AltarOfKingsWhat1.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_AltarOfKingsWhat1, "AltarOfKingsWhat" )
    call SetSoundDuration( gg_snd_AltarOfKingsWhat1, 3585 )
    set gg_snd_AmmoDumpWhat1 = CreateSound( "Buildings\\Other\\AmmoDump\\AmmoDumpWhat1.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_AmmoDumpWhat1, "AmmoDumpWhat" )
    call SetSoundDuration( gg_snd_AmmoDumpWhat1, 2383 )
    set gg_snd_AncientOfTheMoonYes1 = CreateSound( "Buildings\\NightElf\\AncientOfWar\\AncientOfTheMoonYes1.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_AncientOfTheMoonYes1, "AncientOfWarYes" )
    call SetSoundDuration( gg_snd_AncientOfTheMoonYes1, 2000 )
    set gg_snd_ArcherYesAttack3 = CreateSound( "Units\\NightElf\\Archer\\ArcherYesAttack3.wav", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_ArcherYesAttack3, "ArcherYesAttack" )
    call SetSoundDuration( gg_snd_ArcherYesAttack3, 1665 )
    set gg_snd_AxeMissileLaunch1 = CreateSound( "Abilities\\Weapons\\Axe\\AxeMissileLaunch1.wav", false, true, true, 10, 10, "MissilesEAX" )
    call SetSoundParamsFromLabel( gg_snd_AxeMissileLaunch1, "AxeMissileLaunch" )
    call SetSoundDuration( gg_snd_AxeMissileLaunch1, 617 )
