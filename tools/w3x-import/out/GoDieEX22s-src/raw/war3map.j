// 重新設定玩者名稱
function ReSetPlayerName takes unit PlayerUnit returns nothing
    local integer i
    set i = GetConvertedPlayerId(GetOwningPlayer(PlayerUnit))
    set udg_PlayerName[i] = ( udg_PlayerStarHeroTitle[i] + ( udg_PlayerItemTitle[i] + ( udg_PlayerMissionTitle[i] + (  udg_PlayerHeroName[i] + udg_PlayerTruthName[i] + "|r" ) ) ) )
    call SetPlayerName( ConvertedPlayer(i), udg_PlayerName[i] )
endfunction
