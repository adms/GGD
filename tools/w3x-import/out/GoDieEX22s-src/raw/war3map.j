    set gg_trg_Hell_Rock_Move = CreateTrigger(  )
    call DisableTrigger( gg_trg_Hell_Rock_Move )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Hell_Rock_Move, 0.02 )
    call TriggerAddAction( gg_trg_Hell_Rock_Move, function Trig_Hell_Rock_Move_Actions )
endfunction

