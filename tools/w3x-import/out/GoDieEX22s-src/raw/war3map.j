    call TriggerAddAction( gg_trg_lzfsEffect, function Trig_lzfsEffect_Actions )
endfunction

//===========================================================================
// Trigger: newlzfs
//===========================================================================
function Trig_newlzfs_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0MV' ) ) then
        return false
    endif
    return true
endfunction

function Trig_newlzfs_Actions takes nothing returns nothing
    set udg_Dog_lzfsMU = GetTriggerUnit()
    set udg_Dog_lzfsP = GetSpellTargetLoc()
    set udg_Dog_lzfsTP = GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc( 1, 'h02E', GetOwningPlayer(GetTriggerUnit()), udg_Dog_lzfsTP, bj_UNIT_FACING )
    call RemoveUnitSP( GetLastCreatedUnit() , 5 , 1)
    set udg_Dog_lzfsU = GetLastCreatedUnit()
    set udg_Dog_lzfsAngle = AngleBetweenPoints(udg_Dog_lzfsTP, udg_Dog_lzfsP)
    set udg_Dog_lzfsDist = DistanceBetweenPoints(udg_Dog_lzfsTP, udg_Dog_lzfsP)
    call EnableTrigger( gg_trg_newlzfsmove )
endfunction

//===========================================================================
function InitTrig_newlzfs takes nothing returns nothing
    set gg_trg_newlzfs = CreateTrigger(  )
    call DisableTrigger( gg_trg_newlzfs )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_newlzfs, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_newlzfs, Condition( function Trig_newlzfs_Conditions ) )
    call TriggerAddAction( gg_trg_newlzfs, function Trig_newlzfs_Actions )
endfunction

//===========================================================================
// Trigger: newlzfsmove
//===========================================================================
function Trig_newlzfsmove_Func001Func009Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_Dog_lzfsMU ) ) then
        return false
    endif
    return true
endfunction

function Trig_newlzfsmove_Func001Func009A takes nothing returns nothing
    if ( Trig_newlzfsmove_Func001Func009Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_Dog_lzfsGroup )
        call ShowUnitHide( GetEnumUnit() )
        call PauseUnitBJ( true, GetEnumUnit() )
    else
    endif
endfunction

function Trig_newlzfsmove_Func001Func011A takes nothing returns nothing
    call ShowUnitShow( GetEnumUnit() )
    call PauseUnitBJ( false, GetEnumUnit() )
    call UnitDamageTargetBJ( udg_Dog_lzfsMU, GetEnumUnit(), 1300.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "BloodBreathStream.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

function Trig_newlzfsmove_Func001C takes nothing returns boolean
    if ( not ( udg_Dog_lzfsDist >= 25.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_newlzfsmove_Actions takes nothing returns nothing
    if ( Trig_newlzfsmove_Func001C() ) then
        call RemoveLocation(udg_Dog_lzfsP)
        set udg_Dog_lzfsP = PolarProjectionBJ(udg_Dog_lzfsTP, 50.00, udg_Dog_lzfsAngle)
        call SetUnitPositionLoc( udg_Dog_lzfsU, udg_Dog_lzfsP )
        set udg_Dog_lzfsDist = ( udg_Dog_lzfsDist - 50.00 )
        call RemoveLocation(udg_Dog_lzfsTP)
        set udg_Dog_lzfsTP = GetUnitLoc(udg_Dog_lzfsU)
        call AddSpecialEffectLocBJ( udg_Dog_lzfsTP, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitAnimation( udg_Dog_lzfsU, "death" )
        call TriggerSleepAction( 0.01 )
        call KillUnit( udg_Dog_lzfsU )
        call RemoveUnit( udg_Dog_lzfsU )
        call CreateNUnitsAtLoc( 1, 'o01N', GetOwningPlayer(udg_Dog_lzfsMU), udg_Dog_lzfsTP, bj_UNIT_FACING )
        call RemoveUnitSP( GetLastCreatedUnit() , 12 , 1)
        set udg_Dog_lzfsU = GetLastCreatedUnit()
        call ForGroupBJ( GetUnitsInRangeOfLocAll(600.00, udg_Dog_lzfsTP), function Trig_newlzfsmove_Func001Func009A )
        call TriggerSleepAction( 6.00 )
        call ForGroupBJ( udg_Dog_lzfsGroup, function Trig_newlzfsmove_Func001Func011A )
        call GroupClear( udg_Dog_lzfsGroup )
        call TriggerSleepAction( 1.00 )
        call KillUnit( udg_Dog_lzfsU )
        call RemoveUnit( udg_Dog_lzfsU )
        call RemoveLocation(udg_Dog_lzfsP)
        call RemoveLocation(udg_Dog_lzfsTP)
    endif
endfunction

//===========================================================================
function InitTrig_newlzfsmove takes nothing returns nothing
    set gg_trg_newlzfsmove = CreateTrigger(  )
    call DisableTrigger( gg_trg_newlzfsmove )
    call TriggerRegisterTimerEventPeriodic( gg_trg_newlzfsmove, 0.03 )
    call TriggerAddAction( gg_trg_newlzfsmove, function Trig_newlzfsmove_Actions )
endfunction

