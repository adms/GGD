    if ( Trig_AKT_1_Effect_Func001C() ) then
        set udg_CloseDesEffectCount = ( udg_CloseDesEffectCount + 1 )
        call SetUnitScalePercent( udg_AKTShanaUnit, ( ( I2R(udg_CloseDesEffectCount) * 5.00 ) + 10.00 ), 100, 100 )
        call SetUnitVertexColorBJ( udg_AKTShanaUnit, 100, 100, 100, ( I2R(udg_CloseDesEffectCount) * 1.50 ) )
    else
        call DisableTrigger( GetTriggeringTrigger() )
    endif
