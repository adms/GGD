//===========================================================================
// Trigger: All Random
//===========================================================================
//TESH.scrollpos=5
//TESH.alwaysfold=0
function Trig_All_Random_Actions takes nothing returns nothing
    local integer i
    local integer j

    call DisableTrigger( gg_trg_Turn_off_All_Rand )
    call DisableTrigger( gg_trg_SetIndex )
    call DisableTrigger( GetTriggeringTrigger() )

//處理亂數種子超出範圍
    loop
    if ( udg_RandSqu <= udg_HeroTypeCount ) then
        exitwhen true
    else
        set udg_RandSqu = ( udg_RandSqu - udg_HeroTypeCount )
    endif
    endloop

    call PolledWait( 2 )

//判別玩者是否為玩家並進行全數隨機
    set i = 1
    set j = 12
    loop
        exitwhen i > j
          if ( GetPlayerController(ConvertedPlayer(i)) == MAP_CONTROL_USER ) then
              if( GetPlayerSlotState(ConvertedPlayer(i)) == PLAYER_SLOT_STATE_PLAYING ) then
                   set udg_TempPlayer = ConvertedPlayer(i)
                   call TriggerExecute( gg_trg_Select_Random_Hero )
              endif
        endif
        set i = i + 1
    endloop
endfunction

