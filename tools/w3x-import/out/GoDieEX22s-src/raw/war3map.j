    call TriggerAddCondition( gg_trg_Ptt_Judge, Condition( function Trig_Ptt_Judge_Conditions ) )
    call TriggerAddAction( gg_trg_Ptt_Judge, function Trig_Ptt_Judge_Actions )
endfunction

