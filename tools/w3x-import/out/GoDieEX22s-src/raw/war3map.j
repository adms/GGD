    call TriggerRegisterAnyUnitEventBJ( gg_trg_lzfs, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_lzfs, Condition( function Trig_lzfs_Conditions ) )
    call TriggerAddAction( gg_trg_lzfs, function Trig_lzfs_Actions )
endfunction

//===========================================================================
// Trigger: lzfsEffect
//===========================================================================
function Trig_lzfsEffect_Func002Func003Func001Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(udg_lzfsUnits2[0]), GetOwningPlayer(GetEnumUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_lzfsEffect_Func002Func003Func001C takes nothing returns boolean
    if ( not Trig_lzfsEffect_Func002Func003Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_lzfsEffect_Func002Func003A takes nothing returns nothing
    if ( Trig_lzfsEffect_Func002Func003Func001C() ) then
        call UnitDamageTargetBJ( udg_lzfsUnits2[0], GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_lzfsUnits2[0], true)) * 5.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_lzfsEffect_Func002Func008A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_lzfsEffect_Func002C takes nothing returns boolean
    if ( not ( udg_lzfsCount >= 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_lzfsEffect_Actions takes nothing returns nothing
    set udg_lzfsCount = ( udg_lzfsCount + 1 )
    if ( Trig_lzfsEffect_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call PlaySoundOnUnitBJ( gg_snd_PossessionMissileLaunch1, 100.00, udg_lzfsUnits[1] )
        call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(GetUnitLoc(udg_lzfsUnits2[1]), 450.00, 450.00)), function Trig_lzfsEffect_Func002Func003A )
        call ShowUnitShow( udg_lzfsUnits2[0] )
        call SelectUnitForPlayerSingle( udg_lzfsUnits2[0], GetOwningPlayer(udg_lzfsUnits2[0]) )
        call SetUnitPositionLocFacingLocBJ( udg_lzfsUnits2[0], GetUnitLoc(udg_lzfsUnits2[1]), GetUnitLoc(udg_lzfsUnits2[1]) )
        call TriggerSleepAction( 0.10 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_lzfsUnits2[0]), 'o01C'), function Trig_lzfsEffect_Func002Func008A )
    else
        call CreateNUnitsAtLocFacingLocBJ( 1, 'o01C', GetOwningPlayer(udg_lzfsUnits2[0]), PolarProjectionBJ(GetUnitLoc(udg_lzfsUnits2[1]), 250.00, ( 45.00 * I2R(udg_SeesCount) )), GetUnitLoc(udg_lzfsUnits2[1]) )
        set udg_lzfsUnits[udg_SeesCount] = GetLastCreatedUnit()
        call AddSpecialEffectLocBJ( GetUnitLoc(GetLastCreatedUnit()), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitVertexColorBJ( udg_lzfsUnits[udg_SeesCount], 75.00, 75.00, 75.00, 40.00 )
        call SetUnitTimeScalePercent( udg_lzfsUnits[udg_SeesCount], 375.00 )
        call SetUnitAnimation( udg_lzfsUnits[udg_SeesCount], "attack" )
        call SetUnitAnimation( udg_lzfsUnits2[1], "death" )
        call SetUnitTimeScalePercent( udg_lzfsUnits[udg_SeesCount], 0.00 )
        call AddSpecialEffectLocBJ( GetUnitLoc(udg_lzfsUnits2[1]), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

