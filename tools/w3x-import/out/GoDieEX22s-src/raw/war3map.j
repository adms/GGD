        return false
    endif
    return true
endfunction

function Trig_tenCow_Normal_Func002Func019C takes nothing returns boolean
    if ( not ( udg_TenCow == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_tenCow_Normal_Func002C takes nothing returns boolean
    if ( not ( GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER) >= 700 ) ) then
        return false
    endif
    return true
endfunction

function Trig_tenCow_Normal_Actions takes nothing returns nothing
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8864" )
    if ( Trig_tenCow_Normal_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_TenCow = true
        call SetPlayerStateBJ( GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER) - 700 ) )
        call TriggerSleepAction( 2.00 )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8865" )
        call TriggerSleepAction( 6.00 )
        call CreateNUnitsAtLoc( 1, 'obot', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct________048), bj_UNIT_FACING )
        set udg_TenCowUnit = GetLastCreatedUnit()
        call IssueTargetOrderBJ( gg_unit_opeo_0223, "board", udg_TenCowUnit )
        call IssueTargetOrderBJ( gg_unit_opeo_0222, "board", udg_TenCowUnit )
        call IssueTargetOrderBJ( gg_unit_opeo_0224, "board", udg_TenCowUnit )
        call TriggerSleepAction( 2.00 )
        call KillUnit( udg_TenCowUnit )
        call RemoveUnit( gg_unit_opeo_0222 )
        call RemoveUnit( gg_unit_opeo_0224 )
        call RemoveUnit( gg_unit_opeo_0223 )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8866" )
        call PlaySoundBJ( gg_snd_GoodJob )
        if ( Trig_tenCow_Normal_Func002Func019C() ) then
            set udg_TenCow = false
            set udg_TenWeaMission = true
            if ( Trig_tenCow_Normal_Func002Func019Func004C() ) then
                set udg_LevelUpCount = 2
                loop
                    exitwhen udg_LevelUpCount > 6
                    call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
                    call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
                    set udg_LevelUpCount = udg_LevelUpCount + 1
                endloop
            else
                set udg_LevelUpCount = 8
                loop
                    exitwhen udg_LevelUpCount > 12
                    call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
                    call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
                    set udg_LevelUpCount = udg_LevelUpCount + 1
                endloop
            endif
            call CreateItemLoc( 'I06J', GetRectCenter(gg_rct________027) )
            call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + "完成獸人的船難任務|r" ) ) )
            call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + "同盟獲得500賞金以及提升等級！|r" ) ) )
            call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + "獲得新稱號!" ) )
            set udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetEnteringUnit()))] = "|c20FF0000(俺是耕田滴)|r"
            call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) ) )
        else
        endif
    else
    endif
endfunction

