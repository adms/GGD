function Trig_FinalShottingMove_Func002Func003Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_FinalShotGroup) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalShottingMove_Func002Func003A takes nothing returns nothing
    if ( Trig_FinalShottingMove_Func002Func003Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_FinalShotGroup )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_FinalShottingMove_Func002Func008Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalShottingMove_Func002Func008A takes nothing returns nothing
    if ( Trig_FinalShottingMove_Func002Func008Func001C() ) then
        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_FinalShottingMove_Func002Func011Func003C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_FinalShotCastUnit)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalShottingMove_Func002Func011A takes nothing returns nothing
    call SetUnitFacingToFaceUnitTimed( GetLastCreatedUnit(), GetEnumUnit(), 0 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "purge", GetEnumUnit() )
    if ( Trig_FinalShottingMove_Func002Func011Func003C() ) then
        call UnitDamageTargetBJ( udg_FinalShotCastUnit, GetEnumUnit(), I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_FinalShotCastUnit, true) * 3 )), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_FinalShottingMove_Func002C takes nothing returns boolean
    if ( not ( udg_FinalShotCount <= 40 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalShottingMove_Actions takes nothing returns nothing
    set udg_FinalShotCount = ( udg_FinalShotCount + 1 )
    if ( Trig_FinalShottingMove_Func002C() ) then
        set udg_FinalShottingPoint = PolarProjectionBJ(udg_FinalShottingPoint, 100.00, GetUnitFacing(udg_FinalShotCastUnit))
        call SetUnitPositionLoc( udg_FinalShotUnit, udg_FinalShottingPoint )
        call ForGroupBJ( GetUnitsInRangeOfLocAll(200.00, udg_FinalShottingPoint), function Trig_FinalShottingMove_Func002Func003A )
        call AddSpecialEffectLocBJ( udg_FinalShottingPoint, "Doodads\\Cityscape\\Props\\MagicRunes\\MagicRunes2.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_FinalShottingPoint, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call EnumDestructablesInCircleBJ( 450.00, udg_FinalShottingPoint, function Trig_FinalShottingMove_Func002Func008A )
    else
        call DisableTrigger( gg_trg_FinalShottingMove )
        call ForGroupBJ( udg_FinalShotGroup, function Trig_FinalShottingMove_Func002Func011A )
    endif
endfunction

