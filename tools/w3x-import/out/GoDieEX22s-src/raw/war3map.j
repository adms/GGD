function Trig_GoldDrgan_Effect_Func009Func007A takes nothing returns nothing
    if ( Trig_GoldDrgan_Effect_Func009Func007Func001C() ) then
        call UnitDamageTargetBJ( udg_GaShoUnit, GetEnumUnit(), I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_GaShoUnit, true) * 4 )), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

