//===========================================================================
function Trig_MoveInst_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_NegiUnit ) ) then
        return false
    endif
    return true
endfunction

function Trig_MoveInst_Actions takes nothing returns nothing
    set udg_NegiMasterPoint = GetUnitLoc(GetTriggerUnit())
    set udg_NegiPoint = GetOrderPointLoc()
    set udg_NegiAngle = AngleBetweenPoints(udg_NegiMasterPoint, udg_NegiPoint)
    call AddSpecialEffectLocBJ( udg_NegiMasterPoint, "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation( udg_NegiPoint )
    set udg_NegiPoint = PolarProjectionBJ(udg_NegiMasterPoint, 200.00, udg_NegiAngle)
    call SetUnitPositionLocFacingBJ( udg_NegiUnit, udg_NegiPoint, udg_NegiAngle )
    call AddSpecialEffectLocBJ( udg_NegiPoint, "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation( udg_NegiPoint )
    call RemoveLocation( udg_NegiMasterPoint )
endfunction

