function InitTrig_KillPowerEX takes nothing returns nothing
    set gg_trg_KillPowerEX = CreateTrigger(  )
    call DisableTrigger( gg_trg_KillPowerEX )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KillPowerEX, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_KillPowerEX, Condition( function Trig_KillPowerEX_Conditions ) )
    call TriggerAddAction( gg_trg_KillPowerEX, function Trig_KillPowerEX_Actions )
endfunction

