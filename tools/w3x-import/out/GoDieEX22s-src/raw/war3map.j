// Trigger: Voice
//===========================================================================
function Trig_Voice_Func007Func001C takes nothing returns boolean
    if ( ( GetTriggerPlayer() == udg_d8246505 ) ) then
        return true
    endif
    if ( ( udg_PlayerTruthName[GetConvertedPlayerId(GetTriggerPlayer())] == "ericer" ) ) then
        return true
    endif
    return false
endfunction

function Trig_Voice_Func007C takes nothing returns boolean
    if ( not Trig_Voice_Func007Func001C() ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())]) == 'Opgh' ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())]) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voice_Conditions takes nothing returns boolean
    if ( not Trig_Voice_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Voice_Func001C takes nothing returns boolean
    if ( not ( GetPlayerName(GetTriggerPlayer()) == "ericer" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voice_Actions takes nothing returns nothing
    if ( Trig_Voice_Func001C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_2425" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_3386" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_3979" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_4399" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_4533" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_801" )
    else
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call ReplaceUnitBJ( udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())], 'O02P', bj_UNIT_STATE_METHOD_RELATIVE )
    set udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] = GetLastReplacedUnitBJ()
    set udg_DES_init_counter = 20
    loop
        exitwhen udg_DES_init_counter > udg_Des_BuffCont
        call TriggerRegisterUnitEvent( udg_Des_BuffTri[udg_DES_init_counter], GetLastReplacedUnitBJ(), EVENT_UNIT_DAMAGED )
        set udg_DES_init_counter = udg_DES_init_counter + 1
    endloop
    set udg_DES_init_counter = 20
    loop
        exitwhen udg_DES_init_counter > udg_Des_UtypTriCont
        call TriggerRegisterUnitEvent( udg_Des_UtypTri[udg_DES_init_counter], GetLastReplacedUnitBJ(), EVENT_UNIT_DAMAGED )
        set udg_DES_init_counter = udg_DES_init_counter + 1
    endloop
endfunction

