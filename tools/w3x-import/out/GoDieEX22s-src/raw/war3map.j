    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIGAttacked_Actions takes nothing returns nothing
    if ( Trig_AIGAttacked_Func001C() ) then
        if ( Trig_AIGAttacked_Func001Func002C() ) then
            if ( Trig_AIGAttacked_Func001Func002Func001C() ) then
                call IssueTargetOrderBJ( GetTriggerUnit(), "attack", GetAttacker() )
            else
                call SelectHeroSkill( GetTriggerUnit(), GetLearnedSkillBJ() )
                call IssuePointOrderLocBJ( GetTriggerUnit(), "move", GetRectCenter(gg_rct_DieHeroPoint) )
            endif
        else
        endif
    else
        set udg_AI_COUNT = 8
        loop
            exitwhen udg_AI_COUNT > 12
            if ( Trig_AIGAttacked_Func001Func001Func001C() ) then
                if ( Trig_AIGAttacked_Func001Func001Func001Func001C() ) then
                    call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I03D'), GetTriggerUnit() )
                else
                endif
                if ( Trig_AIGAttacked_Func001Func001Func001Func003C() ) then
                    call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                    call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                else
                    call IssueTargetOrderBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "attack", GetAttacker() )
                endif
            else
            endif
            set udg_AI_COUNT = udg_AI_COUNT + 1
        endloop
    endif
endfunction

