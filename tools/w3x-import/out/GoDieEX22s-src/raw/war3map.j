//===========================================================================
function Trig_DragonExpGo_Func002Func003Func001Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Func002Func003Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Func002Func003Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_ChiRam)) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Func002Func003A takes nothing returns nothing
    if ( Trig_DragonExpGo_Func002Func003Func001C() ) then
        if ( Trig_DragonExpGo_Func002Func003Func001Func001C() ) then
            call UnitDamageTargetBJ( udg_ChiRam, GetEnumUnit(), ( udg_DraganDamage * 0.25 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        else
            if ( Trig_DragonExpGo_Func002Func003Func001Func001Func001C() ) then
                call UnitDamageTargetBJ( udg_ChiRam, GetEnumUnit(), ( udg_DraganDamage * 0.50 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            else
                call UnitDamageTargetBJ( udg_ChiRam, GetEnumUnit(), udg_DraganDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            endif
        endif
    else
        call DoNothing(  )
    endif
endfunction

function Trig_DragonExpGo_Func002Func006A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_DragonExpGo_Func002Func009Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_DragonDamageGroup) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Func002Func009A takes nothing returns nothing
    if ( Trig_DragonExpGo_Func002Func009Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_DragonDamageGroup )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_DragonExpGo_Func002Func017Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Func002Func017A takes nothing returns nothing
    if ( Trig_DragonExpGo_Func002Func017Func001C() ) then
        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_DragonExpGo_Func002C takes nothing returns boolean
    if ( not ( udg_DragonCounter == 25 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonExpGo_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_GoldMineDeath1, 100.00, GetTriggerUnit() )
    if ( Trig_DragonExpGo_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_DraganDamage = ( udg_DraganDamage + I2R(( udg_DragonTimerCounter * ( R2I(udg_DragonAgi) * 5 ) )) )
        call ForGroupBJ( udg_DragonDamageGroup, function Trig_DragonExpGo_Func002Func003A )
        call TriggerSleepAction( 1.00 )
        call EnableTrigger( gg_trg_DragonExp )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_ChiRam), 'h000'), function Trig_DragonExpGo_Func002Func006A )
        call RemoveLocation(udg_DragonPoint)
    else
        set udg_DragonCounter = ( udg_DragonCounter + 1 )
        call ForGroupBJ( GetUnitsInRangeOfLocAll(( 100.00 + ( I2R(udg_DragonTimerCounter) * 70.00 ) ), udg_DragonPoint), function Trig_DragonExpGo_Func002Func009A )
        call AddSpecialEffectLocBJ( udg_DragonPoint, "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_DragonPoint, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitPositionLoc( udg_DragonExpUnit, PolarProjectionBJ(udg_DragonPoint, 75.00, udg_DragonFace) )
        call RemoveLocation(udg_DragonPoint)
        set udg_DragonPoint = GetUnitLoc(udg_DragonExpUnit)
        call EnumDestructablesInCircleBJ( 450.00, udg_DragonPoint, function Trig_DragonExpGo_Func002Func017A )
    endif
endfunction

