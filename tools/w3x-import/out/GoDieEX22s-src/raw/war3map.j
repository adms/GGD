//===========================================================================
function InitTrig_init_Die takes nothing returns nothing
    set gg_trg_init_Die = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_init_Die, GetPlayableMapRect() )
    call TriggerAddAction( gg_trg_init_Die, function Trig_init_Die_Actions )
endfunction

//===========================================================================
// Trigger: GhostDaEX
//===========================================================================
function Trig_GhostDaEX_Func011C takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))] == true ) ) then
        return false
    endif
    if ( not ( RAbsBJ(( ModuloReal(( ( GetUnitFacing(GetAttacker()) - GetUnitFacing(GetAttackedUnitBJ()) ) + 180.00 ), 360.00) - 180.00 )) <= 90.00 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Oshd' ) ) then
        return false
    endif
    if ( not ( GetRandomInt(1, 2) <= 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GhostDaEX_Conditions takes nothing returns boolean
    if ( not Trig_GhostDaEX_Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_GhostDaEX_Func002A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_GhostDaEX_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(GetAttacker()), 'ogru'), function Trig_GhostDaEX_Func002A )
    call CreateNUnitsAtLoc( 1, 'ogru', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttackedUnitBJ()), bj_UNIT_FACING )
    call ShowUnitHide( GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A10R', GetLastCreatedUnit() )
    call SetUnitFacingToFaceUnitTimed( GetLastCreatedUnit(), GetTriggerUnit(), 0 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "hex", GetAttackedUnitBJ() )
    call TriggerSleepAction( 0.01 )
    call EnableTrigger( gg_trg_GhostDaEX )
endfunction

//===========================================================================
function InitTrig_GhostDaEX takes nothing returns nothing
    set gg_trg_GhostDaEX = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_GhostDaEX, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_GhostDaEX, Condition( function Trig_GhostDaEX_Conditions ) )
    call TriggerAddAction( gg_trg_GhostDaEX, function Trig_GhostDaEX_Actions )
endfunction

