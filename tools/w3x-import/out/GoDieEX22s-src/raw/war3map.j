    loop
        exitwhen udg_DestWall_Index > 8
        set udg_DestWall_P2 = PolarProjectionBJ(udg_DestWall_P1, ( 400.00 - ( 100.00 * I2R(udg_DestWall_Index) ) ), ( GetUnitFacing(GetTriggerUnit()) + 90.00 ))
