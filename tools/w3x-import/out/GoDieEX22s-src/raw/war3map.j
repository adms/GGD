        return false
    endif
    return true
endfunction

function Trig_Wine_Extract_Initiate_Func004Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_ArcaneUnit, 'B00I') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_ArcaneUnit, 'B05A') == false ) ) then
        return false
    endif
    return true
endfunction

