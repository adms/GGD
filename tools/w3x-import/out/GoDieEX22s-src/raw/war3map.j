//===========================================================================
// Trigger: DeathSpread
//===========================================================================
function Trig_DeathSpread_Func001C takes nothing returns boolean
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_ButtyGhost_SD))] == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_ButtyGhost_SD) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DeathSpread_Conditions takes nothing returns boolean
    if ( not Trig_DeathSpread_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_DeathSpread_Func004Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_ButtyGhost_SD)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DeathSpread_Func004Func001C takes nothing returns boolean
    if ( not Trig_DeathSpread_Func004Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_DeathSpread_Func004A takes nothing returns nothing
    if ( Trig_DeathSpread_Func004Func001C() ) then
        set udg_DeathSpreadDamage = DistanceBetweenPoints(udg_ButtyAfraidPoint, GetUnitLoc(GetEnumUnit()))
        set udg_DeathSpreadDamage = ( RAbsBJ(udg_DeathSpreadDamage) * 0.50 )
        call CreateTextTagUnitBJ( ( I2S(R2I(udg_DeathSpreadDamage)) + "!" ), GetEnumUnit(), -30.00, 10.00, 10.00, 10.00, 0.00, 10.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        call UnitDamageTargetBJ( udg_ButtyGhost_SD, GetEnumUnit(), udg_DeathSpreadDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\NightElf\\shadowstrike\\shadowstrike.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_DeathSpread_Actions takes nothing returns nothing
    set udg_ButtyAfraidPoint = GetUnitLoc(udg_ButtyGhost_SD)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(600.00, GetUnitLoc(udg_ButtyGhost_SD)), function Trig_DeathSpread_Func004A )
endfunction

