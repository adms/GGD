//===========================================================================
function Trig_ZombKing_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n002' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'U01F' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ZombKing_Conditions takes nothing returns boolean
    if ( not Trig_ZombKing_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ZombKing_Func004C takes nothing returns boolean
    if ( not ( udg_ChungFe == false ) ) then
        return false
    endif
    if ( not ( udg_ZombKingDieN >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ZombKing_Func005C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 20) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ZombKing_Actions takes nothing returns nothing
    set udg_ZombKingDieN = ( udg_ZombKingDieN + 1 )
    call TriggerSleepAction( 90.00 )
    if ( Trig_ZombKing_Func004C() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_644" )
        call CreateNUnitsAtLoc( 1, 'U01F', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct________051), bj_UNIT_FACING )
        call SetHeroLevelBJ( GetLastCreatedUnit(), 30, false )
        call UnitAddItemByIdSwapped( 'I000', GetLastCreatedUnit() )
        call PingMinimapLocForForce( GetPlayersAll(), GetRectCenter(gg_rct________051), 3.00 )
        set udg_ChungFe = true
    else
        call CreateNUnitsAtLoc( 1, 'n002', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct________051), bj_UNIT_FACING )
    endif
    if ( Trig_ZombKing_Func005C() ) then
        call CreateItemLoc( 'I004', GetRectCenter(gg_rct________051) )
    else
        call DoNothing(  )
    endif
endfunction

