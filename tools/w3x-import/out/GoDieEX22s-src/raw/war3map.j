//===========================================================================
// Trigger: SmallMap Singnal
//===========================================================================
function Trig_SmallMap_Singnal_Actions takes nothing returns nothing
    call UnitAddAbilityBJ( 'Amim', gg_unit_Ogld_0032 )
    call UnitAddAbilityBJ( 'A0RA', gg_unit_uzg2_0136 )
    call UnitAddAbilityBJ( 'A0RA', gg_unit_ncap_0134 )
    set udg_RegoinAI[1] = gg_rct_godie_left_trun
    set udg_RegoinAI[2] = gg_rct_center_tranfer
    set udg_RegoinAI[3] = gg_rct_love_right_turn
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call StartTimerBJ( udg_Timer[GetForLoopIndexA()], false, 15.00 )
        call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 40.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopBIndex = 8
    set bj_forLoopBIndexEnd = 12
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call StartTimerBJ( udg_Timer[GetForLoopIndexB()], false, 15.00 )
        call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexB()), 40.00 )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    // 星人第一次計時
    call StartTimerBJ( udg_TargetKillHreoTimer, false, 300.00 )
endfunction

