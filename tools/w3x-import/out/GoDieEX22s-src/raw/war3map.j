//===========================================================================
// Trigger: Burdock
//===========================================================================
function Trig_Burdock_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I055' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burdock_Func003C takes nothing returns boolean
    if ( not ( udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))] >= 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burdock_Actions takes nothing returns nothing
    call ForceClear( udg_Mission_Score_Caster )
    call ForceAddPlayerSimple( GetOwningPlayer(GetBuyingUnit()), udg_Mission_Score_Caster )
    if ( Trig_Burdock_Func003C() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_2485" )
        call UnitAddItemByIdSwapped( 'I02M', GetBuyingUnit() )
        set udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))] = ( udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))] - 50 )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))], I2S(udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetBuyingUnit()))]) )
        call RemoveItemFromAllStock( 'I055' )
    else
        call DisplayTextToForce( udg_Mission_Score_Caster, "TRIGSTR_1770" )
    endif
endfunction

//===========================================================================
function InitTrig_Burdock takes nothing returns nothing
    set gg_trg_Burdock = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Burdock, EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Burdock, Condition( function Trig_Burdock_Conditions ) )
    call TriggerAddAction( gg_trg_Burdock, function Trig_Burdock_Actions )
endfunction

