    if ( Trig_AIgoHomeBuy_Func002C() ) then
        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_love_back, Player(0)))
        if ( Trig_AIgoHomeBuy_Func002Func002C() ) then
            call UnitUseItemTarget( GetKillingUnitBJ(), GetItemOfTypeFromUnitBJ(GetKillingUnitBJ(), 'I048'), udg_MoveUnit )
        else
            call IssuePointOrderLocBJ( GetKillingUnitBJ(), "move", GetRectCenter(gg_rct_LoveHeroPoint) )
