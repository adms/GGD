    set udg_PlayerTruthName[GetConvertedPlayerId(GetTriggerPlayer())] = SubStringBJ(GetEventPlayerChatString(), 7, StringLength(GetEventPlayerChatString()))
    set udg_Borad_PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())] = ( ( udg_PlayerHeroName[GetConvertedPlayerId(GetTriggerPlayer())] + udg_PlayerTruthName[GetConvertedPlayerId(GetTriggerPlayer())] ) + "|r" )
    call ReSetPlayerName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())])
endfunction

