function Trig_Run_Effect_Actions takes nothing returns nothing
    set udg_KnockBack_Index = ( udg_KnockBack_Index + 1 )
    set udg_P1 = GetUnitLoc(udg_KnockBack_Target)
    set udg_P2 = PolarProjectionBJ(udg_P1, 20.00, udg_KnockBack_Angle)
    call SetUnitPositionLoc( udg_KnockBack_Target, udg_P2 )
    call EnumDestructablesInCircleBJ( 300.00, GetUnitLoc(udg_KnockBack_Target), function Trig_Run_Effect_Func005A )
    set udg_P3 = GetUnitLoc(udg_KnockBack_Target)
    call CreateNUnitsAtLoc( 1, 'o00P', GetOwningPlayer(udg_KnockBack_Target), udg_P1, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'ACfn', GetLastCreatedUnit() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(300.00, udg_P1), function Trig_Run_Effect_Func011A )
    if ( Trig_Run_Effect_Func012C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitPositionLoc( udg_KnockBack_Target, udg_P1 )
        call TriggerSleepAction( 1.00 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_KnockBack_Target), 'o00P'), function Trig_Run_Effect_Func012Func004A )
    else
    endif
    call RemoveLocation( udg_P1 )
    call RemoveLocation( udg_P2 )
    call RemoveLocation( udg_P3 )
    if ( Trig_Run_Effect_Func016C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerSleepAction( 2.00 )
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_KnockBack_Target), 'o00P'), function Trig_Run_Effect_Func016Func003A )
    else
    endif
endfunction

