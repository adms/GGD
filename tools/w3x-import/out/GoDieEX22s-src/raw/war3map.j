//===========================================================================
// Trigger: DragonTigerMove
//===========================================================================
function Trig_DragonTigerMove_Func012C takes nothing returns boolean
    if ( not ( udg_KOFIndex == 40 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonTigerMove_Func013Func002Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonTigerMove_Func013Func002A takes nothing returns nothing
    if ( Trig_DragonTigerMove_Func013Func002Func001C() ) then
        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_DragonTigerMove_Func013C takes nothing returns boolean
    if ( not ( udg_KOFIndex == 42 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonTigerMove_Actions takes nothing returns nothing
    call SetUnitFlyHeightBJ( udg_KOFCaster, ( ( -1.50 * Pow(( I2R(udg_KOFIndex) - 21.00 ), 2.00) ) + 600.00 ), 0.00 )
    set udg_KOFIndex = ( udg_KOFIndex + 1 )
    call SetUnitPositionLocFacingLocBJ( udg_KOFCaster, PolarProjectionBJ(GetUnitLoc(udg_KOFCaster), 10.00, udg_KOFMasterAngle), GetUnitLoc(udg_KOFMaster) )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_KOFCaster, "Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "hand", udg_KOFCaster, "Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "head", udg_KOFCaster, "Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "foot", udg_KOFCaster, "Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_DragonTigerMove_Func012C() ) then
        call SetUnitPathing( udg_KOFCaster, true )
    else
    endif
    if ( Trig_DragonTigerMove_Func013C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnumDestructablesInCircleBJ( 200.00, GetUnitLoc(udg_KOFCaster), function Trig_DragonTigerMove_Func013Func002A )
        call AddSpecialEffectLocBJ( GetUnitLoc(udg_KOFCaster), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitRemoveAbilityBJ( 'A0FZ', udg_KOFCaster )
        call PauseUnitBJ( false, udg_KOFCaster )
        call SetUnitInvulnerable( udg_KOFCaster, false )
    else
    endif
endfunction

//===========================================================================
function InitTrig_DragonTigerMove takes nothing returns nothing
    set gg_trg_DragonTigerMove = CreateTrigger(  )
    call DisableTrigger( gg_trg_DragonTigerMove )
    call TriggerRegisterTimerEventPeriodic( gg_trg_DragonTigerMove, 0.02 )
    call TriggerAddAction( gg_trg_DragonTigerMove, function Trig_DragonTigerMove_Actions )
endfunction

