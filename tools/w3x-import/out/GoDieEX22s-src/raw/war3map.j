function Trig_Fan_Movement_Func006A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_NiJan, GetEnumUnit(), udg_FanTossDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call GroupRemoveUnitSimple( GetEnumUnit(), udg_PotentialTargetsFanRight )
    call GroupAddUnitSimple( GetEnumUnit(), udg_SafeTargetsFanRight )
endfunction

function Trig_Fan_Movement_Actions takes nothing returns nothing
    if ( Trig_Fan_Movement_Func001C() ) then
        if ( Trig_Fan_Movement_Func001Func001C() ) then
            set udg_TrackWE_Point = GetUnitLoc(udg_NiJan)
            set udg_CurrentFanLeftPoint = PolarProjectionBJ(GetUnitLoc(udg_FanLeft), 30.00, AngleBetweenPoints(GetUnitLoc(udg_FanLeft), udg_TrackWE_Point))
            call SetUnitPositionLocFacingBJ( udg_FanLeft, udg_CurrentFanLeftPoint, bj_UNIT_FACING )
            set udg_CurrentFanRightPoint = PolarProjectionBJ(GetUnitLoc(udg_FanRight), 30.00, AngleBetweenPoints(GetUnitLoc(udg_FanRight), udg_TrackWE_Point))
            call SetUnitPositionLocFacingBJ( udg_FanRight, udg_CurrentFanLeftPoint, bj_UNIT_FACING )
            if ( Trig_Fan_Movement_Func001Func001Func006C() ) then
                call KillUnit( udg_FanLeft )
                call RemoveUnit( udg_FanLeft )
                call KillUnit( udg_FanRight )
                call RemoveUnit( udg_FanRight )
                call GroupClear( udg_PotentialTargetsFanLeft )
                call GroupClear( udg_PotentialTargetsFanRight )
                call GroupClear( udg_SafeTargetsFanLeft )
                call GroupClear( udg_SafeTargetsFanRight )
                call RemoveLocation(udg_TrackWE_Point)
                call RemoveLocation(udg_CurrentFanLeftPoint)
                call RemoveLocation(udg_CurrentFanRightPoint)
                call RemoveLocation(udg_Fan_Left_Point_1)
                call RemoveLocation(udg_Fan_Right_Point_1)
                call DisableTrigger( GetTriggeringTrigger() )
            else
                call DoNothing(  )
            endif
        else
            set udg_CurrentFanLeftPoint = PolarProjectionBJ(udg_Fan_Left_Point_1, 250.00, ( AngleBetweenPoints(udg_Fan_Left_Point_1, GetUnitLoc(udg_FanLeft)) + 9.00 ))
            set udg_CurrentFanRightPoint = PolarProjectionBJ(udg_Fan_Right_Point_1, 250.00, ( AngleBetweenPoints(udg_Fan_Right_Point_1, GetUnitLoc(udg_FanRight)) - 9.00 ))
            call SetUnitPositionLocFacingBJ( udg_FanLeft, udg_CurrentFanLeftPoint, bj_UNIT_FACING )
            call SetUnitPositionLocFacingBJ( udg_FanRight, udg_CurrentFanRightPoint, bj_UNIT_FACING )
            set udg_FanRotationCounter = ( udg_FanRotationCounter + 9.00 )
        endif
    else
        set udg_CurrentFanLeftPoint = PolarProjectionBJ(GetUnitLoc(udg_FanLeft), 30.00, udg_FanLeftAngle)
        set udg_CurrentFanRightPoint = PolarProjectionBJ(GetUnitLoc(udg_FanRight), 30.00, udg_FanRightAngle)
        set udg_FanTravel_DIST = ( udg_FanTravel_DIST - 30.00 )
        call SetUnitPositionLocFacingBJ( udg_FanLeft, udg_CurrentFanLeftPoint, bj_UNIT_FACING )
        call SetUnitPositionLocFacingBJ( udg_FanRight, udg_CurrentFanRightPoint, bj_UNIT_FACING )
    endif
    set udg_PotentialTargetsFanLeft = GetUnitsInRangeOfLocMatching(100.00, udg_CurrentFanLeftPoint, Condition(function Trig_Fan_Movement_Func002002003))
    call ForGroupBJ( udg_PotentialTargetsFanLeft, function Trig_Fan_Movement_Func003A )
    call RemoveLocation(udg_CurrentFanLeftPoint)
    set udg_PotentialTargetsFanRight = GetUnitsInRangeOfLocMatching(100.00, udg_CurrentFanRightPoint, Condition(function Trig_Fan_Movement_Func005002003))
    call ForGroupBJ( udg_PotentialTargetsFanRight, function Trig_Fan_Movement_Func006A )
    call RemoveLocation(udg_CurrentFanRightPoint)
    call RemoveLocation(udg_TrackWE_Point)
endfunction

