    set gg_trg_EXP_2500sec = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_EXP_2500sec, 2500.00 )
    call TriggerAddAction( gg_trg_EXP_2500sec, function Trig_EXP_2500sec_Actions )
