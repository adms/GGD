    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_EyesMaster)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_LightGroup) == false ) ) then
