            loop
                exitwhen udg_AI_COUNT > 6
                if ( Trig_help_Func005Func001Func001Func001C() ) then
                    if ( Trig_help_Func005Func001Func001Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_LoveHeroPoint) )
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_help, Player(0)))
                        if ( Trig_help_Func005Func001Func001Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "smart", GetRectCenter(gg_rct_help) )
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        else
            set udg_AI_COUNT = 8
            loop
                exitwhen udg_AI_COUNT > 12
                if ( Trig_help_Func005Func001Func002Func001C() ) then
                    if ( Trig_help_Func005Func001Func002Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_help, Player(6)))
                        if ( Trig_help_Func005Func001Func002Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "smart", GetRectCenter(gg_rct_help) )
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        endif
    else
    endif
    call DisplayTextToForce( GetPlayersAllies(GetTriggerPlayer()), ( ( "" + udg_Borad_PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())] ) + ( ": 救命阿~快來救 " + ( GetUnitName(udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())]) + "阿~" ) ) ) )
    call AdjustPlayerStateBJ( -100, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
endfunction

