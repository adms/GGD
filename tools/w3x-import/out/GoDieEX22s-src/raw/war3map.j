// Trigger: Open Skill of Henti
//===========================================================================
function Trig_Open_Skill_of_Henti_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Orkn' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Open_Skill_of_Henti_Actions takes nothing returns nothing
    set udg_Henti = GetTriggerUnit()
    call EnableTrigger( gg_trg_HentiEX )
endfunction

//===========================================================================
function InitTrig_Open_Skill_of_Henti takes nothing returns nothing
    set gg_trg_Open_Skill_of_Henti = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Open_Skill_of_Henti, GetPlayableMapRect() )
    call TriggerAddCondition( gg_trg_Open_Skill_of_Henti, Condition( function Trig_Open_Skill_of_Henti_Conditions ) )
    call TriggerAddAction( gg_trg_Open_Skill_of_Henti, function Trig_Open_Skill_of_Henti_Actions )
endfunction

//===========================================================================
// Trigger: HentiEX
//===========================================================================
function Trig_HentiEX_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Orkn' ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetAttackedUnitBJ()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetAttackedUnitBJ(), 'BNdh') == true ) ) then
        return false
    endif
    if ( not ( udg_EX_Mode[GetConvertedPlayerId(GetOwningPlayer(udg_Henti))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HentiEX_Conditions takes nothing returns boolean
    if ( not Trig_HentiEX_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HentiEX_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Henti = GetAttacker()
    set udg_HentiAttacked = GetAttackedUnitBJ()
    set udg_HentiDamage = ( GetUnitStateSwap(UNIT_STATE_MANA, udg_HentiAttacked) * 0.20 )
    set udg_Hell = GetUnitLoc(udg_HentiAttacked)
    call SetUnitPositionLoc( udg_Henti, udg_Hell )
    call SetUnitAnimation( udg_Henti, "Victory" )
    call RemoveLocation( udg_Hell )
    // xxxxxxxxx
    call TerrainDeformationRippleBJ( 2.00, true, udg_Hell, 50.00, 250.00, 64, 1, 200.00 )
    call EnableWeatherEffect( GetLastCreatedWeatherEffect(), true )
    // xxxxxxxxx
    call PlaySoundOnUnitBJ( gg_snd_BigBadVoodooSpellBirth1, 100, GetTriggerUnit() )
    call UnitDamageTargetBJ( udg_Henti, udg_HentiAttacked, udg_HentiDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_HentiAttacked, "Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call EnableTrigger( gg_trg_HentiEX )
endfunction

//===========================================================================
function InitTrig_HentiEX takes nothing returns nothing
    set gg_trg_HentiEX = CreateTrigger(  )
    call DisableTrigger( gg_trg_HentiEX )
