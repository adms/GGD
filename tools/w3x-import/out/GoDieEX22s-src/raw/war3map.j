                                                                    call DisplayTextToForce( GetPlayersAll(), ( udg_Player_Colors[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + ( "鄭先生: 你吃過洨嗎?" + "|r" ) ) )
