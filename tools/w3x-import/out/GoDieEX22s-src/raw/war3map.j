    call UnitDropItemTargetBJ( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 5), udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] )
    call UnitDropItemTargetBJ( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 6), udg_PlayerHeroUnit[GetConvertedPlayerId(GetTriggerPlayer())] )
    call UnitDropItemPointLoc( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 1), GetUnitLoc(GetEnumUnit()) )
    call UnitDropItemPointLoc( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 2), GetUnitLoc(GetEnumUnit()) )
    call UnitDropItemPointLoc( GetEnumUnit(), UnitItemInSlotBJ(GetEnumUnit(), 3), GetUnitLoc(GetEnumUnit()) )
