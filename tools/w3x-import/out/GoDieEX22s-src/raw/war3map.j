//===========================================================================
// Trigger: TutleDie
//===========================================================================
function Trig_TutleDie_Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetKillingUnitBJ()), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TutleDie_Actions takes nothing returns nothing
    if ( Trig_TutleDie_Func001C() ) then
        set udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = GetKillingUnitBJ()
        set udg_LevelUpCount = 2
        loop
            exitwhen udg_LevelUpCount > 6
            call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
            call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
            set udg_LevelUpCount = udg_LevelUpCount + 1
        endloop
    else
        set udg_LevelUpCount = 8
        loop
            exitwhen udg_LevelUpCount > 12
            call SetHeroLevelBJ( udg_PlayerHeroUnit[udg_LevelUpCount], ( GetHeroLevel(udg_PlayerHeroUnit[udg_LevelUpCount]) + 1 ), true )
            call AdjustPlayerStateBJ( 500, GetOwningPlayer(udg_PlayerHeroUnit[udg_LevelUpCount]), PLAYER_STATE_RESOURCE_GOLD )
            set udg_LevelUpCount = udg_LevelUpCount + 1
        endloop
    endif
    call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + "完成龍龜將軍任務|r" ) ) )
    call DisplayTimedTextToForce( GetPlayersAll(), 15.00, ( "|c00af5cff玩家" + ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + "同盟獲得500賞金以及提升等級！|r" ) ) )
    set udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + GetUnitLevel(GetDyingUnit()) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, udg_Multiboard_Spots[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], I2S(udg_MissionScore[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
    call DisplayTextToForce( GetPlayersAll(), ( udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + "獲得新稱號!" ) )
    set udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = "|c20FF0000(欺負烏龜的)|r"
    call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), ( ( udg_PlayerStarHeroTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_PlayerMissionTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) + ( udg_PlayerItemTitle[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + udg_Borad_PlayerNames[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] ) ) )
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

