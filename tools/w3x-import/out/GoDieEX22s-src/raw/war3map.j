endfunction

//===========================================================================
// Trigger: DragonChannel
//===========================================================================
function Trig_DragonChannel_Func001Func001C takes nothing returns boolean
    if ( not ( OrderId2StringBJ(GetUnitCurrentOrder(udg_ChiRam)) == "channel" ) ) then
        return false
    endif
    if ( not ( udg_DragonTimerCounter != 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonChannel_Func001Func010Func001A takes nothing returns nothing
    call CameraSetEQNoiseForPlayer( GetOwningPlayer(GetEnumUnit()), 12.00 )
endfunction

function Trig_DragonChannel_Func001C takes nothing returns boolean
    if ( not Trig_DragonChannel_Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_DragonChannel_Actions takes nothing returns nothing
    if ( Trig_DragonChannel_Func001C() ) then
        set udg_DragonTimerCounter = ( udg_DragonTimerCounter + 1 )
        set udg_DragonSize = ( I2R(udg_DragonTimerCounter) * 450.00 )
        call SetUnitScalePercent( udg_DragonExpUnit, udg_DragonSize, udg_DragonSize, udg_DragonSize )
        call AddSpecialEffectLocBJ( udg_DragonPoint, "Abilities\\Spells\\Other\\Drain\\ManaDrainTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        call PauseTimerBJ( true, udg_DragonTimer )
        set udg_DragonCounter = 0
        call EnableTrigger( gg_trg_DragonExpGo )
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call ForGroupBJ( GetUnitsInRectAll(RectFromCenterSizeBJ(GetSpellTargetLoc(), 1600.00, 1600.00)), function Trig_DragonChannel_Func001Func010Func001A )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        call TriggerSleepAction( 0.50 )
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = 12
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CameraClearNoiseForPlayer( ConvertedPlayer(GetForLoopIndexB()) )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
    endif
endfunction

//===========================================================================
function InitTrig_DragonChannel takes nothing returns nothing
    set gg_trg_DragonChannel = CreateTrigger(  )
    call DisableTrigger( gg_trg_DragonChannel )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_DragonChannel, udg_DragonTimer )
    call TriggerAddAction( gg_trg_DragonChannel, function Trig_DragonChannel_Actions )
endfunction

