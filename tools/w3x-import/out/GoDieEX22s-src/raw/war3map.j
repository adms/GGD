// Trigger: Lumber
//===========================================================================
function Trig_Lumber_Func001C takes nothing returns boolean
    if ( not ( GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) > 0 ) ) then
        return false
    endif
    if ( not ( GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) <= 12 ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetDyingUnit()) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lumber_Conditions takes nothing returns boolean
    if ( not Trig_Lumber_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Lumber_Func004C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lumber_Func005C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lumber_Actions takes nothing returns nothing
    call AdjustPlayerStateBJ( ( ( udg_NumberOfE * 5 ) + 5 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    call AdjustPlayerStateBJ( 10, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_LUMBER )
    if ( Trig_Lumber_Func004C() ) then
        call AdjustPlayerStateBJ( ( GetHeroLevel(GetTriggerUnit()) * 5 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    else
        call DoNothing(  )
    endif
    if ( Trig_Lumber_Func005C() ) then
        call AdjustPlayerStateBJ( ( GetHeroLevel(GetTriggerUnit()) * 5 ), GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    else
        call DoNothing(  )
    endif
endfunction

