//===========================================================================
// Trigger: Map Initialization
//===========================================================================
function Trig_Map_Initialization_Actions takes nothing returns nothing
    call InitHashtableBJ(  )
    call InitGameCacheBJ( "DotATemplate" )
    set udg_cache = GetLastCreatedGameCacheBJ()
    call PlayMusicBJ( gg_snd_Credits )
    set udg_Combine_Charged_Items = true
    set udg_Combine_Charges_Max = 50
    set udg_End_Game_If_All_Gone = false
    set udg_Hero_Revive_Time_FactorRed = 0.60
    set udg_Hero_Revive_Time_FactorGreen = 0.60
    set udg_Hostile_Revive_Time = 120.00
    set udg_Player_Starting_Gold = 1300
    set udg_Repick_Cost_Ammount = -150
    set udg_Sort_Board_By_Kills = true
    set udg_IsSingleGame = bj_isSinglePlayer
    // -
    // Order is important. Leave as is.
    // -
    call SetTimeOfDay( 8.00 )
    call TriggerExecute( gg_trg_Setup_Players )
    call TriggerExecute( gg_trg_Player_Colors )
    call TriggerExecute( gg_trg_Setup_Invunerable )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_299", "TRIGSTR_589", "ReplaceableTextures\\CommandButtons\\BTNLoadDwarf.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_628", "TRIGSTR_643", "ReplaceableTextures\\CommandButtons\\BTNBox.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_645", "TRIGSTR_5381", "ReplaceableTextures\\WorldEditUI\\Editor-MultipleUnits.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1140", "TRIGSTR_1190", "ReplaceableTextures\\WorldEditUI\\Editor-Random-Unit.blp" )
endfunction

//===========================================================================
