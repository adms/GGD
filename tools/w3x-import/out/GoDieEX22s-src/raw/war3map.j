    if ( Trig_ThunderFist_Func006Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_ThunderUnitGroup )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_ThunderFist_Func006Func001Func006C() ) then
            call UnitDamageTargetBJ( udg_NegiUnit, GetEnumUnit(), udg_ThunderLanceDam, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        else
            call UnitDamageTargetBJ( udg_NegiUnit, GetEnumUnit(), ( udg_ThunderLanceDam * 0.50 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        endif
    else
    endif
endfunction

function Trig_ThunderFist_Func007C takes nothing returns boolean
    if ( not ( udg_NegiDistan <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ThunderFist_Actions takes nothing returns nothing
    set udg_ThunderLancePoint = PolarProjectionBJ(udg_ThunderLancePoint, 100.00, udg_NegiAngle)
    call AddSpecialEffectLocBJ( udg_ThunderLancePoint, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_NegiDistan = ( udg_NegiDistan - 100.00 )
    set udg_NegiInt = 1
    loop
        exitwhen udg_NegiInt > 6
        set udg_NegiPoint = PolarProjectionBJ(udg_ThunderLancePoint, 50.00, ( 60.00 * I2R(udg_NegiInt) ))
        call AddSpecialEffectLocBJ( udg_NegiPoint, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation( udg_NegiPoint )
        set udg_NegiInt = udg_NegiInt + 1
    endloop
    call ForGroupBJ( GetUnitsInRangeOfLocAll(200.00, udg_ThunderLancePoint), function Trig_ThunderFist_Func006A )
    if ( Trig_ThunderFist_Func007C() ) then
        call GroupClear( udg_ThunderUnitGroup )
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

