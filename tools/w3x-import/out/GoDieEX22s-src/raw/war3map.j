//===========================================================================
// Trigger: Bowling
//===========================================================================
function Trig_Bowling_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CV' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bowling_Actions takes nothing returns nothing
    // 變數設定
    set udg_Bowling_IndexBear = 0
    set udg_BearUnit = GetTriggerUnit()
    set udg_P1Bear = GetUnitLoc(GetTriggerUnit())
    set udg_P2Bear = GetSpellTargetLoc()
    set udg_Bowling_AngleBear = AngleBetweenPoints(udg_P1Bear, udg_P2Bear)
    set udg_BearDamage = ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_BearUnit, true)) * 2.00 ) + ( ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A0CV', udg_BearUnit)) ) + 50.00 ) )
    call SetUnitTimeScalePercent( udg_BearUnit, 700.00 )
    call GroupClear( udg_BearGroup )
    call RemoveLocation( udg_P1Bear )
    call RemoveLocation( udg_P2Bear )
    call EnableTrigger( gg_trg_BowlingEffect )
endfunction

//===========================================================================
function InitTrig_Bowling takes nothing returns nothing
    set gg_trg_Bowling = CreateTrigger(  )
    call DisableTrigger( gg_trg_Bowling )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Bowling, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Bowling, Condition( function Trig_Bowling_Conditions ) )
    call TriggerAddAction( gg_trg_Bowling, function Trig_Bowling_Actions )
endfunction

//===========================================================================
// Trigger: BowlingEffect
//
// 
//===========================================================================
function Trig_BowlingEffect_Func005A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_BowlingEffect_Func007Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_BearUnit)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_BearGroup) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_BowlingEffect_Func007A takes nothing returns nothing
    if ( Trig_BowlingEffect_Func007Func001C() ) then
        set udg_P5Bear = GetUnitLoc(GetEnumUnit())
        call AddSpecialEffectLocBJ( udg_P5Bear, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitAnimation( GetEnumUnit(), "death" )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "BloodBreathStream.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_BearUnit, GetEnumUnit(), udg_BearDamage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call GroupAddUnitSimple( GetEnumUnit(), udg_BearGroup )
    else
    endif
endfunction

function Trig_BowlingEffect_Func011Func001C takes nothing returns boolean
    if ( ( DistanceBetweenPoints(udg_P2Bear, udg_P3Bear) >= 10.00 ) ) then
        return true
    endif
    if ( ( udg_Bowling_IndexBear >= 12 ) ) then
        return true
    endif
    return false
endfunction

function Trig_BowlingEffect_Func011Func006Func004Func001Func005Func006C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_P5Bear, udg_P4Bear) >= 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BowlingEffect_Func011Func006Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_BearUnit)) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BowlingEffect_Func011Func006Func004A takes nothing returns nothing
    if ( Trig_BowlingEffect_Func011Func006Func004Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_BearUnit, GetEnumUnit(), 50.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call SetUnitAnimation( GetEnumUnit(), "death" )
        set udg_Bear_Index2 = 1
        loop
            exitwhen udg_Bear_Index2 > 5
            set udg_P5Bear = GetUnitLoc(GetEnumUnit())
            set udg_KnockBack_AngleBear = AngleBetweenPoints(udg_P1Bear, udg_P5Bear)
            set udg_P4Bear = PolarProjectionBJ(udg_P5Bear, 50.00, udg_KnockBack_AngleBear)
            call SetUnitPositionLoc( GetEnumUnit(), udg_P4Bear )
            set udg_P5Bear = GetUnitLoc(GetEnumUnit())
            if ( Trig_BowlingEffect_Func011Func006Func004Func001Func005Func006C() ) then
                call SetUnitPositionLoc( GetEnumUnit(), udg_P5Bear )
                set udg_Bear_Index2 = 5
            else
            endif
            call RemoveLocation( udg_P5Bear )
            call RemoveLocation( udg_P4Bear )
            set udg_Bear_Index2 = udg_Bear_Index2 + 1
        endloop
    else
    endif
endfunction

function Trig_BowlingEffect_Func011Func006C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_P2Bear, udg_P3Bear) >= 10.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BowlingEffect_Func011C takes nothing returns boolean
    if ( not Trig_BowlingEffect_Func011Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_BowlingEffect_Actions takes nothing returns nothing
    call SetUnitFacingTimed( udg_BearUnit, ( GetUnitFacing(udg_BearUnit) + 190.00 ), 0 )
    set udg_Bowling_IndexBear = ( udg_Bowling_IndexBear + 1 )
    set udg_P1Bear = GetUnitLoc(udg_BearUnit)
    set udg_P2Bear = PolarProjectionBJ(udg_P1Bear, 50.00, udg_Bowling_AngleBear)
    call EnumDestructablesInCircleBJ( 350.00, udg_Bear_P2, function Trig_BowlingEffect_Func005A )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(200.00, udg_P2Bear), function Trig_BowlingEffect_Func007A )
    call SetUnitPositionLoc( udg_BearUnit, udg_P2Bear )
    call SetUnitAnimation( udg_BearUnit, "attack slam" )
    set udg_P3Bear = GetUnitLoc(udg_BearUnit)
    if ( Trig_BowlingEffect_Func011C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call GroupClear( udg_BearGroup )
        call SetUnitAnimationWithRarity( udg_BearUnit, "stand three", RARITY_FREQUENT )
        call SetUnitTimeScalePercent( udg_BearUnit, 100.00 )
        if ( Trig_BowlingEffect_Func011Func006C() ) then
            call AddSpecialEffectLocBJ( udg_P2Bear, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            set bj_wantDestroyGroup = true
            call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_P2Bear), function Trig_BowlingEffect_Func011Func006Func004A )
        else
        endif
    else
    endif
    call RemoveLocation( udg_P1Bear )
    call RemoveLocation( udg_P2Bear )
    call RemoveLocation( udg_P3Bear )
endfunction

//===========================================================================
function InitTrig_BowlingEffect takes nothing returns nothing
    set gg_trg_BowlingEffect = CreateTrigger(  )
    call DisableTrigger( gg_trg_BowlingEffect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_BowlingEffect, 0.05 )
    call TriggerAddAction( gg_trg_BowlingEffect, function Trig_BowlingEffect_Actions )
endfunction

