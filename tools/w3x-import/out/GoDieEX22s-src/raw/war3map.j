    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_ThunderUnitGroup) == false ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_NegiUnit)) == true ) ) then
        return false
    endif
