    set gg_trg_Iamacoward = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_Iamacoward, Player(1), "-kill ", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_Iamacoward, Player(2), "-kill ", false )
