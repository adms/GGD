    set udg_HeroType[23] = 'Nbst'
    set udg_HeroType[24] = 'Umal'
    set udg_HeroType[25] = 'Harf'
    set udg_HeroType[26] = 'Naka'
    set udg_HeroType[27] = 'Huth'
    set udg_HeroType[28] = 'Oshd'
    set udg_HeroType[29] = 'Orkn'
    set udg_HeroType[30] = 'Othr'
    set udg_HeroType[31] = 'Opgh'
    set udg_HeroType[32] = 'Obla'
    set udg_HeroType[33] = 'Osam'
    set udg_HeroType[34] = 'Hpal'
    set udg_HeroType[35] = 'Ubal'
    set udg_HeroType[36] = 'Uvng'
    set udg_HeroType[37] = 'U00H'
    set udg_HeroType[38] = 'Nman'
    set udg_HeroType[39] = 'H001'
    set udg_HeroType[40] = 'N003'
    set udg_HeroType[41] = 'Uwar'
    set udg_HeroType[42] = 'Emns'
    set udg_HeroType[43] = 'Edem'
    set udg_HeroType[44] = 'Hvsh'
    set udg_HeroType[45] = 'Usyl'
    set udg_HeroType[46] = 'Hapm'
    set udg_HeroType[47] = 'O00L'
    set udg_HeroType[48] = 'N00B'
    set udg_HeroType[49] = 'Ofar'
    set udg_HeroType[50] = 'E00R'
    set udg_HeroType[51] = 'H00L'
    set udg_HeroType[52] = 'U012'
    set udg_HeroType[53] = 'Ecen'
    set udg_HeroType[54] = 'Udea'
    set udg_HeroType[55] = 'E00T'
    set udg_HeroType[56] = 'E00S'
    set udg_HeroType[57] = 'U00K'
    set udg_HeroType[58] = 'Ogld'
    set udg_HeroType[59] = 'U00J'
    set udg_HeroType[60] = 'U00N'
    set udg_HeroType[61] = 'E00W'
    set udg_HeroType[62] = 'U00V'
    set udg_HeroType[63] = 'H01N'
    set udg_HeroType[64] = 'H01U'
    set udg_HeroType[65] = 'O01Z'
    set udg_HeroType[66] = 'H022'
    set udg_HeroType[67] = 'E00V'
    set udg_HeroType[68] = 'O00K'
    set udg_HeroType[69] = 'H02K'
    set udg_HeroType[70] = 'Hgam'
    set udg_HeroType[71] = 'H02S'
    set udg_HeroType[72] = 'H02V'
    set udg_HeroType[73] = 'Ekee'
    set udg_HeroType[74] = 'E015'
    set udg_HeroType[75] = 'E00J'
    set udg_HeroType[76] = 'O02W'
    set udg_HeroType[77] = 'N01L'
    set udg_HeroType[78] = 'O02P'

//將部隊類型陣列丟進亂數部隊類型陣列
    set i = 1
    set j = udg_HeroTypeCount
    loop
        exitwhen i > j
            set udg_RandomHeroType[i] = udg_HeroType[i]
        set i = i + 1
    endloop

//處理亂數部隊類型陣列 利用洗牌演算法
    set i = 1
    set j = udg_HeroTypeCount
    loop
        exitwhen i > j
          set RandomNumber = GetRandomInt(1, udg_HeroTypeCount)
          set udg_Temp = udg_RandomHeroType[RandomNumber]
          set udg_RandomHeroType[RandomNumber] = udg_RandomHeroType[i]
          set udg_RandomHeroType[i] = udg_Temp
        set i = i + 1
    endloop
endfunction

