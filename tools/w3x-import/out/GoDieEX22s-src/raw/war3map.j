//===========================================================================
// Trigger: RandomKillHero
//
// 第一次計時放在SmallMap Singnal
//===========================================================================
function Trig_RandomKillHero_Func006Func001Func002C takes nothing returns boolean
    if ( not ( udg_MaxPointTemp > udg_MaxPoint ) ) then
        return false
    endif
    return true
endfunction

function Trig_RandomKillHero_Func006Func001Func003C takes nothing returns boolean
    if ( not ( udg_PlayerHeroUnit[udg_RandomKillHeroCounter] != null ) ) then
        return false
    endif
    if ( not ( udg_PlayerHeroUnit[udg_RandomKillHeroCounter] != udg_TargetKillHero ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_PlayerHeroUnit[udg_RandomKillHeroCounter], UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_PlayerHeroUnit[udg_RandomKillHeroCounter]) != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RandomKillHero_Func006Func001C takes nothing returns boolean
    if ( not Trig_RandomKillHero_Func006Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_RandomKillHero_Actions takes nothing returns nothing
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8344" )
    call PlaySoundBJ( gg_snd_letsgo01 )
    set udg_MaxPoint = 0
    set udg_PlayerStarHeroTitle[udg_TargetKillHeroNumber] = ""
    call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[udg_TargetKillHeroNumber]), ( ( udg_PlayerStarHeroTitle[udg_TargetKillHeroNumber] + udg_PlayerMissionTitle[udg_TargetKillHeroNumber] ) + ( udg_PlayerItemTitle[udg_TargetKillHeroNumber] + udg_Borad_PlayerNames[udg_TargetKillHeroNumber] ) ) )
    set udg_RandomKillHeroCounter = 2
    loop
        exitwhen udg_RandomKillHeroCounter > 12
        if ( Trig_RandomKillHero_Func006Func001C() ) then
            set udg_MaxPointTemp = ( ( GetHeroLevel(udg_PlayerHeroUnit[udg_RandomKillHeroCounter]) + udg_HeroKill[udg_RandomKillHeroCounter] ) + ( GetRandomInt(1, 30) + ( udg_MissionScore[udg_RandomKillHeroCounter] / 5 ) ) )
            if ( Trig_RandomKillHero_Func006Func001Func002C() ) then
                set udg_MaxPoint = udg_MaxPointTemp
                set udg_TargetKillHeroNumber = udg_RandomKillHeroCounter
            else
            endif
        else
        endif
        set udg_RandomKillHeroCounter = udg_RandomKillHeroCounter + 1
    endloop
    set udg_TargetKillHero = udg_PlayerHeroUnit[udg_TargetKillHeroNumber]
    call DisplayTextToForce( GetPlayersAll(), ( "|c00FFFF00決定了，狙擊目標就是|r" + ( udg_Borad_PlayerNames[udg_TargetKillHeroNumber] + ( "|c00FFFF00，殺死目標的人將可獲得額外賞金" + ( I2S(( udg_MaxPoint * 35 )) + "及木頭150！|r" ) ) ) ) )
    set udg_PlayerStarHeroTitle[udg_TargetKillHeroNumber] = "|c00FF0000(打我阿笨蛋)|r"
    call SetPlayerName( GetOwningPlayer(udg_PlayerHeroUnit[udg_TargetKillHeroNumber]), ( ( udg_PlayerStarHeroTitle[udg_TargetKillHeroNumber] + udg_PlayerMissionTitle[udg_TargetKillHeroNumber] ) + ( udg_PlayerItemTitle[udg_TargetKillHeroNumber] + udg_Borad_PlayerNames[udg_TargetKillHeroNumber] ) ) )
    call StartTimerBJ( udg_TargetKillHreoTimer, false, 180.00 )
endfunction

//===========================================================================
