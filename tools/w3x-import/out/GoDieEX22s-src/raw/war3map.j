//===========================================================================
// Trigger: FireLord
//===========================================================================
function Trig_FireLord_Func014C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetAttacker(), 'I06I') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetAttacker(), GetOwningPlayer(GetAttackedUnitBJ())) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Conditions takes nothing returns boolean
    if ( not Trig_FireLord_Func014C() ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Actions takes nothing returns nothing
    local real Distand
    local unit Attacker = GetAttacker()
    local unit Attacked = GetAttackedUnitBJ()
    set udg_P0 = GetUnitLoc(GetAttackedUnitBJ())
    set udg_P1 = GetUnitLoc(GetAttacker())
    set Distand = DistanceBetweenPoints( udg_P0 , udg_P1 )
    call RemoveLocation( udg_P0 )
    call RemoveLocation( udg_P1 )
    call TriggerSleepAction( 0.20 )
    call UnitDamageTargetBJ( Attacker , Attacked , ( 0.11 * ( Distand + I2R( GetHeroStatBJ( bj_HEROSTAT_AGI , Attacker , true)) ) ), ATTACK_TYPE_PIERCE, DAMAGE_TYPE_POISON )
    set Attacker = null
    set Attacked = null
endfunction

//===========================================================================
function InitTrig_FireLord takes nothing returns nothing
    set gg_trg_FireLord = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FireLord, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_FireLord, Condition( function Trig_FireLord_Conditions ) )
    call TriggerAddAction( gg_trg_FireLord, function Trig_FireLord_Actions )
endfunction

