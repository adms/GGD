    if ( not ( GetUnitLifePercent(udg_PlayerHeroUnit[udg_AI_COUNT]) <= 50.00 ) ) then
        return false
    endif
    if ( not ( GetAIDifficulty(ConvertedPlayer(udg_AI_COUNT)) != AI_DIFFICULTY_NEWBIE ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001Func002Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(udg_PlayerHeroUnit[udg_AI_COUNT])) == MAP_CONTROL_COMPUTER ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_AINotice) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_back_Actions takes nothing returns nothing
    if ( Trig_back_Func001C() ) then
        if ( Trig_back_Func001Func001C() ) then
            set udg_AI_COUNT = 2
            loop
                exitwhen udg_AI_COUNT > 6
                if ( Trig_back_Func001Func001Func001Func001C() ) then
                    if ( Trig_back_Func001Func001Func001Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_LoveHeroPoint) )
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_love_back, Player(0)))
                        if ( Trig_back_Func001Func001Func001Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "smart", GetRectCenter(gg_rct_LoveHeroPoint) )
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        else
            set udg_AI_COUNT = 8
            loop
                exitwhen udg_AI_COUNT > 12
                if ( Trig_back_Func001Func001Func002Func001C() ) then
                    if ( Trig_back_Func001Func001Func002Func001Func002C() ) then
                        call SelectHeroSkill( udg_PlayerHeroUnit[udg_AI_COUNT], GetLearnedSkillBJ() )
                        call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                    else
                        set udg_MoveUnit = GroupPickRandomUnit(GetUnitsInRectOfPlayer(gg_rct_godie_back, Player(6)))
                        if ( Trig_back_Func001Func001Func002Func001Func002Func002C() ) then
                            call UnitUseItemTarget( udg_PlayerHeroUnit[udg_AI_COUNT], GetItemOfTypeFromUnitBJ(udg_PlayerHeroUnit[udg_AI_COUNT], 'I048'), udg_MoveUnit )
                        else
                            call IssuePointOrderLocBJ( udg_PlayerHeroUnit[udg_AI_COUNT], "move", GetRectCenter(gg_rct_DieHeroPoint) )
                        endif
                    endif
                else
                endif
                set udg_AI_COUNT = udg_AI_COUNT + 1
            endloop
        endif
    else
    endif
    call DisplayTextToForce( GetPlayersAllies(GetTriggerPlayer()), ( ( "" + udg_Borad_PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())] ) + ": 退退退~大家撤退!!" ) )
    call AdjustPlayerStateBJ( -100, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
endfunction

