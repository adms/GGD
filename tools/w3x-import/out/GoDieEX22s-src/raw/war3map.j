    set gg_trg_Luf_Axe = CreateTrigger(  )
    call DisableTrigger( gg_trg_Luf_Axe )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Luf_Axe, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Luf_Axe, Condition( function Trig_Luf_Axe_Conditions ) )
    call TriggerAddAction( gg_trg_Luf_Axe, function Trig_Luf_Axe_Actions )
endfunction

//===========================================================================
// Trigger: Luf Axe Effect
//===========================================================================
function Trig_Luf_Axe_Effect_Func006Func020Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Luf_Axe_Effect_Func006Func020A takes nothing returns nothing
    if ( Trig_Luf_Axe_Effect_Func006Func020Func001C() ) then
        call KillDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Luf_Axe_Effect_Func006Func025Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_Luff_ToDamUnit)) != true ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_Luff_Jump_Caster ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Luf_Axe_Effect_Func006Func025A takes nothing returns nothing
    if ( Trig_Luf_Axe_Effect_Func006Func025Func001C() ) then
        call SetUnitPositionLoc( GetEnumUnit(), PolarProjectionBJ(GetUnitLoc(GetEnumUnit()), -75.00, AngleBetweenPoints(GetUnitLoc(GetEnumUnit()), udg_Luff_P1)) )
        call UnitDamageTargetBJ( udg_Luff_ToDamUnit, GetEnumUnit(), 225.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_Luf_Axe_Effect_Func006C takes nothing returns boolean
    if ( not ( udg_Luff_Jump_Index >= 21.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Luf_Axe_Effect_Actions takes nothing returns nothing
    set udg_Luff_Jump_Index = ( udg_Luff_Jump_Index + 1 )
    set udg_Luff_P1 = GetUnitLoc(udg_Luff_Jump_Caster)
    set udg_Luff_P2 = PolarProjectionBJ(udg_Luff_P1, udg_Luff_Jump_dDist, ( udg_Luff_Jump_Angle + 180.00 ))
    call SetUnitPositionLoc( udg_Luff_Jump_Caster, udg_Luff_P2 )
    call SetUnitFlyHeightBJ( udg_Luff_Jump_Caster, ( ( -1.50 * Pow(( udg_Luff_Jump_Index - 21.00 ), 2.00) ) + 600.00 ), 0.00 )
    if ( Trig_Luf_Axe_Effect_Func006C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Luff_P1 = udg_Luff_Axe_FinalPoint
        call SetUnitFlyHeightBJ( udg_Luff_ToDamUnit, 625.00, 0.00 )
        call SetUnitPositionLocFacingLocBJ( udg_Luff_ToDamUnit, PolarProjectionBJ(udg_Luff_Axe_FinalPoint, 75.00, udg_Luff_Jump_Angle), GetUnitLoc(udg_Luff_Jump_Caster) )
        call CreateTextTagUnitBJ( "TRIGSTR_3855", udg_Luff_ToDamUnit, 0, 14.00, 100, 0.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.80 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        call SetUnitTimeScalePercent( udg_Luff_ToDamUnit, 200.00 )
        call SetUnitAnimationWithRarity( udg_Luff_ToDamUnit, "spell", RARITY_RARE )
        call TriggerSleepAction( 0.15 )
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_Luff_Jump_Caster, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitFlyHeightBJ( udg_Luff_Jump_Caster, 0.00, 2000.00 )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Luff_ToDamUnit, "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitFlyHeightBJ( udg_Luff_ToDamUnit, 0.00, 1000.00 )
        call TriggerSleepAction( 0.20 )
        call EnumDestructablesInCircleBJ( 250.00, udg_Luff_P1, function Trig_Luf_Axe_Effect_Func006Func020A )
        call AddSpecialEffectLocBJ( udg_Luff_P1, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TriggerSleepAction( 0.05 )
        call TerrainDeformationRippleBJ( 1.50, false, GetUnitLoc(udg_Luff_Jump_Caster), 50.00, 650.00, 300.00, 0.50, 100.00 )
        call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_Luff_P1), function Trig_Luf_Axe_Effect_Func006Func025A )
        call SetUnitFlyHeightBJ( udg_Luff_ToDamUnit, 0.00, 0.00 )
        call DestroyEffectBJ( udg_LufEffect[1] )
        call DestroyEffectBJ( udg_LufEffect[2] )
        call RemoveLocation( udg_P1 )
        call SetUnitTimeScalePercent( udg_Luff_Jump_Caster, 100.00 )
        call SetUnitTimeScalePercent( udg_Luff_ToDamUnit, 100.00 )
        call UnitRemoveAbilityBJ( 'A0FZ', udg_Luff_ToDamUnit )
        call PauseUnitBJ( false, udg_Luff_ToDamUnit )
        call UnitRemoveAbilityBJ( 'A0FZ', udg_Luff_Jump_Caster )
        call PauseUnitBJ( false, udg_Luff_Jump_Caster )
        call UnitDamageTargetBJ( udg_Luff_ToDamUnit, udg_Luff_Jump_Caster, ( udg_LufDamMath + I2R(( ( udg_LuffAxeLevel * 125 ) + 125 )) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call SelectUnitForPlayerSingle( udg_Luff_ToDamUnit, GetOwningPlayer(udg_Luff_ToDamUnit) )
        call SelectUnitForPlayerSingle( udg_Luff_Jump_Caster, GetOwningPlayer(udg_Luff_Jump_Caster) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Luf_Axe_Effect takes nothing returns nothing
    set gg_trg_Luf_Axe_Effect = CreateTrigger(  )
    call DisableTrigger( gg_trg_Luf_Axe_Effect )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Luf_Axe_Effect, ( 0.15 / 10.00 ) )
    call TriggerAddAction( gg_trg_Luf_Axe_Effect, function Trig_Luf_Axe_Effect_Actions )
