{
  "name": "@ggd/model-budget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget:report": "node --import tsx emit_report.ts",
    "budget:check": "node --import tsx emit_report.ts --check",
    "budget:guard": "node --import tsx guard.ts",
    "budget:worklist": "node --import tsx worklist.ts",
    "budget:optimize": "node --import tsx optimize.ts",
    "budget:policy-doc": "node --import tsx generate_policy_doc.ts",
    "budget:policy-doc:check": "node --import tsx generate_policy_doc.ts --check",
    "budget:priority-audit": "node --import tsx audit_priority_release.ts",
    "budget:priority-audit:check": "node --import tsx audit_priority_release.ts --check",
    "budget:trim-clips": "node --import tsx trimClips.ts",
    "budget:optimize:setup-geometry": "bash optimize/bootstrap-geometry.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
