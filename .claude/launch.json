        "dev",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "test-dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ggd/test-dashboard",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "content-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ggd/content-api",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "editor",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ggd/editor",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "client-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ggd/client",
        "dev",
        "--port",
        "39527",
