{
  "name": "@ggd/content-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DEV-ONLY Fastify service: validated CRUD over content/ JSON + incremental reindex + SSE change events. Never deployed to production (static nginx serves content there).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ggd/shared": "workspace:*",
    "chokidar": "^4.0.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
