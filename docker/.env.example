# docker/.env.example — copy to docker/.env and fill with STRONG values.
#
#   cp docker/.env.example docker/.env
#   # then generate real secrets (do NOT commit docker/.env — it is gitignored):
#   printf 'REDIS_PASSWORD=%s\n'               "$(openssl rand -hex 32)" >> docker/.env
#   printf 'JWT_SIGNING_SECRET=%s\n'           "$(openssl rand -hex 32)" >> docker/.env
#   printf 'PLATFORM_GAME_SHARED_SECRET=%s\n'  "$(openssl rand -hex 32)" >> docker/.env
#
# compose.yaml uses the ${VAR:?...} fail-fast form, so `docker compose up|config`
# errors until these are set. The placeholders below are intentionally invalid
# (they are NOT usable secrets) — replace every one.

REDIS_PASSWORD=replace-me-with-openssl-rand-hex-32
JWT_SIGNING_SECRET=replace-me-with-openssl-rand-hex-32
PLATFORM_GAME_SHARED_SECRET=replace-me-with-openssl-rand-hex-32
