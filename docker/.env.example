# docker/.env.example — copy to docker/.env and fill with STRONG values.
#
#   cp docker/.env.example docker/.env
#   # then generate real secrets (do NOT commit docker/.env — it is gitignored):
#   printf 'REDIS_PASSWORD=%s\n'               "$(openssl rand -hex 32)" >> docker/.env
#   printf 'JWT_SIGNING_SECRET=%s\n'           "$(openssl rand -hex 32)" >> docker/.env
#   printf 'PLATFORM_GAME_SHARED_SECRET=%s\n'  "$(openssl rand -hex 32)" >> docker/.env
#
# compose.yaml uses the ${VAR:?...} fail-fast form, so `docker compose up|config`
# errors until these are set. The placeholders below are intentionally invalid
# (they are NOT usable secrets) — replace every one.
#
# ---------------------------------------------------------------------------
# ROTATING an already-deployed secret (GH#181)
# ---------------------------------------------------------------------------
# PLATFORM_GAME_SHARED_SECRET is the platform<->game HMAC key, and BOTH services
# read the SAME variable (compose.yaml:65 platform, compose.yaml:84 game).
# Rotating it in one service only is the footgun: the two sides then disagree,
# every room-open / seat handshake fails its HMAC check, and nothing in the
# logs says "you rotated half of it". So recreate the pair in one command:
#
#   # edit docker/.env on the host, then:
#   docker compose -f docker/compose.yaml --env-file docker/.env \
#     up -d --force-recreate platform game
#
# The new value must survive the strength rules in
# packages/shared/src/deploySecrets.ts — apps/game-server/src/config/secretGuard.ts
# is fail-CLOSED outside development, so a weak or placeholder value makes the
# game shard refuse to boot rather than serve unauthenticated joins.
# After recreating, confirm BOTH containers are up and one room really opens.
#
# The admin account password is NOT in this file and is not rotated here: use
# the self-service endpoint POST /api/v1/account/password
# (apps/platform/internal/auth/password.go), which also revokes every live
# refresh token of that account. CLI recovery path: apps/platform/cmd/ownerreset.

REDIS_PASSWORD=replace-me-with-openssl-rand-hex-32
JWT_SIGNING_SECRET=replace-me-with-openssl-rand-hex-32
PLATFORM_GAME_SHARED_SECRET=replace-me-with-openssl-rand-hex-32
