# docker/backup.env.example — template for the off-machine backup's config.
#
# COPY IT, DO NOT EDIT IT IN PLACE. On the host:
#
#   mkdir -p ~/.config/ggd
#   cp ~/GGD/docker/backup.env.example ~/.config/ggd/backup.env
#   chmod 600 ~/.config/ggd/backup.env
#   $EDITOR ~/.config/ggd/backup.env
#
# ggd-backup.sh looks for /etc/ggd/backup.env first, then
# ~/.config/ggd/backup.env. The per-user path is the one to use on ggd.adms.ai:
# writing to /etc needs sudo, and sudo there wants a password.
#
# ---------------------------------------------------------------------------
# THIS FILE DELIBERATELY LIVES OUTSIDE data/
# ---------------------------------------------------------------------------
# It is the configuration of the thing that rescues data/. If it lived inside
# data/ — or in the admin console, whose settings are stored in data/ — then
# after losing the disk you would have to restore the backup in order to find
# out where the backups are. That is why these knobs are a file and not a 後台
# page. (Every one of them is still a knob: nothing below is hard-coded in the
# script's logic.)
#
# NOTHING SECRET BELONGS IN HERE. The GCS path is reached with the VM's own
# attached service account; the rsync path is reached with an ssh key that lives
# in ~/.ssh. If you ever find yourself pasting a credential into this file, the
# destination is configured wrong — see docs/runbooks/offsite-backup.md § 2.
# ---------------------------------------------------------------------------

# --- WHERE THE BYTES GO (the one decision with no safe default) -------------
# none  = refuse to run. That is the shipped default ON PURPOSE: a copy that
#         never leaves the VM is the exact failure GH#123 describes.
# gcs   = a bucket in the same GCP project        GGD_BACKUP_DEST_URI=gs://<bucket>/<prefix>
# rsync = another machine over ssh                GGD_BACKUP_DEST_URI=user@host:/path
# dir   = a mounted disk / NFS / USB stick        GGD_BACKUP_DEST_URI=/mnt/backup/ggd
GGD_BACKUP_DEST=none
GGD_BACKUP_DEST_URI=

# --- WHAT TRAVELS -----------------------------------------------------------
# platformarchive group names, comma separated. `core` is always included.
#   core     accounts + password hashes, 藍水晶 wallets, 邀請碼, 白名單,
#            戰鬥系統設定, 內容覆蓋層, 公告, 好友, 排行榜快照   (~20 KB)
#   matches  對戰紀錄 + 覆盤帳本
#   history  個人戰績履歷
#   audit    管理稽核紀錄
#   replays  對戰回放 — the bulk of the bytes, and the owner counts them as
#            irreplaceable, which is why `all` is the default here.
GGD_BACKUP_GROUPS=all

# --- HOW OFTEN --------------------------------------------------------------
# Read by `ggd-backup.sh cron`, which prints the crontab line for you. Five
# cron fields. 04:17 every day by default — off-peak, and a deliberately odd
# minute so it never lines up with everything else on the box.
GGD_BACKUP_SCHEDULE=17 4 * * *

# --- HOW MANY COPIES SURVIVE ------------------------------------------------
# local  = staging copies kept on the VM. This is a cache for fast re-upload,
#          NOT a backup — it dies with the machine. 3 is plenty.
# remote = copies kept off-machine. Set to 0 to hand retention to the
#          destination instead (for GCS that means a bucket lifecycle rule,
#          which keeps working after the VM is gone — this script does not).
GGD_BACKUP_KEEP_LOCAL=3
GGD_BACKUP_KEEP_REMOTE=30

# --- WHEN `status` STARTS SHOUTING -----------------------------------------
# Hours since the last VERIFIED backup after which `ggd-backup.sh status` exits
# non-zero. Daily schedule + one tolerated miss + slack = 36.
GGD_BACKUP_MAX_AGE_HOURS=36

# --- HOW THE EXPORTER IS REACHED -------------------------------------------
# auto  = exec into the running platform container, and if that fails start a
#         throwaway one from the same image. `auto` is the default because a
#         crash-looping platform is a night you still want a backup.
# exec  = only the running container (fails loudly if it is down)
# run   = only a throwaway container
# local = `go run ./cmd/platformarchive` from a checkout (laptop / CI only)
GGD_BACKUP_SOURCE=auto

# --- PATHS ------------------------------------------------------------------
# Staging directory on the VM. Must NOT be inside the repo's data/ (an archive
# under data/ would be swept into the next archive) and must not be inside the
# repo at all (git status noise on every deploy).
GGD_BACKUP_STAGING=$HOME/ggd-backups

# --- SAFETY VALVES (leave these alone unless you know why) ------------------
# Smallest believable archive, in bytes. Anything under this is treated as a
# truncated stream and the run fails instead of shipping a stub.
GGD_BACKUP_MIN_BYTES=1024
# Hand each fresh archive back to `platformarchive inspect` before shipping it.
# 1 = on. Turning this off removes the only check that the bytes are an archive.
GGD_BACKUP_INSPECT=1
