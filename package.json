{
  "name": "ggd",
  "version": "0.0.0",
  "private": true,
  "description": "3v3v3v3 3D voxel arena MOBA — full-stack monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ggd/game-server --filter @ggd/client dev",
    "dev:editor": "pnpm --parallel --filter @ggd/content-api --filter @ggd/editor dev",
    "dev:all": "pnpm --parallel --filter @ggd/game-server --filter @ggd/client --filter @ggd/editor --filter @ggd/content-api --filter @ggd/admin dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --no-bail --if-present typecheck",
    "test": "pnpm -r --no-bail --if-present test",
    "lint": "eslint apps packages tools",
    "lint:fix": "eslint apps packages tools --fix",
    "todo:check": "tsx tools/todo-check/src/cli.ts --static",
    "todo:runtime": "tsx tools/todo-check/src/cli.ts --runtime",
    "voice:index": "tsx tools/voice-gen/index-lines.mjs",
    "voxel:gen": "pnpm --filter @ggd/voxel-gen voxel:gen",
    "voxel:check": "pnpm --filter @ggd/voxel-gen voxel:check",
    "voxel:build": "pnpm --filter @ggd/voxel-gen voxel:build",
    "voxel:build:check": "pnpm --filter @ggd/voxel-gen voxel:build:check",
    "voxel:extract": "pnpm --filter @ggd/voxel-gen voxel:extract",
    "scenery:gen": "tsx tools/scenery-gen/gen.ts",
    "scenery:check": "tsx tools/scenery-gen/gen.ts --check",
    "caps:export": "tsx tools/capability-export/export.ts",
    "caps:check": "tsx tools/capability-export/export.ts --check",
    "spec:build": "tsx tools/skill-spec/gen_spec.ts",
    "spec:check": "tsx tools/skill-spec/gen_spec.ts --check",
    "overview:build": "tsx tools/innate-legendary/gen_overview.ts",
    "overview:check": "tsx tools/innate-legendary/gen_overview.ts --check",
    "tiers:build": "tsx tools/skill-tiers/gen_tiers.ts",
    "tiers:check": "tsx tools/skill-tiers/gen_tiers.ts --check",
    "content:build": "pnpm --filter @ggd/shared content:build && pnpm spec:build && pnpm overview:build && pnpm tiers:build",
    "content:validate": "pnpm --filter @ggd/shared content:validate",
    "docs:reference": "python3 tools/reference/gen_reference.py",
    "docs:readme": "python3 tools/reference/gen_readme_lists.py",
    "docs:readme:check": "python3 tools/reference/gen_readme_lists.py --check",
    "docs:status": "python3 tools/status/gen_status.py",
    "docs:status:check": "python3 tools/status/gen_status.py --check",
    "docs:status:test": "python3 tools/status/test_gen_status.py",
    "items:csv:export": "python3 tools/item-csv/item_csv.py export -o items.csv",
    "items:csv:import": "python3 tools/item-csv/item_csv.py import -i items.csv",
    "items:csv:requests": "python3 tools/item-csv/item_csv.py requests -i items.csv",
    "champions:csv:export": "python3 tools/champion-csv/champion_csv.py export -o champions.csv",
    "champions:csv:import": "python3 tools/champion-csv/champion_csv.py import -i champions.csv",
    "champions:csv:requests": "python3 tools/champion-csv/champion_csv.py requests -i champions.csv",
    "contract:numbers": "python3 tools/editor-contract/gen_contract_numbers.py",
    "contract:numbers:check": "python3 tools/editor-contract/gen_contract_numbers.py --check",
    "vocab:test": "python3 tools/engine-vocab/test_engine_vocab.py",
    "atlas": "tsx tools/engine-atlas/atlas.ts && tsx tools/engine-atlas/page.ts",
    "atlas:check": "tsx tools/engine-atlas/atlas.ts --check",
    "roster:check": "tsx tools/roster-guard/check.ts",
    "treasure:csv": "python3 tools/economy/gen_treasure_csv.py",
    "treasure:csv:check": "python3 tools/economy/gen_treasure_csv.py --check",
    "atlas:build": "tsx tools/engine-atlas/atlas.ts",
    "skillremake:docs": "python3 tools/skill-remake/refresh_docs.py",
    "skillremake:docs:check": "python3 tools/skill-remake/refresh_docs.py --check",
    "skillremake:json": "python3 tools/skill-remake/batch1.py",
    "skillremake:json:check": "python3 tools/skill-remake/batch1.py --check",
    "skillremake:provenance": "python3 tools/skill-remake/stamp_provenance.py",
    "skillremake:provenance:check": "python3 tools/skill-remake/stamp_provenance.py --check",
    "grail:wishes": "python3 tools/grail-wishes/build_wishes.py",
    "grail:wishes:check": "python3 tools/grail-wishes/build_wishes.py --check",
    "iconstyle:build": "python3 tools/icon-console/emit_style_spec.py",
    "iconstyle:check": "python3 tools/icon-console/emit_style_spec.py --check",
    "legacyindex:build": "python3 tools/legacy-index/build_index.py",
    "legacyindex:check": "python3 tools/legacy-index/build_index.py --check",
    "scenerycc0:build": "tsx tools/scenery-cc0/normalize.ts",
    "scenerycc0:check": "tsx tools/scenery-cc0/normalize.ts --check",
    "newhero:build": "tsx tools/newhero/gen.ts",
    "newhero:check": "tsx tools/newhero/gen.ts --check",
    "skills:sync": "pnpm skillremake:json && pnpm skillremake:provenance && pnpm grail:wishes && pnpm pitch:build && pnpm content:build && pnpm caps:export && pnpm skillremake:docs && pnpm contract:numbers && pnpm atlas:build && pnpm treasure:csv && pnpm docs:readme && pnpm docs:status && pnpm newhero:build && pnpm board:build",
    "skills:check": "pnpm spec:check && pnpm overview:check && pnpm tiers:check && pnpm caps:check && pnpm skillremake:docs:check && pnpm skillremake:json:check && pnpm skillremake:provenance:check && pnpm grail:wishes:check && pnpm contract:numbers:check && pnpm atlas:check && pnpm treasure:csv:check && pnpm docs:readme:check && pnpm docs:status:check && pnpm roster:check && pnpm pitch:check && pnpm newhero:check && pnpm board:check",
    "pitch:build": "python3 tools/w3x-import/build_pitch.py",
    "pitch:check": "python3 tools/w3x-import/build_pitch.py --check",
    "board:build": "python3 tools/board/gen_board.py",
    "board:check": "python3 tools/board/gen_board.py --check"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8",
    "vitest": "^2.1.4"
  }
}
