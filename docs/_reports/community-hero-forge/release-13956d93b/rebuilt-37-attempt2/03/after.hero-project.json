  "sourceDesign": {
    "identity": "作品：《THE KING OF FIGHTERS》  \n定位：飛行道具、近身範圍、突進。",
    "name": "不知火舞",
    "ownerText": "### 03｜不知火舞\n\n作品：《THE KING OF FIGHTERS》  \n定位：飛行道具、近身範圍、突進。\n\n- **PASSIVE｜〔不知火流身法〕**：完成位移後獲得一次短效普攻強化；刷新不疊加。\n- **Q｜花蝶扇**：投出扇子，對沿途合法目標造成傷害。\n- **W｜龍炎舞**：向前揮出近身火焰弧，適合迎擊貼身敵人。\n- **E｜必殺忍蜂**：直線突進撞擊；遇牆或到達最大距離停止。\n- **R｜超必殺忍蜂**：有明顯起手的強化突進連擊，末段小範圍爆發。\n- **EX｜陽炎之舞**：短時間產生跟隨施法的火焰殘像；追加傷害有次數上限，殘像不獨立尋敵。\n\n**審查重點**：扇子、身體與火焰弧各自有正確判定；驗證穿牆、同目標重複碰撞，以及殘像再觸發殘像的循環。\n\n",
    "reviewText": "扇子、身體與火焰弧各自有正確判定；驗證穿牆、同目標重複碰撞，以及殘像再觸發殘像的循環。",
    "schema": "ggd-hero-source-design@1",
    "slots": {
      "E": {
        "baselineBehavior": "向指定方向突進 300 wc3u，造成極小級碰撞範圍傷害與推移。",
        "name": "必殺忍蜂",
        "ownerDescription": "直線突進撞擊；遇牆或到達最大距離停止。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "核對 Owner 原文與模擬／畫面後才可驗收。"
      },
      "EX": {
        "baselineBehavior": "自身取得 3 秒增益：ad +15%。",
        "name": "陽炎之舞",
        "ownerDescription": "短時間產生跟隨施法的火焰殘像；追加傷害有次數上限，殘像不獨立尋敵。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "目前為自身 3 秒 +15% AD；需限次跟隨施法殘像及去重。"
      },
      "PASSIVE": {
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "name": "〔不知火流身法〕",
        "ownerDescription": "完成位移後獲得一次短效普攻強化；刷新不疊加。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "需位移完成後一次普攻增益，刷新不疊加。"
      },
      "Q": {
        "baselineBehavior": "四段沿直線推進的波，每 0.12 秒向前 100 wc3u；各段獨立區域傷害。",
        "name": "花蝶扇",
        "ownerDescription": "投出扇子，對沿途合法目標造成傷害。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "扇子模型及逐彈碰撞需補，模板是分段傷害波。"
      },
      "R": {
        "baselineBehavior": "4 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "name": "超必殺忍蜂",
        "ownerDescription": "有明顯起手的強化突進連擊，末段小範圍爆發。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "缺突進命中後才接連擊條件。"
      },
      "W": {
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "name": "龍炎舞",
        "ownerDescription": "向前揮出近身火焰弧，適合迎擊貼身敵人。",
        "refinementContracts": [
          "M01",
          "M11"
        ],
        "requiredRefinement": "目前為窄直線，需前方近身弧形判定。"
      }
    },
    "sourceSha256": "1fa00b89649191fec570f5d2f500416dd0eef5e8ba6cfbf55cc4383ba0041c42"
  },
