  "sourceDesign": {
    "identity": "作品：《鬼畜王蘭斯／Rance》  \n角色實體：蘭斯；與鬼眼狂刀 KYO 無關。  \n定位：近戰爆發、有限成長、隊伍衝鋒。",
    "name": "鬼畜王蘭斯",
    "ownerText": "### 36｜鬼畜王蘭斯\n\n作品：《鬼畜王蘭斯／Rance》  \n角色實體：蘭斯；與鬼眼狂刀 KYO 無關。  \n定位：近戰爆發、有限成長、隊伍衝鋒。\n\n- **PASSIVE｜〔自信過剩〕**：參與擊殺獲得當回合戰意，上限五層，提升有限近戰能力。\n- **Q｜〔蠻力斬擊〕**：大開大合的正面斬擊。\n- **W｜〔本大爺還沒認真〕**：短暫蓄勢取得護盾，下一次主動攻擊消耗護盾換取有限增傷。\n- **E｜〔霸王突進〕**：直線衝鋒，命中後停止。\n- **R｜Rance Attack／蘭斯攻擊**：蓄力後的大範圍重斬，保留喊招與誇張爆發。\n- **EX｜〔跟著本大爺衝〕**：消耗戰意，為附近友軍提供短效移速與一次普攻強化。\n\n**審查重點**：檢查戰意上限、助攻去重、護盾轉換及群體增益；角色辨識放在戰鬥、性格與演出，技能定義不混用其他作品人物。\n\n",
    "reviewText": "檢查戰意上限、助攻去重、護盾轉換及群體增益；角色辨識放在戰鬥、性格與演出，技能定義不混用其他作品人物。",
    "schema": "ggd-hero-source-design@1",
    "slots": {
      "E": {
        "baselineBehavior": "向指定方向突進 350 wc3u，造成極小級碰撞範圍傷害與推移。",
        "name": "〔霸王突進〕",
        "ownerDescription": "直線衝鋒，命中後停止。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "需命中第一人後停止。"
      },
      "EX": {
        "baselineBehavior": "自身取得 3 秒增益：極小級移速、as +20%。",
        "name": "〔跟著本大爺衝〕",
        "ownerDescription": "消耗戰意，為附近友軍提供短效移速與一次普攻強化。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "目前自身加速攻速；需戰意消耗及附近友軍一次普攻增益。"
      },
      "PASSIVE": {
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "name": "〔自信過剩〕",
        "ownerDescription": "參與擊殺獲得當回合戰意，上限五層，提升有限近戰能力。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "需擊殺／助攻一次戰意，上限五層、回合重置。"
      },
      "Q": {
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "name": "〔蠻力斬擊〕",
        "ownerDescription": "大開大合的正面斬擊。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "需正面蠻力弧形斬。"
      },
      "R": {
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "name": "Rance Attack／蘭斯攻擊",
        "ownerDescription": "蓄力後的大範圍重斬，保留喊招與誇張爆發。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "需大範圍重斬、長起手與總傷害預算。"
      },
      "W": {
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-36-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "name": "〔本大爺還沒認真〕",
        "ownerDescription": "短暫蓄勢取得護盾，下一次主動攻擊消耗護盾換取有限增傷。",
        "refinementContracts": [
          "M01",
          "M12"
        ],
        "requiredRefinement": "需下一次主動攻擊消耗剩餘盾換取有限增傷。"
      }
    },
