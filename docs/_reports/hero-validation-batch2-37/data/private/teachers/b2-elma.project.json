      "sha256:bdc30b4f4711cc9d5e3decf5c46c5956dd1456ff54ec66924f52e39108974d18": {
        "id": "tpl-buff-self",
        "schema": "template@1",
        "name": "變身強化-數值面",
        "description": "純數值自我強化（技能組替換/換模僅屬 P1 非目標）。 兩格選填讓它同時掛一個「別人問得到」的名字：`statusId` 把標記併進**同一份**增益來源（延長／淨化／到期一起發生，例：三刀流），`status` 則是**另一顆獨立**的狀態節點（秒數與增益各自算，機制欄位住在節點上，例：邪王真眼）。兩格都清空 ⇒ 就是一份純數值增益。 `perRank` 是**逐階欄位表**（WC3 的 buff 一階一欄）：填了它之後每一階換的是一整組 modifier ＋ 秒數，而上面的 `modifiers`／`duration` 就沒有人讀（handler 走 `perRank[階-1]`），⛔ 但仍要填第一階的值。",
        "family": "buff-self",
        "status": "enabled",
        "params": {
          "duration": {
            "type": "number",
            "default": 15,
            "min": 1,
            "max": 60,
            "unit": "s"
          },
          "modifiers": {
            "type": "statModifiers",
            "default": [
              {
                "stat": "ad",
                "op": "flat",
                "value": 50
              }
            ]
          },
          "perRank": {
            "type": "buffPerRank",
            "optional": true
          },
          "statusId": {
            "type": "docRef",
            "optional": true
          },
          "status": {
            "type": "applyStatus",
            "optional": true
          },
          "castTimeSec": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true
          }
        },
        "requires": [
          "applyStatus"
        ],
        "gapScore": 6,
        "exemplar": {
          "skill": "82-04 闇之魔法",
          "jass": "A0Q6"
        }
      },
      "sha256:00f870cec154f9b8c3c2cfa420c54bfef7d028bd98faa8a816b495516b465e80": {
        "id": "tpl-single-strike",
        "schema": "template@1",
        "name": "單體斬擊",
        "description": "單一指向目標的一次魔法斬擊（僅數值核心，執行斬條件為紅色降級槽）。 可以再掛一格 `status`（打一下＋上狀態：暈眩／定身／減速／混亂…機制欄位住在節點上，由 zApplyStatus 本人驗，⛔ 不是 id 的下拉）；清空 ⇒ 純傷害。 另外兩格選填：`invulnerableSec` 是**起手的無敵幀**（護施法者、擋全部傷害與控制、不擋真傷 —— 那四格是家族語意，只有秒數是參數），`dot` 是**施法者自己**背上的持續傷害（界王拳那一族的代價；打在敵人身上的同型傷害請用「吸血／汲取」那一族）。三格全部清空 ⇒ 就是一發純傷害。",
        "family": "single-strike",
        "status": "enabled",
        "params": {
          "damage": {
            "type": "scaling",
            "default": {
              "perRank": [
                350
              ],
              "ratios": []
            }
          },
          "damageType": {
            "type": "enum",
            "default": "magic",
            "values": [
              "magic",
              "physical",
              "true"
            ]
          },
          "invulnerableSec": {
            "type": "number",
            "min": 0.05,
            "max": 5,
            "unit": "s",
            "optional": true
          },
          "dot": {
            "type": "dot",
            "optional": true
          },
          "status": {
            "type": "applyStatus",
            "optional": true
          },
          "castTimeSec": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true
          }
        },
        "requires": [
          "applyStatus",
          "invulnerable",
          "periodicDamage"
        ],
        "gapScore": 9,
        "exemplar": {
          "skill": "23-04 雷焰聖劍",
          "jass": "A0OD"
        }
      },
      "sha256:5e32c7c7058f94bde709b5227a3055b220279f0e74f0eda611a82716b3b2f856": {
        "id": "tpl-heal",
        "schema": "template@1",
        "name": "回血",
        "description": "加一個量的回血（`kind:\"heal\"`，走 Scaling：perRank ＋ 係數），⛔ 不是把生命回到某個比例 —— 那是 tpl-life-manipulate 的 `restore`，兩個 effect kind，⛔ 不塞進同一個下拉。`target`：self ＝ 對自己施放（castType self）；ally ＝ 指定一位隊友（targeted、點不到敵人）。`applyTo` 留空 ＝ 回這次施法的對象（self 施法就是自己、指定隊友就是那位隊友）；填 self ＝ 不管點誰都回自己（GH#1046：省略的語意是 ctx.targets，對回血族那正是要的人）。出貨 5 支：42-02 吸血祭品 ×2（self）· 08-01 雙龍紋 ×2 · 99-02 最初的聲音（ally）。⚠️ 回血沒有級距表（damage-tiers 是傷害的），所以 `amount` 走 perRank —— 五支出貨文件本來就是字面 perRank，這裡沒有第二個住處。",
        "family": "heal",
        "status": "enabled",
        "params": {
          "target": {
            "type": "enum",
            "default": "ally",
            "values": [
              "self",
              "ally"
            ],
            "origin": "taxonomy: 出貨 5 支 heal-only 裡 3 支指定隊友（08-01 ×2 · 99-02）、2 支回自己（42-02 ×2）⇒ 預設跟多數與 exemplar 走。"
          },
          "amount": {
            "type": "scaling",
            "default": {
              "perRank": [
                50,
                85,
                120,
                155
              ],
              "ratios": [
                {
                  "stat": "ap",
                  "coeff": 0.465
                }
              ]
            },
            "origin": "derived: exemplar 08-01 雙龍紋 content/abilities/godie-n01c.q.json effects[0].amount 逐位元（孿生 godie-nbbc.q 同值）。"
          },
          "applyTo": {
            "type": "enum",
            "values": [
              "self",
              "target"
            ],
            "optional": true
          },
          "castTimeSec": {
            "type": "number",
            "default": 0.067,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true,
            "origin": "census: 出貨 5/5 支 heal-only 的 `castTimeSec` 逐位元 0.067；castderive:build:raw 推導欄位，文件與 params 同值。"
          }
        },
        "requires": [],
        "gapScore": 9,
        "exemplar": {
