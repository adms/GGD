        ],
        "gapScore": 9,
        "exemplar": {
          "skill": "90-04 陽光烈焰（content/abilities/godie-h02r.r.json）",
          "jass": "GGD 出貨值以 content 為準（第〇·六守則第 2 層：編輯器 JSON ＞ JASS）"
        }
      },
      "sha256:5e32c7c7058f94bde709b5227a3055b220279f0e74f0eda611a82716b3b2f856": {
