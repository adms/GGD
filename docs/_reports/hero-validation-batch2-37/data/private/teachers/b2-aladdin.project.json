      "sha256:1112de91c80812d8694c17311498df56dc44e672d3fe9804c7b7ddb2a8c8df18": {
        "id": "tpl-summon-agent",
        "schema": "template@1",
        "name": "召喚代理",
        "description": "召喚代理 —— 生出 N 具會自己打的身體。⭐ `body:\"self\"` = 分身（複製施法者自己）。⚠️ `cleanse` 是獨立的一格：卡面上的「除掉身上的法術效果」與召喚是兩件事，⛔ 綁死在一起就表達不出「只召喚、不淨化」那一半的技能。",
        "family": "summon-agent",
        "status": "enabled",
        "params": {
          "count": {
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 20,
            "origin": "taxonomy:一具是召喚的**最小**單位 —— ⛔ 0 具不是召喚。逐支的具數由卡面決定（普屋 E 逐字「創造出 **2** 個普烏的實體」）。"
          },
          "body": {
            "type": "enum",
            "default": "self",
            "values": [
              "champion",
              "self"
            ],
            "optional": true,
            "origin": "taxonomy:分身族（複製施法者自己）是這個家族的**多數**形狀 —— `summon.ts` 檔頭逐字點名 57-03 複製鏡 / 27-002 霧隱分身之術；⭐ 選 `self` 當預設讓那一族**零個欄位**就寫得出來。"
          },
          "championId": {
            "type": "docRef",
            "optional": true,
            "inert": "⛔ 只有 `body:\"champion\"` 時才讀得到它；`self`（本家族的預設）時由 sim 端填施法者自己 ⇒ 它沒有一個有意義的預設。",
            "origin": "inert —— ⛔ 只有 `body:\"champion\"` 時才讀得到它；`self`（本家族的預設）時由 sim 端填施法者自己。"
          },
          "durationSec": {
            "type": "number",
            "default": 10,
            "min": 0.5,
            "max": 600,
            "unit": "s",
            "optional": true,
            "origin": "taxonomy:出貨的分身族卡面全部是**有時限**的（普屋 E 逐字「可持續 **10** 秒」）；⭐ 10 秒是那一族的中位數，⛔ 缺席才是「永久」（原作 0 秒的那種）。"
          },
          "damageMult": {
            "type": "number",
            "default": 1,
            "min": 0.01,
            "max": 10,
            "optional": true,
            "origin": "taxonomy:1 ＝ **與本體同強**，也就是「沒有宣告倍率」的中性值。⭐ 逐支覆寫由卡面決定（普屋 E 逐字「具有 **30%** 攻擊力」）。"
          },
          "hpMult": {
            "type": "number",
            "default": 1,
            "min": 0.01,
            "max": 10,
            "optional": true,
            "origin": "taxonomy:同 `damageMult` —— 1 是中性值，⛔ 不是一個平衡選擇。"
          },
          "formation": {
            "type": "enum",
            "default": "ring",
            "values": [
              "ring",
              "line",
              "scatter"
            ],
            "optional": true,
            "origin": "taxonomy:`ring` 是唯一與具數無關的陣型（1 具也成立，N 具不重疊）；⛔ `line` 需要一個朝向、`scatter` 需要 RNG。"
          },
          "spread": {
            "type": "number",
            "default": 2,
            "min": 0.1,
            "max": 12,
            "optional": true,
            "origin": "taxonomy:2 個**世界單位** ≈ 一個身體寬 —— ⭐ 讓兩具不互相卡住的最小間距。⚠️ ⛔ 這一格刻意**沒有** `unit` —— 標成 `wc3u` 會被展開器除以 50（2026-09-01 實測：2 變成 0.04，兩具疊在同一點），⭐ 而 `summon.spread` 本來就是世界單位。"
          },
          "maxAlive": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 20,
            "optional": true,
            "origin": "taxonomy:0 ＝ **不設上限**，也就是「沒有宣告」的中性值。⭐ 要設上限的技能自己填。"
          },
          "onOwnerDeath": {
            "type": "enum",
            "default": "despawn",
            "values": [
              "despawn",
              "persist"
            ],
            "optional": true,
            "origin": "taxonomy:`despawn` —— 分身是施法者的延伸，⭐ 本體死了它們留著會變成「打不死的殘影」；`persist` 是少數（獨立召喚物）才要的。"
          },
          "cleanse": {
            "type": "enum",
            "default": "none",
            "values": [
              "none",
              "status",
              "all"
            ],
            "optional": true,
            "origin": "taxonomy:`none` ＝ **只召喚**。⚠️ 淨化是**另一件事**（普屋 E 的卡面把兩件事寫在同一句），⛔ 綁死在一起就表達不出只召喚的技能。"
          },
          "castTimeSec": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true,
            "origin": "taxonomy:0 ＝ 瞬發，也就是「沒有宣告吟唱」的中性值（同 `tpl-single-strike` 的同名格）。"
          }
        },
        "requires": [
          "summon"
        ],
        "gapScore": 4,
        "exemplar": {
          "skill": "28-02 分身（普屋）",
          "jass": "A0??"
        }
      },
