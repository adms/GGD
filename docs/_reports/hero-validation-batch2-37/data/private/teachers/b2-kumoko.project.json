          "applyStatus"
        ],
        "gapScore": 9,
        "exemplar": {
          "skill": "70-03 木束縛之術（content/abilities/godie-e010.e.json）",
          "jass": "entanglingroots 系（root:true ↔ 22 份出貨文件的配對，expand.ts 原 CC_MECHANIC 註解）；GGD 出貨值以 content 為準（第〇·六守則第 2 層）"
