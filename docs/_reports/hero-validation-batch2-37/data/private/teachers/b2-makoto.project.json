      "sha256:5e32c7c7058f94bde709b5227a3055b220279f0e74f0eda611a82716b3b2f856": {
        "id": "tpl-heal",
        "schema": "template@1",
        "name": "回血",
        "description": "加一個量的回血（`kind:\"heal\"`，走 Scaling：perRank ＋ 係數），⛔ 不是把生命回到某個比例 —— 那是 tpl-life-manipulate 的 `restore`，兩個 effect kind，⛔ 不塞進同一個下拉。`target`：self ＝ 對自己施放（castType self）；ally ＝ 指定一位隊友（targeted、點不到敵人）。`applyTo` 留空 ＝ 回這次施法的對象（self 施法就是自己、指定隊友就是那位隊友）；填 self ＝ 不管點誰都回自己（GH#1046：省略的語意是 ctx.targets，對回血族那正是要的人）。出貨 5 支：42-02 吸血祭品 ×2（self）· 08-01 雙龍紋 ×2 · 99-02 最初的聲音（ally）。⚠️ 回血沒有級距表（damage-tiers 是傷害的），所以 `amount` 走 perRank —— 五支出貨文件本來就是字面 perRank，這裡沒有第二個住處。",
        "family": "heal",
        "status": "enabled",
        "params": {
          "target": {
            "type": "enum",
            "default": "ally",
            "values": [
              "self",
              "ally"
            ],
            "origin": "taxonomy: 出貨 5 支 heal-only 裡 3 支指定隊友（08-01 ×2 · 99-02）、2 支回自己（42-02 ×2）⇒ 預設跟多數與 exemplar 走。"
          },
          "amount": {
            "type": "scaling",
            "default": {
              "perRank": [
                50,
                85,
                120,
                155
              ],
              "ratios": [
                {
                  "stat": "ap",
                  "coeff": 0.465
                }
              ]
            },
            "origin": "derived: exemplar 08-01 雙龍紋 content/abilities/godie-n01c.q.json effects[0].amount 逐位元（孿生 godie-nbbc.q 同值）。"
          },
          "applyTo": {
            "type": "enum",
            "values": [
              "self",
              "target"
            ],
            "optional": true
          },
          "castTimeSec": {
            "type": "number",
            "default": 0.067,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true,
            "origin": "census: 出貨 5/5 支 heal-only 的 `castTimeSec` 逐位元 0.067；castderive:build:raw 推導欄位，文件與 params 同值。"
          }
        },
        "requires": [],
        "gapScore": 9,
        "exemplar": {
          "skill": "08-01 雙龍紋（content/abilities/godie-n01c.q.json）",
          "jass": "GGD 出貨值以 content 為準（第〇·六守則第 2 層：編輯器 JSON ＞ JASS）；原作對照見 tools/skill-remake 的 08-01 列"
        }
      }
