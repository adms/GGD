{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural constraints only. Evidence anchoring, delivery semantics, dependencies, depth and engine/behavior checks remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hero",
    "relations",
    "slots"
  ],
  "properties": {
    "schema": {
      "const": "hero-semantic-ir@2"
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "originBasis",
        "identitySummary",
        "identityEvidence"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "坦克",
            "砲手",
            "鬥士",
            "射手",
            "法鬥",
            "法師",
            "狂戰",
            "硬輔",
            "法刺",
            "軟輔"
          ]
        },
        "originBasis": {
          "type": "string",
          "enum": [
            "source",
            "proposal"
          ]
        },
        "identitySummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "identityEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "evidence"
        ],
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "PASSIVE",
              "Q",
              "W",
              "E",
              "R",
              "EX"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "PASSIVE",
              "Q",
              "W",
              "E",
              "R",
              "EX"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "independent",
              "resource",
              "conditional"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 20
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASSIVE",
        "Q",
        "W",
        "E",
        "R",
        "EX"
      ],
      "properties": {
        "PASSIVE": {
          "$ref": "#/$defs/slot"
        },
        "Q": {
          "$ref": "#/$defs/slot"
        },
        "W": {
          "$ref": "#/$defs/slot"
        },
        "E": {
          "$ref": "#/$defs/slot"
        },
        "R": {
          "$ref": "#/$defs/slot"
        },
        "EX": {
          "$ref": "#/$defs/slot"
        }
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "rangeTier",
        "windup",
        "actions",
        "cost",
        "mechanismGaps",
        "tuningNotes"
      ],
      "properties": {
        "delivery": {
          "type": "string",
          "enum": [
            "passive",
            "self",
            "targeted",
            "ground"
          ]
        },
        "rangeTier": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "極小",
                "小",
                "中",
                "大",
                "極大"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "windup": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 16
        },
        "cost": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "count"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanismGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 12
        },
        "tuningNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 12
        }
      }
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/action_attack_proc"
        },
        {
          "$ref": "#/$defs/action_damage"
        },
        {
          "$ref": "#/$defs/action_dot"
        },
        {
          "$ref": "#/$defs/action_heal_self"
        },
        {
          "$ref": "#/$defs/action_shield_self"
        },
        {
          "$ref": "#/$defs/action_buff_self"
        },
        {
          "$ref": "#/$defs/action_control"
        },
        {
          "$ref": "#/$defs/action_knockback"
        },
        {
          "$ref": "#/$defs/action_area_pulses"
        },
        {
          "$ref": "#/$defs/action_barrage"
        },
        {
          "$ref": "#/$defs/action_chain"
        },
        {
          "$ref": "#/$defs/action_combo"
        },
        {
          "$ref": "#/$defs/action_leap"
        },
        {
          "$ref": "#/$defs/action_resource"
        },
        {
          "$ref": "#/$defs/action_output_modifier"
        },
        {
          "$ref": "#/$defs/action_spend_health"
        },
        {
          "$ref": "#/$defs/action_counter_window"
        },
        {
          "$ref": "#/$defs/action_projectile"
        },
        {
          "$ref": "#/$defs/action_status_branch"
        }
      ]
    },
    "action_attack_proc": {
      "type": "object",
