        "sha256:bdc30b4f4711cc9d5e3decf5c46c5956dd1456ff54ec66924f52e39108974d18": {
          "id": "tpl-buff-self",
          "schema": "template@1",
          "name": "變身強化-數值面",
          "description": "純數值自我強化（技能組替換/換模僅屬 P1 非目標）。 兩格選填讓它同時掛一個「別人問得到」的名字：`statusId` 把標記併進**同一份**增益來源（延長／淨化／到期一起發生，例：三刀流），`status` 則是**另一顆獨立**的狀態節點（秒數與增益各自算，機制欄位住在節點上，例：邪王真眼）。兩格都清空 ⇒ 就是一份純數值增益。 `perRank` 是**逐階欄位表**（WC3 的 buff 一階一欄）：填了它之後每一階換的是一整組 modifier ＋ 秒數，而上面的 `modifiers`／`duration` 就沒有人讀（handler 走 `perRank[階-1]`），⛔ 但仍要填第一階的值。",
          "family": "buff-self",
          "status": "enabled",
          "params": {
            "duration": {
              "type": "number",
              "default": 15,
              "min": 1,
              "max": 60,
              "unit": "s"
            },
            "modifiers": {
              "type": "statModifiers",
              "default": [
                {
                  "stat": "ad",
                  "op": "flat",
                  "value": 50
                }
              ]
            },
            "perRank": {
              "type": "buffPerRank",
              "optional": true
            },
            "statusId": {
              "type": "docRef",
              "optional": true
            },
            "status": {
              "type": "applyStatus",
              "optional": true
            },
            "castTimeSec": {
              "type": "number",
              "default": 0,
              "min": 0,
              "max": 5,
              "unit": "s",
              "optional": true
            }
          },
          "requires": [
            "applyStatus"
          ],
          "gapScore": 6,
          "exemplar": {
            "skill": "82-04 闇之魔法",
            "jass": "A0Q6"
          }
        },
        "sha256:8ad74d5c99ca88a9cf4b5ef5ae62dd670596b201d42e78b41146563a36c4be10": {
          "id": "tpl-blink",
          "schema": "template@1",
          "name": "純位移瞬移",
          "description": "把自己的身體搬到指定的地面點 —— 真的瞬移（`kind:\"blink\"`；owner 2026-08-09「是真的瞬移，不是平移」，GH#301-2），中間那兩格身體不存在：不會被範圍技掃到、飛行途中不吃碰撞；落點仍照 `content/config/displacement-tiers.json` 結算牆前截斷／飛行豁免／場地邊界（GH#1044）。距離上限就是技能自己的射程（skeleton 的 `range`，⛔ 不是這裡的欄位）。⛔ 零參數是刻意的：出貨 7 支（57-02 任意門 · 86-02 電光一閃 · 09-02 瞬間移動 ×2 · 65-01 神出鬼沒 · 58-00 電光一閃 ×2）的 `effects` 一個位元組都不差，多一格就是編一格。要「瞬移到目標身上再打一下」走 tpl-blink-strike；要「抵達點才結算 onLand」走 tpl-teleport。",
          "family": "blink",
          "status": "enabled",
          "params": {
            "castTimeSec": {
              "type": "number",
              "default": 0.467,
              "min": 0,
              "max": 5,
              "unit": "s",
              "optional": true,
              "origin": "census: 出貨 7/7 支純位移的 `castTimeSec` 逐位元 0.467（content/abilities/godie-n00b.e.json · o00k.w · o00x.w · ogrh.w · udea.q · o02l.passive · ofar.passive）；⚠️ 它是 castderive:build:raw 推導的欄位，文件與 params 同一個值（同 71/79 位既有採用者的慣例）。"
            }
          },
          "requires": [
            "blink"
          ],
          "gapScore": 9,
          "exemplar": {
            "skill": "57-02 任意門（content/abilities/godie-n00b.e.json）",
            "jass": "A0PM 82-02 虛空瞬動 j:35335-35336（GetOrderPointLoc → SetUnitPositionLoc；同一台「指向點」機器，expand.ts teleport 註解逐字）"
          }
        }
