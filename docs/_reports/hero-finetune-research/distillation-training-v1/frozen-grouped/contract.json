{
  "schema": "ggd-distillation-generation-contract@1",
  "formats": {
    "hero-plan": {
      "keys": [
        "format",
        "plan",
        "presentationSelection"
      ],
      "plan": {
        "schema": "ggd-hero-plan@1",
        "required": [
          "planId",
          "title",
          "summary",
          "sourceLock",
          "origin",
          "archetype",
          "attackType",
          "budget",
          "statOverrides",
          "slots"
        ],
        "sourceLock": {
          "canonicalId": null,
          "versionId": null
        },
        "slots": [
          "PASSIVE",
          "Q",
          "W",
          "E",
          "R",
          "EX"
        ],
        "slotFields": [
          "slot",
          "name",
          "purpose",
          "maxRank",
          "abilityOverrides",
          "products",
          "templateConflictPolicy",
          "tuning",
          "capabilityIds",
          "directionOptionIds",
          "fallbackOptionIds"
        ],
        "product": {
          "instanceId": "unique within slot",
          "template": {
            "ref": "public template ID",
            "params": "template parameters",
            "inheritDefaults": true
          }
        },
        "tuning": [
          "cooldownSec",
          "manaCost",
          "range"
        ],
        "templateConflictPolicy": "reject"
      },
      "presentationSelection": {
        "keys": [
          "modelKey",
          "championIcon",
          "slots"
        ],
        "slotFields": [
          "gameplayEvent",
          "icon",
          "sfxKey",
          "vfxLayers",
          "scriptSelections"
        ],
        "gameplayEvent": "abilityCast",
        "scriptSelections": [
          {
            "kind": "anim",
            "on": "castStart",
            "at": "caster",
            "pulse": "cast"
          },
          {
            "kind": "vfx",
            "on": "castEffect",
            "at": "self|target|point",
            "vfxId": "existing VFX ID"
          }
        ]
      }
    },
    "native-content": {
      "keys": [
        "format",
        "champion",
        "abilities"
      ],
      "champion": {
        "schema": "champion@1",
        "required": [
          "id",
          "name",
          "description",
          "origin",
          "role",
          "attackType",
          "baseStats",
          "growth",
          "attributes",
          "modelKey",
          "skillOrder",
          "buildPriority",
          "passiveAbility",
          "exAbility"
        ],
        "embeddedAbilities": "omit; script mirrors authoritative Q/W/E/R"
      },
      "abilities": {
        "slots": [
          "PASSIVE",
          "Q",
          "W",
          "E",
          "R",
          "EX"
        ],
        "schema": "ability@1",
        "required": [
          "id",
          "name",
          "description",
          "slot",
          "castType",
          "maxRank",
          "cooldown",
          "manaCost",
          "range",
          "effects"
        ],
        "optionalMechanisms": [
          "passive",
          "hooks",
          "marks",
          "template",
          "statusCost",
          "castTimeSec",
          "targetsEnemies",
          "radius"
        ],
        "ranks": "preserve requested native ranks; never silently replace native mechanics with a template"
      }
    },
    "hero-slot": {
      "keys": [
        "format",
        "slot",
        "presentationSelection"
      ],
      "fields": "same HeroPlan slot and presentation selection as above"
    },
    "native-slot": {
      "keys": [
        "format",
        "ability"
      ],
      "fields": "same authoritative ability@1 as above"
    }
  },
  "deterministicFields": "Template contentSha256 and templateVersions are resolved and pinned by script from the fixed engine, not memorized/generated by the model. Do not emit generatorVersion or fabricated validation receipts.",
  "capabilityLimits": "Index IDs are not unconditional support. Unsupported needs must not silently become a weaker ability. All output goes through full schema/compiler; index-only generation is not automatic quality approval."
}
