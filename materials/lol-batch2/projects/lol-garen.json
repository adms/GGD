            "values": [
              "point",
              "caster"
            ]
          },
          "applyTo": {
            "type": "enum",
            "default": "enemies",
            "values": [
              "enemies",
              "allies"
            ]
          },
          "damageTier": {
            "type": "enum",
            "default": "極小",
            "values": [
              "極小",
              "小",
              "中",
              "大",
              "極大"
            ]
          },
          "damageType": {
            "type": "enum",
            "default": "magic",
            "values": [
              "magic",
