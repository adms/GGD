      "sha256:bdc30b4f4711cc9d5e3decf5c46c5956dd1456ff54ec66924f52e39108974d18": {
        "id": "tpl-buff-self",
        "schema": "template@1",
        "name": "變身強化-數值面",
        "description": "純數值自我強化（技能組替換/換模僅屬 P1 非目標）。 兩格選填讓它同時掛一個「別人問得到」的名字：`statusId` 把標記併進**同一份**增益來源（延長／淨化／到期一起發生，例：三刀流），`status` 則是**另一顆獨立**的狀態節點（秒數與增益各自算，機制欄位住在節點上，例：邪王真眼）。兩格都清空 ⇒ 就是一份純數值增益。 `perRank` 是**逐階欄位表**（WC3 的 buff 一階一欄）：填了它之後每一階換的是一整組 modifier ＋ 秒數，而上面的 `modifiers`／`duration` 就沒有人讀（handler 走 `perRank[階-1]`），⛔ 但仍要填第一階的值。",
        "family": "buff-self",
        "status": "enabled",
        "params": {
          "duration": {
            "type": "number",
            "default": 15,
            "min": 1,
            "max": 60,
            "unit": "s"
          },
          "modifiers": {
            "type": "statModifiers",
            "default": [
              {
                "stat": "ad",
                "op": "flat",
                "value": 50
              }
            ]
          },
          "perRank": {
            "type": "buffPerRank",
            "optional": true
          },
          "statusId": {
            "type": "docRef",
            "optional": true
          },
          "status": {
            "type": "applyStatus",
            "optional": true
          },
          "castTimeSec": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 5,
            "unit": "s",
            "optional": true
          }
        },
        "requires": [
          "applyStatus"
        ],
        "gapScore": 6,
        "exemplar": {
          "skill": "82-04 闇之魔法",
          "jass": "A0Q6"
        }
      },
