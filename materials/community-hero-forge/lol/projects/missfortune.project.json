            "default": {
              "perRank": [
                150
              ],
              "ratios": []
            }
          },
          "damageType": {
            "type": "enum",
            "default": "magic",
            "values": [
              "magic",
              "physical",
              "true"
            ]
          },
          "impactRadius": {
            "type": "number",
            "default": 320,
            "min": 50,
            "max": 900,
            "unit": "wc3u"
          },
          "scatterRadius": {
