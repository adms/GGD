{
  "id": "tpl-line-sweep",
  "schema": "template@1",
  "name": "直線分段掃擊",
  "description": "沿直線分段的掃擊：每一段各自在自己的落點結算一次（`delayed` + `advance`，GH#393 的機制）。⭐ 同一個目標整串只被打一次（`hitOncePerTarget`）—— 那是原作的規則，卡片寫的是**一次**的數字。",
  "family": "line-sweep",
  "status": "enabled",
  "params": {
    "segmentCount": {
      "type": "number",
      "default": 6,
      "min": 3,
      "max": 20,
      "unit": "count",
      "origin": "j:32335 —— `exitwhen udg_WinSwordCounter > 6`，而 j:32333 是 `set udg_WinSwordCounter = 1` ⇒ 正好 **6 段**（⛔ 不是 7：它從 **1** 起算，⛔ 不是 0）"
    },
    "stepSize": {
      "type": "number",
      "default": 200,
      "min": 100,
      "max": 300,
      "unit": "wc3u",
      "origin": "j:32336 —— `PolarProjectionBJ(udg_LocPoint1, I2R(udg_WinSwordCounter) * 200.00, …)` ⇒ 每段 **200 wc3u**"
    },
    "segmentAoe": {
      "type": "number",
      "default": 400,
      "min": 100,
      "max": 900,
      "unit": "wc3u",
      "origin": "j:32337 —— `GetUnitsInRangeOfLocMatching(400.00, udg_LocPoint3, …)` ⇒ 每段半徑 **400 wc3u**"
    },
    "damage": {
      "type": "scaling",
      "default": {
        "perRank": [
          150
        ],
        "ratios": []
      }
    },
    "damageType": {
      "type": "enum",
      "values": [
        "magic",
        "physical",
        "true"
      ],
      "default": "magic"
    },
    "castTimeSec": {
      "type": "number",
      "optional": true,
      "default": 0,
      "min": 0,
      "max": 5,
      "unit": "s"
    }
  },
  "requires": [
    "projectile"
  ],
  "gapScore": 7,
  "exemplar": {
    "skill": "20-03 約束與勝利之劍",
    "jass": "A0D5"
  }
}
