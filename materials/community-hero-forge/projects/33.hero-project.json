  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "30869e4829e4896cb117eeac7687c7866d3910595958fbfe4847d219ea99ef8c",
    "name": "近衛刀太",
    "identity": "作品：《UQ HOLDER!》  \n採用：不死身與重力劍為核心的版本。  \n定位：再生、武器重量、有限致死恢復。",
    "ownerText": "### 33｜近衛刀太\n\n作品：《UQ HOLDER!》  \n採用：不死身與重力劍為核心的版本。  \n定位：再生、武器重量、有限致死恢復。\n\n- **PASSIVE｜〔不死者再生〕**：受到傷害後延遲恢復部分損失生命；再次受擊延後恢復，且有每段時間上限。\n- **Q｜〔重力劍・橫掃〕**：使用重力劍進行扇形斬擊。\n- **W｜〔重量切換〕**：在輕劍與重劍模式間切換：輕模式較快、重模式傷害較高且動作較慢。\n- **E｜〔踏地突進〕**：短距離接近並揮劍。\n- **R｜〔不死者的再起〕**：短時間準備再起；首次致死傷害被攔截，經明顯恢復動作後回復有限生命。每回合一次。\n- **EX｜〔重力劍・壓潰〕**：固定為重劍模式的蓄力重擊，完成後短暫降低移速。\n\n**審查重點**：測試極低生命、同幀多次致死、治療限制、再起中受控與重量切換；避免死亡獎勵、生命底線及復原事件重複。\n\n",
    "reviewText": "測試極低生命、同幀多次致死、治療限制、再起中受控與重量切換；避免死亡獎勵、生命底線及復原事件重複。",
    "slots": {
      "PASSIVE": {
        "name": "〔不死者再生〕",
        "ownerDescription": "受到傷害後延遲恢復部分損失生命；再次受擊延後恢復，且有每段時間上限。",
        "baselineBehavior": "本場一層免死標記，首次致死消耗並回復 15% 生命，保護 0.5 秒。",
        "requiredRefinement": "本場被動免死只是基底；需受傷延後再生与 R 短期再起资格，不能無條件常駐代替。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      },
      "Q": {
        "name": "〔重力劍・橫掃〕",
        "ownerDescription": "使用重力劍進行扇形斬擊。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需重力劍扇形判定。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      },
      "W": {
        "name": "〔重量切換〕",
        "ownerDescription": "在輕劍與重劍模式間切換：輕模式較快、重模式傷害較高且動作較慢。",
        "baselineBehavior": "自身取得 3 秒增益：ad +15%。",
        "requiredRefinement": "固定 AD 增益；需輕／重模式、攻速與動作時長同步。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      },
      "E": {
        "name": "〔踏地突進〕",
        "ownerDescription": "短距離接近並揮劍。",
        "baselineBehavior": "向指定方向突進 250 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "近身突進可作基礎驗收。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      },
      "R": {
        "name": "〔不死者的再起〕",
        "ownerDescription": "短時間準備再起；首次致死傷害被攔截，經明顯恢復動作後回復有限生命。每回合一次。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"heal\",\"amount\":{\"flat\":100,\"ratios\":[]},\"applyTo\":\"self\"}]。",
        "requiredRefinement": "目前立即回復；需主動再起窗口、首次致死截取與每回合一次。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      },
      "EX": {
        "name": "〔重力劍・壓潰〕",
        "ownerDescription": "固定為重劍模式的蓄力重擊，完成後短暫降低移速。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需固定重劍模式蓄力与完成後緩速。",
        "refinementContracts": [
          "M05",
          "M09"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n背著自己的slow40重劍增益受傷時回復60生命，每兩秒一次；空身不領健身補貼。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n黑棒劍小級物理傷害加0.8AD，真實讀重量模式增加的AD。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n負重深蹲：回復100；仍背重劍時再回復180。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n掛上鐵片：四秒AD+45、移速-40%，同一份具名buff，卸下時一起還原。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n健身成果展示，兩次小級物理傷害；不是永久吸血。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "刀太的健身鐵片：背重劍變慢變強，丟掉鐵片才跑得動\n卸鐵片：消耗自己的重劍buff才回復8%魔力並得到25%移速兩秒；沒掛過不補貼。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
