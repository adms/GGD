  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "17b2f1f05e8c6b757502b123a7d443c0d334c47077006e57cf0b2172fa755ee1",
    "name": "利姆路",
    "identity": "作品：《關於我轉生變成史萊姆這檔事》  \n採用：以大賢者、捕食者、擬態為核心的版本。  \n定位：吸收分析、有限技能取得、變形。",
    "ownerText": "### 11｜利姆路\n\n作品：《關於我轉生變成史萊姆這檔事》  \n採用：以大賢者、捕食者、擬態為核心的版本。  \n定位：吸收分析、有限技能取得、變形。\n\n- **PASSIVE｜大賢者**：分析最近承受的技能類型，提供該類型的短效有限減傷；同時只保存一種分析結果。\n- **Q｜水刃**：直線水刃，可穿過有限數量目標。\n- **W｜捕食者**：短窗口吸收一個白名單敵方投射物，取消其後續命中並保存分析樣本。\n- **E｜擬態**：在人形與史萊姆形態間切換，改變普攻及移動表現，保留生命、資源與冷卻。\n- **R｜黑炎**：在指定區域產生有限脈衝的黑炎，結束後清理全部區域效果。\n- **EX｜〔解析完成・能力再現〕**：消耗 W 的樣本，以自己的屬性施放一次核准的技能副本；使用後清空樣本。\n\n**審查重點**：吸收與複製必須經白名單；測試不可吸收物、同幀多彈、複製來源死亡，以及樣本內不得夾帶任意腳本或遞迴複製。\n\n",
    "reviewText": "吸收與複製必須經白名單；測試不可吸收物、同幀多彈、複製來源死亡，以及樣本內不得夾帶任意腳本或遞迴複製。",
    "slots": {
      "PASSIVE": {
        "name": "大賢者",
        "ownerDescription": "分析最近承受的技能類型，提供該類型的短效有限減傷；同時只保存一種分析結果。",
        "baselineBehavior": "受傷時觸發有 4 秒冷卻的小範圍反擊；不是防禦成功或閃避成功事件。",
        "requiredRefinement": "需最近受擊類型分析及同時只留一種減傷結果。",
        "refinementContracts": [
          "M05"
        ]
      },
      "Q": {
        "name": "水刃",
        "ownerDescription": "直線水刃，可穿過有限數量目標。",
        "baselineBehavior": "四段沿直線推進的波，每 0.12 秒向前 100 wc3u；各段獨立區域傷害。",
        "requiredRefinement": "需穿透人數上限及單彈命中去重。",
        "refinementContracts": [
          "M05"
        ]
      },
      "W": {
        "name": "捕食者",
        "ownerDescription": "短窗口吸收一個白名單敵方投射物，取消其後續命中並保存分析樣本。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-11-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "護盾不會吸收或刪除敵彈；需白名單投射物與樣本持有。",
        "refinementContracts": [
          "M05"
        ]
      },
      "E": {
        "name": "擬態",
        "ownerDescription": "在人形與史萊姆形態間切換，改變普攻及移動表現，保留生命、資源與冷卻。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "需人形／史萊姆形態、普攻替換與生命冷卻保留。",
        "refinementContracts": [
          "M05"
        ]
      },
      "R": {
        "name": "黑炎",
        "ownerDescription": "在指定區域產生有限脈衝的黑炎，結束後清理全部區域效果。",
        "baselineBehavior": "指定落點維持 3 秒的小級半徑傷害區，每秒一跳極小級傷害。",
        "requiredRefinement": "固定 3 秒黑炎可作基本區域驗收；黑炎色覆寫。",
        "refinementContracts": [
          "M05"
        ]
      },
      "EX": {
        "name": "〔解析完成・能力再現〕",
        "ownerDescription": "消耗 W 的樣本，以自己的屬性施放一次核准的技能副本；使用後清空樣本。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。",
        "requiredRefinement": "固定攻擊不是能力副本；需樣本版本、消耗與禁止遞迴。",
        "refinementContracts": [
          "M05"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n受到物理傷害留物理樣本、魔法傷害留魔法樣本四秒，兩口味分開；真伤不供樣本。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n魔法口味：小級魔法打擊，消耗自己的魔法樣本才追加小級魔法傷害。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n變果凍，120護盾三秒；樣本標記本身並非魔法免疫。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n物理口味：小級物理打擊，消耗自己的物理樣本才把敵人推開三格。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n綜合口味：兩份樣本各可換120生命，沒有的口味不出餐；每份只消耗一次。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "史萊姆試吃會：真的挨過物理或魔法，才能分別吐出不同口味\n縮成一坨跑掉；不複製敵人的技能。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
