  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "f6f564d27fb8c192755c725a27e9ae2e521c9b55be2322bbf7bd3344d0412399",
    "name": "御坂美琴",
    "identity": "作品：《科學超電磁砲》  \n定位：電擊連鎖、電磁防禦、直線爆發。",
    "ownerText": "### 20｜御坂美琴\n\n作品：《科學超電磁砲》  \n定位：電擊連鎖、電磁防禦、直線爆發。\n\n- **PASSIVE｜〔電荷累積〕**：不同技能命中累積電荷，上限三層；下一次強化技消耗。\n- **Q｜電擊之槍**：直線電擊，主要作為穩定消耗。\n- **W｜〔連鎖放電〕**：在附近不同敵人間跳躍，同一施法不重複命中同一目標。\n- **E｜〔鐵砂防壁〕**：用鐵砂建立短效護盾，破盾時散開為純視覺碎粒。\n- **R｜超電磁砲**：彈出硬幣後發射有預警的高傷害直線攻擊。\n- **EX｜〔電磁過載〕**：消耗電荷，強化下一次 Q 的範圍或 W 的跳躍數；使用時明示強化結果。\n\n**審查重點**：驗證跳躍去重、目標死亡後改選、射線碰撞與電荷消耗。鐵砂護盾不自動等同永久可阻擋地形。\n\n",
    "reviewText": "驗證跳躍去重、目標死亡後改選、射線碰撞與電荷消耗。鐵砂護盾不自動等同永久可阻擋地形。",
    "slots": {
      "PASSIVE": {
        "name": "〔電荷累積〕",
        "ownerDescription": "不同技能命中累積電荷，上限三層；下一次強化技消耗。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需三層電荷及下一次強化技消耗。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "Q": {
        "name": "電擊之槍",
        "ownerDescription": "直線電擊，主要作為穩定消耗。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需單道電擊與貫穿去重。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "W": {
        "name": "〔連鎖放電〕",
        "ownerDescription": "在附近不同敵人間跳躍，同一施法不重複命中同一目標。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。 附加效果：[{\"kind\":\"chainLightning\",\"shape\":\"single\",\"amount\":{\"damageTier\":\"極小\",\"ratios\":[]},\"damageType\":\"magic\",\"jumps\":3,\"jumpRange\":3,\"decay\":0.8,\"revisit\":false,\"maxTotalJumps\":3,\"jumpIntervalSec\":0.12}]。",
        "requiredRefinement": "模板主命中加鏈起點會對起點追加；需原設計整招同目標只命中一次。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "E": {
        "name": "〔鐵砂防壁〕",
        "ownerDescription": "用鐵砂建立短效護盾，破盾時散開為純視覺碎粒。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-20-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "鐵砂碎粒及破盾事件待補。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "R": {
        "name": "超電磁砲",
        "ownerDescription": "彈出硬幣後發射有預警的高傷害直線攻擊。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "目前四段線；需硬幣彈出、單發射線與整體傷害上限。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "EX": {
        "name": "〔電磁過載〕",
        "ownerDescription": "消耗電荷，強化下一次 Q 的範圍或 W 的跳躍數；使用時明示強化結果。",
        "baselineBehavior": "自身取得 3 秒增益：ap +15%。",
        "requiredRefinement": "僅 AP 增益；需電荷扣除與 Q／W 指定版本強化。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      }
    }
  },
