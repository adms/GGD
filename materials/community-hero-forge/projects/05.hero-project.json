  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "801a6de40c5eaf8a97f0f3bba1156a9ed2548cb5914a3002de39b6eea80cef25",
    "name": "洛克人",
    "identity": "作品：《Mega Man》  \n採用：初代洛克人，不混入 X 或 EXE。  \n定位：蓄力、武器能源、技能切換。",
    "ownerText": "### 05｜洛克人\n\n作品：《Mega Man》  \n採用：初代洛克人，不混入 X 或 EXE。  \n定位：蓄力、武器能源、技能切換。\n\n- **PASSIVE｜〔武器能源管理〕**：特殊武器共用有限能源；能源隨時間恢復，切換武器不補滿。\n- **Q｜洛克砲**：按住蓄力、放開射擊；依蓄力階段決定彈體與傷害。\n- **W｜Metal Blade**：投出金屬刀刃，可選擇射擊方向，消耗武器能源。\n- **E｜Leaf Shield**：形成有限耐久的葉片護盾；再次使用可將剩餘葉片射出。\n- **R｜〔全武裝齊射〕**：按固定次序發射砲彈、刀刃與葉片，整套共享總傷害預算。\n- **EX｜〔特殊武器切換〕**：讓 Q 在洛克砲與已核准的特殊武器版本間切換；保留各自冷卻與共用能源。\n\n**審查重點**：蓄力中斷、護盾剩餘耐久轉換、切換後圖示與實際技能一致；反覆切換不能重置冷卻或複製能源。\n\n",
    "reviewText": "蓄力中斷、護盾剩餘耐久轉換、切換後圖示與實際技能一致；反覆切換不能重置冷卻或複製能源。",
    "slots": {
      "PASSIVE": {
        "name": "〔武器能源管理〕",
        "ownerDescription": "特殊武器共用有限能源；能源隨時間恢復，切換武器不補滿。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需共用武器能源、恢復與切換保留；預覽沿用 GGD 魔力。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      },
      "Q": {
        "name": "洛克砲",
        "ownerDescription": "按住蓄力、放開射擊；依蓄力階段決定彈體與傷害。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "目前固定起手；需按住／放開與分段蓄力。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      },
      "W": {
        "name": "Metal Blade",
        "ownerDescription": "投出金屬刀刃，可選擇射擊方向，消耗武器能源。",
        "baselineBehavior": "四段沿直線推進的波，每 0.12 秒向前 100 wc3u；各段獨立區域傷害。",
        "requiredRefinement": "Metal Blade 的方向與刀刃模型待補。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      },
      "E": {
        "name": "Leaf Shield",
        "ownerDescription": "形成有限耐久的葉片護盾；再次使用可將剩餘葉片射出。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-05-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "缺再次輸入射出剩餘葉片及護盾剩餘量換算。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      },
      "R": {
        "name": "〔全武裝齊射〕",
        "ownerDescription": "按固定次序發射砲彈、刀刃與葉片，整套共享總傷害預算。",
        "baselineBehavior": "在指定區域依序落下 6 發；每發間隔 0.35 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "彈種固定時序及整套共享總預算需補。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      },
      "EX": {
        "name": "〔特殊武器切換〕",
        "ownerDescription": "讓 Q 在洛克砲與已核准的特殊武器版本間切換；保留各自冷卻與共用能源。",
        "baselineBehavior": "自身取得 3 秒增益：as +20%。",
        "requiredRefinement": "僅自身攻速增益；需 Q 技能版本切換、圖示與共用冷卻。",
        "refinementContracts": [
          "M02",
          "M05"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "過熱機器人：砲擊把自己燒到跑不動，排氣拿敵人當散熱片\nQ 或 R 開火後散熱器卡住，自身減速40%四秒；排氣或冷卻才能解除。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "過熱機器人：砲擊把自己燒到跑不動，排氣拿敵人當散熱片\n小鋼砲直線中級魔法傷害；開砲有過熱代價。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "過熱機器人：砲擊把自己燒到跑不動，排氣拿敵人當散熱片\n散熱排氣：消耗自己的過熱，才對周圍三格敵人造成小級傷害並回復自身8%魔力；沒熱就吹冷氣。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "過熱機器人：砲擊把自己燒到跑不動，排氣拿敵人當散熱片\n滑行到指定點；排氣後四秒內再由被動給自己120護盾。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
