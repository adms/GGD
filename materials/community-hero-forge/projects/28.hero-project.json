  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "fa51eba24d608b6ee090706ecea4afd14f5ab0c88d79377ce70afcaf0dd922e0",
    "name": "艾莉絲·伯雷亞斯·格雷拉特",
    "identity": "作品：《無職轉生》  \n採用：接受劍之聖地訓練後的劍士版本。  \n定位：先手、重斬、近身追擊。",
    "ownerText": "### 28｜艾莉絲·伯雷亞斯·格雷拉特\n\n作品：《無職轉生》  \n採用：接受劍之聖地訓練後的劍士版本。  \n定位：先手、重斬、近身追擊。\n\n- **PASSIVE｜〔劍神流・先發制人〕**：對剛進入交鋒的目標，首次近戰命中獲得有限強化；同一目標有冷卻。\n- **Q｜〔猛進斬〕**：向前踏步斬擊。\n- **W｜〔鬥氣護身〕**：短時間提高承傷能力，無法無限疊加。\n- **E｜〔逼近步〕**：短距離接近，保留可被攔截的路徑。\n- **R｜光之太刀**：有明確起手的高速直線斬擊，命中後停在合法位置。\n- **EX｜〔狂劍追擊〕**：對剛被自己擊中的近身目標進行一次額外追擊，超距時不能使用。\n\n**審查重點**：光速意象轉為有限距離與可見起手；驗證先手判定、追擊窗口、突進碰撞與高攻速下的動作完整性。\n\n",
    "reviewText": "光速意象轉為有限距離與可見起手；驗證先手判定、追擊窗口、突進碰撞與高攻速下的動作完整性。",
    "slots": {
      "PASSIVE": {
        "name": "〔劍神流・先發制人〕",
        "ownerDescription": "對剛進入交鋒的目標，首次近戰命中獲得有限強化；同一目標有冷卻。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需對剛交鋒目標的首次命中及每目標冷卻。",
        "refinementContracts": [
          "M01",
          "M11"
        ]
      },
      "Q": {
        "name": "〔猛進斬〕",
