  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "6f12f1c0c99da1f6841e901addc0e419b341f37fa61d73d452d91bf7d01dbd3c",
    "name": "魯路修",
    "identity": "作品：《Code Geass 反叛的魯路修》  \n定位：戰術標記、有限命令、隊伍配合。",
    "ownerText": "### 10｜魯路修\n\n作品：《Code Geass 反叛的魯路修》  \n定位：戰術標記、有限命令、隊伍配合。\n\n- **PASSIVE｜〔戰局推演〕**：友軍命中自己的戰術標記時累積指揮層數，同一技能多段命中只計一次。\n- **Q｜〔戰術射擊〕**：中距離單發射擊，對帶標記目標造成額外傷害。\n- **W｜〔集中火力〕**：標記一個可見敵人，讓下一次友軍有效命中獲得追加效果。\n- **E｜〔撤退指令〕**：為附近友軍提供朝安全方向移動時的短效加速。\n- **R｜絕對遵守的 Geass**：在視線成立後，命令一名敵人沿合法路徑朝指定位置移動，持續約 1 秒。每名目標每回合只能成功受此命令一次；控制免疫或視線失敗時不記為成功。\n- **EX｜〔Checkmate〕**：消耗指揮層數，對已標記區域發動有預警的戰術打擊。\n\n**審查重點**：驗證視線、命令成功紀錄、路徑失效、淨化與控制恢復；不允許命令玩家購物、交出資產或執行任意指令。\n\n",
    "reviewText": "驗證視線、命令成功紀錄、路徑失效、淨化與控制恢復；不允許命令玩家購物、交出資產或執行任意指令。",
    "slots": {
      "PASSIVE": {
        "name": "〔戰局推演〕",
        "ownerDescription": "友軍命中自己的戰術標記時累積指揮層數，同一技能多段命中只計一次。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需友軍命中戰術標記與施法去重指揮層數。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      },
      "Q": {
        "name": "〔戰術射擊〕",
        "ownerDescription": "中距離單發射擊，對帶標記目標造成額外傷害。",
        "baselineBehavior": "指定單一敵人造成小級物理傷害。",
        "requiredRefinement": "缺戰術標記額外傷害。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      },
      "W": {
        "name": "〔集中火力〕",
        "ownerDescription": "標記一個可見敵人，讓下一次友軍有效命中獲得追加效果。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。 附加效果：[{\"kind\":\"applyStatus\",\"statusId\":\"slow30\",\"duration\":1.5,\"applyTo\":\"target\",\"moveSpeedMult\":0.7}]。",
        "requiredRefinement": "固定緩速；需標記與下一次友軍命中消耗。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      },
      "E": {
        "name": "〔撤退指令〕",
        "ownerDescription": "為附近友軍提供朝安全方向移動時的短效加速。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "目前只加速自身；需朝安全方向移動的友軍條件。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      },
      "R": {
        "name": "絕對遵守的 Geass",
        "ownerDescription": "在視線成立後，命令一名敵人沿合法路徑朝指定位置移動，持續約 1 秒。每名目標每回合只能成功受此命令一次；控制免疫或視線失敗時不記為成功。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。 附加效果：[{\"kind\":\"applyStatus\",\"statusId\":\"stun\",\"duration\":0.8,\"applyTo\":\"target\",\"stun\":true}]。",
        "requiredRefinement": "單體 0.8 秒暈眩不能代替 Geass；需視線、強制合法移動與每目標每回合成功一次。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      },
      "EX": {
        "name": "〔Checkmate〕",
        "ownerDescription": "消耗指揮層數，對已標記區域發動有預警的戰術打擊。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次中級範圍傷害。",
        "requiredRefinement": "缺指揮層數消耗。",
        "refinementContracts": [
          "M01",
          "M08",
          "M12"
        ]
      }
    }
  },
