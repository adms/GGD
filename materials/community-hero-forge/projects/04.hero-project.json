  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "efa6e215376a822eeb99001216c87c088f2f03e5875432f2d3d4c36f559cb66d",
    "name": "空條承太郎",
    "identity": "作品：《JoJo 的奇妙冒險》  \n採用：第三部後期、已能停止時間。  \n定位：替身近戰、局部時停。",
    "ownerText": "### 04｜空條承太郎\n\n作品：《JoJo 的奇妙冒險》  \n採用：第三部後期、已能停止時間。  \n定位：替身近戰、局部時停。\n\n- **PASSIVE｜〔白金之星・精密動作〕**：近距離命中累積精密層數；滿層後強化下一次 Q 的末擊。\n- **Q｜歐拉連打**：白金之星在前方進行多段拳擊，每段重新確認距離與目標。\n- **W｜流星指刺**：中短距離直線刺擊，用於追擊離開普攻範圍的敵人。\n- **E｜〔替身護衛〕**：白金之星進入短暫防禦姿態，減免一次正面攻擊並推開近身敵人。\n- **R｜白金之星・世界**：建立短暫局部時停區域。暫停範圍內敵方單位的動作與指定計時器，以及敵方投射物運動。對決倒數及時停自身的結束計時繼續。承太郎在期間造成的命中記入有限佇列，時停結束後依序結算。\n- **EX｜〔歐拉終結拳〕**：有起手動作的重拳；時停期間使用時，加入同一套待結算命中佇列。\n\n**審查重點**：驗證投射物、施法進度、持續效果與解除時序；時停須具有模擬行為，並測試承太郎死亡、兩個時停重疊及結束瞬間的致死傷害。\n\n",
    "reviewText": "驗證投射物、施法進度、持續效果與解除時序；時停須具有模擬行為，並測試承太郎死亡、兩個時停重疊及結束瞬間的致死傷害。",
    "slots": {
      "PASSIVE": {
        "name": "〔白金之星・精密動作〕",
        "ownerDescription": "近距離命中累積精密層數；滿層後強化下一次 Q 的末擊。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需精密層數與 Q 末擊消耗。",
        "refinementContracts": [
          "M01",
          "M04",
          "M07",
          "M11"
        ]
      },
      "Q": {
        "name": "歐拉連打",
        "ownerDescription": "白金之星在前方進行多段拳擊，每段重新確認距離與目標。",
        "baselineBehavior": "6 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "需逐段距離重新檢查、替身掛點及雙模型動作。",
        "refinementContracts": [
          "M01",
          "M04",
          "M07",
          "M11"
        ]
      },
      "W": {
        "name": "流星指刺",
        "ownerDescription": "中短距離直線刺擊，用於追擊離開普攻範圍的敵人。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需單條流星指刺與單目標去重。",
        "refinementContracts": [
          "M01",
          "M04",
          "M07",
          "M11"
        ]
      },
      "E": {
        "name": "〔替身護衛〕",
        "ownerDescription": "白金之星進入短暫防禦姿態，減免一次正面攻擊並推開近身敵人。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-04-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "需正面一次格擋與推開近敵，不能以一般護盾驗收。",
        "refinementContracts": [
          "M01",
          "M04",
          "M07",
          "M11"
        ]
      },
