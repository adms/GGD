  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "e77ee996b85862140ac3b84fdc46af8c0c3582c0ac8dfef773bf51ab16f4529b",
    "name": "SUN樂",
    "identity": "作品：《香格里拉・開拓異境》  \n角色實體：サンラク／陽務樂郎。  \n定位：精準回避、反擊、短期強化。  \n來源錨點：作者公開小說中的實際招式。",
    "ownerText": "### 31｜SUN樂\n\n作品：《香格里拉・開拓異境》  \n角色實體：サンラク／陽務樂郎。  \n定位：精準回避、反擊、短期強化。  \n來源錨點：作者公開小說中的實際招式。\n\n- **PASSIVE｜〔糞作獵人的讀招〕**：成功以位移避開有效攻擊後，獲得一層讀招，上限三層。單純空按移動不增加。\n- **Q｜Spiral Edge**：短劍螺旋刺擊；對剛被自己反擊的目標有有限追加效果。\n- **W｜Slide Move**：滑步位移，提供很短的精準迴避窗口。\n- **E｜Repel Counter**：短窗口迎擊攻擊，成功時擊退攻擊者，並提供一次 Q 接續機會。\n- **R｜Accel**：短期提高移速與近戰輸出能力，保留原本技能冷卻。\n- **EX｜〔攻略完成〕**：消耗三層讀招，對近期交鋒目標進行一次有方向的高傷害短劍終結。\n\n**審查重點**：精準迴避、格擋、反擊及擊退必須是不同事件；測試未受攻擊空按、範圍技、多段技與反擊窗口結束瞬間。\n\n",
    "reviewText": "精準迴避、格擋、反擊及擊退必須是不同事件；測試未受攻擊空按、範圍技、多段技與反擊窗口結束瞬間。",
    "slots": {
      "PASSIVE": {
        "name": "〔糞作獵人的讀招〕",
        "ownerDescription": "成功以位移避開有效攻擊後，獲得一層讀招，上限三層。單純空按移動不增加。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需真正閃避事件的三層讀招，空按不增加。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "Q": {
        "name": "Spiral Edge",
        "ownerDescription": "短劍螺旋刺擊；對剛被自己反擊的目標有有限追加效果。",
        "baselineBehavior": "指定單一敵人造成小級物理傷害。",
        "requiredRefinement": "需螺旋刃動畫與反擊後目標追加條件。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "W": {
        "name": "Slide Move",
        "ownerDescription": "滑步位移，提供很短的精準迴避窗口。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "模板低跳不是精準迴避；需傷害來臨時間窗口。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "E": {
        "name": "Repel Counter",
        "ownerDescription": "短窗口迎擊攻擊，成功時擊退攻擊者，並提供一次 Q 接續機會。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-31-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "護盾不是 Repel Counter；需格擋成功、擊退與 Q 窗口。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "R": {
        "name": "Accel",
        "ownerDescription": "短期提高移速與近戰輸出能力，保留原本技能冷卻。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速、as +20%。",
        "requiredRefinement": "Accel 基礎移速／攻速增益；持續 3 秒且保留冷卻。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "EX": {
        "name": "〔攻略完成〕",
        "ownerDescription": "消耗三層讀招，對近期交鋒目標進行一次有方向的高傷害短劍終結。",
        "baselineBehavior": "指定單一敵人造成小級物理傷害。",
        "requiredRefinement": "需消耗三層讀招並限定近期交鋒目標。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      }
    }
