    "slots": {
      "PASSIVE": {
        "slot": "PASSIVE",
        "name": "〔阿卡曼戰鬥直覺〕",
        "purpose": "【目前模板可執行】普攻追加極小級物理傷害，內置冷卻 3 秒。\n【目標設計】成功避開攻擊後，下一次刀刃命中獲得有限增傷；有觸發間隔。\n【待補機制】需有效閃避事件、內置冷卻與下一刀增傷。",
        "maxRank": 1,
        "abilityOverrides": {
          "provenance": "editor-json"
        },
