  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "8127fa7c85a369611bf1ddae7ef03cb2c01e8f983e606c06e91ac238839a5210",
    "name": "米卡莎",
    "identity": "作品：《進擊的巨人》  \n採用：配備立體機動裝置與雷槍的版本。  \n定位：錨點移動、氣體與刀刃雙資源。",
    "ownerText": "### 08｜米卡莎\n\n作品：《進擊的巨人》  \n採用：配備立體機動裝置與雷槍的版本。  \n定位：錨點移動、氣體與刀刃雙資源。\n\n- **PASSIVE｜〔阿卡曼戰鬥直覺〕**：成功避開攻擊後，下一次刀刃命中獲得有限增傷；有觸發間隔。\n- **Q｜〔雙刃斬擊〕**：近身雙段斬擊，消耗刀刃耐久。\n- **W｜立體機動裝置**：射出鉤索連接合法錨點，消耗氣體沿路徑移動。\n- **E｜〔補給與換刃〕**：短暫停留更換刀刃並補充部分氣體；受到控制會中斷。\n- **R｜雷槍**：發射兩支可辨識的雷槍，命中或落地後延遲爆炸。\n- **EX｜〔立體機動・迴旋斬〕**：選定錨點與敵人後，沿限定弧線移動斬擊；路線失效時安全停止。\n\n**審查重點**：驗證找不到錨點、氣體不足、換刃中斷、鉤索目標消失與高速碰撞；禁止僅播放飛行動作而直接傳送。\n\n",
    "reviewText": "驗證找不到錨點、氣體不足、換刃中斷、鉤索目標消失與高速碰撞；禁止僅播放飛行動作而直接傳送。",
    "slots": {
      "PASSIVE": {
        "name": "〔阿卡曼戰鬥直覺〕",
        "ownerDescription": "成功避開攻擊後，下一次刀刃命中獲得有限增傷；有觸發間隔。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需有效閃避事件、內置冷卻與下一刀增傷。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "Q": {
        "name": "〔雙刃斬擊〕",
        "ownerDescription": "近身雙段斬擊，消耗刀刃耐久。",
        "baselineBehavior": "2 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "缺刀刃耐久。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "W": {
        "name": "立體機動裝置",
        "ownerDescription": "射出鉤索連接合法錨點，消耗氣體沿路徑移動。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "需合法場景錨點、鉤索路径、氣體消耗；不是自由跳躍。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "E": {
        "name": "〔補給與換刃〕",
        "ownerDescription": "短暫停留更換刀刃並補充部分氣體；受到控制會中斷。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"restore\",\"manaPct\":0.15,\"applyTo\":\"self\"}]。",
        "requiredRefinement": "需換刃及氣體資源／控制中斷。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "R": {
        "name": "雷槍",
        "ownerDescription": "發射兩支可辨識的雷槍，命中或落地後延遲爆炸。",
        "baselineBehavior": "在指定區域依序落下 2 發；每發間隔 0.4 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "兩發落點爆炸；需雷槍投射物、黏附與延遲引爆。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "EX": {
        "name": "〔立體機動・迴旋斬〕",
        "ownerDescription": "選定錨點與敵人後，沿限定弧線移動斬擊；路線失效時安全停止。",
        "baselineBehavior": "向指定方向突進 400 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "目前直線；需錨點弧線與路徑失效停止。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n成功位移後得到80護盾一秒，每三秒一次；這是安全繩保險，不是無敵。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n近身小級刀擊；四秒內換過E瓦斯罐才追加一刀極小物理傷害。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n鋼索斜飛：沿指定方向前進三格，沿途敵人各吃一次極小刀擊。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n換瓦斯罐：自身定身0.7秒，回復15%魔力；敵人可以趁換罐進攻。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n報銷刀片：指定敵人四段極小斬擊；四秒內用過W再退回5%魔力。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "瓦斯費先付：原地換罐挨打，補氣後的斬擊才有第二刀\n脫離危險到合法施法點，沒有免費補瓦斯。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
