  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "8127fa7c85a369611bf1ddae7ef03cb2c01e8f983e606c06e91ac238839a5210",
    "name": "米卡莎",
    "identity": "作品：《進擊的巨人》  \n採用：配備立體機動裝置與雷槍的版本。  \n定位：錨點移動、氣體與刀刃雙資源。",
    "ownerText": "### 08｜米卡莎\n\n作品：《進擊的巨人》  \n採用：配備立體機動裝置與雷槍的版本。  \n定位：錨點移動、氣體與刀刃雙資源。\n\n- **PASSIVE｜〔阿卡曼戰鬥直覺〕**：成功避開攻擊後，下一次刀刃命中獲得有限增傷；有觸發間隔。\n- **Q｜〔雙刃斬擊〕**：近身雙段斬擊，消耗刀刃耐久。\n- **W｜立體機動裝置**：射出鉤索連接合法錨點，消耗氣體沿路徑移動。\n- **E｜〔補給與換刃〕**：短暫停留更換刀刃並補充部分氣體；受到控制會中斷。\n- **R｜雷槍**：發射兩支可辨識的雷槍，命中或落地後延遲爆炸。\n- **EX｜〔立體機動・迴旋斬〕**：選定錨點與敵人後，沿限定弧線移動斬擊；路線失效時安全停止。\n\n**審查重點**：驗證找不到錨點、氣體不足、換刃中斷、鉤索目標消失與高速碰撞；禁止僅播放飛行動作而直接傳送。\n\n",
    "reviewText": "驗證找不到錨點、氣體不足、換刃中斷、鉤索目標消失與高速碰撞；禁止僅播放飛行動作而直接傳送。",
    "slots": {
      "PASSIVE": {
        "name": "〔阿卡曼戰鬥直覺〕",
        "ownerDescription": "成功避開攻擊後，下一次刀刃命中獲得有限增傷；有觸發間隔。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需有效閃避事件、內置冷卻與下一刀增傷。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
      "Q": {
        "name": "〔雙刃斬擊〕",
        "ownerDescription": "近身雙段斬擊，消耗刀刃耐久。",
        "baselineBehavior": "2 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "缺刀刃耐久。",
        "refinementContracts": [
          "M01",
          "M06",
          "M07"
        ]
      },
