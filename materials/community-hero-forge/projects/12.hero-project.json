  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "5dbb3b127c837110e23f3b8434750e3ac05f69c29fbc3911a2c7b268854865dc",
    "name": "衛宮士郎",
    "identity": "作品：《Fate/stay night》  \n採用：Unlimited Blade Works 路線。  \n定位：投影武器、短期武裝、區域劍製。",
    "ownerText": "### 12｜衛宮士郎\n\n作品：《Fate/stay night》  \n採用：Unlimited Blade Works 路線。  \n定位：投影武器、短期武裝、區域劍製。\n\n- **PASSIVE｜〔武器解析〕**：近戰交鋒累積解析層數，降低下一次投影的資源消耗；有最低消耗限制。\n- **Q｜干將・莫邪**：投影雙劍進行近身交叉斬擊。\n- **W｜〔投影・飛劍〕**：將有限數量的投影劍射向指定方向。\n- **E｜〔強化・踏步〕**：短距離移動並強化下一次近戰命中。\n- **R｜無限劍製**：展開有期限的劍域，強化 W 並在固定節奏追加投影劍；領域不改寫地圖邊界。\n- **EX｜〔投影・迎擊〕**：投影武器攔截一次正面攻擊，成功後開啟一次反擊。\n\n**審查重點**：投影武器具有期限與數量上限，不生成永久背包物品；驗證劍域退出、死亡清理及武器模型掛點。避免混入 HF 的移植手臂設定。\n\n",
    "reviewText": "投影武器具有期限與數量上限，不生成永久背包物品；驗證劍域退出、死亡清理及武器模型掛點。避免混入 HF 的移植手臂設定。",
    "slots": {
      "PASSIVE": {
        "name": "〔武器解析〕",
        "ownerDescription": "近戰交鋒累積解析層數，降低下一次投影的資源消耗；有最低消耗限制。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需近戰解析層與投影最低資源消耗。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      },
      "Q": {
        "name": "干將・莫邪",
        "ownerDescription": "投影雙劍進行近身交叉斬擊。",
        "baselineBehavior": "2 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "雙劍掛點與交叉斬動畫待製。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      },
      "W": {
        "name": "〔投影・飛劍〕",
        "ownerDescription": "將有限數量的投影劍射向指定方向。",
        "baselineBehavior": "在指定區域依序落下 3 發；每發間隔 0.15 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "目前定點三發落劍；需按方向投影飛劍。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      },
      "E": {
        "name": "〔強化・踏步〕",
        "ownerDescription": "短距離移動並強化下一次近戰命中。",
        "baselineBehavior": "向指定方向突進 250 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "缺下一次近戰強化。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      },
      "R": {
        "name": "無限劍製",
        "ownerDescription": "展開有期限的劍域，強化 W 並在固定節奏追加投影劍；領域不改寫地圖邊界。",
        "baselineBehavior": "指定落點維持 3 秒的小級半徑傷害區，每秒一跳極小級傷害。",
        "requiredRefinement": "目前領域傷害；需領域内 W 強化、投影劍生成與退出還原。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      },
      "EX": {
        "name": "〔投影・迎擊〕",
        "ownerDescription": "投影武器攔截一次正面攻擊，成功後開啟一次反擊。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-12-20260907.ex.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "需一次正面迎擊成功後反擊窗口。",
        "refinementContracts": [
          "M01",
          "M07",
          "M12"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n自己的護盾實際破裂後取得保固單四秒，每兩秒一次；空放護盾不給。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n投影小刀小級物理打擊；消耗保固單追加小級劍擊並回復5%魔力。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n廉價投影盾：只有40吸收量、持續三秒。敵人不打破就拿不到退貨單。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n把鍋鏟當劍丟：小級打擊並定身0.6秒。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n廚房劍雨，三發小級物理傷害；不召喚永久武器庫。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "投影保固：山寨盾真的碎了，才能把退貨單投影成第二把劍\n保固也能折現：消耗同一張保固單回復220生命，和Q只能選一邊。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
