  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "9bc1841caa0f5777f8163ce3a83aa70c7ec4e64a620167dbf435323b80a532db",
    "name": "桐谷和人",
    "identity": "作品：《刀劍神域》  \n採用：SAO 二刀流桐人。  \n定位：多段近戰、連擊中斷、雙武器動作。",
    "ownerText": "### 19｜桐谷和人\n\n作品：《刀劍神域》  \n採用：SAO 二刀流桐人。  \n定位：多段近戰、連擊中斷、雙武器動作。\n\n- **PASSIVE｜二刀流**：交替命中累積連擊節奏，停止交鋒後衰退；提供有限攻速加成。\n- **Q｜〔雙劍交叉斬〕**：左右手各進行一次近戰判定。\n- **W｜〔劍技招架〕**：短窗口迎擊正面攻擊，成功後強化下一次近戰。\n- **E｜Sonic Leap**：短距離躍進斬擊，碰撞或落點失效時安全停止。\n- **R｜Starburst Stream**：十六次依序發生的斬擊機會；每次重新檢查目標範圍，整招共享傷害預算。\n- **EX｜The Eclipse**：更長起手的二十七連擊終結技；具有更高的暴露時間與中斷風險。\n\n**審查重點**：驗證第幾段中斷、目標移出範圍、左右武器命中點，以及吸血、被動和命中特效的觸發頻率。\n\n",
    "reviewText": "驗證第幾段中斷、目標移出範圍、左右武器命中點，以及吸血、被動和命中特效的觸發頻率。",
    "slots": {
      "PASSIVE": {
        "name": "二刀流",
        "ownerDescription": "交替命中累積連擊節奏，停止交鋒後衰退；提供有限攻速加成。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需左右手交替命中、節奏衰退與攻速。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      },
      "Q": {
        "name": "〔雙劍交叉斬〕",
        "ownerDescription": "左右手各進行一次近戰判定。",
        "baselineBehavior": "2 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "需左右手掛點對應。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      },
      "W": {
        "name": "〔劍技招架〕",
        "ownerDescription": "短窗口迎擊正面攻擊，成功後強化下一次近戰。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-19-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "需迎擊窗口與成功後下一刀加成。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      },
      "E": {
        "name": "Sonic Leap",
        "ownerDescription": "短距離躍進斬擊，碰撞或落點失效時安全停止。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "需對目標的躍進斬、牆體與落點失效處理。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      },
      "R": {
        "name": "Starburst Stream",
        "ownerDescription": "十六次依序發生的斬擊機會；每次重新檢查目標範圍，整招共享傷害預算。",
        "baselineBehavior": "16 段連擊，間隔 0.1 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "16 段已可配置；須證明每段重查距離、中斷後不再命中及總預算。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      },
      "EX": {
        "name": "The Eclipse",
        "ownerDescription": "更長起手的二十七連擊終結技；具有更高的暴露時間與中斷風險。",
        "baselineBehavior": "20 段連擊，間隔 0.1 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "模板 hitCount 上限 20，不能冒稱 27 連擊；需有序 27 段的共用模板擴充，不採兩個並行連擊拼接。",
        "refinementContracts": [
          "M01",
          "M07",
          "M11"
        ]
      }
    }
  },
