  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "e5ef08a61c9b45d823be6c2f8956dcfc6818de3a297e889bacad62206b767843",
    "name": "坂田銀時",
    "identity": "作品：《銀魂》  \n定位：木刀近戰、反擊、喜劇節奏。",
    "ownerText": "### 23｜坂田銀時\n\n作品：《銀魂》  \n定位：木刀近戰、反擊、喜劇節奏。\n\n- **PASSIVE｜〔糖分補給〕**：脫戰後累積一份補給，供 W 消耗；最多保存一份。\n- **Q｜〔洞爺湖・橫斬〕**：木刀橫掃前方。\n- **W｜〔草莓牛奶休息時間〕**：短暫飲用補給恢復生命，受擊或移動會中斷。\n- **E｜〔萬事屋式反擊〕**：短時間招架，成功後可接一次木刀反擊。\n- **R｜〔白夜叉〕**：限時強化近戰動作與追擊能力，不提供永久變形。\n- **EX｜〔吐槽也是武器〕**：近身重擊打斷一個可中斷的施法，以吐槽文字及誇張表情演出。\n\n**審查重點**：喜劇文字與真正控制事件對齊；測試反擊失敗、補給中斷與強化結束，不把台詞解析成額外技能指令。\n\n",
    "reviewText": "喜劇文字與真正控制事件對齊；測試反擊失敗、補給中斷與強化結束，不把台詞解析成額外技能指令。",
    "slots": {
      "PASSIVE": {
        "name": "〔糖分補給〕",
        "ownerDescription": "脫戰後累積一份補給，供 W 消耗；最多保存一份。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需脫戰保存一份補給給 W。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "Q": {
        "name": "〔洞爺湖・橫斬〕",
        "ownerDescription": "木刀橫掃前方。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需木刀近身弧形判定。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "W": {
        "name": "〔草莓牛奶休息時間〕",
        "ownerDescription": "短暫飲用補給恢復生命，受擊或移動會中斷。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"heal\",\"amount\":{\"flat\":100,\"ratios\":[]},\"applyTo\":\"self\"}]。",
        "requiredRefinement": "需喝草莓牛奶動作、移動／受擊中斷。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "E": {
        "name": "〔萬事屋式反擊〕",
        "ownerDescription": "短時間招架，成功後可接一次木刀反擊。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-23-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "需招架成功後一次反擊窗口。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "R": {
        "name": "〔白夜叉〕",
        "ownerDescription": "限時強化近戰動作與追擊能力，不提供永久變形。",
        "baselineBehavior": "自身取得 4 秒增益：ad +15%、極小級移速。",
        "requiredRefinement": "短期 AD＋移速對應基础强化；白夜叉動作待製。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
