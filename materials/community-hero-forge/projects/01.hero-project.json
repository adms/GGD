  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "6b5927c053da8f108f3cf1595684c8d34465df0a36d7a077a65d78a98955a505",
    "name": "武藤遊戲",
    "identity": "作品：《遊戲王》  \n採用：武藤遊戲／闇遊戲的黑魔導牌組意象。  \n定位：召喚、陷阱、協同施法。",
    "ownerText": "### 01｜武藤遊戲\n\n作品：《遊戲王》  \n採用：武藤遊戲／闇遊戲的黑魔導牌組意象。  \n定位：召喚、陷阱、協同施法。\n\n- **PASSIVE｜〔決鬥者的布局〕**：召喚物命中與陷阱成功觸發，各累積布局；每次施法最多增加一層，上限三層，供 EX 消耗。\n- **Q｜黑魔導**：召喚一名可受擊的黑魔導；再次下令可更換攻擊目標，同種召喚物最多一名。\n- **W｜黑魔導女孩**：召喚一名可受擊的黑魔導女孩；與黑魔導共同攻擊同一目標時，觸發有內置冷卻的協同追加傷害。\n- **E｜神聖彗星・反射力量**：設置一個可辨識的陷阱；範圍內首次敵方普攻觸發時，抵消該次攻擊並反擊來源，隨後消失。\n- **R｜歐西里斯的天空龍**：以天空龍投影演出有預警的區域雷擊；此招是一次性施法投影，不增加常駐召喚物。\n- **EX｜黑・魔・導**：消耗布局，由存活的黑魔導射出強化直線魔法；缺少黑魔導時顯示使用條件。\n\n**審查重點**：Q/W 必須具有生命、仇恨、主人與死亡事件；驗證召喚者死亡、陷阱重複觸發、協同傷害去重，以及 EX 施法途中召喚物被擊殺。\n\n",
    "reviewText": "Q/W 必須具有生命、仇恨、主人與死亡事件；驗證召喚者死亡、陷阱重複觸發、協同傷害去重，以及 EX 施法途中召喚物被擊殺。",
    "slots": {
      "PASSIVE": {
        "name": "〔決鬥者的布局〕",
        "ownerDescription": "召喚物命中與陷阱成功觸發，各累積布局；每次施法最多增加一層，上限三層，供 EX 消耗。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需補召喚／陷阱成功事件去重、三層布局及 EX 扣除。",
        "refinementContracts": [
          "M01",
          "M03"
        ]
      },
      "Q": {
        "name": "黑魔導",
        "ownerDescription": "召喚一名可受擊的黑魔導；再次下令可更換攻擊目標，同種召喚物最多一名。",
        "baselineBehavior": "召喚 1 名 sela 樣板代理，6 秒、25% 傷害、30% 生命，同類上限 1、主人死亡清除。",
        "requiredRefinement": "黑魔導專屬造型與再次下令換目標未提供；代理採 sela。",
        "refinementContracts": [
          "M01",
          "M03"
        ]
      },
      "W": {
        "name": "黑魔導女孩",
        "ownerDescription": "召喚一名可受擊的黑魔導女孩；與黑魔導共同攻擊同一目標時，觸發有內置冷卻的協同追加傷害。",
        "baselineBehavior": "召喚 1 名 sela 樣板代理，6 秒、25% 傷害、30% 生命，同類上限 1、主人死亡清除。",
        "requiredRefinement": "黑魔導女孩造型、與黑魔導協同事件未提供；目前同模板上限須驗證跨槽隔離。",
        "refinementContracts": [
          "M01",
          "M03"
        ]
      },
      "E": {
        "name": "神聖彗星・反射力量",
        "ownerDescription": "設置一個可辨識的陷阱；範圍內首次敵方普攻觸發時，抵消該次攻擊並反擊來源，隨後消失。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-01-20260907.e.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "目標設計是一次觸發陷阱與反射；目前只有自身護盾，不能驗收陷阱。",
        "refinementContracts": [
          "M01",
          "M03"
        ]
      },
      "R": {
        "name": "歐西里斯的天空龍",
        "ownerDescription": "以天空龍投影演出有預警的區域雷擊；此招是一次性施法投影，不增加常駐召喚物。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次大級範圍傷害。",
        "requiredRefinement": "天空龍投影是待製資產；預覽以雷電區域脈衝表達。",
        "refinementContracts": [
          "M01",
          "M03"
        ]
