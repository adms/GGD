  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "abcad4bd0109fab996039d46fe9b9aef79ce4386a5a04f85a79792cc6c1d1240",
    "name": "一拳超人",
    "identity": "作品：《一拳超人》  \n角色實體：埼玉；保留「一拳超人」顯示名稱。  \n定位：高辨識單擊、長起手、傷害上限。",
    "ownerText": "### 25｜一拳超人\n\n作品：《一拳超人》  \n角色實體：埼玉；保留「一拳超人」顯示名稱。  \n定位：高辨識單擊、長起手、傷害上限。\n\n- **PASSIVE｜〔興趣使然的英雄〕**：一段時間未攻擊後，下一次普通拳獲得有限強化。\n- **Q｜普通拳**：短距離單次重拳。\n- **W｜連續普通拳**：多段拳擊，整招使用固定傷害預算。\n- **E｜〔趕上特賣〕**：直線快速移動，碰撞後停止。\n- **R｜認真系列・認真一拳**：長起手後的高傷害衝擊波，具有明顯方向與閃避窗口。\n- **EX｜認真系列・認真反覆橫跳**：短期快速左右移動並產生殘像，提供有限迴避機會。\n\n**審查重點**：認真一拳仍經過護盾、減傷與保命結算；驗證高傷害溢位、碰撞與多段觸發，保留「一拳」演出而不直接刪除敵人。\n\n",
    "reviewText": "認真一拳仍經過護盾、減傷與保命結算；驗證高傷害溢位、碰撞與多段觸發，保留「一拳」演出而不直接刪除敵人。",
    "slots": {
      "PASSIVE": {
        "name": "〔興趣使然的英雄〕",
        "ownerDescription": "一段時間未攻擊後，下一次普通拳獲得有限強化。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需未攻擊時間與下一拳一次消耗。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      },
      "Q": {
        "name": "普通拳",
        "ownerDescription": "短距離單次重拳。",
        "baselineBehavior": "指定單一敵人造成小級物理傷害。",
        "requiredRefinement": "普通拳仍走標準傷害。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      },
      "W": {
        "name": "連續普通拳",
        "ownerDescription": "多段拳擊，整招使用固定傷害預算。",
        "baselineBehavior": "5 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "需要整招總傷害預算；目前每段各自級距。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      },
      "E": {
        "name": "〔趕上特賣〕",
        "ownerDescription": "直線快速移動，碰撞後停止。",
        "baselineBehavior": "向指定方向突進 450 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "碰撞安全需場景驗收。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      },
      "R": {
        "name": "認真系列・認真一拳",
        "ownerDescription": "長起手後的高傷害衝擊波，具有明顯方向與閃避窗口。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "四段衝擊波不等於單拳總結算；需高單擊預算與較長起手。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      },
      "EX": {
        "name": "認真系列・認真反覆橫跳",
        "ownerDescription": "短期快速左右移動並產生殘像，提供有限迴避機會。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "目前移速增益；需左右連續側移與有限次有效迴避。",
        "refinementContracts": [
          "M02",
          "M07",
          "M11"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n用EX招呼隊友來分菜時回復8%魔力，每四秒一次；有沒有菜只決定EX能否治療。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n普通拳小級物理傷害加0.8AD，不保證一拳秒殺。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n超市衝刺：四秒自己移速+50%但不能普攻；雙手提菜的狀態只能消費一次。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n抄近路買菜，瞬移到合法落點，仍遵守落點限制。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n放下菜再認真：普通小級打擊；消耗自己購物狀態才追加大級物理傷害，消耗後移速和繳械一起結束。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "一拳特價日：提著菜不能普攻，放下購物袋才打得出認真拳\n分菜：消耗自己的購物狀態，指定隊友回復260；分完就不能拿同一袋打認真拳。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
