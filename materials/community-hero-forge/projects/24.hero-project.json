  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "be056be7a5e33d0f97f27dd29d8ddbeb066e5acf74d34dfcb824035667012e97",
    "name": "奇犽",
    "identity": "作品：《HUNTER×HUNTER》  \n定位：電力資源、高速移動、自動反應。",
    "ownerText": "### 24｜奇犽\n\n作品：《HUNTER×HUNTER》  \n定位：電力資源、高速移動、自動反應。\n\n- **PASSIVE｜〔電力儲備〕**：技能消耗電力；停止攻擊一段時間後逐步充電，設上限。\n- **Q｜落雷**：指定小區域的延遲電擊。\n- **W｜肢曲**：短距離側移並留下殘像；只有有效迴避才觸發後續反擊資源。\n- **E｜電光石火**：持續消耗電力提高移動速度，關閉或電力耗盡時停止。\n- **R｜神速・疾風迅雷**：短期開啟自動反應：符合距離與攻擊條件時進行有限次反擊，每次消耗電力且有觸發間隔。\n- **EX｜〔充電釋放〕**：消耗剩餘電力進行近身爆發，之後進入低電力狀態。\n\n**審查重點**：區分有效迴避、攻擊落空與無敵免傷；反擊不得再次觸發自己的反擊，充電與消耗須可重播。\n\n",
    "reviewText": "區分有效迴避、攻擊落空與無敵免傷；反擊不得再次觸發自己的反擊，充電與消耗須可重播。",
    "slots": {
      "PASSIVE": {
        "name": "〔電力儲備〕",
        "ownerDescription": "技能消耗電力；停止攻擊一段時間後逐步充電，設上限。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需電力上限／脫戰充電；目前用標準魔力。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "Q": {
        "name": "落雷",
        "ownerDescription": "指定小區域的延遲電擊。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次小級範圍傷害。",
        "requiredRefinement": "短起手落點電擊對應基礎版。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "W": {
        "name": "肢曲",
        "ownerDescription": "短距離側移並留下殘像；只有有效迴避才觸發後續反擊資源。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "需貼地肢曲殘像與有效閃避事件。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "E": {
        "name": "電光石火",
        "ownerDescription": "持續消耗電力提高移動速度，關閉或電力耗盡時停止。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "目前固定 3 秒加速；需開關及持續扣電。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "R": {
        "name": "神速・疾風迅雷",
        "ownerDescription": "短期開啟自動反應：符合距離與攻擊條件時進行有限次反擊，每次消耗電力且有觸發間隔。",
        "baselineBehavior": "自身取得 3 秒增益：as +20%、極小級移速。",
        "requiredRefinement": "目前攻速／移速；需受攻擊條件自動反應、限次扣電及循環防止。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      },
      "EX": {
        "name": "〔充電釋放〕",
        "ownerDescription": "消耗剩餘電力進行近身爆發，之後進入低電力狀態。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次中級範圍傷害。",
        "requiredRefinement": "固定傷害；需消耗剩餘電力與低電力狀態。",
        "refinementContracts": [
          "M01",
          "M07"
        ]
      }
    }
  },
