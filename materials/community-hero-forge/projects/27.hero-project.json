  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "3a105938fa54ec021b5701ecb97b0b90a52b7ac83035df99318d683ecfd1510b",
    "name": "庫洛魔法使",
    "identity": "作品：《庫洛魔法使》  \n角色實體：木之本櫻；採庫洛牌篇能力意象。  \n定位：固定牌組、技能替換、短期武裝。",
    "ownerText": "### 27｜庫洛魔法使\n\n作品：《庫洛魔法使》  \n角色實體：木之本櫻；採庫洛牌篇能力意象。  \n定位：固定牌組、技能替換、短期武裝。\n\n- **PASSIVE｜〔卡牌連結〕**：依序使用不同卡牌累積連結，上限三層，強化下一次護盾。\n- **Q｜風牌**：以風束攻擊並推動目標。\n- **W｜盾牌**：為自己或指定友軍提供護盾。\n- **E｜翔牌**：短期飛行位移，具有合法落點與高度限制。\n- **R｜劍牌**：短期將法杖化為劍，替換普攻並強化近戰。\n- **EX｜〔換牌：風與樹〕**：將 Q 在風牌推動與樹牌束縛之間切換；兩者共享 Q 的冷卻與資源。\n\n**審查重點**：牌面、圖示與實際技能同步；驗證切換中的施法、共用冷卻、劍牌結束，以及飛行不穿越對決邊界。\n\n",
    "reviewText": "牌面、圖示與實際技能同步；驗證切換中的施法、共用冷卻、劍牌結束，以及飛行不穿越對決邊界。",
    "slots": {
      "PASSIVE": {
        "name": "〔卡牌連結〕",
        "ownerDescription": "依序使用不同卡牌累積連結，上限三層，強化下一次護盾。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需不同牌序列三層與護盾消耗。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "Q": {
        "name": "風牌",
        "ownerDescription": "以風束攻擊並推動目標。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。",
        "requiredRefinement": "風束推動缺 knockback；目前單體魔法。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "W": {
        "name": "盾牌",
        "ownerDescription": "為自己或指定友軍提供護盾。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-27-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "目前自身；需友軍選取。",
        "refinementContracts": [
          "M01",
