  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "b01c3704427d0f0c47a8574dc146fefbc1bec9e6ba239345479e9001c721e1be",
    "name": "西索",
    "identity": "作品：《HUNTER×HUNTER》  \n定位：連線、牽引、表面偽裝。",
    "ownerText": "### 07｜西索\n\n作品：《HUNTER×HUNTER》  \n定位：連線、牽引、表面偽裝。\n\n- **PASSIVE｜〔魔術師的節奏〕**：以不同技能命中同一目標，強化下一次撲克牌攻擊；最多保存一次。\n- **Q｜〔撲克牌連射〕**：扇形投出三張牌，同一目標的額外命中採遞減傷害。\n- **W｜伸縮自在的愛**：將念線附著於一個敵人或合法場景錨點；超距、死亡或期限到達時斷線。\n- **E｜〔收線〕**：附著敵人時牽引敵人；附著錨點時拉動自己。兩種行為都受碰撞與最大位移限制。\n- **R｜〔彈性殺陣〕**：短暫建立最多兩條額外念線，結束時向中心牽引一次。\n- **EX｜輕薄的假象**：在地面製作一個假的陷阱外觀，或改變自身表面外觀。偽裝不改變真實陣營、碰撞與伺服器身分。\n\n**審查重點**：連線的來源、端點及斷線條件可追蹤；驗證雙向牽引、牆角、錨點消失，以及偽裝對敵我資訊的顯示範圍。\n\n",
    "reviewText": "連線的來源、端點及斷線條件可追蹤；驗證雙向牽引、牆角、錨點消失，以及偽裝對敵我資訊的顯示範圍。",
    "slots": {
      "PASSIVE": {
        "name": "〔魔術師的節奏〕",
        "ownerDescription": "以不同技能命中同一目標，強化下一次撲克牌攻擊；最多保存一次。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需不同技能序列及下一次牌擊消耗。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "Q": {
        "name": "〔撲克牌連射〕",
        "ownerDescription": "扇形投出三張牌，同一目標的額外命中採遞減傷害。",
        "baselineBehavior": "在指定區域依序落下 3 發；每發間隔 0.12 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "三發為落點散射；需扇形牌彈與同目標遞減。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "W": {
        "name": "伸縮自在的愛",
        "ownerDescription": "將念線附著於一個敵人或合法場景錨點；超距、死亡或期限到達時斷線。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。 附加效果：[{\"kind\":\"applyStatus\",\"statusId\":\"root\",\"duration\":0.7,\"applyTo\":\"target\",\"root\":true}]。",
        "requiredRefinement": "只有短暫鎖足；需有端點的彈性連線及斷線規則。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "E": {
        "name": "〔收線〕",
        "ownerDescription": "附著敵人時牽引敵人；附著錨點時拉動自己。兩種行為都受碰撞與最大位移限制。",
        "baselineBehavior": "拖拉指定目標後向前投擲 120 wc3u，0.45 秒拋物線，落地半徑 2 GGD 單位小級傷害。",
        "requiredRefinement": "僅敵人抓投；需錨點拉動自己與敵人牽引的分支。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "R": {
        "name": "〔彈性殺陣〕",
        "ownerDescription": "短暫建立最多兩條額外念線，結束時向中心牽引一次。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次小級範圍傷害。",
        "requiredRefinement": "目前單次區域傷害；需最多兩條额外念線及一次中心牽引。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "EX": {
        "name": "輕薄的假象",
        "ownerDescription": "在地面製作一個假的陷阱外觀，或改變自身表面外觀。偽裝不改變真實陣營、碰撞與伺服器身分。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "僅短效移速；需假陷阱／表面偽裝及敵我顯示隔離。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n自己真正施加控制後得到60護盾一秒，每三秒一次；表演翻車仍會掉血。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n把自己的口香糖黏上敵人四秒，減速20%；別人的糖不算。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n收線：只有自己黏過的敵人才被拉至身前；起手距離超過四格還多一次小級傷害。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n先將敵人推遠四格，替口香糖上弦；這招不自帶傷害。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n收表演費：中級打擊；仍黏著自己的糖時定身一秒，控制可以被淨化。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "伸縮自在的口香糖：先黏、再推遠，拉長了才像在打人\n魔術師換位離場，不留假的可攻擊分身。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
