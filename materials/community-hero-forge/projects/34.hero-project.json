  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "1992d2a65620e63219a53f44a52d450d11ee2de2b1e27bcd8b1ce3812ba35af9",
    "name": "高速婆婆",
    "identity": "作品：《膽大黨》  \n採用：高速婆婆本體的妖怪戰鬥意象。  \n定位：高速追擊、轉向、有限詛咒。",
    "ownerText": "### 34｜高速婆婆\n\n作品：《膽大黨》  \n採用：高速婆婆本體的妖怪戰鬥意象。  \n定位：高速追擊、轉向、有限詛咒。\n\n- **PASSIVE｜〔追上你了〕**：持續追逐同一可見目標時累積速度，轉換目標、失去視線或停止追逐後衰退。\n- **Q｜〔疾走爪擊〕**：短距離突進爪擊。\n- **W｜〔急轉彎〕**：快速改變方向，降低當前加速層數以換取操作能力。\n- **E｜〔妖怪的咒印〕**：標記一個可見敵人，使自己朝其移動時獲得有限加速。\n- **R｜〔全速追獵〕**：短期提升速度上限與轉向能力，期間仍須通過碰撞檢查。\n- **EX｜〔百公里衝撞〕**：蓄勢後沿長直線衝撞，命中第一名英雄或障礙物時停止。\n\n**審查重點**：測試高速穿牆、轉角、目標死亡及追擊超距；區分高速婆婆、招財貓容器與厄卡倫的能力持有狀態。\n\n",
    "reviewText": "測試高速穿牆、轉角、目標死亡及追擊超距；區分高速婆婆、招財貓容器與厄卡倫的能力持有狀態。",
    "slots": {
      "PASSIVE": {
        "name": "〔追上你了〕",
        "ownerDescription": "持續追逐同一可見目標時累積速度，轉換目標、失去視線或停止追逐後衰退。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需同一可見目標追逐速度與轉目標衰退。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "Q": {
        "name": "〔疾走爪擊〕",
        "ownerDescription": "短距離突進爪擊。",
        "baselineBehavior": "向指定方向突進 250 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "爪擊模型待製。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "W": {
        "name": "〔急轉彎〕",
        "ownerDescription": "快速改變方向，降低當前加速層數以換取操作能力。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "需急轉向與消耗加速層，不能單純低跳。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "E": {
        "name": "〔妖怪的咒印〕",
        "ownerDescription": "標記一個可見敵人，使自己朝其移動時獲得有限加速。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。 附加效果：[{\"kind\":\"applyStatus\",\"statusId\":\"slow30\",\"duration\":1.5,\"applyTo\":\"target\",\"moveSpeedMult\":0.7}]。",
        "requiredRefinement": "緩速只是底稿；需追獵目標標記與朝向加速。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "R": {
        "name": "〔全速追獵〕",
        "ownerDescription": "短期提升速度上限與轉向能力，期間仍須通過碰撞檢查。",
        "baselineBehavior": "自身取得 3 秒增益：極小級移速。",
        "requiredRefinement": "3 秒移速增益；需上限与轉向能力独立参数。",
        "refinementContracts": [
          "M01",
          "M06"
        ]
      },
      "EX": {
        "name": "〔百公里衝撞〕",
        "ownerDescription": "蓄勢後沿長直線衝撞，命中第一名英雄或障礙物時停止。",
        "baselineBehavior": "向指定方向突進 500 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "需命中第一英雄或牆即停止，不能穿越後繼續連撞。",
        "refinementContracts": [
          "M01",
