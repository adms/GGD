  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "d76c6bdfe3d31db6183947e00aac69e6ad320088a1a7ddd51aa1f4a9c0b6c85d",
    "name": "安茲·烏爾·恭",
    "identity": "作品：《OVERLORD》  \n定位：死亡魔法、召喚、延遲終結。",
    "ownerText": "### 17｜安茲·烏爾·恭\n\n作品：《OVERLORD》  \n定位：死亡魔法、召喚、延遲終結。\n\n- **PASSIVE｜〔情緒抑制〕**：受到控制後獲得短效控制抗性，具有內置冷卻。\n- **Q｜心臟掌握**：對單一目標造成魔法傷害；低生命時追加有限傷害，仍經正常致死與保命流程。\n- **W｜死亡騎士**：召喚一名可受擊的死亡騎士，負責近身牽制。\n- **E｜高階傳送**：移動到合法落點，保留可辨識的起點與終點演出。\n- **R｜墜落天空**：長起手的區域超位魔法，具有明顯預警與中斷機會。\n- **EX｜死亡是所有生命的終點**：對範圍內敵人施加倒數詛咒。到期後，低於生命門檻者進入標準處決結算，其餘受到有限傷害。可依 GGD 規則以離開有效條件、淨化或保命能力反制。\n\n**審查重點**：處決不能直接刪除單位；驗證倒數期間死亡、召喚主死亡、保命優先序及重複結算。先比對既有飛鼠／安茲內容，建立社群版本而非覆蓋。\n\n",
    "reviewText": "處決不能直接刪除單位；驗證倒數期間死亡、召喚主死亡、保命優先序及重複結算。先比對既有飛鼠／安茲內容，建立社群版本而非覆蓋。",
    "slots": {
      "PASSIVE": {
        "name": "〔情緒抑制〕",
        "ownerDescription": "受到控制後獲得短效控制抗性，具有內置冷卻。",
        "baselineBehavior": "受傷時觸發有 4 秒冷卻的小範圍反擊；不是防禦成功或閃避成功事件。",
        "requiredRefinement": "需受控後控制抗性及冷卻；目前受傷反擊。",
        "refinementContracts": [
          "M03",
          "M09"
        ]
      },
      "Q": {
        "name": "心臟掌握",
        "ownerDescription": "對單一目標造成魔法傷害；低生命時追加有限傷害，仍經正常致死與保命流程。",
        "baselineBehavior": "指定單一敵人造成小級魔法傷害。",
        "requiredRefinement": "缺低生命有限追加與處決流程專測。",
        "refinementContracts": [
          "M03",
          "M09"
        ]
      },
      "W": {
        "name": "死亡騎士",
        "ownerDescription": "召喚一名可受擊的死亡騎士，負責近身牽制。",
        "baselineBehavior": "召喚 1 名 thorne 樣板代理，6 秒、25% 傷害、30% 生命，同類上限 1、主人死亡清除。",
        "requiredRefinement": "死亡騎士造型待製，代理採 thorne。",
        "refinementContracts": [
          "M03",
          "M09"
        ]
      },
      "E": {
        "name": "高階傳送",
        "ownerDescription": "移動到合法落點，保留可辨識的起點與終點演出。",
        "baselineBehavior": "傳送到指定落點，抵達後小範圍極小級傷害。",
        "requiredRefinement": "原設計只有傳送，模板帶抵達傷害，需審查這項改編。",
        "refinementContracts": [
          "M03",
          "M09"
        ]
      },
      "R": {
        "name": "墜落天空",
        "ownerDescription": "長起手的區域超位魔法，具有明顯預警與中斷機會。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次大級範圍傷害。",
        "requiredRefinement": "需長吟唱途中真正可中斷與落點預警。",
        "refinementContracts": [
          "M03",
          "M09"
        ]
      },
      "EX": {
        "name": "死亡是所有生命的終點",
        "ownerDescription": "對範圍內敵人施加倒數詛咒。到期後，低於生命門檻者進入標準處決結算，其餘受到有限傷害。可依 GGD 規則以離開有效條件、淨化或保命能力反制。",
        "baselineBehavior": "指定落點半徑 300 wc3u 的一次中級範圍傷害。",
        "requiredRefinement": "目前立即範圍傷害；需倒數詛咒、標準處決、淨化與保命優先序。",
