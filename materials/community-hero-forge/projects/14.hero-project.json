  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "6b1a3c8e65786d6ec92a7a2a2753416a2e86f96d168bbf4178e0f59cb27d6ee7",
    "name": "殺老師",
    "identity": "作品：《暗殺教室》  \n定位：高速移動、觸手多工、限時防禦。",
    "ownerText": "### 14｜殺老師\n\n作品：《暗殺教室》  \n定位：高速移動、觸手多工、限時防禦。\n\n- **PASSIVE｜〔教師的觀察〕**：同一敵人反覆以相同招式攻擊時，短暫提高對該招的有限防禦；不同技能可打破適應。\n- **Q｜〔觸手批改〕**：前方多段觸手打擊，整招共享觸發次數上限。\n- **W｜〔高速授課〕**：沿指定路線快速移動，到達終點時給附近友軍短效加速。\n- **E｜〔觸手再生〕**：消耗資源分段恢復生命，受控制時停止。\n- **R｜完全防禦形態**：進入短暫球體防禦，期間無法移動及施法；結束後有明顯恢復動作。\n- **EX｜〔分身式教學〕**：以高速殘像演出三處依序打擊，實際由同一本體按時序結算。\n\n**審查重點**：高速位移仍處理路徑碰撞；防禦不能無限續接；殘像不生成三個完整英雄，也不重複獲得被動與擊殺獎勵。\n\n",
    "reviewText": "高速位移仍處理路徑碰撞；防禦不能無限續接；殘像不生成三個完整英雄，也不重複獲得被動與擊殺獎勵。",
    "slots": {
      "PASSIVE": {
        "name": "〔教師的觀察〕",
        "ownerDescription": "同一敵人反覆以相同招式攻擊時，短暫提高對該招的有限防禦；不同技能可打破適應。",
        "baselineBehavior": "受傷時觸發有 4 秒冷卻的小範圍反擊；不是防禦成功或閃避成功事件。",
        "requiredRefinement": "需按敵人技能 ID 適應，不是所有受擊反擊。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      },
      "Q": {
        "name": "〔觸手批改〕",
        "ownerDescription": "前方多段觸手打擊，整招共享觸發次數上限。",
        "baselineBehavior": "4 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "觸手多掛點與整招觸發上限待補。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      },
      "W": {
        "name": "〔高速授課〕",
        "ownerDescription": "沿指定路線快速移動，到達終點時給附近友軍短效加速。",
        "baselineBehavior": "向指定方向突進 450 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "缺到達終點後的友軍加速。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      },
      "E": {
        "name": "〔觸手再生〕",
        "ownerDescription": "消耗資源分段恢復生命，受控制時停止。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"heal\",\"amount\":{\"flat\":100,\"ratios\":[]},\"applyTo\":\"self\"}]。",
        "requiredRefinement": "目前立即回血；需分段再生與受控中止。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      },
      "R": {
        "name": "完全防禦形態",
        "ownerDescription": "進入短暫球體防禦，期間無法移動及施法；結束後有明顯恢復動作。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":180,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-14-20260907.r.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "需球體變形、禁移動禁施法與限時防禦；目前只有盾。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      },
      "EX": {
        "name": "〔分身式教學〕",
        "ownerDescription": "以高速殘像演出三處依序打擊，實際由同一本體按時序結算。",
        "baselineBehavior": "在指定區域依序落下 3 發；每發間隔 0.2 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "三個落點固定脈衝；需本體依序定位及殘像對齊。",
        "refinementContracts": [
          "M07",
          "M11",
          "M12"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n自己施加控制後，移速增加20%兩秒，每三秒一次；趕著批下一份。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n零分粉筆：敵人小級魔法傷害，普攻失手40%三秒。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n發還考卷：消耗自己給敵人的致盲，解除他的視力問題；自己周圍三格友軍各回復160。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n高速巡堂移動到合法落點，沒有保證閃避。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n下課前小考：三次極小魔法打擊；同目標死亡即停止。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "改作業的殺老師：先讓學生看不清，再把錯題收回換全班補血\n補習班保護：給隊友180護盾；自己慢30%兩秒去擦黑板。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
