  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "236e77e81e9f5354e89974a06035b65155caddbf81f15e8e9cbafcde52a6438c",
    "name": "炭治郎",
    "identity": "作品：《鬼滅之刃》  \n採用：能使用水之呼吸與火之神神樂的版本。  \n定位：呼吸姿態、資源消耗、刀技方向。",
    "ownerText": "### 35｜炭治郎\n\n作品：《鬼滅之刃》  \n採用：能使用水之呼吸與火之神神樂的版本。  \n定位：呼吸姿態、資源消耗、刀技方向。\n\n- **PASSIVE｜〔嗅覺・破綻辨識〕**：成功閃過敵人攻擊後，短暫顯示該敵人的近身破綻；下一次刀技命中消耗。\n- **Q｜水之呼吸・水面斬**：前方橫斬，適合穩定輸出。\n- **W｜水之呼吸・水車**：旋轉斬擊並進行短距離位移。\n- **E｜〔呼吸調整〕**：短暫調息恢復呼吸資源，移動或受擊會降低恢復效率。\n- **R｜火之神神樂・圓舞**：明顯蓄勢後的高傷害斬擊，消耗較多呼吸資源。\n- **EX｜〔呼吸切換〕**：讓 Q 在水面斬與火之神神樂的強化斬版本間切換。共用 Q 冷卻；火之神版本消耗較高並增加自身負擔。\n\n**審查重點**：姿態切換保留冷卻及資源；驗證嗅覺標記的可見性、呼吸不足與高負擔狀態。水火演出不自動生成永久水域或燃燒地形。\n\n",
    "reviewText": "姿態切換保留冷卻及資源；驗證嗅覺標記的可見性、呼吸不足與高負擔狀態。水火演出不自動生成永久水域或燃燒地形。",
    "slots": {
      "PASSIVE": {
        "name": "〔嗅覺・破綻辨識〕",
        "ownerDescription": "成功閃過敵人攻擊後，短暫顯示該敵人的近身破綻；下一次刀技命中消耗。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需有效閃避後近身破綻標記與下一刀消耗。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      },
      "Q": {
        "name": "水之呼吸・水面斬",
        "ownerDescription": "前方橫斬，適合穩定輸出。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需水面斬前方橫弧，目前四段直線。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      },
      "W": {
        "name": "水之呼吸・水車",
        "ownerDescription": "旋轉斬擊並進行短距離位移。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "需水車旋轉斬与武器動作。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      },
      "E": {
        "name": "〔呼吸調整〕",
        "ownerDescription": "短暫調息恢復呼吸資源，移動或受擊會降低恢復效率。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"restore\",\"manaPct\":0.15,\"applyTo\":\"self\"}]。",
        "requiredRefinement": "標準魔力回復 15%；需呼吸資源、調息中移動受傷降效率。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      },
      "R": {
        "name": "火之神神樂・圓舞",
        "ownerDescription": "明顯蓄勢後的高傷害斬擊，消耗較多呼吸資源。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "需火之神單次高傷斬與呼吸高消耗。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      },
      "EX": {
        "name": "〔呼吸切換〕",
        "ownerDescription": "讓 Q 在水面斬與火之神神樂的強化斬版本間切換。共用 Q 冷卻；火之神版本消耗較高並增加自身負擔。",
        "baselineBehavior": "自身取得 3 秒增益：ad +15%。",
        "requiredRefinement": "固定 AD 增益不是切換；需水／火 Q 版本、共用冷卻与負擔。",
        "refinementContracts": [
          "M01",
          "M05",
          "M07"
        ]
      }
    }
