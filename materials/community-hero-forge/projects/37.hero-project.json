  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "d6914597576ea4f3967a26e03b87190b41c306cd0006d8cc45aa5f9d2f57ac5e",
    "name": "吉伊卡哇",
    "identity": "作品：《吉伊卡哇》  \n採用：吉伊卡哇本人。  \n定位：膽怯與勇氣、短兵器、小型角色可讀性。  \n註：以下名稱與戰鬥效果為 GGD 創編。",
    "ownerText": "### 37｜吉伊卡哇\n\n作品：《吉伊卡哇》  \n採用：吉伊卡哇本人。  \n定位：膽怯與勇氣、短兵器、小型角色可讀性。  \n註：以下名稱與戰鬥效果為 GGD 創編。\n\n- **PASSIVE｜〔雖然害怕還是努力〕**：附近友軍交戰時累積勇氣，上限三層；以時間間隔累積，避免多段傷害快速疊滿。\n- **Q｜〔討伐叉刺擊〕**：短距離刺擊，武器判定與外觀一致。\n- **W｜〔哇啊啊撤退〕**：朝指定方向短距離逃跑，消耗一層勇氣可取得小護盾。\n- **E｜〔點心時間〕**：短暫停留恢復少量生命，受擊中斷。\n- **R｜〔鼓起勇氣討伐〕**：消耗勇氣發動數次叉擊，層數決定有限的強化幅度。\n- **EX｜〔一起加油〕**：為附近友軍提供護盾與短效抗恐懼，自己也獲得相同效果。\n\n**審查重點**：小型模型仍要有公平且清楚的受擊範圍；驗證勇氣產生、恐懼解除與撤退方向，避免將小八台詞或兔兔招式當成本人的原作招式。\n\n",
    "reviewText": "小型模型仍要有公平且清楚的受擊範圍；驗證勇氣產生、恐懼解除與撤退方向，避免將小八台詞或兔兔招式當成本人的原作招式。",
    "slots": {
      "PASSIVE": {
        "name": "〔雖然害怕還是努力〕",
        "ownerDescription": "附近友軍交戰時累積勇氣，上限三層；以時間間隔累積，避免多段傷害快速疊滿。",
        "baselineBehavior": "普攻追加極小級物理傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需附近友軍交战依時間累積勇氣，上限三層。",
        "refinementContracts": [
          "M01",
          "M12"
        ]
      },
      "Q": {
        "name": "〔討伐叉刺擊〕",
        "ownerDescription": "短距離刺擊，武器判定與外觀一致。",
        "baselineBehavior": "指定單一敵人造成小級物理傷害。",
        "requiredRefinement": "討伐叉造型與近身命中對齊待製。",
        "refinementContracts": [
          "M01",
          "M12"
        ]
      },
      "W": {
        "name": "〔哇啊啊撤退〕",
        "ownerDescription": "朝指定方向短距離逃跑，消耗一層勇氣可取得小護盾。",
        "baselineBehavior": "向指定方向突進 220 wc3u，造成極小級碰撞範圍傷害與推移。",
        "requiredRefinement": "需無傷害撤退並可扣勇氣換小盾；目前衝撞模板不等價。",
        "refinementContracts": [
          "M01",
          "M12"
        ]
      },
      "E": {
        "name": "〔點心時間〕",
        "ownerDescription": "短暫停留恢復少量生命，受擊中斷。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"heal\",\"amount\":{\"flat\":70,\"ratios\":[]},\"applyTo\":\"self\"}]。",
        "requiredRefinement": "需停留吃點心及受擊中斷。",
        "refinementContracts": [
          "M01",
          "M12"
        ]
      },
      "R": {
        "name": "〔鼓起勇氣討伐〕",
        "ownerDescription": "消耗勇氣發動數次叉擊，層數決定有限的強化幅度。",
        "baselineBehavior": "3 段連擊，間隔 0.18 秒；各段極小級、末段小級，不附帶鎖足或施法者無敵。",
        "requiredRefinement": "固定三段；需勇氣消耗与有限強化幅度。",
        "refinementContracts": [
          "M01",
          "M12"
        ]
