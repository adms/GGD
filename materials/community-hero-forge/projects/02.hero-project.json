  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "cc5732f3d513233d7dd106c63bb767ef94b59fb79fd213566130640e8ecf800d",
    "name": "八神庵",
    "identity": "作品：《THE KING OF FIGHTERS》  \n採用：具有紫炎的八神庵。  \n定位：接續輸入、近身連段、爆發。",
    "ownerText": "### 02｜八神庵\n\n作品：《THE KING OF FIGHTERS》  \n採用：具有紫炎的八神庵。  \n定位：接續輸入、近身連段、爆發。\n\n- **PASSIVE｜〔八神之炎〕**：不同主動技能連續命中同一敵人，累積最多三層紫炎；下一次終結技消耗層數增傷。\n- **Q｜百八式・闇拂**：沿地面前進的紫炎投射物，遇到有效碰撞結算。\n- **W｜百式・鬼燒**：原地上升火焰打擊，提供短暫迎擊窗口與有限擊退。\n- **E｜百二十七式・葵花**：三段接續技；每段須在指定窗口再次輸入，逾時、受控或第三段完成後結束。\n- **R｜禁千二百十一式・八稚女**：突進命中後進入有限連擊，最後一擊引爆紫炎層數。\n- **EX｜裏三百十六式・豺華**：可獨立使用；在八稚女完成後的短窗口內使用，改為接續追擊並消耗自己的冷卻。\n\n**審查重點**：接續輸入是真正的技能狀態；測試晚按、連按、斷線重送、控制中斷，以及 R→EX 的消耗與傷害只結算一次。\n\n",
    "reviewText": "接續輸入是真正的技能狀態；測試晚按、連按、斷線重送、控制中斷，以及 R→EX 的消耗與傷害只結算一次。",
    "slots": {
      "PASSIVE": {
        "name": "〔八神之炎〕",
        "ownerDescription": "不同主動技能連續命中同一敵人，累積最多三層紫炎；下一次終結技消耗層數增傷。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需技能命中三層紫炎與終結技消耗。",
        "refinementContracts": [
          "M01",
          "M02",
          "M11"
        ]
      },
      "Q": {
        "name": "百八式・闇拂",
        "ownerDescription": "沿地面前進的紫炎投射物，遇到有效碰撞結算。",
        "baselineBehavior": "四段沿直線推進的波，每 0.12 秒向前 100 wc3u；各段獨立區域傷害。",
        "requiredRefinement": "推進波並非遇第一個單位即停的投射物。",
        "refinementContracts": [
