  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "eedb4a55ff1a046044ef02e793e9f242529f89a2a1f6853f4eff5af73fe81ba8",
    "name": "魔法少女☆伊莉雅",
    "identity": "作品：《Fate/kaleid liner 魔法少女☆伊莉雅》  \n定位：魔杖射擊、職階卡、限時武裝。",
    "ownerText": "### 16｜魔法少女☆伊莉雅\n\n作品：《Fate/kaleid liner 魔法少女☆伊莉雅》  \n定位：魔杖射擊、職階卡、限時武裝。\n\n- **PASSIVE｜〔紅寶石的支援〕**：不同魔法技能連續施放後，強化下一次防禦或攻擊，不能由同一次多段命中快速疊滿。\n- **Q｜〔魔力砲擊〕**：由紅寶石之星發射直線魔力彈。\n- **W｜〔魔力防壁〕**：展開有限耐久的正面護盾。\n- **E｜〔魔法少女飛行〕**：短距離浮空移動，仍受對決邊界與落點合法性限制。\n- **R｜夢幻召喚・Saber**：限時取得 Saber 武裝，替換普攻與 Q；結束後還原，生命與冷卻持續。\n- **EX｜限定展開・Excalibur**：展開寶具進行一次有起手的直線光束攻擊。\n\n**審查重點**：區分限定展開與夢幻召喚；測試卡片形態、武器掛點、切回技能及死亡還原，不借用其他伊莉雅版本的身世或能力補槽。\n\n",
    "reviewText": "區分限定展開與夢幻召喚；測試卡片形態、武器掛點、切回技能及死亡還原，不借用其他伊莉雅版本的身世或能力補槽。",
    "slots": {
      "PASSIVE": {
        "name": "〔紅寶石的支援〕",
        "ownerDescription": "不同魔法技能連續施放後，強化下一次防禦或攻擊，不能由同一次多段命中快速疊滿。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需不同魔法施放序列及一次强化消耗。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "Q": {
        "name": "〔魔力砲擊〕",
        "ownerDescription": "由紅寶石之星發射直線魔力彈。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "魔杖彈体待製；目前分段光路。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "W": {
        "name": "〔魔力防壁〕",
        "ownerDescription": "展開有限耐久的正面護盾。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-16-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "目前全方向自身盾；需正面防壁。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "E": {
        "name": "〔魔法少女飛行〕",
        "ownerDescription": "短距離浮空移動，仍受對決邊界與落點合法性限制。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "有限落點跳躍，不是持續飛行。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "R": {
        "name": "夢幻召喚・Saber",
        "ownerDescription": "限時取得 Saber 武裝，替換普攻與 Q；結束後還原，生命與冷卻持續。",
        "baselineBehavior": "自身取得 4 秒增益：ad +15%、as +20%。",
        "requiredRefinement": "目前 AD／攻速；需 Saber 武裝、普攻与 Q 替換與還原。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      },
      "EX": {
        "name": "限定展開・Excalibur",
        "ownerDescription": "展開寶具進行一次有起手的直線光束攻擊。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "限定展開為一次光束，可作基礎驗收；需寶具武器掛點。",
        "refinementContracts": [
          "M01",
          "M05",
          "M12"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n施放EX準備卸妝時回復5%魔力，每三秒一次；並非普攻免費附傷。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n魔法拳：小級物理傷害加0.8AD；近戰服提供AD，仍遵守本遊戲的通用技能係數。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n近戰職階裝填：三秒攻擊力+80、魔法攻擊力-20。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n借你緞帶：指定隊友140護盾三秒，不假裝成換装。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n魔法光束：中級魔法傷害加0.8AP；穿近戰服時這招會弱，選裝有取捨。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "魔法少女換裝事故：穿近戰卡會丟掉魔攻，卸妝才退票\n卸妝退票：消耗自己的職階增益還原攻擊力與魔法攻擊力，回復10%魔力；沒有衣服不退額外魔力。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
