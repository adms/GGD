  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "541315ab12f52f3f0042eb9bfd98d3c58854cdf816a2cc1175d4445d161ac3a1",
    "name": "芙莉蓮",
    "identity": "作品：《葬送的芙莉蓮》  \n定位：魔法射擊、防壁、魔力資訊、生活魔法改編。",
    "ownerText": "### 29｜芙莉蓮\n\n作品：《葬送的芙莉蓮》  \n定位：魔法射擊、防壁、魔力資訊、生活魔法改編。\n\n- **PASSIVE｜魔力抑制**：降低敵方魔力感知類技能取得的強度資訊；不等同隱形，也不隱藏基本敵我識別。\n- **Q｜一般攻擊魔法・Zoltraak**：直線魔法射擊。\n- **W｜防禦魔法**：展開方向明確的防壁，消耗資源抵擋有限傷害。\n- **E｜飛行魔法**：短距離浮空移動。\n- **R｜〔葬送連射〕**：依序射出多方向魔法束，每束有獨立射線及整招總傷害上限。\n- **EX｜變出花田的魔法**：生成短期花田；GGD 改編效果為友軍首次進入時解除恐懼並取得小額護盾。\n\n**審查重點**：區分外觀魔力量、真實資源與可見性；防壁需處理方向及耐久。花田的戰鬥效果明列為 GGD 改編，不借用其他角色專屬魔法。\n\n",
    "reviewText": "區分外觀魔力量、真實資源與可見性；防壁需處理方向及耐久。花田的戰鬥效果明列為 GGD 改編，不借用其他角色專屬魔法。",
    "slots": {
      "PASSIVE": {
        "name": "魔力抑制",
        "ownerDescription": "降低敵方魔力感知類技能取得的強度資訊；不等同隱形，也不隱藏基本敵我識別。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需魔力感知的資訊層抑制，不可用隱形或傷害被動冒充。",
        "refinementContracts": [
          "M12"
        ]
      },
      "Q": {
        "name": "一般攻擊魔法・Zoltraak",
        "ownerDescription": "直線魔法射擊。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "Zoltraak 原型；需單束碰撞去重。",
        "refinementContracts": [
          "M12"
        ]
      },
      "W": {
        "name": "防禦魔法",
        "ownerDescription": "展開方向明確的防壁，消耗資源抵擋有限傷害。",
