  "sourceDesign": {
    "schema": "ggd-hero-source-design@1",
    "sourceSha256": "541315ab12f52f3f0042eb9bfd98d3c58854cdf816a2cc1175d4445d161ac3a1",
    "name": "芙莉蓮",
    "identity": "作品：《葬送的芙莉蓮》  \n定位：魔法射擊、防壁、魔力資訊、生活魔法改編。",
    "ownerText": "### 29｜芙莉蓮\n\n作品：《葬送的芙莉蓮》  \n定位：魔法射擊、防壁、魔力資訊、生活魔法改編。\n\n- **PASSIVE｜魔力抑制**：降低敵方魔力感知類技能取得的強度資訊；不等同隱形，也不隱藏基本敵我識別。\n- **Q｜一般攻擊魔法・Zoltraak**：直線魔法射擊。\n- **W｜防禦魔法**：展開方向明確的防壁，消耗資源抵擋有限傷害。\n- **E｜飛行魔法**：短距離浮空移動。\n- **R｜〔葬送連射〕**：依序射出多方向魔法束，每束有獨立射線及整招總傷害上限。\n- **EX｜變出花田的魔法**：生成短期花田；GGD 改編效果為友軍首次進入時解除恐懼並取得小額護盾。\n\n**審查重點**：區分外觀魔力量、真實資源與可見性；防壁需處理方向及耐久。花田的戰鬥效果明列為 GGD 改編，不借用其他角色專屬魔法。\n\n",
    "reviewText": "區分外觀魔力量、真實資源與可見性；防壁需處理方向及耐久。花田的戰鬥效果明列為 GGD 改編，不借用其他角色專屬魔法。",
    "slots": {
      "PASSIVE": {
        "name": "魔力抑制",
        "ownerDescription": "降低敵方魔力感知類技能取得的強度資訊；不等同隱形，也不隱藏基本敵我識別。",
        "baselineBehavior": "普攻追加極小級魔法傷害，內置冷卻 3 秒。",
        "requiredRefinement": "需魔力感知的資訊層抑制，不可用隱形或傷害被動冒充。",
        "refinementContracts": [
          "M12"
        ]
      },
      "Q": {
        "name": "一般攻擊魔法・Zoltraak",
        "ownerDescription": "直線魔法射擊。",
        "baselineBehavior": "向前依序展開四個窄區域判定，各段極小級傷害；交疊段可重複命中。",
        "requiredRefinement": "Zoltraak 原型；需單束碰撞去重。",
        "refinementContracts": [
          "M12"
        ]
      },
      "W": {
        "name": "防禦魔法",
        "ownerDescription": "展開方向明確的防壁，消耗資源抵擋有限傷害。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-29-20260907.w.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "目前無方向盾；需六角防壁方向、耐久與持續消耗。",
        "refinementContracts": [
          "M12"
        ]
      },
      "E": {
        "name": "飛行魔法",
        "ownerDescription": "短距離浮空移動。",
        "baselineBehavior": "朝落點進行 0.5 秒跳躍，著地小範圍極小級傷害。",
        "requiredRefinement": "短期浮空可用落點跳躍預覽，不提供持續飛行。",
        "refinementContracts": [
          "M12"
        ]
      },
      "R": {
        "name": "〔葬送連射〕",
        "ownerDescription": "依序射出多方向魔法束，每束有獨立射線及整招總傷害上限。",
        "baselineBehavior": "在指定區域依序落下 6 發；每發間隔 0.35 秒、半徑 150 wc3u、極小級傷害，可多次命中。",
        "requiredRefinement": "目前定點六波；需各方向獨立射線及總傷害上限。",
        "refinementContracts": [
          "M12"
        ]
      },
      "EX": {
        "name": "變出花田的魔法",
        "ownerDescription": "生成短期花田；GGD 改編效果為友軍首次進入時解除恐懼並取得小額護盾。",
        "baselineBehavior": "自身取得 3 秒增益：無屬性加成；另結算下列護盾／回復等 effects。 附加效果：[{\"kind\":\"shield\",\"amount\":{\"flat\":120,\"ratios\":[]},\"duration\":3,\"absorbs\":\"all\",\"stackKey\":\"community-review-29-20260907.ex.guard\",\"onExisting\":\"keepLarger\"}]。",
        "requiredRefinement": "目前自身盾；需花田區域、友軍首次進入解除恐懼及一次護盾。",
        "refinementContracts": [
          "M12"
        ]
      }
    }
  },
  "refinementNotes": {
    "PASSIVE": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n自己真正接受治療後回復5%魔力，每三秒一次；不是持續白拿藍。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "Q": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n普通攻擊魔法，中級直線魔法傷害；招式名普通不代表無限傷害。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "W": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n候診保險：指定队友160護盾三秒；四秒內開過E掛號，再加100護盾。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "E": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n掛號排隊：以指定隊友當下落點約兩秒後重選兩格內友軍，各回復220；病人走掉可落空。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "R": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n花園候診室：三次每秒重選自身三格友軍各回復60；原地站好，不是傷害友軍的魔法領域。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。",
    "EX": "芙莉蓮掛號處：治療約兩秒後，先給候診者盾；病人跑掉就白等\n把診間搬到自己身邊，瞬移到合法落點；已約好的E地點不會跟著搬。\n原文留在sourceDesign。既有模型綁定保留；畫面與發布驗收另記，不以編譯取代。"
  },
