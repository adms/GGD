    {
      "priority": "P2",
      "file": "tools/hero-model-library/priority-conversion/kaiji/freeze.py",
      "lines": "58-60",
      "title": "Re-running freeze erases completed registration receipt fields",
      "detail": "freeze always replaces receipt.json with readiness=runtime-verified-awaiting-registration and no backendSelectionVerified/activeModelKey/selectionMode/registrationEvidence. Current checked receipt has those completed fields; readback.mts writes only priority-registration and registration-readback, so rerunning the documented pair downgrades and loses this completed receipt state. Current artifacts are consistent; issue affects reproducible replay.",
      "suggestion": "Separate conversion and registration receipts or preserve/validate completed registration fields when source SHA is unchanged; reject drift rather than overwrite.",
      "rootDisposition": "Root acknowledged and is implementing the replay fix independently; this report pins the pre-fix reviewed source SHA."
    }
  ],
  "notes": [
    {
      "file": "tools/hero-model-library/build_priority81_handoff.py",
      "detail": "Current raw supplement association matches the correct source URL/key/SHA. runtime_supplement joins by hero/sourceModelKey but does not verify source receipt identity, so future second Kaiji source should be joined by sourceId/receipt as well; not a current data mismatch."
    },
    {
      "file": "tools/hero-model-library/priority-conversion/kaiji/readback.mts",
