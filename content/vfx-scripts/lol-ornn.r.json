{
  "id": "lol-ornn.r",
  "schema": "vfx-script@1",
  "abilityId": "lol-ornn.r",
  "notes": "鄂爾 R：GGD 基本演出，非原作特效還原。投射物依實際命中、週期演出依 strike、移動結束依 onLand/onEnd；落點與成功分支使用既有 spawnVfx。判定與尚缺機制仍以技能資料為準。",
  "yields": [
    "caster.castFx"
  ],
  "segments": [
    {
      "kind": "anim",
      "on": "castStart",
      "replaces": "caster.action",
      "at": "caster",
      "pulse": "cast"
    },
    {
      "vfxId": "fx.prim.fire.pulse",
      "at": "self",
      "kind": "vfx",
      "on": "castStart",
      "tint": [
        255,
        110,
        35
      ]
    },
    {
      "vfxId": "fx.prim.holy.beam-flat",
      "at": "self",
      "kind": "vfx",
      "on": "castEffect",
      "offsetForwardU": 0.35,
      "tint": [
        255,
        110,
        35
      ],
      "flyHeight": 55
    }
  ]
}
