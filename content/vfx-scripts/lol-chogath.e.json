{
  "id": "lol-chogath.e",
  "schema": "vfx-script@1",
  "abilityId": "lol-chogath.e",
  "notes": "科加斯 E：GGD 基本演出，非原作特效還原。投射物依實際命中、週期演出依 strike、移動結束依 onLand/onEnd；落點與成功分支使用既有 spawnVfx。判定與尚缺機制仍以技能資料為準。",
  "yields": [
    "caster.castFx"
  ],
  "segments": [
    {
      "kind": "anim",
      "on": "castStart",
      "replaces": "caster.action",
      "at": "caster",
      "pulse": "cast"
    },
    {
      "vfxId": "fx.prim.physical.slash",
      "at": "self",
      "kind": "vfx",
      "on": "castEffect",
      "w3xScale": 0.65,
      "tint": [
        185,
        85,
        230
      ],
      "flyHeight": 55
    }
  ]
}
