{
  "id": "acquired-emilia.q",
  "schema": "vfx-script@1",
  "abilityId": "acquired-emilia.q",
  "notes": "採用已出貨 GGD 特效與音效。施法提示不代表傷害或資源消耗成功；判定依技能資料。非原作特效與語音還原。",
  "yields": [
    "caster.castFx"
  ],
  "segments": [
    {
      "kind": "anim",
      "on": "castStart",
      "replaces": "caster.action",
      "at": "caster",
      "pulse": "cast"
    },
    {
      "vfxId": "fx.prim.ice.pulse-sm",
      "at": "target",
      "kind": "vfx",
      "on": "projectileHit",
      "w3xScale": 0.7,
      "tint": [
        110,
        210,
        255
      ]
    },
    {
      "kind": "sound",
      "on": "castEffect",
      "soundKey": "hitMagic"
    }
  ]
}
