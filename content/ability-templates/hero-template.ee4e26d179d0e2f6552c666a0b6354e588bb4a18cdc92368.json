{"description":"朝目標點直線衝鋒，抵達後對落點周圍造成範圍傷害，並把該處的敵人推開。預設貼地衝刺（衝鋒弧高 0）；把弧高拉起來就變成 52-02 蹂躪編年史那種掄飛。「推開距離」清空 = 只衝鋒不推撞（52-04 巨神一擊）。傷害與推撞都在抵達點結算，不是在起跳點。","exemplar":{"jass":"A0OG","skill":"38-01 邪王炎殺劍"},"family":"charge-push","gapScore":5,"id":"hero-template.ee4e26d179d0e2f6552c666a0b6354e588bb4a18cdc92368","name":"衝鋒推撞","params":{"apexHeight":{"default":0,"max":600,"min":0,"type":"number","unit":"wc3h"},"castTimeSec":{"default":0,"max":5,"min":0,"optional":true,"type":"number","unit":"s"},"damage":{"default":{"perRank":[350],"ratios":[]},"type":"scaling"},"damageType":{"default":"physical","type":"enum","values":["magic","physical","true"]},"dashDistance":{"default":600,"max":1309,"min":100,"type":"number","unit":"wc3u"},"dashDurationSec":{"default":0.4,"max":2,"min":0.05,"type":"number","unit":"s"},"pushDistance":{"default":400,"max":1090,"min":50,"optional":true,"type":"number","unit":"wc3u"},"pushFrom":{"default":"facing","type":"enum","values":["caster","facing","pull"]},"pushLaunchHeight":{"default":0,"max":600,"min":0,"type":"number","unit":"wc3h"},"pushSpeed":{"default":872,"max":2181,"min":100,"type":"number","unit":"wc3u"},"radius":{"default":300,"max":900,"min":50,"type":"number","unit":"wc3u"}},"requires":["leap","knockback"],"schema":"template@1","status":"enabled"}
